--!strict
-- Quest EXP budget (S98, docs/DESIGN-15.md §3.2): the monster EXP multiplier of a character level (the
-- compensation generated by tools/quest_budget.luau into Data/QuestBudget), the budget bands and the EXP of the
-- boss quests. Pure; never requires Data/Quests (Data/Quests/Boss requires this module).

local Data = require("../Data/QuestBudget")
local Exp = require("./Exp")

local QuestBudget = {}

-- Monster EXP multiplier for a character of `level` (1 at level 100 and above: no EXP is collected there).
function QuestBudget.monsterExpMul(level: number): number
	local l = math.floor(level)
	if l >= 100 then
		return 1
	end
	return Data.MONSTER_EXP_MUL[math.clamp(l, 1, 99)] or 1
end

-- The budget band (first, last level) holding `level`; 100 and above fall into the last band.
function QuestBudget.bandOf(level: number): (number, number)
	for _, band in Data.BANDS do
		if level >= band[1] and level <= band[2] then
			return band[1], band[2]
		end
	end
	if level < Data.BANDS[1][1] then
		return Data.BANDS[1][1], Data.BANDS[1][2]
	end
	local last = Data.BANDS[#Data.BANDS]
	return last[1], last[2]
end

-- Sum of Exp.expToNext over the band of `level`.
function QuestBudget.bandExp(level: number): number
	local lo, hi = QuestBudget.bandOf(level)
	local sum = 0
	for L = lo, hi do
		sum += Exp.expToNext(L)
	end
	return sum
end

-- EXP of one boss quest of `level` when `count` boss quests share the band: TARGET.boss of the band's EXP.
function QuestBudget.bossQuestExp(level: number, count: number): number
	return math.floor(QuestBudget.bandExp(level) * Data.TARGET.boss / math.max(count, 1))
end

return QuestBudget
