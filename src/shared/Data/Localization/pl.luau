	["path.trapper.contagion.name"] = "Zaraza",
	["path.trapper.contagion.desc"] = "Gdy zatruty przez Ciebie wróg ginie, reszta trucizny przechodzi na najbliższych wrogów w 8 st. (najwyżej {contagion}).",
	["path.trapper.toxicologist.name"] = "Toksykolog",
	["path.trapper.toxicologist.desc"] = "Wrogowie zatruci przez Ciebie zadają Ci o {toxicologist}% mniej obrażeń.",
	["path.trapper.huntingGround.name"] = "Łowisko",
	["path.trapper.huntingGround.desc"] = "Trafienia obszarowe Twoich umiejętności (Deszcz Strzał, Salwa, Strzała Przebijająca, pułapki) zadają o {huntingGround}% więcej obrażeń. Nie dotyczy trucizny ani ataków podstawowych.",
	["path.trapper.bitingRain.name"] = "Kąsające Strzały",
	["path.trapper.bitingRain.desc"] = "Pierwsza fala Deszczu Strzał zadaje o {bitingWave}% więcej, a deszcz zostawia na 4 s trujące pole, które co sekundę zadaje {bitingField}% obrażeń fali.",
	["path.trapper.spoils.name"] = "Łup Kłusownika",
	["path.trapper.spoils.desc"] = "Za każdego wroga złapanego przez Twoją pułapkę odzyskujesz {spoils} energii, najwyżej za 3 wrogów na pułapkę.",
	["path.trapper.blastTrap.name"] = "Wybuchowa Pułapka",
	["path.trapper.blastTrap.desc"] = "Pułapka Lodowa wybucha przy złapaniu: {blastDmg}% obrażeń i trucizna {blastPoison}% przez 6 s.",
	["path.trapper.entrap.name"] = "Uwięzienie",
	["path.trapper.entrap.desc"] = "Unieruchomienie z Twoich pułapek (Pułapka Lodowa, Pole Sideł) trwa {entrap} s dłużej.",
	["path.trapper.ambush.name"] = "Zasadzka",
	["path.trapper.ambush.desc"] = "Odnowienie Kamuflażu jest krótsze o {ambushPct}%.",
	["path.trapper.denseSnares.name"] = "Gęste Sidła",
	["path.trapper.denseSnares.desc"] = "Pole Sideł zastawia więcej sideł: +{denseSnares}.",
	["path.trapper.numbingVenom.name"] = "Paraliżujący Jad",
	["path.trapper.numbingVenom.desc"] = "Wrogowie zatruci przez Ciebie są spowolnieni o {numbingVenom}%.",
	["path.trapper.basilisk.name"] = "Jad Bazyliszka",
	["path.trapper.basilisk.desc"] = "Wszystkie Twoje trucizny zadają o {basilisk}% więcej obrażeń (razem z Jadem Myśliwskim).",
