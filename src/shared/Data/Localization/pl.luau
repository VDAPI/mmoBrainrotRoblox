	-- S107: the five new people of the Ashen Wastes; where the givers of the Ashen arcs stand (the innkeeper's gossip)
	["npc.scout_ashen.where"] = "przy Bramie z Żeber na Spalonych Pustkowiach",
	["npc.alchemist.where"] = "w pracowni alchemicznej",
	["npc.waterkeeper_orren.name"] = "Studniarz Orren",
	["npc.waterkeeper_orren.role"] = "Studniarz",
	["npc.waterkeeper_orren.greeting"] = "Woda słyszy, jak o niej mówisz. Mów cicho.",
	["npc.waterkeeper_orren.line1"] = "Mój ród pilnował tej wody od czasów, kiedy oaza była jeziorem. Zostałem ja i ostatni staw.",
	["npc.waterkeeper_orren.line2"] = "Woda nie umiera. Odchodzi, kiedy ludzie przestają o nią dbać, i wraca, kiedy ktoś ją zawoła.",
	["npc.waterkeeper_orren.line3"] = "Szary podróżny pił z mojej studni. Tej nocy woda w niej zamarzła, choć piasek parzył stopy.",
	["npc.waterkeeper_orren.where"] = "przy pomoście w Martwej Oazie",
	["npc.prospector_dragan.name"] = "Poszukiwacz Dragan",
	["npc.prospector_dragan.role"] = "Poszukiwacz srebra",
	["npc.prospector_dragan.greeting"] = "Uważaj, gdzie kopiesz. Tu każda dziura jest czyjaś.",
	["npc.prospector_dragan.line1"] = "Przyszedłem z miasta po srebro z trzema wspólnikami. Wracam sam i z długami.",
	["npc.prospector_dragan.line2"] = "Liczę wszystko: srebro, dni, obietnice. Obietnice najtrudniej.",
	["npc.prospector_dragan.line3"] = "Orkowie z obozu nie kopią. Biorą to, co wykopią inni.",
	["npc.prospector_dragan.where"] = "przy rozwidleniu drogi do kopalni",
	["npc.wyvernhunter_wieslawa.name"] = "Łowczyni Wiesława",
	["npc.wyvernhunter_wieslawa.role"] = "Łowczyni wywern",
	["npc.wyvernhunter_wieslawa.greeting"] = "Głowa nisko. Tu wszystko, co lata, chce cię zjeść.",
	["npc.wyvernhunter_wieslawa.line1"] = "Płacą od łba wywerny. Uczciwa praca, jeśli się ją przeżyje.",
	["npc.wyvernhunter_wieslawa.line2"] = "Mirko poluje ze mną od dziesięciu lat. Teraz leży w obozie i nie czuje nogi.",
	["npc.wyvernhunter_wieslawa.line3"] = "Wywerna atakuje od słońca. Kto patrzy w ziemię, ten długo nie popatrzy.",
	["npc.wyvernhunter_wieslawa.where"] = "pod skalnym łukiem na Turniach Wywern",
	["npc.tombwarden_ezra.name"] = "Strażnik Ezra",
	["npc.tombwarden_ezra.role"] = "Strażnik nekropolii",
	["npc.tombwarden_ezra.greeting"] = "Mów ciszej. Oni tu śpią. Przynajmniej powinni.",
	["npc.tombwarden_ezra.line1"] = "Jestem ostatnim strażnikiem grobów Królów Popiołu. Pamiętam obrzędy, których nikt już nie odprawia.",
	["npc.tombwarden_ezra.line2"] = "Od kiedy w Kuźni znów płonie, piasek nie śpi. Umarli też nie.",
	["npc.tombwarden_ezra.line3"] = "Czterdzieści lat chodzę tą drogą. Każdy kamień zna moje kroki.",
	["npc.tombwarden_ezra.where"] = "przed piramidą w Grobowcach Pustyni",
	["npc.wagoner_bogna.name"] = "Woźnica Bogna",
	["npc.wagoner_bogna.role"] = "Woźnica karawany",
	["npc.wagoner_bogna.greeting"] = "Karawana stoi. Ja też. Mów, czego chcesz.",
	["npc.wagoner_bogna.line1"] = "Woziliśmy sól z Doliny Soli do miasta. Dwadzieścia lat tą samą drogą.",
	["npc.wagoner_bogna.line2"] = "Woły czują bazyliszka wcześniej niż ludzie. Szkoda, że ludzie nie słuchają wołów.",
	["npc.wagoner_bogna.line3"] = "Mój mąż stoi przy jamie. Nie pytaj jeszcze.",
	["npc.wagoner_bogna.where"] = "przy obrabowanych wozach na Szlaku Popiołu",
	-- S107: S. Fire in the Cracks
	["quest.side_ash_salve.title"] = "Maść dla zwiadowców",
	["quest.side_ash_salve.p1"] = "Kesra pisze, że jej ludzie wracają z równin z dłońmi spalonymi do kości. Pęknięcia w ziemi plują ogniem, gdy ktoś się zbliży.",
	["quest.side_ash_salve.p2"] = "Ta maść chłodzi i zamyka rany. Zanieś jej słój, zanim zrobi się za późno dla kolejnego.",
	["quest.side_ash_salve.progress"] = "Zanieś Maść Żarową Zwiadowczyni Kesrze na Spalonych Pustkowiach.",
	["quest.side_ash_salve.done"] = "Od Ysolde? Niech ją bogowie mają w opiece. Dwóch moich ludzi nie trzymało już łuku.",
	["quest.side_ash_salve.say.hurry"] = "Zaraz tam będę.",
	["quest.side_ash_salve.say.hurry.reply"] = "Nie biegnij po popiele. Pęknięcia lubią biegaczy.",
	["quest.side_ash_salve.say.enough"] = "Starczy dla wszystkich?",
	["quest.side_ash_salve.say.enough.reply"] = "Nie. Weź dwie mikstury, sam też się poparzysz.",
	["quest.side_ash_salve.bark.accept1"] = "Kesra stoi przy portalach. Trzymaj słój prosto, maść lubi się rozlewać.",
	["quest.side_ash_salve.bark.done1"] = "Pierwszy raz od miesiąca coś tu ładnie pachnie.",
	["quest.side_ash_glands.title"] = "Gruczoły i kopce",
	["quest.side_ash_glands.p1"] = "Salamandry wyłażą z pęknięć dalej niż kiedykolwiek. Ysolde potrzebuje ich gruczołów ogniowych na kolejne maści, a ja potrzebuję kolejnych maści.",
	["quest.side_ash_glands.p2"] = "Chcę przy pęknięciach kopców z bazaltu, z czerwoną szmatą na szczycie. Żeby moi ludzie z daleka widzieli, gdzie nie stawać.",
	["quest.side_ash_glands.p3"] = "Trzy miejsca: przy płytach, na których salamandry się wygrzewają, nad Żarzącym Lejem i pod Bramą z Żeber. Kamienia tam nie brakuje.",
	["quest.side_ash_glands.progress"] = "Sześć gruczołów ogniowych od salamander z Równin Salamander i trzy kopce przy pęknięciach.",
	["quest.side_ash_glands.done"] = "Kopce stoją, gruczoły są. Ysolde będzie zadowolona, a moi ludzie wreszcie widzą, gdzie kończy się ziemia.",
	["quest.side_ash_glands.say.rag"] = "Czemu czerwona szmata?",
	["quest.side_ash_glands.say.rag.reply"] = "Popiół jest szary, ogień czerwony, a moi ludzie zmęczeni.",
	["quest.side_ash_glands.say.cairns"] = "Najpierw kopce.",
	["quest.side_ash_glands.say.cairns.reply"] = "Dobrze. Ludzie chodzą tam już dziś.",
	["quest.side_ash_glands.say.glands"] = "Najpierw gruczoły.",
	["quest.side_ash_glands.say.glands.reply"] = "Dobrze. Tylko nie zwlekaj z kopcami, pęknięcia nie czekają.",
	["quest.side_ash_glands.bark.accept1"] = "Gruczoł jest pod szczęką. Tnij szybko, zanim ostygnie.",
	["quest.side_ash_glands.bark.half1"] = "Gruczoły jeszcze ciepłe. Dobrze, nieś dalej.",
	["quest.side_ash_glands.bark.done1"] = "Kopce widać aż od portali. Wracaj, mam dla ciebie coś jeszcze.",
	["quest.side_ash_glands.bark.death1"] = "Wstań. Moich ludzi to też zaskoczyło, za pierwszym razem.",
	["quest.side_ash_den.title"] = "Jama pod czaszką",
	["quest.side_ash_den.p1"] = "Hieny z jamy pod wbitą w popiół czaszką chodzą za rannymi. Idą krok w krok i czekają, aż człowiek upadnie.",
	["quest.side_ash_den.p2"] = "Smoła w oczodołach czaszki wykurzy je z jamy. Podpal ją i odsuń się, dym gryzie.",
	["quest.side_ash_den.p3"] = "Dwanaście hien z Równin i na drodze od portali będzie spokój. Moi ludzie znów będą mogli wracać sami.",
	["quest.side_ash_den.progress"] = "Dwanaście hien pustkowi na Równinach Salamander i smoła podpalona w czaszce nad ich jamą.",
	["quest.side_ash_den.done"] = "Dym widać było aż z obozu. Weź to, należy ci się. Pustkowia zapamiętają, że ktoś tu zrobił porządek.",
	["quest.side_ash_den.done.rag"] = "Moi ludzie mówią na kopce „szmaty od ciebie”. Lepsza nazwa niż moja. Weź to, należy ci się, a jama wreszcie dymi zamiast wyć.",
	["quest.side_ash_den.say.pitch"] = "Smoła w czaszce? Dziwny zwyczaj.",
	["quest.side_ash_den.say.pitch.reply"] = "Nie zwyczaj. Hieny nie znoszą dymu, a ja nie znoszę hien.",
	["quest.side_ash_den.say.count"] = "Ile ich jest?",
	["quest.side_ash_den.say.count.reply"] = "Dwanaście widziałam. Licz na więcej.",
	["quest.side_ash_den.say.smoke"] = "Najpierw je wykurzę.",
	["quest.side_ash_den.say.smoke.reply"] = "Dobrze. Walcz na otwartym, nie w jamie.",
	["quest.side_ash_den.bark.accept1"] = "Smoła jest w worku. Nie noś go blisko pęknięć.",
	["quest.side_ash_den.bark.half1"] = "Wyją coraz rzadziej. Tak trzymaj.",
	["quest.side_ash_den.bark.near1"] = "Smoła w oczodoły i odejdź. Dym gryzie.",
	["quest.side_ash_den.bark.done1"] = "Jama dymi. Wracaj, zanim wiatr się odwróci.",
	["quest.side_ash_den.bark.death1"] = "Hieny czekają, aż ktoś upadnie. Nie dawaj im tego.",
	-- S107: T. The Last Water
	["quest.side_ash_cask.title"] = "Beczka słodkiej wody",
	["quest.side_ash_cask.p1"] = "Przyszedł list ze spalonej oazy. Pismo starego człowieka, litery krzywe jak gałęzie. Prosi o beczkę słodkiej wody, bo ostatni staw cuchnie od padliny.",
	["quest.side_ash_cask.p2"] = "Beczka jest ciężka, ale stary Orren pilnuje tej wody od zawsze. Ktoś musi mu ją zanieść, a ja karczmy nie zostawię.",
	["quest.side_ash_cask.progress"] = "Zanieś beczkę słodkiej wody Studniarzowi Orrenowi przy pomoście w Martwej Oazie.",
	["quest.side_ash_cask.done"] = "Od Wacława? Dobry chłopak, choć leje wino. Postaw ją w cieniu, słodka woda nie lubi słońca.",
	["quest.side_ash_cask.say.wine"] = "A gdyby zanieść wino?",
	["quest.side_ash_cask.say.wine.reply"] = "Orren pije tylko wodę i ma na to dziewięćdziesiąt lat dowodów.",
	["quest.side_ash_cask.say.who"] = "Kim jest Orren?",
	["quest.side_ash_cask.say.who.reply"] = "Ostatnim, kto pilnuje oazy. Uparty jak ta beczka.",
	["quest.side_ash_cask.bark.accept1"] = "Beczka jest szczelna. Pilnuj, żeby taka została.",
	["quest.side_ash_cask.bark.done1"] = "Słodka. Zapomniałem, jak smakuje słodka.",
	["quest.side_ash_wells.title"] = "Studnie pod piaskiem",
	["quest.side_ash_wells.p1"] = "Woda odeszła, ale nie umarła. Schowała się pod piaskiem i czeka, aż ktoś ją zawoła.",
	["quest.side_ash_wells.p2"] = "Przewoźnik z łodzi, która stoi na suchym dnie, prowadził dziennik. Była w nim mapa studni z czasów, kiedy oaza była jeziorem.",
	["quest.side_ash_wells.p3"] = "Zaprowadzę cię do łodzi. Potem trzy studnie: przy łodzi, przy pomoście i przy cmentarzysku karawan. Odkop je.",
	["quest.side_ash_wells.progress"] = "Idź z Orrenem do łodzi na suchym dnie, przeszukaj ją i odkop trzy studnie w Martwej Oazie.",
	["quest.side_ash_wells.done"] = "Dziennik pisał mój ojciec. Znał studnie i milczał, bo bał się, że odejdę szukać wody gdzie indziej. Odkopałeś je za niego.",
	["quest.side_ash_wells.say.dead"] = "Ta woda umarła.",
	["quest.side_ash_wells.say.dead.reply"] = "Woda nie umiera. Odchodzi pod piasek, kiedy przestaje się o nią dbać.",
	["quest.side_ash_wells.say.boat"] = "Gdzie ta łódź?",
	["quest.side_ash_wells.say.boat.reply"] = "Zaprowadzę cię. Sam szukałbyś do zmroku.",
	["quest.side_ash_wells.say.alone"] = "Pójdę sam.",
	["quest.side_ash_wells.say.alone.reply"] = "Siedemdziesiąt lat chodzę po tym dnie. Trudem jest siedzieć.",
	["quest.side_ash_wells.bark.accept1"] = "Chodź, póki cień długi.",
	["quest.side_ash_wells.bark.half1"] = "Ojciec pisał krzywo, ale studnie liczył dobrze.",
	["quest.side_ash_wells.bark.near1"] = "Tu była głębia. Jako chłopak nurkowałem po muszle i nie sięgnąłem dna.",
	["quest.side_ash_wells.bark.done1"] = "Trzy studnie. Nie pij jeszcze, niech się uspokoi.",
	["quest.side_ash_wells.bark.stuck1"] = "Szukaj, gdzie piasek ciemniejszy. Patrz pod nogi, nie w niebo.",
	["quest.side_ash_wells.comp.join1"] = "Chodź. Pokażę ci, gdzie stała woda.",
	["quest.side_ash_wells.comp.wait1"] = "Nie zostawaj. Piasek łyka ślady.",
	["quest.side_ash_wells.comp.wait2"] = "Mam dziewięćdziesiąt lat i idę szybciej od ciebie.",
	["quest.side_ash_wells.comp.arrive1"] = "Na rufie znak mojego ojca. Mówił, że łódź zabrała burza.",
	["quest.side_ash_wells.comp.back1"] = "Zgubiłem cię. Wracam na pomost, nie będę krzyczał po pustyni.",
	["quest.side_ash_seals.title"] = "Pieczęcie kupców",
	["quest.side_ash_seals.p1"] = "Sępy znoszą z cmentarzyska karawan błyszczące pieczęcie kupców. Widzę je z pomostu, jak lecą z nimi w dziobach.",
	["quest.side_ash_seals.p1.dead"] = "Mówiłeś, że woda umarła. Wróciła. Teraz czas na tych, którzy przy niej zginęli. Sępy znoszą z cmentarzyska karawan ich pieczęcie.",
	["quest.side_ash_seals.p2"] = "Każda pieczęć to czyjeś imię i czyjaś rodzina, która nie wie, gdzie leży ich bliski. Chcę je oddać.",
	["quest.side_ash_seals.p3"] = "Hieny pilnują studni, które odkopałeś. Najpierw one, potem pieczęcie.",
	["quest.side_ash_seals.progress"] = "Osiem hien pustkowi i pięć pieczęci kupieckich od sępów popiołu w Martwej Oazie.",
	["quest.side_ash_seals.done"] = "Pięć domów dowie się, gdzie szukać. Ta jedna jest krasnoludzka, ten wasz runmistrz będzie chciał ją zobaczyć. Weź to, ode mnie i od wody.",
	["quest.side_ash_seals.say.families"] = "Jak znajdziesz rodziny?",
	["quest.side_ash_seals.say.families.reply"] = "Pieczęć to imię domu. Domy pamiętają dłużej niż ludzie.",
	["quest.side_ash_seals.say.wells"] = "Hieny przy studniach?",
	["quest.side_ash_seals.say.wells.reply"] = "Przy wszystkich trzech. Od nich zacznij.",
	["quest.side_ash_seals.bark.accept1"] = "Sępy siadają na wozach. Tam ich szukaj.",
	["quest.side_ash_seals.bark.half1"] = "Ta jest z Doliny Soli. Znałem ten dom.",
	["quest.side_ash_seals.bark.done1"] = "Przynieś je. Ułożę je w cieniu, jak należy.",
	-- S107: U. Blood and Ash
	["quest.side_ash_rite.title"] = "Obrzęd oczyszczenia",
	["quest.side_ash_rite.p1"] = "Klatka zostawia na ciele zapach strachu. Przodkowie go nie znoszą i nie chcą ze mną mówić.",
	["quest.side_ash_rite.p2"] = "Na kamieniach przy źródle pali się zioła, ogniokwiat z brzegu i siarkę. Dym niesie słowa do przodków.",
	["quest.side_ash_rite.p3"] = "Złóż zioła na kamieniach i przynieś ogniokwiat, a ja odprawię obrzęd. Potem porozmawiamy o klanie.",
	["quest.side_ash_rite.progress"] = "Zioła złożone na kamieniach przy Gorącym Źródle i cztery ogniokwiaty dla Szamanki Ghashy.",
	["quest.side_ash_rite.done"] = "Dym idzie prosto w górę. Przodkowie znów mnie słyszą. Teraz mogę myśleć o tych, którzy zostali w obozie.",
	["quest.side_ash_rite.say.smell"] = "Nie czuję strachu.",
	["quest.side_ash_rite.say.smell.reply"] = "Ty nie. Przodkowie mają lepszy nos niż ty i gorszy charakter niż ja.",
	["quest.side_ash_rite.say.cage"] = "Co było w klatce?",
	["quest.side_ash_rite.say.cage.reply"] = "Liczyłam dni po kroplach z dachu. Więcej nie powiem.",
	["quest.side_ash_rite.say.herbs"] = "Najpierw ogniokwiat.",
	["quest.side_ash_rite.say.herbs.reply"] = "Rośnie przy pęknięciach i nad źródłem.",
	["quest.side_ash_rite.bark.accept1"] = "Ogniokwiat zrywaj u nasady. Kwiat bez korzenia nic nie mówi.",
	["quest.side_ash_rite.bark.half1"] = "Dym idzie prosto. Słuchają.",
	["quest.side_ash_rite.bark.done1"] = "Wróć do źródła. Przodkowie chcą zobaczyć, kto im pomógł.",
	["quest.side_ash_drum.title"] = "Wojenny bęben",
	["quest.side_ash_drum.p1"] = "Wielki bęben w obozie bije za złoto szarych ludzi. Młodzi wojownicy nie słyszą przez niego niczego innego.",
	["quest.side_ash_drum.p2"] = "Przetnij skórę bębna. Kiedy zamilknie, może usłyszą starych.",
	["quest.side_ash_drum.p3"] = "Orkowie będą bronić bębna jak sztandaru. Dziesięciu musi paść, zanim do niego podejdziesz.",
	["quest.side_ash_drum.progress"] = "Dziesięciu orków popiołu i przecięta skóra wojennego bębna w Obozie Popielnych Orków.",
	["quest.side_ash_drum.done"] = "Słyszałam, jak bęben zgubił rytm, a potem zamilkł. W obozie kłócą się teraz o to, kto go naprawi. Dobrze. Niech się kłócą.",
	["quest.side_ash_drum.say.gold"] = "Ile płacą szarzy?",
	["quest.side_ash_drum.say.gold.reply"] = "Tyle, że młodzi przestali słyszeć starych.",
	["quest.side_ash_drum.say.chief"] = "Prościej zabić wodza.",
	["quest.side_ash_drum.say.chief.reply"] = "Prościej. I pójdą za następnym, który bierze złoto.",
	["quest.side_ash_drum.bark.accept1"] = "Bęben stoi na podwyższeniu za obozem. Usłyszysz go.",
	["quest.side_ash_drum.bark.half1"] = "Słyszysz? Bęben gubi rytm.",
	["quest.side_ash_drum.bark.done1"] = "Cisza. Pierwszy raz od lata słyszę wiatr nad obozem.",
	["quest.side_ash_drum.bark.death1"] = "Wstań. Orkowie śpiewają nad leżącymi. Nie daj im pieśni.",
	["quest.side_ash_fang.title"] = "Kieł Przodków",
	["quest.side_ash_fang.p1"] = "Kieł Przodków to talizman klanu. Pamięta imiona wszystkich wodzów, od pierwszego.",
	["quest.side_ash_fang.p2"] = "Wódz oddał go w zastaw za topory z zimnego żelaza. Leży w jego namiocie jak zwykła rzecz.",
	["quest.side_ash_fang.p3"] = "Kto niesie Kieł, ten mówi za klan. Młodzi pójdą za nim, nie za złotem.",
	["quest.side_ash_fang.p4"] = "Nie chcę krwi wodza. Chcę tylko, żeby klan miał wybór. Przynieś Kieł, a resztę zrobią sami.",
	["quest.side_ash_fang.progress"] = "Ośmiu orków popiołu i Kieł Przodków z namiotu wodza w Obozie Popielnych Orków.",
	["quest.side_ash_fang.done"] = "Nocą przyszli do źródła. Siedmioro młodych, z imionami matek na ustach. Obóz stoi dalej, ale już nie cały. Weź to, należy ci się.",
	["quest.side_ash_fang.done.smell"] = "Przodkowie mówią, że pachniesz jak ktoś z klanu. To komplement. Nocą przyszło do źródła siedmioro młodych. Obóz stoi dalej, ale już nie cały. Weź to.",
	["quest.side_ash_fang.say.pledge"] = "Zastawił talizman za topory?",
	["quest.side_ash_fang.say.pledge.reply"] = "Za zimne żelazo. Kieł pamięta wodzów, którzy niczego nie zastawiali.",
	["quest.side_ash_fang.say.young"] = "Ilu młodych pójdzie?",
	["quest.side_ash_fang.say.young.reply"] = "Ci, którzy pamiętają imię matki. Wystarczy.",
	["quest.side_ash_fang.bark.accept1"] = "Idź cicho. Kieł leży tam, gdzie wódz śpi.",
	["quest.side_ash_fang.bark.half1"] = "Namiot stoi za bębnem. Za tym, który milczy.",
	["quest.side_ash_fang.bark.done1"] = "Masz go? Nie pokazuj go nikomu w obozie. Wracaj.",
	-- S107: V. Silver and Mithril
	["quest.side_ash_silver.title"] = "Długi Dragana",
	["quest.side_ash_silver.p1"] = "Liczę długi. Wspólnicy zostawili rodziny, a ja zostawiłem im obietnicę, że wrócą bogatsi. Wróciłem tylko ja.",
	["quest.side_ash_silver.p2"] = "Srebro leży w skałach na pustkowiach. Sępy z wysypiska pod obozem orków dziobią każdego, kto kopie. Przynieś sześć bryłek i przerzedź te ptaszyska.",
	["quest.side_ash_silver.progress"] = "Sześć bryłek srebra z żył na pustkowiach i ośmiu sępów popiołu przy Obozie Popielnych Orków.",
	["quest.side_ash_silver.done"] = "Sześć bryłek. Policzyłem dwa razy. Wdowy dostaną swoje, choć nie od razu.",
	["quest.side_ash_silver.say.debt"] = "Ile jesteś winien?",
	["quest.side_ash_silver.say.debt.reply"] = "Czterysta dwanaście srebrnych i trzy obietnice. Obietnice droższe.",
	["quest.side_ash_silver.say.town"] = "Czemu nie wrócisz do miasta?",
	["quest.side_ash_silver.say.town.reply"] = "Z pustą sakwą nie spojrzę wdowom w oczy.",
	["quest.side_ash_silver.say.vultures"] = "Najpierw sępy.",
	["quest.side_ash_silver.say.vultures.reply"] = "Dziobią każdego, kto kopie. Rozsądnie.",
	["quest.side_ash_silver.bark.accept1"] = "Srebrne żyły świecą na szaro. Nie myl ich z popiołem.",
	["quest.side_ash_silver.bark.half1"] = "Połowa. Odliczam od długu, nie od wstydu.",
	["quest.side_ash_silver.bark.done1"] = "Wracaj z tym. Liczyć lepiej przy ogniu.",
	["quest.side_ash_partners.title"] = "Blaszki wspólników",
	["quest.side_ash_partners.p1"] = "Trzech wspólników zeszło do Opuszczonej Kopalni przed orkami. Juro, Stach i Benek. Nie wrócił żaden.",
	["quest.side_ash_partners.p2"] = "Każdy nosił na szyi blaszkę z imieniem. Hieny, które zaległy w chodnikach, połykają wszystko, co błyszczy.",
	["quest.side_ash_partners.p3"] = "Przynieś blaszki. Niech rodziny dostaną coś więcej niż moje słowa.",
	["quest.side_ash_partners.progress"] = "Trzy blaszki górników od hien pustkowi (Elity) w Opuszczonej Kopalni.",
	["quest.side_ash_partners.done"] = "Juro, Stach, Benek. Trzy blaszki, trzy domy. Zaniosę je sam, to jestem im winien.",
	["quest.side_ash_partners.say.names"] = "Jak się nazywali?",
	["quest.side_ash_partners.say.names.reply"] = "Juro, Stach i Benek. Benek najmłodszy.",
	["quest.side_ash_partners.say.way"] = "Gdzie wejście?",
	["quest.side_ash_partners.say.way.reply"] = "Na północnym grzbiecie. Zaznaczę ci sztolnię.",
	["quest.side_ash_partners.bark.accept1"] = "Kopalnia jest za obozem orków, w grzbiecie. Trzymaj się drogi.",
	["quest.side_ash_partners.bark.half1"] = "Jedna. Juro. Zawsze pierwszy.",
	["quest.side_ash_partners.bark.done1"] = "Masz wszystkie trzy? Wracaj. Ostrożnie w chodnikach.",
	["quest.side_ash_partners.bark.stuck1"] = "Hieny w chodnikach są większe. Szukaj największych.",
	["quest.side_ash_columns.title"] = "Pod kolumnami",
	["quest.side_ash_columns.p1"] = "Od lat śnię o mithrilu. Bazalt pęka tam, gdzie pod spodem jest coś twardszego od niego.",
	["quest.side_ash_columns.p2"] = "Na Polach Golemów, pod bazaltowymi kolumnami, kolumny pękają równo, jak cięte nożem.",
	["quest.side_ash_columns.p3"] = "Golemy pilnują tego miejsca. Odłup próbkę z pękniętej kolumny, a ja powiem ci, czy dalej śnię.",
	["quest.side_ash_columns.progress"] = "Dziesięć ognistych golemów i próbka z pękniętej kolumny na Polach Golemów.",
	["quest.side_ash_columns.done"] = "Zobacz to lśnienie pod bazaltem. Nie śnię. Pierwszy raz od dwudziestu lat nie śnię.",
	["quest.side_ash_columns.say.dream"] = "Śnisz o mithrilu?",
	["quest.side_ash_columns.say.dream.reply"] = "Od dwudziestu lat. We śnie zawsze jestem bogaty i zawsze się budzę.",
	["quest.side_ash_columns.say.sample"] = "Najpierw próbka.",
	["quest.side_ash_columns.say.sample.reply"] = "Śmiało. Golemy i tak cię zauważą.",
	["quest.side_ash_columns.bark.accept1"] = "Pęknięta kolumna stoi na skraju pola. Nie pomylisz jej.",
	["quest.side_ash_columns.bark.half1"] = "Golemy ciężko padają. Ziemia aż dudni.",
	["quest.side_ash_columns.bark.done1"] = "Przynieś próbkę. Ręce mi się trzęsą.",
	["quest.side_ash_claim.title"] = "Palik poszukiwacza",
	["quest.side_ash_claim.p1"] = "Próbka była dobra. Mithril leży płytko, pod samą skorupą bazaltu.",
	["quest.side_ash_claim.p2"] = "Wbij mój palik między kolumnami i przynieś Dorganowi kilka bryłek mithrilu. Kowal powie, ile to warte.",
	["quest.side_ash_claim.p3"] = "Część pójdzie do rodzin wspólników. Tak im obiecałem, kiedy jeszcze myślałem, że wrócą.",
	["quest.side_ash_claim.progress"] = "Cztery bryłki mithrilu z Pól Golemów, palik Dragana między kolumnami i Kowal Dorgan w mieście.",
	["quest.side_ash_claim.done"] = "Czysty mithril. Dam za niego uczciwą cenę, a część odłożę dla rodzin wspólników, tak jak Dragan chciał. Weź to za fatygę.",
	["quest.side_ash_claim.done.debt"] = "Dragan pisze, że zostały mu trzy obietnice. Dwie właśnie spłaciłeś. Mithril jest czysty, cena będzie uczciwa, część pójdzie do wdów. Weź to za fatygę.",
	["quest.side_ash_claim.say.share"] = "Ile dla rodzin?",
	["quest.side_ash_claim.say.share.reply"] = "Połowa. Liczyłem trzy razy i zawsze za mało.",
	["quest.side_ash_claim.say.dorgan"] = "Dorgan da uczciwą cenę?",
	["quest.side_ash_claim.say.dorgan.reply"] = "Liczy dokładniej niż ja. Dlatego mu ufam.",
	["quest.side_ash_claim.bark.accept1"] = "Palik wbij głęboko. Golemy lubią przewracać rzeczy.",
	["quest.side_ash_claim.bark.half1"] = "Mithril jest cięższy, niż wygląda. Nie zgub ani bryłki.",
	["quest.side_ash_claim.bark.done1"] = "Prawdziwy mithril. Zważę dwa razy, chodzi o wdowy.",
	-- S107: W. Names of the Dead
	["quest.side_ash_chimneys.title"] = "Kominy",
	["quest.side_ash_chimneys.p1"] = "Domy spłonęły w jedną noc, kominy zostały. Na każdym rodzina wyryła swoje imię, kiedy go stawiała.",
	["quest.side_ash_chimneys.p2"] = "Chochliki gnieżdżą się w paleniskach i wyją po nocach. Przepędź je.",
	["quest.side_ash_chimneys.p3"] = "Przy trzech kominach w alei zapal świecę i odczytaj imiona. Ja je spiszę.",
	["quest.side_ash_chimneys.progress"] = "Dziesięć ognistych chochlików i imiona z trzech kominów w Spalonych Ruinach.",
	["quest.side_ash_chimneys.done"] = "Mów je jeszcze raz, powoli. Piszę. Każde imię to dom, w którym ktoś się śmiał.",
	["quest.side_ash_chimneys.say.why"] = "Po co spisywać imiona?",
	["quest.side_ash_chimneys.say.why.reply"] = "Żeby ktoś je jeszcze raz wypowiedział. Tylko tyle zostało.",
	["quest.side_ash_chimneys.say.knew"] = "Znałeś tych ludzi?",
	["quest.side_ash_chimneys.say.knew.reply"] = "Chrzciłem ich dzieci. Ich imiona też tu są.",
	["quest.side_ash_chimneys.say.imps"] = "Najpierw chochliki.",
	["quest.side_ash_chimneys.say.imps.reply"] = "Tak. Nie będą mieszkać tam, gdzie mieszkali ludzie.",
	["quest.side_ash_chimneys.bark.accept1"] = "Świece są w torbie. Zapalaj je od żaru, nie od chochlików.",
	["quest.side_ash_chimneys.bark.half1"] = "Mów imiona głośno. Ja piszę.",
	["quest.side_ash_chimneys.bark.near1"] = "Zapal świecę przed czytaniem. Tak robiliśmy na pogrzebach.",
	["quest.side_ash_chimneys.bark.done1"] = "Wracaj. Chcę je zapisać, zanim wiatr zatrze resztę.",
	["quest.side_ash_heirlooms.title"] = "Pamiątki z fontanny",
	["quest.side_ash_heirlooms.p1"] = "Gdy przyszedł ogień, ludzie wrzucali do fontanny to, co mieli najcenniejsze. Wierzyli, że woda ocali.",
	["quest.side_ash_heirlooms.p2"] = "Fontanna jest dziś pełna żaru. Wygarnij go. Pod spodem może coś zostało.",
	["quest.side_ash_heirlooms.p3"] = "Resztę pamiątek skorpiony zawlokły do gniazd pod wschodnimi zaspami. Przynieś je, ile zdołasz.",
	["quest.side_ash_heirlooms.progress"] = "Żar wygarnięty z suchej fontanny i pięć rodzinnych pamiątek od skorpionów pustyni w Spalonych Ruinach.",
	["quest.side_ash_heirlooms.done"] = "Pierścionek, dzwoneczek, grzebień z kości. Każdą rzecz przypiszę do imienia. Niektóre poznaję.",
	["quest.side_ash_heirlooms.say.water"] = "Fontanna nikogo nie ocaliła.",
	["quest.side_ash_heirlooms.say.water.reply"] = "Nie. Ale wierzyli do końca. Uszanuj to.",
	["quest.side_ash_heirlooms.say.drifts"] = "Najpierw gniazda.",
	["quest.side_ash_heirlooms.say.drifts.reply"] = "Wschodnie zaspy. Uważaj na ogony.",
	["quest.side_ash_heirlooms.bark.accept1"] = "Żar w fontannie tli się od tamtej nocy. Weź łopatę, nie ręce.",
	["quest.side_ash_heirlooms.bark.half1"] = "Ostrożnie z nimi. To wszystko, co po nich zostało.",
	["quest.side_ash_heirlooms.bark.done1"] = "Przynieś je. Położę je na progu świątyni.",
	["quest.side_ash_names.title"] = "Lista Brata Kaspara",
	["quest.side_ash_names.p1"] = "Lista jest gotowa. Zmarli i ci, których zabrano do Kuźni. Przy tych drugich piszę „zabrani”, nie „zmarli”.",
	["quest.side_ash_names.p2"] = "Brat Anzelm odczyta imiona przy ołtarzu w świątyni w mieście. Może rodziny się dowiedzą.",
	["quest.side_ash_names.p2.why"] = "Pytałeś, po co imiona. Jest ich dwieście siedem. Brat Anzelm odczyta je przy ołtarzu w mieście i ktoś je wreszcie wypowie.",
	["quest.side_ash_names.p3"] = "Skorpiony przy drodze najpierw. Nie chcę, żebyś zginął z listą przy pasie.",
	["quest.side_ash_names.progress"] = "Osiem skorpionów pustyni w Spalonych Ruinach i lista Brata Kaspara dla Brata Anzelma w mieście.",
	["quest.side_ash_names.done"] = "Dwieście siedem imion. Odczytam je w najbliższy dzień święty, każde osobno. O zabranych nic nie obiecuję, ale będę o nich pamiętał. Weź to, z błogosławieństwem.",
	["quest.side_ash_names.say.forge"] = "Zabrani do Kuźni żyją?",
	["quest.side_ash_names.say.forge.reply"] = "Nie wiem. Dlatego piszę „zabrani”, nie „zmarli”.",
	["quest.side_ash_names.say.anzelm"] = "Anzelm to odczyta?",
	["quest.side_ash_names.say.anzelm.reply"] = "Odczyta. On ma głos do imion, ja tylko pióro.",
	["quest.side_ash_names.bark.accept1"] = "Lista jest w skórzanej teczce. Nie zamocz jej.",
	["quest.side_ash_names.bark.half1"] = "Lista jest ważniejsza niż pośpiech.",
	["quest.side_ash_names.bark.done1"] = "Odczytam je. Każde osobno.",
	-- S107: X. The Crag Hunt
	["quest.side_ash_lookout.title"] = "Szlak wywern",
	["quest.side_ash_lookout.p1"] = "Wywerny latają nisko i bezczelnie, jakby coś je wypędzało z Leża.",
	["quest.side_ash_lookout.p2"] = "Dziesięć łbów to nagroda i spokój na drodze. Podzielimy się, jak przystało.",
	["quest.side_ash_lookout.p3"] = "Przy Kamiennej Wywernie oznacz szlak, którym latają. Moi ludzie będą wiedzieć, gdzie zastawiać sieci.",
	["quest.side_ash_lookout.progress"] = "Dziesięć wywern na Turniach Wywern i oznaczony szlak przy Kamiennej Wywernie.",
	["quest.side_ash_lookout.done"] = "Dziesięć łbów i szlak jak na dłoni. Wywerny wracają tą samą drogą, głupie bestie. Teraz mam je w garści.",
	["quest.side_ash_lookout.say.bold"] = "Bezczelne?",
	["quest.side_ash_lookout.say.bold.reply"] = "Wczoraj jedna ukradła mi obiad. Z ręki.",
	["quest.side_ash_lookout.say.driven"] = "Co je wypędza z Leża?",
	["quest.side_ash_lookout.say.driven.reply"] = "Coś, czego boi się wywerna. Nie chcę tego poznać.",
	["quest.side_ash_lookout.say.mark"] = "Najpierw szlak.",
	["quest.side_ash_lookout.say.mark.reply"] = "Przy Kamiennej Wywernie. Nie przegapisz.",
	["quest.side_ash_lookout.bark.accept1"] = "Celuj w skrzydła. Wywerna na ziemi to już tylko duża jaszczurka.",
	["quest.side_ash_lookout.bark.half1"] = "Nisko latają. Tym łatwiej liczyć.",
	["quest.side_ash_lookout.bark.done1"] = "Wracaj. Mirko będzie chciał usłyszeć o każdej.",
	["quest.side_ash_lookout.bark.death1"] = "Wywerna atakuje od słońca. Patrz w górę.",
	["quest.side_ash_eyes.title"] = "Oczy bazyliszków",
	["quest.side_ash_eyes.p1"] = "Mirko leży w obozie z nogą z kamienia do kolana, a kamień idzie w górę. Każdego ranka o palec wyżej.",
	["quest.side_ash_eyes.p2"] = "Ysolde w mieście umie zrobić wywar przeciw kamieniowi, jeśli dostanie oczy bazyliszków.",
	["quest.side_ash_eyes.p3"] = "Zanieś jej cztery. Ja nie mogę zostawić Mirka.",
	["quest.side_ash_eyes.progress"] = "Cztery oczy bazyliszków z Turni Wywern dla Alchemiczki Ysolde w mieście.",
	["quest.side_ash_eyes.done"] = "Oczy bazyliszków, świeże. Wywar zajmie chwilę. Wróć do mnie, zanim kamień dojdzie dalej.",
	["quest.side_ash_eyes.say.mirko"] = "Jak się trzyma Mirko?",
	["quest.side_ash_eyes.say.mirko.reply"] = "Pyta o pogodę. O nic innego nie umie.",
	["quest.side_ash_eyes.say.road"] = "Daleko do miasta.",
	["quest.side_ash_eyes.say.road.reply"] = "Weź to na drogę.",
	["quest.side_ash_eyes.bark.accept1"] = "Nie patrz bazyliszkowi w oczy, dopóki ma je w głowie.",
	["quest.side_ash_eyes.bark.half1"] = "Dwa. Nie zgub ich.",
	["quest.side_ash_eyes.bark.done1"] = "Cztery. Starczy na jeden wywar, jeśli nic nie wykipi.",
	["quest.side_ash_nest.title"] = "Wywar i gniazdo",
	["quest.side_ash_nest.p1"] = "Wywar jest gotowy. Musi zdążyć, zanim kamień dojdzie do serca.",
	["quest.side_ash_nest.p2"] = "Wiesława prosiła jeszcze o jedno: o wielkie gniazdo na skalnym stole, skąd przylatują młode. Póki stoi, wywerny będą wracać.",
	["quest.side_ash_nest.p3"] = "Zanieś wywar i spal gniazdo. W tej kolejności, jeśli chcesz mojej rady.",
	["quest.side_ash_nest.progress"] = "Wywar Przeciw Kamieniowi dla Łowczyni Wiesławy i spalone gniazdo na skalnym stole na Turniach Wywern.",
	["quest.side_ash_nest.done"] = "Mirko poruszył palcami. Kuleje i będzie kulał, ale żyje. A gniazdo pali się tak, że widać je z miasta. Weź to, zasłużyłeś.",
	["quest.side_ash_nest.done.driven"] = "Nadal nie wiem, co je wypędza. Ale Mirko żyje, rusza palcami i klnie jak dawniej. Gniazdo płonie. Weź to, zasłużyłeś.",
	["quest.side_ash_nest.say.draught"] = "Najpierw wywar.",
	["quest.side_ash_nest.say.draught.reply"] = "Tak. Kamień nie czeka.",
	["quest.side_ash_nest.say.nest"] = "Najpierw gniazdo.",
	["quest.side_ash_nest.say.nest.reply"] = "Wiesława prosiła o oba. Kolejność twoja, czas nie.",
	["quest.side_ash_nest.bark.accept1"] = "Wywar trzymaj w cieple. Zimny nie zadziała.",
	["quest.side_ash_nest.bark.half1"] = "Połowa za tobą. Kamień też nie stoi w miejscu.",
	["quest.side_ash_nest.bark.near1"] = "Młode piszczą. Nie patrz, tylko podpal.",
	["quest.side_ash_nest.bark.done1"] = "Słyszę, jak trzaska. Wracaj, Mirko chce ci podziękować.",
	-- S107: Y. The Sleep of Kings
	["quest.side_ash_king.title"] = "Pogrzebany Król",
	["quest.side_ash_king.p1"] = "Piasek się rusza, a umarli Królów Popiołu chodzą po wydmach. Szukają czegoś, czego nie mogą znaleźć.",
	["quest.side_ash_king.p2"] = "Najstarszy z nich, Pogrzebany Król, wystaje z wydmy: głowa i ręka. Tam zaczyna się szlak umarłych.",
	["quest.side_ash_king.p3"] = "Zaprowadzę cię drogą. Potem połóż do snu tych, którzy wstali.",
	["quest.side_ash_king.progress"] = "Idź ze Strażnikiem Ezrą do Pogrzebanego Króla i połóż do snu dwanaście mumii pustyni na Wydmach Skorpionów.",
	["quest.side_ash_king.done"] = "Śpią. Na razie. Szlak umarłych jest cichy pierwszy raz od miesięcy, ale piasek dalej się rusza.",
	["quest.side_ash_king.say.faces"] = "Czego szukają umarli?",
	["quest.side_ash_king.say.faces.reply"] = "Twarzy. Bez masek nie wiedzą, kim byli.",
	["quest.side_ash_king.say.legs"] = "Dasz radę iść na wydmy?",
	["quest.side_ash_king.say.legs.reply"] = "Chodzę tam czterdzieści lat. Wolno, ale prosto.",
	["quest.side_ash_king.say.lead"] = "Prowadź.",
	["quest.side_ash_king.say.lead.reply"] = "Za mną. Piasek pamięta stare ścieżki, ja też.",
	["quest.side_ash_king.bark.accept1"] = "Drogą, nie przez dziedzińce.",
	["quest.side_ash_king.bark.half1"] = "Kładą się. Piasek przyjmuje ich z powrotem.",
	["quest.side_ash_king.bark.near1"] = "Tam. Głowa i ręka. Reszta króla śpi głębiej.",
	["quest.side_ash_king.bark.done1"] = "Śpią. Na razie.",
	["quest.side_ash_king.bark.death1"] = "Wstań. Tu nie wolno leżeć bez imienia.",
	["quest.side_ash_king.comp.join1"] = "Chodźmy drogą. Przez dziedzińce umarli nie przepuszczają nawet mnie.",
	["quest.side_ash_king.comp.wait1"] = "Szybciej nie umiem, wolniej nie wolno. Chodź.",
	["quest.side_ash_king.comp.arrive1"] = "Tu zaczyna się ich szlak. Ja zostanę przy królu.",
	["quest.side_ash_king.comp.back1"] = "Zgubiłem cię. Czekam przy piramidzie.",
	["quest.side_ash_wards.title"] = "Runy snu",
	["quest.side_ash_wards.p1"] = "Wiatr odsłonił sarkofagi, a runy snu na wiekach starły się do gładkiego kamienia.",
	["quest.side_ash_wards.p1.legs"] = "Doszliśmy razem. Dalej pójdziesz sam, moje nogi zostały na wydmach. Wiatr odsłonił sarkofagi, a runy snu na wiekach starły się do gładkiego kamienia.",
	["quest.side_ash_wards.p2"] = "Pokażę ci znak. Odnów go na trzech wiekach, starannie, kreska po kresce.",
	["quest.side_ash_wards.p3"] = "Skorpiony gnieżdżą się w szczelinach sarkofagów. Wypłosz je, zanim zaczniesz.",
	["quest.side_ash_wards.progress"] = "Runy snu odnowione na trzech sarkofagach i osiem skorpionów pustyni na Wydmach Skorpionów.",
	["quest.side_ash_wards.done"] = "Runy świecą. Ci trzej będą spać spokojnie. Zostało jeszcze wielu, ale od czegoś trzeba zacząć.",
	["quest.side_ash_wards.say.sign"] = "Pokaż znak raz jeszcze.",
	["quest.side_ash_wards.say.sign.reply"] = "Trzy kreski i zamknięte oko. Oko zawsze zamknięte.",
	["quest.side_ash_wards.say.scorp"] = "Najpierw skorpiony.",
	["quest.side_ash_wards.say.scorp.reply"] = "Siedzą w szczelinach wiek. Wypłosz je.",
	["quest.side_ash_wards.bark.accept1"] = "Kreśl powoli. Runa pisana w pośpiechu nie trzyma.",
	["quest.side_ash_wards.bark.half1"] = "Dobrze. Kamień przyjmuje znak.",
	["quest.side_ash_wards.bark.done1"] = "Śpią spokojniej. Wracaj, nie zostawaj tam po zmroku.",
	["quest.side_ash_altar.title"] = "Kadzidło na ołtarzu",
	["quest.side_ash_altar.p1"] = "Na ołtarzu wschodniego dziedzińca przez trzysta lat paliło się kadzidło za królów. Zgasło, kiedy umarł ostatni kapłan.",
	["quest.side_ash_altar.p2"] = "Nie mam już sił zejść do dziedzińca, w którym chodzą mumie. Kiedyś schodziłem tam codziennie.",
	["quest.side_ash_altar.p3"] = "Zapal kadzidło. Mumie, które poczują dym, wrócą do grobów albo padną.",
	["quest.side_ash_altar.progress"] = "Dziesięć mumii pustyni w Grobowcach Pustyni i kadzidło zapalone na ołtarzu wschodniego dziedzińca.",
	["quest.side_ash_altar.done"] = "Czuję ten dym aż tutaj. Pachnie jak w dniu, kiedy przyszedłem na naukę. Dziękuję.",
	["quest.side_ash_altar.say.priest"] = "Kto był ostatnim kapłanem?",
	["quest.side_ash_altar.say.priest.reply"] = "Mój nauczyciel. Kadzidło zgasło tej nocy, kiedy umarł.",
	["quest.side_ash_altar.say.potions"] = "Dziedziniec pełen mumii.",
	["quest.side_ash_altar.say.potions.reply"] = "Weź mikstury. Mnie już niepotrzebne.",
	["quest.side_ash_altar.bark.accept1"] = "Kadzidło jest w glinianym naczyniu. Zapalaj od żaru, nie od ognia.",
	["quest.side_ash_altar.bark.half1"] = "Słyszę, jak padają. Ostrożnie przy ołtarzu.",
	["quest.side_ash_altar.bark.done1"] = "Dym idzie nad dziedzińcem. Wracaj.",
	["quest.side_ash_masks.title"] = "Maski królów",
	["quest.side_ash_masks.p1"] = "Rabusie grobów zdarli z królów maski pogrzebowe. Bez twarzy umarli nie trafią do snu.",
	["quest.side_ash_masks.p2"] = "Mumie, które je odzyskały, noszą je przy sobie i bronią ich jak życia, którego już nie mają.",
	["quest.side_ash_masks.p3"] = "Trzy maski i wrota piramidy. Zapieczętujesz je twoją ręką, ja powiem słowa.",
	["quest.side_ash_masks.p4"] = "Od kiedy w Kuźni na wschodzie znów płonie, piasek nie śpi. Może po tej nocy zaśnie choć na trochę.",
	["quest.side_ash_masks.p4.faces"] = "Pytałeś, czego szukają umarli. Teraz wiesz: siebie. Od kiedy w Kuźni na wschodzie znów płonie, piasek nie śpi. Może po tej nocy zaśnie choć na trochę.",
	["quest.side_ash_masks.progress"] = "Trzy maski pogrzebowe od mumii pustyni w Grobowcach Pustyni i zapieczętowane wrota piramidy.",
	["quest.side_ash_masks.done"] = "Wrota zamknięte, maski na swoich miejscach. Śpią wszyscy, pierwszy raz od lat. Weź dar ze skarbca strażników, nikt nie zasłużył bardziej.",
	["quest.side_ash_masks.say.door"] = "Czemu moją ręką?",
	["quest.side_ash_masks.say.door.reply"] = "Bo moja drży. Wrota tego nie lubią.",
	["quest.side_ash_masks.say.after"] = "Co potem?",
	["quest.side_ash_masks.say.after.reply"] = "Potem będę pilnował dalej. Od tego jestem.",
	["quest.side_ash_masks.bark.accept1"] = "Maski są lekkie, ale nie dla nich. Nie śpiesz się.",
	["quest.side_ash_masks.bark.half1"] = "Druga maska. Ten król miał wąską twarz.",
	["quest.side_ash_masks.bark.done1"] = "Wrota czekają. Przyłóż dłoń, ja powiem resztę.",
	-- S107: Z. The Salt Caravans
	["quest.side_ash_wagons.title"] = "Rozbite wozy",
	["quest.side_ash_wagons.p1"] = "Sól, płótno i narzędzia leżą w rozbitych wozach, a bazyliszki chodzą między nimi jak po swoim.",
	["quest.side_ash_wagons.p2"] = "Przeszukaj trzy wozy. Co da się uratować, pójdzie do miasta, resztę niech weźmie pustkowie.",
	["quest.side_ash_wagons.p3"] = "Dziesięć bazyliszków przy drodze, zanim kolejna karawana tu wejdzie. Woźnice nie ruszą, póki one tu chodzą.",
	["quest.side_ash_wagons.progress"] = "Trzy obrabowane wozy przeszukane i dziesięć bazyliszków na Szlaku Popiołu.",
	["quest.side_ash_wagons.done"] = "Starczy, żeby karawana ruszyła dalej. Mniej, niż było, więcej, niż myślałam.",
	["quest.side_ash_wagons.say.oxen"] = "Woły przeżyły?",
	["quest.side_ash_wagons.say.oxen.reply"] = "Dwa. Uciekły pierwsze. Mądrzejsze od woźniców.",
	["quest.side_ash_wagons.say.husband"] = "Gdzie twój mąż?",
	["quest.side_ash_wagons.say.husband.reply"] = "Przy jamie. Stoi. Później o tym.",
	["quest.side_ash_wagons.say.basilisks"] = "Najpierw bazyliszki.",
	["quest.side_ash_wagons.say.basilisks.reply"] = "Dobrze. Wozy nie uciekną.",
	["quest.side_ash_wagons.bark.accept1"] = "Nie patrz bazyliszkom w oczy. Patrz na ich nogi.",
	["quest.side_ash_wagons.bark.half1"] = "Sól cała. Płótno nie.",
	["quest.side_ash_wagons.bark.done1"] = "Wracaj. Wozy same się nie zaprzęgną.",
	["quest.side_ash_avenue.title"] = "Monety myta",
	["quest.side_ash_avenue.p1"] = "Wywerny znoszą błyszczące monety myta do gniazd przy Alei Królów. Widziałam, jak jedna porwała całą sakwę.",
	["quest.side_ash_avenue.p2"] = "To pieniądze karawany i płaca woźniców. Idź do Alei i odzyskaj pięć monet, resztę spiszemy na straty.",
	["quest.side_ash_avenue.progress"] = "Aleja Królów na Szlaku Popiołu i pięć monet myta od wywern.",
	["quest.side_ash_avenue.done"] = "Pięć monet. Woźnice dostaną po jednej i będą narzekać, że mało. To dobry znak, ludzie narzekają, kiedy żyją.",
	["quest.side_ash_avenue.say.kings"] = "Kim byli ci królowie?",
	["quest.side_ash_avenue.say.kings.reply"] = "Nie wiem. Woźnice mówią „dziadkowie” i kłaniają się w przejeździe.",
	["quest.side_ash_avenue.say.toll"] = "Myto komu?",
	["quest.side_ash_avenue.say.toll.reply"] = "Kiedyś królom. Teraz wywernom.",
	["quest.side_ash_avenue.bark.accept1"] = "Aleja jest na zachód od wozów. Posągi zobaczysz z daleka.",
	["quest.side_ash_avenue.bark.half1"] = "Słyszę brzęk. Jeszcze kilka.",
	["quest.side_ash_avenue.bark.done1"] = "Pięć. Wracaj, zanim wywerny policzą swoje.",
	["quest.side_ash_mirror.title"] = "Tarcza przy jamie",
	["quest.side_ash_mirror.p1"] = "Stara wiara woźniców mówi, że bazyliszek, który zobaczy własne oczy, odchodzi i nie wraca.",
	["quest.side_ash_mirror.p2"] = "Mam wypolerowaną tarczę męża. Postaw ją przy jamie, lustrem do środka.",
	["quest.side_ash_mirror.p3"] = "Mój mąż stoi w kamieniu przy tej jamie. Tego się już nie odwróci. Ale nikt więcej tak nie skończy.",
	["quest.side_ash_mirror.progress"] = "Dwanaście bazyliszków na Szlaku Popiołu i tarcza postawiona przy jamie bazyliszka.",
	["quest.side_ash_mirror.done"] = "Zostawiłam przy nim garść soli. Woźnice tak robią, kiedy ktoś zostaje przy drodze. Weź to i niech cię droga prowadzi.",
	["quest.side_ash_mirror.done.husband"] = "Mówiłam: później. Teraz. Zostawiłam mu sól, żeby wiedział, że dojechaliśmy. Weź to i niech cię droga prowadzi.",
	["quest.side_ash_mirror.say.shield"] = "To tarcza twojego męża?",
	["quest.side_ash_mirror.say.shield.reply"] = "Polerował ją co wieczór. Mówił, że kiedyś się przyda.",
	["quest.side_ash_mirror.say.faith"] = "Wierzysz w to?",
	["quest.side_ash_mirror.say.faith.reply"] = "Wierzę, że nikt więcej tak przy tej jamie nie stanie.",
	["quest.side_ash_mirror.bark.accept1"] = "Tarcza jest ciężka. Nieś ją lustrem do siebie.",
	["quest.side_ash_mirror.bark.half1"] = "Coraz ich mniej. Jama cichnie.",
	["quest.side_ash_mirror.bark.near1"] = "Tarczę oczami do jamy. Nie patrz w nią sam.",
	["quest.side_ash_mirror.bark.done1"] = "Stoi? Dobrze. Wracaj, ja pójdę do niego sama.",
