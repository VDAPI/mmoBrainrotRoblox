	-- S106: the eight new people of the Duskwood
	["npc.huntress_wanda.name"] = "Myśliwa Wanda",
	["npc.huntress_wanda.role"] = "Strażniczka latarń",
	["npc.huntress_wanda.greeting"] = "Trzymaj się światła. Za latarniami droga przestaje być drogą.",
	["npc.huntress_wanda.line1"] = "Latarnie przy trakcie palą się zimnym ogniem. Zwierzyna tego nie lubi. Gorsze rzeczy też nie.",
	["npc.huntress_wanda.line2"] = "Olej z księżycowego mchu pali się długo i nie dymi. Kapitanat zawsze się z nim spóźnia.",
	["npc.huntress_wanda.line3"] = "Każdej nocy obchodzę trakt. Liczę latarnie, nie kroki.",
	["npc.huntress_wanda.where"] = "przy Bramie Zmierzchu w Mrocznym Borze",
	["npc.beekeeper_maciej.name"] = "Bartnik Maciej",
	["npc.beekeeper_maciej.role"] = "Bartnik",
	["npc.beekeeper_maciej.greeting"] = "Ciszej, proszę. Pszczoły słyszą więcej, niż się ludziom wydaje.",
	["npc.beekeeper_maciej.line1"] = "Trzydzieści lat trzymam barcie w tym jarze. Pszczoły pamiętają mnie lepiej niż ludzie.",
	["npc.beekeeper_maciej.line2"] = "Rój, który się boi, brzęczy nisko. Ten jar brzęczy nisko od wiosny.",
	["npc.beekeeper_maciej.line3"] = "Miód z Boru jest ciemny i gorzki. W mieście płacą za niego jak za wino.",
	["npc.beekeeper_maciej.where"] = "przy powalonym olbrzymim pniu nad Niedźwiedzim Jarem",
	["npc.gravedigger_bogumil.name"] = "Grabarz Bogumił",
	["npc.gravedigger_bogumil.role"] = "Grabarz",
	["npc.gravedigger_bogumil.greeting"] = "Żywy? To dobrze. Z tymi drugimi mam dość roboty.",
	["npc.gravedigger_bogumil.line1"] = "Pilnuję grobów dawnej czeladzi dworu. Ghule je rozkopują, ja zakopuję. Tak mija rok.",
	["npc.gravedigger_bogumil.line2"] = "Umarli nie są trudni. Trudni są ci, którzy nie chcą zostać w ziemi.",
	["npc.gravedigger_bogumil.line3"] = "Łopata, latarnia, kawałek chleba. Więcej grabarzowi nie trzeba.",
	["npc.gravedigger_bogumil.where"] = "przed bramą cmentarza w Nawiedzonych Ruinach",
	["npc.herbalist_dobrawa.name"] = "Zielarka Dobrawa",
	["npc.herbalist_dobrawa.role"] = "Zielarka",
	["npc.herbalist_dobrawa.greeting"] = "Uważaj, gdzie stajesz. Pod tym mchem rośnie coś cenniejszego niż twoje buty.",
	["npc.herbalist_dobrawa.line1"] = "Grzyby w Sercu Puszczy mają szron na kapeluszach. W środku lata.",
	["npc.herbalist_dobrawa.line2"] = "Miejscy alchemicy znają zioła z ksiąg. Ja znam je z ziemi.",
	["npc.herbalist_dobrawa.line3"] = "Drzewa gniją tu od środka. Kora jest zdrowa, a pod nią zimno.",
	["npc.herbalist_dobrawa.where"] = "w kotlinie Pradrzewa w Sercu Puszczy",
	["npc.warden_zbyszko.name"] = "Strażnik Traktu Zbyszko",
	["npc.warden_zbyszko.role"] = "Strażnik traktu",
	["npc.warden_zbyszko.greeting"] = "Stój. Dokąd i po co? Pytam każdego, taki rozkaz.",
	["npc.warden_zbyszko.line1"] = "Kapitanat posłał mnie na Rozstaj, bo ginęli tu podróżni. Ginęli dalej, póki nie zacząłem ich liczyć.",
	["npc.warden_zbyszko.line2"] = "Nie lubię tej szubienicy. Ale stoi przy drodze, a ja pilnuję drogi.",
	["npc.warden_zbyszko.line3"] = "We mgle każdy znak wygląda jak znak traktu. Dlatego sprawdzam każdy.",
	["npc.warden_zbyszko.where"] = "przy szubienicy na Mglistym Rozstaju",
	["npc.ferryman_oldrzych.name"] = "Przewoźnik Ołdrzych",
	["npc.ferryman_oldrzych.role"] = "Przewoźnik",
	["npc.ferryman_oldrzych.greeting"] = "Przewóz kosztuje. Rada jest za darmo: nie patrz w wodę.",
	["npc.ferryman_oldrzych.line1"] = "Przewożę ludzi przez Trolle Bagno od trzydziestu lat. Bagno też mnie już zna.",
	["npc.ferryman_oldrzych.line2"] = "Kto wsiada do łodzi, spluwa przez lewe ramię. Kto nie spluwa, płynie sam.",
	["npc.ferryman_oldrzych.line3"] = "Trolle są głupie, ale liczyć umieją. Zwłaszcza cudze monety.",
	["npc.ferryman_oldrzych.where"] = "przy pomoście na Trollim Bagnie",
	["npc.exorcist_kalina.name"] = "Siostra Kalina",
	["npc.exorcist_kalina.role"] = "Egzorcystka ze świątyni",
	["npc.exorcist_kalina.greeting"] = "Niech światło cię strzeże. Tutaj przyda się każde.",
	["npc.exorcist_kalina.line1"] = "Brat Anzelm przysłał mnie, żebym zdejmowała uroki z moczarów. Roboty jest więcej, niż myślał.",
	["npc.exorcist_kalina.line2"] = "Wiedźmy z sabatu wieszają uroki przy ścieżkach. Ja je zdejmuję, one wieszają nowe.",
	["npc.exorcist_kalina.line3"] = "Modlę się krótko. Moczary nie czekają, aż skończę.",
	["npc.exorcist_kalina.where"] = "przy wisielczym drzewie na Wiedźmich Moczarach",
	["npc.mason_wojslaw.name"] = "Kamieniarz Wojsław",
	["npc.mason_wojslaw.role"] = "Kamieniarz",
	["npc.mason_wojslaw.greeting"] = "Ostrożnie przy ścianie. Kamień jest cierpliwy, ale nie bez końca.",
	["npc.mason_wojslaw.line1"] = "Przed laty wykuwałem tę drogę w Krwawych Urwiskach. Wróciłem naprawić szalunki.",
	["npc.mason_wojslaw.line2"] = "Czerwony kamień jest miękki pod dłutem i twardy pod deszczem. Trzeba go znać.",
	["npc.mason_wojslaw.line3"] = "Dobry kamieniarz słyszy pęknięcie, zanim je zobaczy.",
	["npc.mason_wojslaw.where"] = "na płaskowyżu Krwawych Urwisk, przy drodze do Krypty",
	-- S106: K. The Dusk Lanterns
	["quest.side_moonOil.title"] = "Olej z księżycowego mchu",
	["quest.side_moonOil.p1"] = "Kapitanat obiecał straży latarń baryłkę oleju z księżycowego mchu. Obiecał miesiąc temu, a baryłka dalej stoi u mnie w kącie.",
	["quest.side_moonOil.p2"] = "Latarnie przy trakcie w Borze gasną. A w Borze to znaczy, że droga przestaje być drogą. Zanieś olej Myśliwej Wandzie przy Bramie Zmierzchu.",
	["quest.side_moonOil.progress"] = "Baryłka oleju dla Myśliwej Wandy przy Bramie Zmierzchu w Mrocznym Borze.",
	["quest.side_moonOil.done"] = "Od Dobiesława? Olej się przyda. Gorzej, że ktoś nam te latarnie przewraca.",
	["quest.side_moonOil.say.why"] = "Po co Borowi olej?",
	["quest.side_moonOil.say.why.reply"] = "Latarnia to granica. Za nią zaczyna się las.",
	["quest.side_moonOil.say.quick"] = "Zaniosę przed zmrokiem.",
	["quest.side_moonOil.say.quick.reply"] = "Przed zmrokiem w Borze? Ambitnie. Tam zmrok jest zawsze.",
	["quest.side_moonOil.bark.accept1"] = "Baryłka jest szczelna. Tylko nie otwieraj jej przy ogniu.",
	["quest.side_moonOil.bark.done1"] = "Postaw tu, nie na drodze. Na drodze ktoś ją przewróci.",
	["quest.side_darkLanterns.title"] = "Zgasłe latarnie",
	["quest.side_darkLanterns.p1"] = "Trzy latarnie przy trakcie leżą w błocie. Słupy złamane jak zapałki, na żelazie ślady pazurów.",
	["quest.side_darkLanterns.p2"] = "Postaw je i zapal, oleju teraz mamy dość. Wilkołaki krążą przy drodze. Odpędź je, zanim wrócą po resztę.",
	["quest.side_darkLanterns.p3"] = "Pierwsza leży niedaleko bramy, dwie dalej w głąb Wilczych Ostępów. Nie zbaczaj z traktu, to je znajdziesz.",
	["quest.side_darkLanterns.progress"] = "Trzy latarnie postawione przy trakcie i osiem wilkołaków w Wilczych Ostępach.",
	["quest.side_darkLanterns.done"] = "Pazury na tej klatce są za wąskie jak na zwykłego wilkołaka. I ślady ciągną się w stronę Drzewa Kości. Muszę to przemyśleć.",
	["quest.side_darkLanterns.say.lanterns"] = "Najpierw latarnie.",
	["quest.side_darkLanterns.say.lanterns.reply"] = "Dobrze. Najpierw światło, potem reszta.",
	["quest.side_darkLanterns.say.wolves"] = "Najpierw wilki.",
	["quest.side_darkLanterns.say.wolves.reply"] = "Też dobrze. Mniej zębów przy robocie.",
	["quest.side_darkLanterns.say.alone"] = "Sama ich pilnujesz?",
	["quest.side_darkLanterns.say.alone.reply"] = "Sama. Latarnie nie pytają o towarzystwo.",
	["quest.side_darkLanterns.bark.accept1"] = "Weź krzesiwo. Latarnia bez ognia to tylko żelazo na kiju.",
	["quest.side_darkLanterns.bark.half1"] = "Jedna już płonie. Widzę ją stąd.",
	["quest.side_darkLanterns.bark.near1"] = "Słup złamany od dołu. Coś go objęło i pociągnęło.",
	["quest.side_darkLanterns.bark.done1"] = "Trakt znów ma światło. Wracaj, pokaż mi, co tam leżało.",
	["quest.side_boneTree.title"] = "Pod Drzewem Kości",
	["quest.side_boneTree.p1"] = "Pod Drzewem Kości wataha składa trofea. Poroża, czaszki i rzeczy ludzi, którzy zeszli z traktu.",
	["quest.side_boneTree.p2"] = "Pójdę z tobą, znam drogę. Przeszukasz trofea i zostawisz znak myśliwych. Niedźwiedzie przychodzą tam na padlinę, uważaj na nie.",
	["quest.side_boneTree.p3"] = "Mój brat Stach był latarnikiem. Przy ostatniej pełni poszedł obejść trakt i nie wrócił. Jeśli tam coś jest, chcę wiedzieć.",
	["quest.side_boneTree.progress"] = "Z Wandą do Drzewa Kości, znak myśliwych przy trofeach i sześć czarnych niedźwiedzi w Wilczych Ostępach.",
	["quest.side_boneTree.done"] = "Hak od latarni z wyrytym „S”. I ten olej na trofeach. Stach tu był, niedawno. Ślady prowadzą do Wilczej Nory.",
	["quest.side_boneTree.say.brother"] = "Opowiedz o Stachu.",
	["quest.side_boneTree.say.brother.reply"] = "Śmiał się za głośno. Tyle.",
	["quest.side_boneTree.say.silent"] = "Nie musisz mówić.",
	["quest.side_boneTree.say.silent.reply"] = "Dobrze. Chodźmy.",
	["quest.side_boneTree.bark.accept1"] = "Idziemy. Trzymaj się blisko i nie dotykaj kości.",
	["quest.side_boneTree.bark.half1"] = "Znak stoi. Teraz niedźwiedzie, zanim zwęszą nas oboje.",
	["quest.side_boneTree.bark.near1"] = "Stach mówił, że tu pachnie żelazem. Miał rację.",
	["quest.side_boneTree.bark.done1"] = "Pokaż, co znalazłeś. Wracaj do bramy.",
	["quest.side_boneTree.bark.death1"] = "Wstawaj. Brat by się z ciebie śmiał. Ja nie.",
	["quest.side_boneTree.comp.join1"] = "Chodź. Trzymaj się latarń, póki stoją.",
	["quest.side_boneTree.comp.wait1"] = "Nie zostawaj. Tu ci, co zostają, zostają na dobre.",
	["quest.side_boneTree.comp.wait2"] = "Patrz pod nogi, nie na drzewa. Drzewa patrzą same.",
	["quest.side_boneTree.comp.arrive1"] = "Czujesz? Olej z księżycowego mchu. Na trofeach. Mają go tylko latarnicy.",
	["quest.side_boneTree.comp.back1"] = "Wracamy do bramy. Bór nie lubi pośpiechu.",
	["quest.side_lampLighter.title"] = "Latarnik",
	["quest.side_lampLighter.p1"] = "Wiem, czym się stał. Wiedziałam, odkąd zobaczyłam te pazury. Nie chciałam tego powiedzieć na głos.",
	["quest.side_lampLighter.p1.brother"] = "Pytałeś o niego. Teraz wiesz więcej, niż chciałam ci powiedzieć. Wiem, czym się stał. Wiedziałam, odkąd zobaczyłam te pazury.",
	["quest.side_lampLighter.p1.silent"] = "Wtedy nie pytałeś. Dziękuję. Teraz i tak muszę to powiedzieć: wiem, czym się stał. Wiedziałam, odkąd zobaczyłam te pazury.",
	["quest.side_lampLighter.p2"] = "W Wilczej Norze żyje wilkołak z latarnią przy pasie. Myśliwi widzieli go dwa razy. Ja widziałam go raz i nie strzeliłam.",
	["quest.side_lampLighter.p3"] = "Zrób to, czego ja nie potrafię. Zakończ to szybko. On by tego chciał, gdyby jeszcze umiał czegoś chcieć.",
	["quest.side_lampLighter.p4"] = "Przynieś mi jego latarnię. Nie jego.",
	["quest.side_lampLighter.progress"] = "Wilkołak z latarnią przy pasie (Elita) w Wilczej Norze i jego latarnia dla Wandy.",
	["quest.side_lampLighter.done"] = "Zapalę ją przy bramie. Będzie się palić najdłużej ze wszystkich. Weź ten czaprak straży latarń. Stach chciałby, żeby ktoś go nosił.",
	["quest.side_lampLighter.say.promise"] = "Przyniosę latarnię.",
	["quest.side_lampLighter.say.promise.reply"] = "Tylko latarnię.",
	["quest.side_lampLighter.say.come"] = "Chodź ze mną.",
	["quest.side_lampLighter.say.come.reply"] = "Nie. Gdybym go zobaczyła, nie strzeliłabym. Weź maści.",
	["quest.side_lampLighter.bark.accept1"] = "Nora jest na północnym skraju Ostępów. Idź, zanim się rozmyślę.",
	["quest.side_lampLighter.bark.half1"] = "Jesteś blisko niego. Nie słuchaj, jak wyje.",
	["quest.side_lampLighter.bark.done1"] = "Wracaj powoli. Latarnię nieś przed sobą.",
	["quest.side_lampLighter.bark.stuck1"] = "Wilcza Nora jest na północy Ostępów, na końcu bocznej drogi, przy skałach.",
	-- S106: L. The Ravine Hives
	["quest.side_clayJars.title"] = "Dzbany dla bartnika",
	["quest.side_clayJars.p1"] = "Od jesieni nie mam miodu z Boru. Bez miodu nie ma miodu pitnego, a bez miodu pitnego goście piją wodę i patrzą na mnie z wyrzutem.",
	["quest.side_clayJars.p2"] = "Bartnik Maciej nie przysłał nic od miesięcy. Zanieś mu nowe dzbany i zapytaj, co się dzieje. Mieszka nad Niedźwiedzim Jarem, przy powalonym olbrzymim pniu.",
	["quest.side_clayJars.progress"] = "Gliniane dzbany dla Bartnika Macieja nad Niedźwiedzim Jarem.",
	["quest.side_clayJars.done"] = "Dzbany mam. Miodu nie mam. Siadaj, opowiem ci, czemu.",
	["quest.side_clayJars.say.mead"] = "Bez miodu karczma padnie?",
	["quest.side_clayJars.say.mead.reply"] = "Karczma nie. Ja tak.",
	["quest.side_clayJars.say.maciej"] = "Co z Maciejem?",
	["quest.side_clayJars.say.maciej.reply"] = "Nie wiem. I to mnie martwi. Maciej nigdy się nie spóźniał.",
	["quest.side_clayJars.bark.accept1"] = "Dzbany nie są puste. Są gotowe.",
	["quest.side_clayJars.bark.done1"] = "Dzbany od Wacława? Poznaję po glinie. Dobrze, że ktoś pamięta.",
	["quest.side_smokedHives.title"] = "Okadzone barcie",
	["quest.side_smokedHives.p1"] = "Niedźwiedzie rozbijają mi barcie i płoszą roje. Pszczoła, która się wystraszy, odlatuje i nie wraca.",
	["quest.side_smokedHives.p2"] = "Trzeba je okadzić i uspokoić, zanim odlecą na dobre. A niedźwiedzie przy barciach trzeba przetrzebić, inaczej wrócą jutro.",
	["quest.side_smokedHives.p3"] = "Pierwsza barć to przewrócony ul na skraju Wilczych Ostępów. Dwie pozostałe są w pniach na dnie jaru.",
	["quest.side_smokedHives.progress"] = "Trzy barcie do okadzenia i osiem czarnych niedźwiedzi w Niedźwiedzim Jarze.",
	["quest.side_smokedHives.done"] = "Roje zostały. Ale niedźwiedzie zdążyły wyjeść plastry, co do jednego. Pszczoły to wybaczą. Ja jeszcze nie.",
	["quest.side_smokedHives.say.hive"] = "Zacznę od barci.",
	["quest.side_smokedHives.say.hive.reply"] = "Dobrze. Najpierw dym, potem zęby.",
	["quest.side_smokedHives.say.bears"] = "Najpierw niedźwiedzie.",
	["quest.side_smokedHives.say.bears.reply"] = "Też dobrze. Pszczoły lubią ciszę.",
	["quest.side_smokedHives.say.sting"] = "Pszczoły mnie nie pogryzą?",
	["quest.side_smokedHives.say.sting.reply"] = "Pogryzą. Ale z szacunkiem.",
	["quest.side_smokedHives.bark.accept1"] = "Kadzidło trzymaj nisko. Dym ma iść do środka, nie na ciebie.",
	["quest.side_smokedHives.bark.half1"] = "Rój się uspokaja. Brzęczy już wyżej.",
	["quest.side_smokedHives.bark.near1"] = "Słyszysz? Brzęczą nisko. To znaczy, że się boją.",
	["quest.side_smokedHives.bark.done1"] = "Roje zostaną. Wracaj, porozmawiamy o plastrach.",
	["quest.side_stolenHoney.title"] = "Skradziony miód",
	["quest.side_stolenHoney.p1"] = "Niedźwiedzie znoszą plastry do legowisk, a to, czego nie zjedzą od razu, noszą w futrze. Lepi się do nich jak żywica.",
	["quest.side_stolenHoney.p2"] = "Co da się odzyskać, zanieś Wacławowi do karczmy. Umowa to umowa, nawet jeśli pszczoły jej nie podpisały.",
	["quest.side_stolenHoney.p3"] = "Niedźwiedzie są śmielsze, odkąd wrócił Kudłacz. Ale o tym niech ci powie ktoś inny.",
	["quest.side_stolenHoney.progress"] = "Sześć plastrów dzikiego miodu od czarnych niedźwiedzi w Niedźwiedzim Jarze, dla Karczmarza Wacława.",
	["quest.side_stolenHoney.done"] = "Miód z Boru, nareszcie. Kudłacz wrócił, mówisz? Dwadzieścia lat temu ten niedźwiedź zabił ojca Macieja. Maciej cię o nic nie poprosi. Ja proszę.",
	["quest.side_stolenHoney.say.fur"] = "Z futra? Naprawdę?",
	["quest.side_stolenHoney.say.fur.reply"] = "Niedźwiedź nie ma kieszeni.",
	["quest.side_stolenHoney.say.shaggy"] = "Kim jest Kudłacz?",
	["quest.side_stolenHoney.say.shaggy.reply"] = "Zapytaj Wacława. Ja nie umiem o nim mówić.",
	["quest.side_stolenHoney.bark.accept1"] = "Plastry z futra będą brudne. Wacław i tak je weźmie.",
	["quest.side_stolenHoney.bark.half1"] = "Połowa plastrów. Wacław już liczy dzbany.",
	["quest.side_stolenHoney.bark.done1"] = "Pachnie Borem stąd do karczmy. Przynieś to tutaj.",
	["quest.side_stolenHoney.bark.stuck1"] = "Niedźwiedzie z jaru noszą plastry w futrze. Szukaj ich na dnie wąwozu.",
	["quest.side_oldShaggy.title"] = "Kudłacz",
	["quest.side_oldShaggy.p1"] = "Dwadzieścia lat temu stary Maciej, ojciec naszego bartnika, poszedł za niedźwiedziem do Wilczej Nory. Nie wrócił.",
	["quest.side_oldShaggy.p1.shaggy"] = "Maciej kazał ci pytać mnie. Dobrze, że zapytałeś. Dwadzieścia lat temu jego ojciec poszedł za niedźwiedziem do Wilczej Nory i nie wrócił.",
	["quest.side_oldShaggy.p2"] = "Bartnicy wieszają dzwonek przy pasie, żeby niedźwiedzie słyszały ich z daleka i schodziły z drogi. Ten jeden niedźwiedź nie zszedł.",
	["quest.side_oldShaggy.p3"] = "Bartnicy nazywają go Kudłaczem. Jest stary, ogromny i do dziś ma dzwonek starego Macieja wplątany w futro. Tej wiosny wrócił do Nory.",
	["quest.side_oldShaggy.p4"] = "Przynieś ten dzwonek Maciejowi. Nie dla zemsty. Żeby znowu było go słychać przy barciach.",
	["quest.side_oldShaggy.progress"] = "Kudłacz i drugi czarny niedźwiedź (Elity) w Wilczej Norze i dzwonek starego bartnika dla Macieja.",
	["quest.side_oldShaggy.done"] = "To dzwonek ojca. Ten sam. Powieszę go przy barciach. Niech znowu będzie nas słychać z daleka, jak dawniej. Dziękuję.",
	["quest.side_oldShaggy.say.bell"] = "Przyniosę dzwonek.",
	["quest.side_oldShaggy.say.bell.reply"] = "Weź dwie flaszki. Kudłacz nie gryzie na pół.",
	["quest.side_oldShaggy.say.revenge"] = "Zabiję go za ojca Macieja.",
	["quest.side_oldShaggy.say.revenge.reply"] = "Nie za ojca. Za barcie. Maciej by tak chciał.",
	["quest.side_oldShaggy.bark.accept1"] = "Nora jest w Wilczych Ostępach. Kudłacza poznasz po rozmiarze.",
	["quest.side_oldShaggy.bark.half1"] = "Jeden padł. Kudłacz jest gdzieś głębiej.",
	["quest.side_oldShaggy.bark.done1"] = "Wacław mówił, że poszedłeś do Nory. Wracaj. Czekam przy barciach.",
	["quest.side_oldShaggy.bark.death1"] = "Wstawaj. Kudłacz zabrał już jednego bartnika. Ciebie nie dostanie.",
	-- S106: M. The Nameless
	["quest.side_nameless.title"] = "Bezimienni",
	["quest.side_nameless.p1"] = "Ghule rozkopują groby czeladzi z dworu. Kości rozwłóczą po całym cmentarzu, a ja potem zbieram, co się da.",
	["quest.side_nameless.p2"] = "Oczyść cztery groby, które jeszcze stoją, i odpędź ghule. Ja już nie mam siły biegać za nimi z łopatą.",
	["quest.side_nameless.p3"] = "I spójrz na ten nagrobek. Ktoś starannie skuł z niego imię. Wandal by rozbił. Ten pracował dłutem.",
	["quest.side_nameless.progress"] = "Cztery groby czeladzi do oczyszczenia i osiem ghuli w Nawiedzonych Ruinach.",
	["quest.side_nameless.done"] = "Na wszystkich czterech tak samo. Imiona skute równo, litera po literze. Ktoś chciał, żeby ci ludzie zniknęli drugi raz.",
	["quest.side_nameless.say.graves"] = "Najpierw groby.",
	["quest.side_nameless.say.graves.reply"] = "Dobrze. Umarli poczekają, ale niechętnie.",
	["quest.side_nameless.say.ghouls"] = "Najpierw ghule.",
	["quest.side_nameless.say.ghouls.reply"] = "Słusznie. Najpierw ci, co gryzą.",
	["quest.side_nameless.say.pay"] = "Kto ci za to płaci?",
	["quest.side_nameless.say.pay.reply"] = "Nikt. Dlatego robię to porządnie.",
	["quest.side_nameless.bark.accept1"] = "Łopaty nie pożyczam. Groby i tak już są.",
	["quest.side_nameless.bark.half1"] = "Połowa zrobiona. Na cmentarzu zrobiło się ciszej.",
	["quest.side_nameless.bark.done1"] = "Wróć do mnie. Muszę ci coś pokazać na tych kamieniach.",
	["quest.side_servantTokens.title"] = "Żetony czeladzi",
	["quest.side_servantTokens.p1"] = "Zjawy, które snują się po Ruinach, to dawna czeladź dworu. Poznaję je po fartuchach i po tym, jak stoją.",
	["quest.side_servantTokens.p2"] = "Każda nosi mosiężny żeton służby z numerem. Pan liczył swoich ludzi jak łyżki w kredensie.",
	["quest.side_servantTokens.p3"] = "Z żetonów odtworzę, kto leży w którym grobie. Przynieś mi sześć.",
	["quest.side_servantTokens.progress"] = "Sześć mosiężnych żetonów od leśnych zjaw w Nawiedzonych Ruinach.",
	["quest.side_servantTokens.done"] = "Numery zgadzają się z grobami. Brakuje mi tylko spisu, kto miał jaki numer. Taki spis miała kiedyś świątynia w mieście.",
	["quest.side_servantTokens.say.numbers"] = "Po co im numery?",
	["quest.side_servantTokens.say.numbers.reply"] = "Pan liczył ludzi jak łyżki. Teraz to się przyda.",
	["quest.side_servantTokens.say.fear"] = "Zjawy oddadzą je same?",
	["quest.side_servantTokens.say.fear.reply"] = "Nie. Ale potem są spokojniejsze.",
	["quest.side_servantTokens.bark.accept1"] = "Zjawy są w Ruinach, przy dworze. Nie bój się ich bardziej, niż trzeba.",
	["quest.side_servantTokens.bark.half1"] = "Trzy żetony. Zaczynam rachować groby.",
	["quest.side_servantTokens.bark.near1"] = "Ta w fartuchu była kucharką. Poznaję po tym, jak stoi.",
	["quest.side_servantTokens.bark.done1"] = "Komplet. Przynieś je, zanim zaśniedzieją.",
	["quest.side_householdRoll.title"] = "Spis czeladzi",
	["quest.side_householdRoll.p1"] = "Przepisałem numery z żetonów na kartę. Trzy noce przy świecy, a oczy już nie te.",
	["quest.side_householdRoll.p2"] = "Zanieś ją Bratu Anzelmowi do świątyni. Świątynia trzymała kiedyś księgi dworów z Boru. Może znajdzie, kto miał jaki numer.",
	["quest.side_householdRoll.progress"] = "Spis żetonów dla Brata Anzelma w świątyni.",
	["quest.side_householdRoll.done"] = "Mam spis czeladzi tego dworu. Bez nazwy pana: strona z herbem jest wycięta. Ktoś się przede mną postarał. Imiona przepiszę na tablicę.",
	["quest.side_householdRoll.say.careful"] = "Zaniosę ostrożnie.",
	["quest.side_householdRoll.say.careful.reply"] = "Dobrze. Pisałem trzy noce.",
	["quest.side_householdRoll.say.why"] = "Czemu sam nie pójdziesz?",
	["quest.side_householdRoll.say.why.reply"] = "Jak wyjdę, ghule wejdą. Pilnują moich godzin lepiej niż ja.",
	["quest.side_householdRoll.bark.accept1"] = "Karta jest sucha. Niech taka zostanie.",
	["quest.side_householdRoll.bark.done1"] = "Bogumił? Dawno nie dostałem od niego ani słowa. Pokaż.",
	["quest.side_restingPlace.title"] = "Miejsce spoczynku",
	["quest.side_restingPlace.p1"] = "Przepisałem imiona czeladzi na tablicę. Czterdzieści dwa imiona. Każde ktoś kiedyś wołał na obiad.",
	["quest.side_restingPlace.p2"] = "Zawieś tablicę na wspólnym grobie czeladzi, za tylnym płotem cmentarza, i zapal przy niej świece.",
	["quest.side_restingPlace.p3"] = "Zjawy, które nie zechcą odejść, trzeba rozproszyć. Nie z gniewu. One już nie wiedzą, że mogą odejść.",
	["quest.side_restingPlace.p4"] = "I proszę cię: nie mów nikomu o wyciętej stronie, dopóki sam się nie dowiem, kto ją wyciął.",
	["quest.side_restingPlace.progress"] = "Tablica z imionami na wspólnym grobie za cmentarzem i dziesięć leśnych zjaw w Nawiedzonych Ruinach. Potem do Grabarza Bogumiła.",
	["quest.side_restingPlace.done"] = "Czytałem imiona na głos, jedno po drugim. Wiesz, że pierwszy raz od lat na tym cmentarzu jest cicho? Dziękuję.",
	["quest.side_restingPlace.done.pay"] = "Mówiłem, że nikt mi nie płaci. Dziś jestem bogaty. Czytałem imiona na głos, jedno po drugim, i na cmentarzu jest cicho.",
	["quest.side_restingPlace.say.keep"] = "Nikomu nie powiem.",
	["quest.side_restingPlace.say.keep.reply"] = "Dziękuję. Weź to na drogę.",
	["quest.side_restingPlace.say.ask"] = "Kto wyciął tę stronę?",
	["quest.side_restingPlace.say.ask.reply"] = "Gdybym wiedział, nie prosiłbym o ciszę.",
	["quest.side_restingPlace.bark.accept1"] = "Tablica jest ciężka. Imiona ważą więcej, niż się wydaje.",
	["quest.side_restingPlace.bark.half1"] = "Połowa za tobą. Niech świece palą się do końca.",
	["quest.side_restingPlace.bark.done1"] = "Cicho jest. Słyszysz? Wracaj, chcę ci coś powiedzieć.",
	-- S106: N. The Cold Rot
	["quest.side_rotSap.title"] = "Zimna żywica",
	["quest.side_rotSap.p1"] = "Gnijące enty sączą żywicę. Dotknij jej, a poczujesz zimno jak od lodu. W środku lata.",
	["quest.side_rotSap.p2"] = "Potrzebuję tej żywicy i księżycowych płatków, które rosną nad wodą na mokradłach, wzdłuż Czarnego Strumienia. Wtedy zrozumiem, co to za choroba.",
	["quest.side_rotSap.p3"] = "Pójdę z tobą. Zbierasz za szybko i za głęboko, widzę po twoich rękach.",
	["quest.side_rotSap.progress"] = "Pięć porcji zimnej żywicy od entów zgnilizny w Sercu Puszczy i cztery księżycowe płatki z mokradeł.",
	["quest.side_rotSap.done"] = "Żywica nie topnieje przy ogniu. Trzymałam ją nad płomieniem całą noc. To nie jest zgnilizna. To jest zima, która udaje zgniliznę.",
	["quest.side_rotSap.say.sap"] = "Najpierw żywica.",
	["quest.side_rotSap.say.sap.reply"] = "Dobrze. Enty nie uciekną, ale żywica gęstnieje.",
	["quest.side_rotSap.say.petals"] = "Najpierw płatki.",
	["quest.side_rotSap.say.petals.reply"] = "Dobrze. Płatki zamykają się o zmierzchu, a w Borze zmierzch jest długi.",
	["quest.side_rotSap.say.alch"] = "Zapytać alchemiczkę z miasta?",
	["quest.side_rotSap.say.alch.reply"] = "Zapytam. Jak będę wiedziała, o co.",
	["quest.side_rotSap.bark.accept1"] = "Słoik na żywicę masz? Nie? Weź mój.",
	["quest.side_rotSap.bark.half1"] = "Połowa. Ręce ci marzną? To od żywicy.",
	["quest.side_rotSap.bark.near1"] = "Nie z korzeniem. Korzeń jest mój na przyszły rok.",
	["quest.side_rotSap.bark.done1"] = "Starczy. Wracamy do mojego obozu, zanim żywica stężeje.",
	["quest.side_rotSap.bark.death1"] = "Martwi nie zbierają ziół. Wstawaj.",
	["quest.side_rotSap.comp.join1"] = "Idę z tobą. Ktoś musi patrzeć, co zrywasz.",
	["quest.side_rotSap.comp.join2"] = "Ent nie ucieknie. Ja też nie, więc się nie spiesz.",
	["quest.side_rotSap.comp.back1"] = "Ogień, opatrunek, dalej. W tej kolejności.",
	["quest.side_ghoulBurrows.title"] = "Nory ghuli",
	["quest.side_ghoulBurrows.p1"] = "Ghule kopią nory pod korzeniami i roznoszą zgniliznę dalej. Gdzie przejdą, drzewa zaczynają gnić od środka.",
	["quest.side_ghoulBurrows.p2"] = "Zasyp trzy nory, które znalazłam, i przetrzeb ghule. Inaczej za miesiąc cała kotlina będzie zimna.",
	["quest.side_ghoulBurrows.p3"] = "Nory poznasz po zapachu. A raczej po tym, że ziemia przy nich jest zimna.",
	["quest.side_ghoulBurrows.progress"] = "Trzy nory ghuli do zasypania i dziesięć ghuli w Sercu Puszczy.",
	["quest.side_ghoulBurrows.done"] = "Napisałam do Ysolde w mieście i posłałam jej próbkę żywicy. Jeśli ktoś umie zrobić nalewkę, która zatrzyma tę chorobę, to ona. Nie mów jej, że to powiedziałam.",
	["quest.side_ghoulBurrows.say.burrows"] = "Najpierw nory.",
	["quest.side_ghoulBurrows.say.burrows.reply"] = "Dobrze. Zasypana nora to mniej ghuli jutro.",
	["quest.side_ghoulBurrows.say.ghouls"] = "Najpierw ghule.",
	["quest.side_ghoulBurrows.say.ghouls.reply"] = "Dobrze. Pustą norę zasypuje się łatwiej.",
	["quest.side_ghoulBurrows.say.smell"] = "Czym tu cuchnie?",
	["quest.side_ghoulBurrows.say.smell.reply"] = "Ghulami. Ta zgnilizna nie pachnie wcale. To gorsze.",
	["quest.side_ghoulBurrows.bark.accept1"] = "Łopatę weź większą. Nory są głębsze, niż wyglądają.",
	["quest.side_ghoulBurrows.bark.half1"] = "Połowa. Las już oddycha trochę lżej.",
	["quest.side_ghoulBurrows.bark.near1"] = "Ziemia przy norze jest zimna. W środku lata.",
	["quest.side_ghoulBurrows.bark.done1"] = "Wracaj. Mam pomysł, ale potrzebuję do niego alchemiczki z miasta.",
	["quest.side_rotCure.title"] = "Nalewka na zgniliznę",
	["quest.side_rotCure.p1"] = "Ysolde odpisała. Pisze ładniej, niż warzy, ale przepis ma dobry. Uwarzyłam według niego pierwszą nalewkę.",
	["quest.side_rotCure.p2"] = "Chcę, żeby sprawdziła ją sama. Zanieś jej butelkę. Ostrożnie, szkło jest cienkie, a nalewka gęsta.",
	["quest.side_rotCure.p3"] = "Zanim pójdziesz: enty, które dusiły zdrowe drzewa wokół mojego obozu, wróciły. Przerzedź je, żeby było czego leczyć.",
	["quest.side_rotCure.progress"] = "Nalewka Dobrawy dla Alchemiczki Ysolde w mieście i osiem entów zgnilizny w Sercu Puszczy.",
	["quest.side_rotCure.done"] = "Nalewka zatrzymuje chorobę. Nie leczy jej. To, co trzyma ten las w zimnie, siedzi głębiej, w samym sercu Puszczy. Dobrawa zrobiła, co mogła. Ja też.",
	["quest.side_rotCure.done.alch"] = "Dobrawa pisze, że pytałeś o mnie. Miło, że ktoś pyta. Nalewka zatrzymuje chorobę, ale jej nie leczy. Przyczyna siedzi głębiej, w samym sercu Puszczy.",
	["quest.side_rotCure.say.test"] = "Ysolde ją sprawdzi.",
	["quest.side_rotCure.say.test.reply"] = "Sprawdzi i powie, że zrobiłaby lepiej. Niech mówi.",
	["quest.side_rotCure.say.drink"] = "Piłaś ją?",
	["quest.side_rotCure.say.drink.reply"] = "Raz. Smakuje jak zimowy kompost.",
	["quest.side_rotCure.bark.accept1"] = "Butelkę trzymaj w cieple. Nalewka nie lubi Boru.",
	["quest.side_rotCure.bark.half1"] = "Enty rzedną. Drzewa skrzypią spokojniej.",
	["quest.side_rotCure.bark.done1"] = "Nalewka od Dobrawy? Przynieś ją do mnie, zanim zgęstnieje.",
	-- S106: O. False Waymarks
	["quest.side_falseMarks.title"] = "Fałszywe znaki",
	["quest.side_falseMarks.p1"] = "Przy drodze do Osady Kultystów stoją kamienie z fioletowymi znakami, takimi samymi jak znaki traktu.",
	["quest.side_falseMarks.p2"] = "Kto idzie za nimi we mgle, schodzi z drogi i nie wraca. Zatrzyj trzy znaki kredą straży.",
	["quest.side_falseMarks.p3"] = "Węże z rozlewisk polują na tych, co zbłądzili. Jak już tam będziesz, przetrzeb je.",
	["quest.side_falseMarks.progress"] = "Trzy fałszywe znaki do zatarcia przy drodze do osady i osiem bagiennych węży na Mglistym Rozstaju.",
	["quest.side_falseMarks.done"] = "Spójrz na moją rękawicę. Świeża farba. Malowali w tym tygodniu. I mieli pędzel, nie palec.",
	["quest.side_falseMarks.say.chalk"] = "Czemu kredą?",
	["quest.side_falseMarks.say.chalk.reply"] = "Farba straży jest w kapitanacie. Kapitanat jest daleko.",
	["quest.side_falseMarks.say.follow"] = "Ktoś za nimi poszedł i wrócił?",
	["quest.side_falseMarks.say.follow.reply"] = "Nikt. Dlatego tu stoję.",
	["quest.side_falseMarks.bark.accept1"] = "Kreda jest w worku. Jeden znak, jeden krzyż.",
	["quest.side_falseMarks.bark.half1"] = "Połowa. Mgła nie lubi, jak ktoś jej psuje robotę.",
	["quest.side_falseMarks.bark.done1"] = "Wróć. Chcę zobaczyć, czym malowali.",
	["quest.side_falseMarks.bark.stuck1"] = "Znaki stoją przy samej drodze do osady, od wschodniej strony.",
	["quest.side_lostLetters.title"] = "Listy zaginionych",
	["quest.side_lostLetters.p1"] = "Kultyści na Rozstaju noszą przy sobie listy i dokumenty podróżnych. Pewnie szukają w nich pieniędzy albo nazwisk.",
	["quest.side_lostLetters.p2"] = "Z tych listów odtworzę, kto zaginął i skąd szedł. Przynieś mi pięć.",
	["quest.side_lostLetters.p3"] = "Część tych ludzi ktoś jeszcze wypatruje w oknie. Chcę mu napisać coś więcej niż „zaginął”.",
	["quest.side_lostLetters.progress"] = "Pięć listów podróżnych od kultystów mroku na Mglistym Rozstaju.",
	["quest.side_lostLetters.done"] = "W listach powtarza się to samo: zaginionym zapłacił za przewodnika człowiek w szarym płaszczu, który mówił jak kapłan. Niektórzy żyją. Siedzą w klatkach w osadzie.",
	["quest.side_lostLetters.say.names"] = "Spiszesz ich imiona?",
	["quest.side_lostLetters.say.names.reply"] = "Wszystkie. Ktoś na nie czeka.",
	["quest.side_lostLetters.say.read"] = "Czytać cudze listy?",
	["quest.side_lostLetters.say.read.reply"] = "Regulamin zabrania. Regulaminu nie pisano na Rozstaju.",
	["quest.side_lostLetters.bark.accept1"] = "Listy są w torbach kultystów. Torby są przy kultystach.",
	["quest.side_lostLetters.bark.half1"] = "Połowa. Pismo różne, historia ta sama.",
	["quest.side_lostLetters.bark.done1"] = "Przynieś je. Mam już atrament i pustą kartę.",
	["quest.side_cultCages.title"] = "Klatki w osadzie",
	["quest.side_cultCages.p1"] = "Na podwórzu Osady Kultystów stoją dwie klatki. W nich ludzie z traktu, ci z listów.",
	["quest.side_cultCages.p2"] = "Otwórz je i daj im czas na ucieczkę. Kultyści w osadzie powinni mieć ważniejsze sprawy niż pościg, więc ich przerzedź.",
	["quest.side_cultCages.p3"] = "Ja nie mogę iść. Ktoś musi pilnować drogi, inaczej jutro w klatkach będą następni.",
	["quest.side_cultCages.p4"] = "Weź klucz kapitanatu i moją rękawicę. Jeńcy ją znają, połowa z nich pytała mnie kiedyś o drogę.",
	["quest.side_cultCages.progress"] = "Dwie klatki do otwarcia i dziesięciu kultystów mroku w Osadzie Kultystów.",
	["quest.side_cultCages.done"] = "Doszli do szubienicy, wszyscy. Jeden z nich powtarzał słowa kultystów: o zimie, która oczyści Bór. Spisuję to dla kapitana. Dziękuję w imieniu traktu.",
	["quest.side_cultCages.done.names"] = "Zgadza się z listami. Trzech więcej, niż myślałem. Doszli do szubienicy, wszyscy. Jeden powtarzał słowa kultystów o zimie, która oczyści Bór.",
	["quest.side_cultCages.say.glove"] = "Pokażę im rękawicę.",
	["quest.side_cultCages.say.glove.reply"] = "Znają ją. Połowa pytała mnie o drogę.",
	["quest.side_cultCages.say.where"] = "Gdzie stoją klatki?",
	["quest.side_cultCages.say.where.reply"] = "Na podwórzu, po zachodniej stronie.",
	["quest.side_cultCages.bark.accept1"] = "Klucz pasuje do obu kłódek. Nie zgub go.",
	["quest.side_cultCages.bark.half1"] = "Pierwsza klatka otwarta. Ludzie biegną w stronę Rozstaju.",
	["quest.side_cultCages.bark.done1"] = "Widzę ich na drodze. Wracaj, zanim osada się zorientuje.",
	-- S106: P. The Swamp Toll
	["quest.side_eelTraps.title"] = "Więcierze",
	["quest.side_eelTraps.p1"] = "Żyję z przewozu i z węgorzy. Przewozu ostatnio mało, a węgorzy jeszcze mniej.",
	["quest.side_eelTraps.p2"] = "Węże przegryzają mi więcierze, a ja sam w trzciny już nie chodzę. Zastaw dwa nowe przy pomoście i przegoń węże.",
	["quest.side_eelTraps.p3"] = "Więcierze leżą przy pomoście, po obu stronach. Wystarczy je zarzucić. Ręce mam już nie te, kolana też nie.",
	["quest.side_eelTraps.progress"] = "Dwa więcierze zastawione przy pomoście i osiem bagiennych węży na Trollim Bagnie.",
	["quest.side_eelTraps.done"] = "Węgorz, dobry. I... stara moneta przewozowa z dziurką. Nic. Nic takiego. Chowam ją, nie pytaj.",
	["quest.side_eelTraps.say.traps"] = "Najpierw więcierze.",
	["quest.side_eelTraps.say.traps.reply"] = "Dobrze. Węgorz nie czeka.",
	["quest.side_eelTraps.say.snakes"] = "Najpierw węże.",
	["quest.side_eelTraps.say.snakes.reply"] = "Rozsądnie. Martwy wąż nie gryzie sieci.",
	["quest.side_eelTraps.say.reeds"] = "Czemu sam nie chodzisz w trzciny?",
	["quest.side_eelTraps.say.reeds.reply"] = "W trzcinach coś mieszka. Węgorze też tak uważają.",
	["quest.side_eelTraps.bark.accept1"] = "Spluń przez lewe ramię, zanim wejdziesz w wodę.",
	["quest.side_eelTraps.bark.half1"] = "Słyszę plusk. Albo węgorz, albo kłopot.",
	["quest.side_eelTraps.bark.done1"] = "Chodź, zobaczymy, co wpadło.",
	["quest.side_trollToll.title"] = "Myto",
	["quest.side_trollToll.p1"] = "Powiem ci, skoro i tak zobaczysz. Trolle biorą ode mnie myto. Monetę od każdego pasażera.",
	["quest.side_trollToll.p2"] = "Kto nie zapłaci, ten nie dopływa. Płacę, bo wolę płacić, niż pływać sam.",
	["quest.side_trollToll.p3"] = "Trolle noszą te monety na sznurkach, jak korale. Odzyskaj je. Poznasz moje: mają dziurki, które sam wiercę.",
	["quest.side_trollToll.progress"] = "Sześć monet przewozowych od bagiennych trolli na Trollim Bagnie.",
	["quest.side_trollToll.done"] = "To moje, wszystkie z dziurkami. Ale brakuje skrzynki z resztą. Ta leży w kopcu kości w wiosce trolli, na wyspie.",
	["quest.side_trollToll.say.pay"] = "Płaciłeś im myto?",
	["quest.side_trollToll.say.pay.reply"] = "Każdy płaci. Ja przynajmniej liczę, ile.",
	["quest.side_trollToll.say.guard"] = "Czemu nie straż?",
	["quest.side_trollToll.say.guard.reply"] = "Straż ma łódź? Nie ma. To po co pytać.",
	["quest.side_trollToll.bark.accept1"] = "Trolle czuć z daleka. To jedyna dobra rzecz w trollach.",
	["quest.side_trollToll.bark.half1"] = "Trzy monety. Liczę je w myślach od lat.",
	["quest.side_trollToll.bark.done1"] = "Wracaj. Monety lepiej liczyć na suchym.",
	["quest.side_trollToll.bark.death1"] = "Mówiłem. Woda nie lubi pośpiechu.",
	["quest.side_trollHoard.title"] = "Skrzynka przewoźnika",
	["quest.side_trollHoard.p1"] = "Wioska trolli stoi na wyspie. Przy wielkim kotle mają kopiec kości, a w nim wszystko, co komu zabrali.",
	["quest.side_trollHoard.p2"] = "Gdzieś w tym kopcu leży moja skrzynka. Niewielka, okuta, z zamkiem, którego trolle nie umiały otworzyć.",
	["quest.side_trollHoard.p3"] = "Rozkop kopiec i przerzedź trolle, żeby długo nie wróciły po myto.",
	["quest.side_trollHoard.p4"] = "Jeśli skrzynka będzie otwarta, nie zaglądaj do środka. Przynieś ją. Proszę.",
	["quest.side_trollHoard.progress"] = "Wioska trolli na wyspie, kopiec kości przy kotle i osiem bagiennych trolli na Trollim Bagnie.",
	["quest.side_trollHoard.done"] = "Monety są. I list od mojej żony, sprzed lat. Myślałem, że przepadł. Od dziś każdego, kto przyjdzie od ciebie, przewożę za darmo.",
	["quest.side_trollHoard.say.island"] = "Jak dojdę na wyspę?",
	["quest.side_trollHoard.say.island.reply"] = "Brodem od północy. I nie patrz w wodę.",
	["quest.side_trollHoard.say.box"] = "Co jest w skrzynce?",
	["quest.side_trollHoard.say.box.reply"] = "Moje. Nie pytaj więcej.",
	["quest.side_trollHoard.bark.accept1"] = "Na wyspie trzymaj się suchego. Trolle nie lubią gości.",
	["quest.side_trollHoard.bark.half1"] = "Kopiec rozkopany. Teraz trolle, zanim wrócą.",
	["quest.side_trollHoard.bark.near1"] = "Kopiec przy kotle. Śmierdzi jak moje myto.",
	["quest.side_trollHoard.bark.done1"] = "Masz ją? Przynieś. Ostrożnie.",
	-- S106: Q. Hexes of the Marsh
	["quest.side_hexCharms.title"] = "Uroki przy ścieżce",
	["quest.side_hexCharms.p1"] = "Na wisielczym drzewie i na dwóch słupach przy ścieżce przez moczary wiszą uroki. Kości, włosy, sznurek.",
	["quest.side_hexCharms.p2"] = "Nie mogę ich dotknąć gołymi rękami. Ty je spal, a w ich miejscu postaw deszczułki ze znakiem świątyni.",
	["quest.side_hexCharms.p3"] = "Wiedźmy przyjdą sprawdzić, kto im psuje robotę. Przyjdą, bo zawsze przychodzą.",
	["quest.side_hexCharms.progress"] = "Trzy uroki do spalenia przy ścieżce i osiem wiedźm mokradeł na Wiedźmich Moczarach.",
	["quest.side_hexCharms.done"] = "Popiół z uroków jest zimny. Spójrz, błyszczy jak szron. Żaden ogień nie zostawia takiego popiołu.",
	["quest.side_hexCharms.say.bare"] = "Czemu nie gołymi rękami?",
	["quest.side_hexCharms.say.bare.reply"] = "Urok szuka ciepła. Ty masz rękawice.",
	["quest.side_hexCharms.say.pray"] = "Pomodlisz się za mnie?",
	["quest.side_hexCharms.say.pray.reply"] = "Krótko. Długie modlitwy są dla tych, co mają czas. Weź wodę.",
	["quest.side_hexCharms.bark.accept1"] = "Ogień trzymaj z dala od twarzy. Uroki pękają z trzaskiem.",
	["quest.side_hexCharms.bark.half1"] = "Połowa. Moczary są cichsze.",
	["quest.side_hexCharms.bark.near1"] = "Nie dotykaj go jeszcze. Najpierw ogień.",
	["quest.side_hexCharms.bark.done1"] = "Wracaj. Pokażę ci, co zostało w popiele.",
	["quest.side_hexPouches.title"] = "Woreczki z urokami",
	["quest.side_hexPouches.p1"] = "Każda wiedźma z sabatu nosi woreczek z włosami i karteczką. Na karteczce jest imię tego, na kogo rzuciła urok.",
	["quest.side_hexPouches.p2"] = "Zbierz pięć takich woreczków i zanieś Bratu Anzelmowi. On zna ludzi z miasta i okolicy, rozpozna imiona.",
	["quest.side_hexPouches.p3"] = "Nie otwieraj ich. Nie czytaj. Imię przeczytane przez obcego tylko wzmacnia urok.",
	["quest.side_hexPouches.progress"] = "Pięć woreczków z urokami od wiedźm mokradeł na Wiedźmich Moczarach, dla Brata Anzelma.",
	["quest.side_hexPouches.done"] = "Te imiona... strażnicy latarń, przewoźnicy, bartnicy. Ludzie, którzy pilnują dróg Boru. I w każdym woreczku pył łuski, zimny w dotyku. Ten sam co w amuletach z Łąk.",
	["quest.side_hexPouches.say.names"] = "Czyje imiona są w środku?",
	["quest.side_hexPouches.say.names.reply"] = "Nie czytam ich. Czyta Brat Anzelm.",
	["quest.side_hexPouches.say.burn"] = "Spalmy je od razu.",
	["quest.side_hexPouches.say.burn.reply"] = "Najpierw imiona. Potem ogień.",
	["quest.side_hexPouches.bark.accept1"] = "Woreczki noś osobno. Nie pozwól, żeby się stykały.",
	["quest.side_hexPouches.bark.half1"] = "Połowa. Czuję je stąd, jak zimny wiatr.",
	["quest.side_hexPouches.bark.done1"] = "Kalina przysyła cię do mnie? Przynieś je. Tylko ich nie otwieraj.",
	["quest.side_witchCauldron.title"] = "Kocioł z moczarów",
	["quest.side_witchCauldron.p1"] = "Te uroki warzono w kotle przy chacie na palach, na skraju Wiedźmich Moczarów. Tam sabat robi to, co robi.",
	["quest.side_witchCauldron.p1.burn"] = "Chciałeś je palić od razu. Kalina miała rację, że nie. Te uroki warzono w kotle przy chacie na palach, na skraju Wiedźmich Moczarów.",
	["quest.side_witchCauldron.p2"] = "Przewrócony kocioł nie wypije już niczyjej krwi. Idź tam i przewróć go.",
	["quest.side_witchCauldron.p3"] = "Trolle pilnują chaty za wiedźmią zapłatę. Kalina czeka przy wisielczym drzewie i modli się za ciebie. Zacznij, od czego chcesz.",
	["quest.side_witchCauldron.p4"] = "Kiedy wrócisz, nie mów w mieście o tych imionach. Ludzie, którzy na nich polują, nie powinni wiedzieć, że wiemy.",
	["quest.side_witchCauldron.progress"] = "Chata wiedźmy na palach, kocioł do przewrócenia i sześć bagiennych trolli na Wiedźmich Moczarach. Potem do Siostry Kaliny.",
	["quest.side_witchCauldron.done"] = "Spaliłam ostatni woreczek przy drzewie. Kto im płaci łuską, ten zapłaci więcej. Ale nie na tej ścieżce.",
	["quest.side_witchCauldron.say.cauldron"] = "Prosto do kotła.",
	["quest.side_witchCauldron.say.cauldron.reply"] = "Dobrze. Najpierw źródło, potem reszta.",
	["quest.side_witchCauldron.say.trolls"] = "Najpierw trolle.",
	["quest.side_witchCauldron.say.trolls.reply"] = "Dobrze. Kocioł nie ucieknie.",
	["quest.side_witchCauldron.say.kalina"] = "Kalina pójdzie ze mną?",
	["quest.side_witchCauldron.say.kalina.reply"] = "Nie. Ona czeka i się modli. Każdy ma swoją robotę.",
	["quest.side_witchCauldron.bark.accept1"] = "Idź. Kalina już się za ciebie modli.",
	["quest.side_witchCauldron.bark.half1"] = "Nie wchodź do chaty. Kocioł stoi obok, nie w środku.",
	["quest.side_witchCauldron.bark.done1"] = "Kocioł leży. Czuję to stąd. Wracaj do drzewa.",
	["quest.side_witchCauldron.bark.stuck1"] = "Chata stoi na palach na zachodnim skraju moczarów.",
	-- S106: R. The Stonemason's Apprentice
	["quest.side_roadCut.title"] = "Szalunki",
	["quest.side_roadCut.p1"] = "Szalunki w wykopie drogi pod Krwawe Urwiska pękają. Belki są nowe, a pękają jak stare.",
	["quest.side_roadCut.p2"] = "Podeprzyj trzy miejsca nowymi deskami, zanim ściana zejdzie na drogę.",
	["quest.side_roadCut.p3"] = "Nietoperze nie dadzą pracować w spokoju. Lecą na każdy stuk młotka. Przetrzeb je.",
	["quest.side_roadCut.progress"] = "Trzy szalunki do podparcia w wykopie drogi i dziesięć nietoperzy krwiopijców na Krwawych Urwiskach.",
	["quest.side_roadCut.done"] = "Spójrz na te belki. Nacięcia równe, dłutem kamieniarskim. Ktoś je podcinał. Takie dłuto miał tylko mój czeladnik, Leszek.",
	["quest.side_roadCut.say.beams"] = "Najpierw belki.",
	["quest.side_roadCut.say.beams.reply"] = "Dobrze. Ściana nie poczeka.",
	["quest.side_roadCut.say.bats"] = "Najpierw nietoperze.",
	["quest.side_roadCut.say.bats.reply"] = "Dobrze. Spokój przy robocie to połowa roboty.",
	["quest.side_roadCut.say.stone"] = "Kamień sam nie wytrzyma?",
	["quest.side_roadCut.say.stone.reply"] = "Kamień wytrzyma wszystko. Ludzie pod nim nie.",
	["quest.side_roadCut.bark.accept1"] = "Deski są przy ścianie. Gwoździ nie żałuj.",
	["quest.side_roadCut.bark.half1"] = "Połowa. Ściana już nie trzeszczy.",
	["quest.side_roadCut.bark.done1"] = "Wracaj. Coś mi się nie podoba w tych belkach.",
	["quest.side_batRoost.title"] = "Nietoperzowy nawis",
	["quest.side_batRoost.p1"] = "Leszek zniknął miesiąc temu przy nietoperzowym nawisie. Poszedł obejrzeć skałę i nie wrócił.",
	["quest.side_batRoost.p2"] = "Nietoperze znoszą do gniazd wszystko, co błyszczy. Jeśli coś po nim zostało, to tam.",
	["quest.side_batRoost.p3"] = "Idź pod nawis i przynieś jego narzędzia. Poznam je. Każde ostrzyłem sam, zanim mu je dałem.",
	["quest.side_batRoost.progress"] = "Nietoperzowy nawis na Krwawych Urwiskach i pięć dłut Leszka od nietoperzy krwiopijców.",
	["quest.side_batRoost.done"] = "Pokryte szronem. A tu, na trzonku, ktoś wydrapał: „Brama. Kują pieczęć. Każą nam”. Urwane. Brama nad Kryptą. Wiem, gdzie to jest.",
	["quest.side_batRoost.say.leszek"] = "Jaki był Leszek?",
	["quest.side_batRoost.say.leszek.reply"] = "Krzywo trzymał dłuto. Prosto myślał.",
	["quest.side_batRoost.say.bats"] = "Nietoperze kradną dłuta?",
	["quest.side_batRoost.say.bats.reply"] = "Wszystko, co błyszczy. Mnie jeszcze nie ukradły.",
	["quest.side_batRoost.bark.accept1"] = "Nawis jest nad drogą. Usłyszysz je, zanim zobaczysz.",
	["quest.side_batRoost.bark.half1"] = "Połowa. Poznaję trzonki, to jego robota.",
	["quest.side_batRoost.bark.near1"] = "Tu. Ten kamień ciosał on, poznaję rękę.",
	["quest.side_batRoost.bark.done1"] = "Przynieś je wszystkie. I niczego nie czyść.",
	["quest.side_apprentice.title"] = "Czeladnik",
	["quest.side_apprentice.p1"] = "Ludzie w szarości brali kamieniarzy do roboty przy Bramie Krypty. Płacili dobrze. Leszek poszedł, bo chciał kupić własne dłuta.",
	["quest.side_apprentice.p2"] = "Tych, którzy skończyli robotę, zostawili w środku. W Krypcie Zapomnianych stoją teraz w szeregu kościanej straży.",
	["quest.side_apprentice.p3"] = "Leszek nosił żelazny pierścień cechu. Dałem mu go, kiedy zrobił pierwszy próg bez pęknięcia. Przynieś mi ten pierścień.",
	["quest.side_apprentice.p4"] = "Jeśli stoi tam z innymi, pozwól mu się położyć.",
	["quest.side_apprentice.progress"] = "Dwa szkielety strażnicy (Elity) w Krypcie Zapomnianych i pierścień cechowy Leszka dla Wojsława.",
	["quest.side_apprentice.done"] = "Wkuję jego imię w kamień przy drodze. Pierwszy znak na nowym szalunku. Będzie trzymał lepiej niż belki.",
	["quest.side_apprentice.say.lay"] = "Pozwolę mu się położyć.",
	["quest.side_apprentice.say.lay.reply"] = "Dziękuję.",
	["quest.side_apprentice.say.bring"] = "Przyniosę go tobie.",
	["quest.side_apprentice.say.bring.reply"] = "Nie przyniesiesz. Przynieś pierścień.",
	["quest.side_apprentice.bark.accept1"] = "Krypta jest pod Bramą, na końcu drogi. Idź ostrożnie.",
	["quest.side_apprentice.bark.half1"] = "Jesteś w środku. Nie licz ich. Szukaj pierścienia.",
	["quest.side_apprentice.bark.done1"] = "Masz go? Wracaj. Kamień już czeka.",
	["quest.side_apprentice.bark.death1"] = "Wstawaj. Nie chcę wkuwać dwóch imion.",
