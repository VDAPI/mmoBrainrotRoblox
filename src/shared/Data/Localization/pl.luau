	["path.destroyer.name"] = "Niszczyciel",
	["path.destroyer.desc"] = "Kostur albo różdżka z kulą. Ziemia płonie, zamarza albo trzaska piorunami, a całe grupy wrogów padają naraz. Premie do obszaru działają, gdy czar trafia co najmniej dwóch wrogów.",
	["path.arcanist.name"] = "Arkanista",
	["path.arcanist.desc"] = "Kostur runiczny albo różdżka z księgą. Uczony czystej magii wlewa manę w coraz silniejsze czary w jeden cel: pełny pasek many to broń, pusty to chwila słabości.",
