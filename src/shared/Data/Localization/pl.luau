	-- S103: story chapter II "The Forgotten House" (pages, new quests, NPCs of Duskwood, answers, comments, cutscenes)
	["quest.toDuskwood.p1"] = "Grimrok mówił o panu z północy, Anzelm o Ilvarze. Dziesięć lat temu Ilvar odszedł do Mrocznego Boru.",
	["quest.toDuskwood.p2"] = "Jeśli gdzieś szukać jego ludzi, to tam. Za Bramą Zmierzchu trakt pilnuje Zwiadowca Borin. Znajdź go.",
	["quest.toDuskwood.p3"] = "Trzymaj się niebieskich latarni, w Borze światło to granica. I weź ten plecak: w Borze nie ma kupców.",
	["quest.toDuskwood.bark.accept1"] = "Trakt do Boru zaczyna się za portalem. Szukaj niebieskich latarni.",
	["quest.toDuskwood.bark.done1"] = "Jesteś. Odpocznij przy latarni, zanim pójdziesz dalej.",
	["quest.werewolves.p1"] = "Wyją od trzech nocy, choć do pełni daleko. Wilkołaki zawsze tu były, ale te nie uciekają przed ogniem i polują w biały dzień.",
	["quest.werewolves.p2"] = "Przerzedź je w zachodnim lesie, zanim pełnia zrobi z nich armię.",
	["quest.werewolves.bark.accept1"] = "Zachodni las. Słuchaj wycia, ono cię zaprowadzi.",
	["quest.werewolves.bark.half1"] = "Połowa watahy. Reszta już wie, że idziesz.",
	["quest.werewolves.bark.done1"] = "Cisza w lesie. Wracaj, zanim wstanie księżyc.",
	["quest.moonstone.title"] = "Księżycowy Kamień",
	["quest.moonstone.p1"] = "Na skraju lasu stał obóz myśliwych. Wilki rozniosły go w jedną noc. Przeżył tylko leśniczy Radomir.",
	["quest.moonstone.p2"] = "Radomir mówi rzeczy, w które nie chcę wierzyć. Że wilki przyszły prosto od Księżycowej Polany i że ktoś tam był przed nimi.",
	["quest.moonstone.p3"] = "Siedzi w tym, co zostało z obozu. Wysłuchaj go, a potem idź na polanę i zobacz sam.",
	["quest.moonstone.text"] = "Odszukaj leśniczego Radomira w rozszarpanym obozie, skuj runę z Księżycowego Kamienia i przerzedź wilkołaki w Wilczych Ostępach.",
	["quest.moonstone.done"] = "Kamień znów świeci srebrem. Runa była z lodu, który nie topniał w dłoni: płatek śniegu przebity cierniem. Po twojej twarzy widzę, że znasz ten znak.",
	["quest.moonstone.radomir"] = "Na menhirze ktoś wyrył świeżą runę. Srebrne światło kamienia zrobiło się zimne i niebieskie, a przy nim wilki wpadają w szał. Skuj ją.",
	["quest.moonstone.say.believe"] = "Wierzę mu. Gdzie ten kamień?",
	["quest.moonstone.say.believe.reply"] = "Polana na północ od obozu. Patrz na kamień, nie na wilki.",
	["quest.moonstone.say.doubt"] = "Runy na kamieniu? Może wypił.",
	["quest.moonstone.say.doubt.reply"] = "Radomir pije tylko wodę. Od tamtej nocy nawet tego mało.",
	["quest.moonstone.say.wolves"] = "Ile ich tam jest?",
	["quest.moonstone.say.wolves.reply"] = "Więcej, niż chcę liczyć. Weź to.",
	["quest.moonstone.bark.accept1"] = "Radomir siedzi przy zimnym ognisku. Mów do niego spokojnie.",
	["quest.moonstone.bark.half1"] = "Mniej wycia. Nie zwalniaj.",
	["quest.moonstone.bark.near1"] = "Kamień jest zimny. W środku lata.",
	["quest.moonstone.bark.done1"] = "Ucichły. Pierwszy raz od tygodnia słyszę sowy.",
	["quest.lostHunters.title"] = "Zaginieni myśliwi",
	["quest.lostHunters.p1"] = "Mój syn, Miłosz, poszedł za śladem wilków w dół, do Niedźwiedziego Jaru. Nie wrócił.",
	["quest.lostHunters.p1.doubt"] = "Borin mówi, że mi nie wierzysz. Dobrze. Zejdziemy i zobaczysz na własne oczy. Mój syn, Miłosz, poszedł za śladem wilków do Niedźwiedziego Jaru. Nie wrócił.",
	["quest.lostHunters.p2"] = "Niedźwiedzie w jarze są rozdrażnione jak wilki. Myśliwi omijają go od miesiąca. Ja też omijałem.",
	["quest.lostHunters.p3"] = "Zejdę z tobą. Znam jar. Sam nie miałem odwagi, a był dobrym myśliwym. Najlepszym, jakiego uczyłem.",
	["quest.lostHunters.text"] = "Idź z Radomirem do obozu zaginionych na dnie Niedźwiedziego Jaru, przeszukaj go i przerzedź czarne niedźwiedzie. Wieści zanieś Borinowi.",
	["quest.lostHunters.done"] = "Notatki Miłosza. Ludzie w szarych płaszczach nieśli przez jar trumnę pokrytą szronem, w stronę Ruin. Tu się urywają. Ciała nie ma, a takie nacięcia robią myśliwi Radomira, kiedy idą dalej. Powiem mu, że jest nadzieja.",
	["quest.lostHunters.done.son"] = "Uparty, mówił? Uparci żyją długo. Ludzie w szarości nieśli przez jar oszronioną trumnę, w stronę Ruin. Ciała nie ma, za to jest nacięcie myśliwych. Powiem Radomirowi, że jest nadzieja.",
	["quest.lostHunters.say.together"] = "Pójdziesz ze mną?",
	["quest.lostHunters.say.together.reply"] = "Pójdę. Znam jar lepiej niż własną chatę. I tak nie śpię.",
	["quest.lostHunters.say.son"] = "Jaki jest twój syn?",
	["quest.lostHunters.say.son.reply"] = "Uparty. Strzela lepiej niż ja. Nie mów mu tego.",
	["quest.lostHunters.say.bears"] = "A niedźwiedzie?",
	["quest.lostHunters.say.bears.reply"] = "Rozdrażnione jak wilki. Masz, mnie się nie przydadzą.",
	["quest.lostHunters.bark.accept1"] = "Trzymaj się blisko. W jarze echo kłamie.",
	["quest.lostHunters.bark.half1"] = "Niedźwiedzie cichną. Jar znowu oddycha.",
	["quest.lostHunters.bark.near1"] = "Tam, pod skałą. Ktoś palił ogień już po napadzie.",
	["quest.lostHunters.bark.done1"] = "Masz jego notatki? Przynieś, zanim zamokną.",
	["quest.lostHunters.bark.death1"] = "Wstawaj. Jar daje drugą szansę, trzeciej nie.",
	["quest.lostHunters.comp.join1"] = "Trakt, potem w dół przy powalonym olbrzymie. Nie zostawaj w tyle.",
	["quest.lostHunters.comp.join2"] = "Miłosz mówi, że prowadzę jak niedźwiedź. Wolno, ale zawsze dochodzę.",
	["quest.lostHunters.comp.wait1"] = "Stoję. Las nie ucieknie, ale wilki mogą przyjść.",
	["quest.lostHunters.comp.wait2"] = "Nie zbieraj grzybów. Tutaj to one zbierają ludzi.",
	["quest.lostHunters.comp.arrive1"] = "Kusza Miłosza. Na kolbie świeże nacięcie: tak znaczymy, że idziemy dalej.",
	["quest.lostHunters.comp.arrive2"] = "Żył, kiedy tu był. Przeszukaj resztę. Ja… popilnuję drogi.",
	["quest.lostHunters.comp.back1"] = "Wracam do obozu. Przyjdź, zejdziemy jeszcze raz.",
	["quest.ruins.p1"] = "Ślady z jaru prowadzą na wzgórze z ruinami. Od kilku tygodni zjawy wychodzą tam za dnia, jakby ktoś je obudził.",
	["quest.ruins.p2"] = "Zniszcz je i zbierz ich esencję. Ysolde powie, co je trzyma przy tym miejscu.",
	["quest.ruins.bark.accept1"] = "Ruiny są na wzgórzu za rozwidleniem. Zjawy nie lubią światła.",
	["quest.ruins.bark.half1"] = "Połowa za tobą. Zjawy wracają tam, gdzie je związano.",
	["quest.ruins.bark.done1"] = "Wracaj z esencją. Ysolde już czeka.",
	["quest.houseOfVael.title"] = "Dom rodu Vael",
	["quest.houseOfVael.p1"] = "Esencja była związana. Ktoś odprawiał w ruinach obrzędy, i to niedawno.",
	["quest.houseOfVael.p2"] = "Na wzgórzu stoi dwór, którego nazwy nikt w Borze nie pamięta. Za nim cmentarz, kaplica i rodowa krypta.",
	["quest.houseOfVael.p3"] = "Obejrzyj witraż w kaplicy i kryptę. Mówią, że przy kaplicy widać czasem bladego człowieka w liberii.",
	["quest.houseOfVael.text"] = "Zbadaj dwór w Nawiedzonych Ruinach: witraż w kaplicy i rodową kryptę. Wysłuchaj ducha, który ich pilnuje.",
	["quest.houseOfVael.done"] = "Morvane. Królowa Krypt to ostatnia z rodu, który uratował północ? I to jej trumnę nieśli przez jar.",
	["quest.houseOfVael.oswin"] = "Byłem zarządcą tego domu. Ludzie w szarości zeszli do krypty i wynieśli trumnę mojej pani. Nie mogłem nic zrobić. Umarli niewiele mogą.",
	["quest.houseOfVael.say.ghosts"] = "Blady człowiek w liberii?",
	["quest.houseOfVael.say.ghosts.reply"] = "Nie wierzę w duchy. Ale tę kaplicę omijam.",
	["quest.houseOfVael.say.whose"] = "Czyj to był dwór?",
	["quest.houseOfVael.say.whose.reply"] = "Nikt nie pamięta. To mnie niepokoi bardziej niż duchy.",
	["quest.houseOfVael.say.way"] = "Gdzie ta kaplica?",
	["quest.houseOfVael.say.way.reply"] = "Za dworem, za cmentarzem. Witraż widać z daleka.",
	["quest.houseOfVael.bark.accept1"] = "Dwór stoi na wzgórzu. Idź drogą od rozwidlenia.",
	["quest.houseOfVael.bark.half1"] = "Nie zostawaj tam po zmroku dłużej, niż musisz.",
	["quest.houseOfVael.bark.near1"] = "Tu zaczyna się dwór. Cisza jest tu za głęboka.",
	["quest.houseOfVael.bark.done1"] = "Wracaj. Chcę wiedzieć, czyja to krypta.",
	["quest.houseOfVael.bark.stuck1"] = "Kaplica stoi za cmentarzem, krypta zaraz obok.",
	["quest.ents.p1"] = "Serce Puszczy gnije od środka. Enty, które pilnowały Pradrzewa, rzucają się na wszystko, co się rusza.",
	["quest.ents.p2"] = "Ukój je. Ysolde prosi też o psiankę z tamtejszych bajor, mówi, że zrobi z niej coś na tę zgniliznę.",
	["quest.ents.bark.accept1"] = "Serce Puszczy leży w kotlinie na północy. Uważaj na korzenie.",
	["quest.ents.bark.half1"] = "Enty słabną. Psianka rośnie przy bajorach.",
	["quest.ents.bark.done1"] = "Las oddycha lżej. Wracaj.",
	["quest.elderHeart.title"] = "Serce Pradrzewa",
	["quest.elderHeart.p1"] = "Gnicie nie ustało. Zgnilizna w Sercu Puszczy jest zimna, a w szczelinie Pradrzewa świeci coś niebieskiego.",
	["quest.elderHeart.p1.ghosts"] = "Po tej kaplicy już nie pytasz o duchy. Dobrze, bo teraz drzewa. Zgnilizna w Sercu Puszczy jest zimna, a w szczelinie Pradrzewa świeci coś niebieskiego.",
	["quest.elderHeart.p2"] = "Ghule ciągną do tego światła. Wyrwij to, co tkwi w drzewie, zanim zgnije całe.",
	["quest.elderHeart.text"] = "Wyrwij to, co tkwi w szczelinie Pradrzewa, i przerzedź ghule w Sercu Puszczy.",
	["quest.elderHeart.done"] = "Odłamek lodu stopniał w dłoni, a szczelina świeci złotem? I drzewo dało ci gałąź, ciepłą i brzęczącą jak struna. Nie wiem, co to jest. Ale las ci ją dał. Zachowaj.",
	["quest.elderHeart.say.cold"] = "Zgnilizna, która jest zimna?",
	["quest.elderHeart.say.cold.reply"] = "Dotknąłem. Palce bolały do rana. Las gnije ciepło. To nie jest las.",
	["quest.elderHeart.say.ghouls"] = "Ile ghuli?",
	["quest.elderHeart.say.ghouls.reply"] = "Dziesiątki. Ciągną do tego światła jak ćmy do ognia.",
	["quest.elderHeart.say.path"] = "Jak zejść do Pradrzewa?",
	["quest.elderHeart.say.path.reply"] = "Po korzeniach, nie po błocie. Błoto tam ma zęby.",
	["quest.elderHeart.bark.accept1"] = "Pradrzewo stoi w kotlinie. Zejdź ostrożnie.",
	["quest.elderHeart.bark.half1"] = "Ghule rzedną. Drzewo chyba to czuje.",
	["quest.elderHeart.bark.near1"] = "Ten błękit w szczelinie… nie dotykaj go gołą ręką.",
	["quest.elderHeart.bark.done1"] = "Las nikomu nic nie daje. Pokaż, co masz.",
	["quest.cult.p1"] = "Kultyści mroku mają osadę na północnym wschodzie, za palisadą, z kręgiem kamieni i fioletowym ogniem. To oni nosili trumnę.",
	["quest.cult.p2"] = "Powstrzymaj ich i zbierz ich pieczęcie. Zanieś je kapitanowi. On będzie wiedział, komu je pokazać.",
	["quest.cult.bark.accept1"] = "Osada jest za palisadą na północnym wschodzie. Nie idź główną bramą.",
	["quest.cult.bark.half1"] = "Pieczęcie noszą przy pasach. Szukaj dalej.",
	["quest.cult.bark.done1"] = "Pieczęcie kultu? Przynieś je prosto do mnie.",
	["quest.turncoat.title"] = "Odstępca",
	["quest.turncoat.p1"] = "Borin przysłał wiadomość. Kultysta, który uciekł od swoich, ukrywa się przy kapliczce na Mglistym Rozstaju.",
	["quest.turncoat.p2"] = "Chce rozmawiać tylko z kimś z miasta. Jego dawni bracia przeczesują rozstaj, więc długo tam nie pożyje.",
	["quest.turncoat.p3"] = "Idź, wysłuchaj go i odpędź tych, którzy go szukają. Nie obiecuj mu niczego, czego nie dotrzymam.",
	["quest.turncoat.text"] = "Odszukaj zbiegłego kultystę przy kapliczce na Mglistym Rozstaju, wysłuchaj go i odpędź tych, którzy go ścigają.",
	["quest.turncoat.done"] = "Trzy pieczęcie trzymają smoka we śnie: Krew, Runa i Straż. Krew to królowa Morvane. Ilvar ma jej ciało i chce ją wskrzesić w Kurhanie, żeby jej krew służyła Zimie. Nie dam mu na to czasu.",
	["quest.turncoat.done.trust"] = "Mówiłem, że mu nie ufam. Wolałbym, żeby kłamał. Trzy pieczęcie: Krew, Runa i Straż. Krew to Morvane. Ilvar ma jej ciało i chce ją wskrzesić w Kurhanie. Nie dam mu na to czasu.",
	["quest.turncoat.jorund"] = "Byłem jednym z nich. Uciekłem, kiedy zobaczyłem, co robią z umarłymi. Powiedz kapitanowi wszystko, co ci powiem. Wszystko.",
	["quest.turncoat.say.trust"] = "Ufasz zbiegowi kultu?",
	["quest.turncoat.say.trust.reply"] = "Nie. Ufam Borinowi, a Borin nie ufa nikomu. Na jedno wychodzi.",
	["quest.turncoat.say.bring"] = "Przyprowadzić go tutaj?",
	["quest.turncoat.say.bring.reply"] = "Nie przejdzie przez Bór żywy. Wysłuchaj go tam, gdzie jest.",
	["quest.turncoat.say.hunters"] = "Kto go ściga?",
	["quest.turncoat.say.hunters.reply"] = "Jego bracia. Krążą po rozstaju. Ich najpierw.",
	["quest.turncoat.bark.accept1"] = "Kapliczka stoi przy drodze do osady. Ręka na broni.",
	["quest.turncoat.bark.half1"] = "Jeszcze kilku braci w mgle. Nie zostawiaj go samego.",
	["quest.turncoat.bark.near1"] = "Szukaj latarni. On nie wyjdzie pierwszy.",
	["quest.turncoat.bark.done1"] = "Wracaj. Chcę to usłyszeć słowo w słowo.",
	["quest.swamp.p1"] = "Zanim ruszymy na Kurhan, garnizon Borina musi przetrwać. Trolle odcięły ścieżki przez bagno, ludzie jedzą korzonki.",
	["quest.swamp.p2"] = "Oczyść drogę i przynieś im ryby. Głodny zwiadowca widzi wilki tam, gdzie ich nie ma.",
	["quest.swamp.bark.accept1"] = "Trolle siedzą na grobli. Weź wędkę, garnizon jest głodny.",
	["quest.swamp.bark.half1"] = "Ścieżka coraz czystsza. Nie zapomnij o rybach.",
	["quest.swamp.bark.done1"] = "Ryby i czysta droga. Moi ludzie tego nie zapomną.",
	["quest.barrow.title"] = "Serce Kurhanu",
	["quest.barrow.p1"] = "Kurhan Kultystów. Jorund mówił, że to tam. W Sercu Kurhanu wybrani kultu strzegą ołtarza.",
	["quest.barrow.p2"] = "Idź, zanim skończą. Odbierz im Księgę Obrzędów. Kult zapisuje wszystko, co robi.",
	["quest.barrow.text"] = "Wejdź do Kurhanu Kultystów, pokonaj ich wybranych i odbierz im Księgę Obrzędów.",
	["quest.barrow.done"] = "„Królowa wstała i wiąże umarłych dla Zimy.” Spóźniliśmy się. Ale teraz wiemy, gdzie jej szukać.",
	["quest.barrow.say.late"] = "Zdążymy?",
	["quest.barrow.say.late.reply"] = "Nie. Ale idź tak, jakbyśmy mieli zdążyć.",
	["quest.barrow.say.book"] = "Czego tam szukać?",
	["quest.barrow.say.book.reply"] = "Księgi. Kult zapisuje każdy obrzęd, a ten był największy.",
	["quest.barrow.say.supplies"] = "Potrzebuję zapasów.",
	["quest.barrow.say.supplies.reply"] = "Bierz. W Kurhanie nikt ci nic nie sprzeda.",
	["quest.barrow.bark.accept1"] = "Kurhan jest na końcu drogi spod dworu. Idź, zanim skończą.",
	["quest.barrow.bark.half1"] = "Wybrani padają. Księga musi być przy którymś z nich.",
	["quest.barrow.bark.done1"] = "Masz księgę? Wracaj, zanim kult zauważy, czego brakuje.",
	["quest.barrow.bark.death1"] = "Wybrani kultu nie walczą uczciwie. Wróć z lepszym planem.",
	["quest.barrow.bark.stuck1"] = "Nie każdy z wybranych nosi księgę. Szukaj dalej.",
	["quest.crypt.p1"] = "Zanieśli ją do Krypty Zapomnianych pod Krwawymi Urwiskami. Kurhan był tylko przystankiem.",
	["quest.crypt.p2"] = "Szkieletowi strażnicy pilnują przejścia. Najpierw oni, potem pomyślimy o królowej.",
	["quest.crypt.bark.accept1"] = "Krypta jest pod Krwawymi Urwiskami, na końcu traktu.",
	["quest.crypt.bark.half1"] = "Strażnicy padają. Krypta jest coraz cichsza.",
	["quest.crypt.bark.done1"] = "Jej strażnicy to proch. Wracaj, zanim krypta się obudzi.",
	["quest.witchCounsel.title"] = "Rada wiedźmy",
	["quest.witchCounsel.p1"] = "Królowej nie zabije się jak trolla. Stal przejdzie przez nią jak przez mgłę, jeśli nie wiemy, z czym walczymy.",
	["quest.witchCounsel.p2"] = "W opuszczonej wiosce na palach, na Trollim Bagnie, mieszka Ragna. Ludzie mówią, że wiedźma. Ona mówi, że nie.",
	["quest.witchCounsel.p3"] = "Zapytaj ją o królową. Sabat z Wiedźmich Moczarów służy kultowi, ale Ragna do niego nie należy. Tak twierdzi.",
	["quest.witchCounsel.text"] = "Porozmawiaj z Ragną z Palów, przerzedź wiedźmy sabatu na Wiedźmich Moczarach i przynieś trzy kościane dzwonki.",
	["quest.witchCounsel.done"] = "Sabat ucichł aż tutaj. Ragna przysłała flakon i słowo: gdy królowa się zachwieje, wypowiedz jej imię. Umarli pamiętają siebie tylko wtedy, gdy ktoś im przypomni.",
	["quest.witchCounsel.ragna"] = "Nie należę do sabatu. Z ich kościanych dzwonków uwarzę Wywar Prawdziwego Imienia. Umarła, która usłyszy swoje imię, przypomni sobie, kim była.",
	["quest.witchCounsel.say.witch"] = "Wiedźma?",
	["quest.witchCounsel.say.witch.reply"] = "Ona mówi, że nie. Ja bym się z nią nie spierał.",
	["quest.witchCounsel.say.trust"] = "Ufasz jej?",
	["quest.witchCounsel.say.trust.reply"] = "Leczyła moich ludzi. Wzięła za to ryby. Uczciwa cena.",
	["quest.witchCounsel.say.way"] = "Gdzie jej szukać?",
	["quest.witchCounsel.say.way.reply"] = "Zachodni brzeg Trollego Bagna, przy chatach na palach.",
	["quest.witchCounsel.bark.accept1"] = "Ragna nie lubi gości. Zapukaj i czekaj.",
	["quest.witchCounsel.bark.half1"] = "Ten dzwonek nastroiłam ja. Czterdzieści lat temu. Nie pytaj.",
	["quest.witchCounsel.bark.near1"] = "Moczary. Oddychaj ustami, nosem nie warto.",
	["quest.witchCounsel.bark.done1"] = "Sabat ucichł aż tutaj. Ragna przysłała flakon. Wracaj.",
	["quest.witchCounsel.bark.death1"] = "Wstawaj. Na moczarach leżą tylko ci, którzy już nie wstaną.",
	["quest.witchCounsel.comp.join1"] = "Pójdę. Dzwonek trzeba umieć zdjąć, inaczej dzwoni dalej.",
	["quest.witchCounsel.comp.back1"] = "Jestem. Stare nogi, ale drogę na moczary pamiętają.",
	["quest.cryptGate.title"] = "Pieczęć na Bramie",
	["quest.cryptGate.p1"] = "Pod Bramą Krypty kult zawiesił pieczęć. Od tej pory widma wychodzą na urwiska, nawet w dzień.",
	["quest.cryptGate.p2"] = "Rozbij ją, a potem zejdź do Krypty i przerzedź jej wybrane widma. Flakon Ragny trzymaj blisko, przyda się później.",
	["quest.cryptGate.text"] = "Rozbij pieczęć kultu na Bramie Krypty i pokonaj wybrane widma Krypty Zapomnianych.",
	["quest.cryptGate.done"] = "Więc to on. Szary płaszcz, głos kapłana. Teraz wiemy, z kim walczymy.",
	["quest.cryptGate.say.ready"] = "Idę.",
	["quest.cryptGate.say.ready.reply"] = "Idź. Urwiska nie lubią tych, którzy się wahają.",
	["quest.cryptGate.say.seal"] = "Jak rozbić pieczęć?",
	["quest.cryptGate.say.seal.reply"] = "Stalą, kamieniem, czymkolwiek. Byle szybko, zanim widma się zbiegną.",
	["quest.cryptGate.say.supplies"] = "Dasz coś na drogę?",
	["quest.cryptGate.say.supplies.reply"] = "Dwie. Trzecia poszła na moje rany.",
	["quest.cryptGate.bark.accept1"] = "Brama jest na końcu traktu, w górze urwisk. Nie zbaczaj.",
	["quest.cryptGate.bark.half1"] = "Widma rzedną. Krypta to czuje.",
	["quest.cryptGate.bark.near1"] = "Ten znak… ten sam, co na Księżycowym Kamieniu.",
	["quest.cryptGate.bark.done1"] = "Wracaj. Nie stój pod tą bramą dłużej, niż musisz.",
	["quest.cryptGate.bark.death1"] = "Krypta zabiera ciepło. Wróć do ognia i spróbuj jeszcze raz.",
	["quest.morvane.p1"] = "Grobowiec Morvane leży za Kryptą. Tam ją złożyli i stamtąd wiąże umarłych dla Zimy.",
	["quest.morvane.p2"] = "Weź wywar Ragny. Kiedy królowa zachwieje się w walce, wypowiedz jej imię: Morvane z rodu Vael.",
	["quest.morvane.p3"] = "Nie zabijasz potwora. Oddajesz spokój królowej, która raz już uratowała północ.",
	["quest.morvane.bark.accept1"] = "Wywar Ragny masz przy sobie? Dobrze. Idź.",
	["quest.morvane.bark.done1"] = "Wróć do Vaelthornu. Chcę usłyszeć, jak odeszła.",
	["quest.queensLegacy.title"] = "Dziedzictwo królowej",
	["quest.queensLegacy.p1"] = "Ona w końcu śpi. A ty wracasz z jej pierścieniem i z gałęzią, którą dało ci Pradrzewo.",
	["quest.queensLegacy.p2"] = "Brat Anzelm powinien zobaczyć oba. Czyta kroniki rodów, o których wszyscy zapomnieli.",
	["quest.queensLegacy.p3"] = "Potem idź do Ysolde. Chciała z tobą mówić o czymś na wschodzie. Mnie nie powiedziała, o czym.",
	["quest.queensLegacy.text"] = "Zanieś pierścień królowej Morvane i gałąź z Pradrzewa Bratu Anzelmowi, a potem porozmawiaj z Alchemiczką Ysolde.",
	["quest.queensLegacy.done"] = "Cierń Vaela pękł na trzy części. Drzewce oddano lasowi, grot krasnoludom, przysięgę Straży. Drzewce masz w ręku. Ysolde mówi, że na wschodzie ognie płoną jaśniej. Jeśli kult szuka grotu, szuka go w ogniu.",
	["quest.queensLegacy.anzelm"] = "Pierścień rodu Vael. Ten herb otwiera ostatnią kartę kroniki, której nikt nie umiał przeczytać. Daj mi chwilę. I tę gałąź też.",
	["quest.queensLegacy.alchemist"] = "Na wschodzie ognie płoną jaśniej. Moi dostawcy ze wschodu nie wracają, a ci, którzy wrócili, mówią o krasnoludach, które kują dla obcych.",
	["quest.queensLegacy.say.rest"] = "Ona w końcu śpi.",
	["quest.queensLegacy.say.rest.reply"] = "Dzięki tobie. Tym razem kroniki zapamiętają jej imię.",
	["quest.queensLegacy.say.anzelm"] = "Czemu Anzelm?",
	["quest.queensLegacy.say.anzelm.reply"] = "Bo czyta kroniki rodów, których nikt już nie pamięta.",
	["quest.queensLegacy.say.east"] = "Co jest na wschodzie?",
	["quest.queensLegacy.say.east.reply"] = "Pustkowia i ogień. Ysolde powie więcej.",
	["quest.queensLegacy.bark.accept1"] = "Anzelm siedzi nad księgami w świątyni, jak zawsze.",
	["quest.queensLegacy.bark.half1"] = "Anzelm ma oba? Teraz Ysolde. Ona nie lubi czekać.",
	["quest.queensLegacy.bark.done1"] = "Wracaj do mnie. Chcę usłyszeć wszystko naraz.",
	["quest.item.riteBook"] = "Księga Obrzędów",
	["quest.item.boneChime"] = "Kościany dzwonek",
	["quest.item.queenRing"] = "Pierścień królowej Morvane",
	["quest.item.heartBranch"] = "Gałąź z serca Pradrzewa",
	["quest.use.moonRune"] = "Skuj runę",
	["quest.use.searchCamp"] = "Przeszukaj obóz",
	["quest.use.stainedGlass"] = "Przyjrzyj się witrażowi",
	["quest.use.examineCrypt"] = "Zbadaj kryptę",
	["quest.use.iceShard"] = "Wyrwij odłamek lodu",
	["quest.use.breakSeal"] = "Rozbij pieczęć",
	["place.manor"] = "Zrujnowany dwór na wzgórzu w Nawiedzonych Ruinach",
	["place.wayShrine"] = "Kapliczka na Mglistym Rozstaju",
	["place.cryptGate"] = "Brama Krypty na Krwawych Urwiskach",
	["place.lostCamp"] = "Obóz zaginionych w Niedźwiedzim Jarze",
	["place.moonGlade"] = "Księżycowa Polana",
	["place.chapel"] = "Kaplica z rozbitym witrażem",
	["place.elderTree"] = "Pradrzewo w kotlinie Serca Puszczy",
	["place.stiltVillage"] = "Wioska na palach",
	["npc.forester_radomir.name"] = "Leśniczy Radomir",
	["npc.forester_radomir.role"] = "Leśniczy",
	["npc.forester_radomir.greeting"] = "Las jest dziś głodny. Czuć to w powietrzu.",
	["npc.forester_radomir.line1"] = "Las to zwierzę. Kiedy jest ranny, gryzie wszystko, co podejdzie.",
	["npc.forester_radomir.line2"] = "Miłosz zawsze wstawał przed świtem. Teraz ja nie śpię za niego.",
	["npc.forester_radomir.line3"] = "Wilki nie zostawiają takich śladów same z siebie. Coś je pędziło.",
	["npc.forester_radomir.where"] = "w rozszarpanym obozie myśliwych w Wilczych Ostępach",
	["npc.ghost_oswin.name"] = "Duch Zarządcy Oswina",
	["npc.ghost_oswin.role"] = "Duch",
	["npc.ghost_oswin.greeting"] = "Dwór nie przyjmuje gości. Pani jest… nieobecna.",
	["npc.ghost_oswin.line1"] = "Pan Vael poluje dziś w Borze. Proszę zaczekać w sieni.",
	["npc.ghost_oswin.line2"] = "Srebro trzeba czyścić co tydzień. Ktoś zaniedbał srebro.",
	["npc.ghost_oswin.line3"] = "Krypta jest zamknięta dla obcych. Klucz trzymam ja. Trzymałem.",
	["npc.ghost_oswin.where"] = "przy kaplicy w Nawiedzonych Ruinach",
	["npc.defector_jorund.name"] = "Jorund Odstępca",
	["npc.defector_jorund.role"] = "Zbiegły kultysta",
	["npc.defector_jorund.greeting"] = "Ciszej. Mgła ma uszy.",
	["npc.defector_jorund.line1"] = "Nosiłem ich szatę dziesięć lat. Wstyd nosi się dłużej.",
	["npc.defector_jorund.line2"] = "Nie podchodź od strony drogi. Oni tamtędy chodzą.",
	["npc.defector_jorund.line3"] = "Kiedyś wierzyłem w to, co mówili. Wiara to dziwna rzecz.",
	["npc.defector_jorund.where"] = "przy kapliczce na Mglistym Rozstaju",
	["npc.witch_ragna.name"] = "Ragna z Palów",
	["npc.witch_ragna.role"] = "Pustelnica",
	["npc.witch_ragna.greeting"] = "Wiedźmy mieszkają na moczarach. Ja mieszkam na palach. Czego chcesz?",
	["npc.witch_ragna.line1"] = "Ryby za lekarstwa. Złoto za lekarstwa też, ale ryby lepiej pachną.",
	["npc.witch_ragna.line2"] = "Sabat przestał słuchać lasu. Słucha kogoś innego.",
	["npc.witch_ragna.line3"] = "Nie każda stara kobieta z ziołami to wiedźma. Niektóre są gorsze.",
	["npc.witch_ragna.where"] = "w opuszczonej wiosce na palach na Trollim Bagnie",
	["cutscene.ch2_title.title"] = "Mroczny Bór",
	["cutscene.ch2_title.l1"] = "Za Bramą Zmierzchu kończy się droga, którą znasz. Niebieskie latarnie wyznaczają granicę światła.",
	["cutscene.ch2_title.l2"] = "Dziesięć lat temu zniknął tu Brat Ilvar. Las pamięta każdego, kto przez niego przeszedł.",
	["cutscene.moonstone.l1"] = "Runa pęka z trzaskiem lodu. Odłamki szronu sypią się na trawę.",
	["cutscene.moonstone.l2"] = "Zimny błękit gaśnie, a kamień znów świeci srebrem, jak co noc od wieków.",
	["cutscene.moonstone.l3"] = "Słyszysz? Ucichły.",
	["cutscene.houseOfVael.l1"] = "Przez rozbite szkło wpada blade światło. Z witraża patrzy królowa z włócznią wbitą w smoka.",
	["cutscene.houseOfVael.l2"] = "To pani Morvane, ostatnia z rodu Vael.",
	["cutscene.houseOfVael.l3"] = "Włócznią zwaną Cierniem Vaela zraniła smoka. A potem kroniki o niej zapomniały.",
	["cutscene.elderHeart.l1"] = "Zimny błękit w szczelinie gaśnie. Odłamek lodu topnieje i spływa po korze.",
	["cutscene.elderHeart.l2"] = "Pradrzewo wzdycha jak ktoś, kto długo wstrzymywał oddech. Szczelina zaczyna świecić złotem.",
	["cutscene.elderHeart.l3"] = "Ze szczeliny wysuwa się gałąź, ciepła w dotyku. Cicho brzęczy, jak napięta struna.",
	["cutscene.cult.l1"] = "Smok na każdej pieczęci.",
	["cutscene.cult.l2"] = "Nie tylko go czczą. Chcą go obudzić.",
	["cutscene.cult.l3"] = "Znam tę rękę. Ilvar. On jest ich Głosem.",
	["cutscene.turncoat.l1"] = "Byłem głupcem, nie potworem.",
	["cutscene.turncoat.l2"] = "On mówi, że zima jest czysta. Że oczyści świat.",
	["cutscene.turncoat.l3"] = "Trzy pieczęcie. Pierwszą już ma.",
	["cutscene.barrow.l1"] = "Na kamiennym ołtarzu leży pusty całun, sztywny od szronu.",
	["cutscene.barrow.l2"] = "Fioletowy ogień kurczy się i gaśnie, jakby ktoś zdmuchnął świecę.",
	["cutscene.barrow.l3"] = "Ostatnia karta Księgi Obrzędów: „Krew Vael wstała. Krew Vael służy Zimie.”",
	["cutscene.cryptGate.l1"] = "Szron na bramie układa się w postać w szarym płaszczu.",
	["cutscene.cryptGate.l2"] = "Za późno. Królowa już śpiewa dla Zimy.",
	["cutscene.cryptGate.l3"] = "Kiedy zima cię zawoła, przyjdź na północ. Wszyscy w końcu przychodzą.",
	["cutscene.cryptGate.l4"] = "Postać rozsypuje się w szron, a pył osiada na kamieniach bramy.",
	["cutscene.morvane.l1"] = "Ktoś wypowiedział moje imię. Trzysta lat nikt go nie pamiętał.",
	["cutscene.morvane.l2"] = "Człowiek w szarym płaszczu zabrał mi imię i dał koronę z lodu.",
	["cutscene.morvane.l3"] = "Weź mój pierścień. Niech ci przypomni, czym był Cierń.",
	["cutscene.morvane.l4"] = "Teraz mogę spać.",
	["cutscene.queensLegacy.l1"] = "Anzelm kładzie gałąź obok pierścienia. Drewno zaczyna świecić ciepłym złotem.",
	["cutscene.queensLegacy.l2"] = "„Drzewce oddano lasowi, grot krasnoludom, przysięgę Straży.”",
	["cutscene.queensLegacy.l3"] = "To nie gałąź. To drzewce Ciernia Vaela.",
	["cutscene.queensLegacy.l4"] = "Na wschód, więc.",
	["cutscene.who.queen"] = "Morvane z rodu Vael",
	["story.chapter.2.end"] = "Koniec rozdziału II",
	["story.morvane.name"] = "Wypowiadasz jej imię: Morvane z rodu Vael. Królowa się waha.",
	-- S104: story chapter III "Cold Fire" (pages, new quests, NPCs of the Ashen Wastes, answers, comments, cutscenes)
	["quest.obj.collectFrom"] = "Zdobądź: {item} ({monster}) {count}",
	["quest.ashen.p1"] = "Kronika Anzelma mówi dalej. Druga pieczęć to Runa: Kajdany Zimy, które krasnoludy wykuły w Kuźni Głębin, za Spalonymi Pustkowiami.",
	["quest.ashen.p2"] = "Od miesiąca nie przyszła stamtąd żadna karawana, a nocą łuna na wschodzie jest jaśniejsza niż kiedykolwiek. Ysolde mówiła o ogniach, które płoną jaśniej.",
	["quest.ashen.p3"] = "Zwiadowczyni Kesra pilnuje Bramy z Żeber. Salamandry wychodzą z pęknięć dalej niż zwykle, coś rozgrzewa ziemię od spodu. Przerzedź je i zgłoś się do niej.",
	["quest.ashen.bark.accept1"] = "Brama z Żeber stoi zaraz za portalem. Czekam pod żebrami.",
	["quest.ashen.bark.half1"] = "Salamandry się chowają. Jeszcze kilka i ziemia przestanie syczeć.",
	["quest.ashen.bark.done1"] = "Wystarczy. Chodź do ognia, zanim upał cię zje.",
	["quest.deadOasis.title"] = "Martwa Oaza",
	["quest.deadOasis.p1"] = "Przyszedł nocą od strony oazy, sam, z poparzonymi rękami. Mówi, że jest runmistrzem z Kuźni Głębin i że jego karawanę wybiły hieny, kiedy woźnice już nie żyli.",
	["quest.deadOasis.p2"] = "Brokk chce tylko jednej rzeczy: żelaznej skrzyni z notatkami, która została na dnie wyschniętego jeziora.",
	["quest.deadOasis.p3"] = "Sępy krążą nad nią od trzech dni, hieny pilnują padliny. Brokk upiera się, że sam cię zaprowadzi.",
	["quest.deadOasis.text"] = "Idź z Brokkiem do szczątków jego karawany, odzyskaj skrzynię z dna Martwej Oazy i przerzedź hieny.",
	["quest.deadOasis.done"] = "Skrzynia cała, notatki suche. Kajdany Zimy wykuli moi przodkowie, żeby trzymały smoka we śnie. Ogień Azgora miał je tylko grzać, nigdy topić. Ktoś mu pozwolił. I ktoś mu za to płaci.",
	["quest.deadOasis.say.notes"] = "Co jest w skrzyni?",
	["quest.deadOasis.say.notes.reply"] = "Notatki z trzystu lat, tak mówi. Bez nich jest krasnoludem, który dużo pamięta i niczego nie udowodni.",
	["quest.deadOasis.say.hands"] = "Najpierw jego ręce.",
	["quest.deadOasis.say.hands.reply"] = "Mówi, że ręce poczekają, a skrzynia nie. Hieny już przy niej węszą.",
	["quest.deadOasis.say.count"] = "Ilu ich było?",
	["quest.deadOasis.say.count.reply"] = "Pytałam. Dziewięciu woźniców, siedem wozów, czternaście wołów. I on. Policzył to dwa razy.",
	["quest.deadOasis.bark.accept1"] = "Prowadzę. Trzymaj się drogi, popiół zasypuje doły.",
	["quest.deadOasis.bark.half1"] = "Pół roboty za nami. Hieny jeszcze krążą przy wozach.",
	["quest.deadOasis.bark.done1"] = "Skrzynia jest, notatki są. Teraz mogę się martwić porządnie.",
	["quest.deadOasis.bark.death1"] = "Wstań. Na dnie oazy leży już dość ludzi.",
	["quest.deadOasis.comp.join1"] = "Idę z tobą. Ręce mam spalone, nogi nie.",
	["quest.deadOasis.comp.wait1"] = "Kesra mówi, że liczę za dużo. A ja wiem, ile ma strzał w kołczanie: dwadzieścia trzy.",
	["quest.deadOasis.comp.wait2"] = "Kuźnia ma siedem bram, Brama z Żeber czternaście żeber. Policz, jak nie wierzysz.",
	["quest.deadOasis.comp.wait3"] = "Stoję. Liczę. Doszedłem do trzystu. Nie każ mi dojść do tysiąca.",
	["quest.deadOasis.comp.arrive1"] = "Woźniców było dziewięciu. Tu leży sześciu. Orkowie wzięli trzech żywcem.",
	["quest.deadOasis.comp.arrive2"] = "Sześciu z dziewięciu. Ślady okutych butów, ciężkie. Trzech wzięli żywcem.",
	["quest.deadOasis.comp.back1"] = "Wracam powiedzieć Kesrze. Ty weź skrzynię, ja tego nie zrobię.",
	["quest.warcampCages.title"] = "Klatki obozu",
	["quest.warcampCages.p1"] = "Na dnie oazy leżało sześciu z dziewięciu woźniców. Ślady okutych butów prowadzą na płaskowyż: trzech orkowie wzięli żywcem.",
	["quest.warcampCages.p1.count"] = "Mówiłem: dziewięciu. Na dnie leżało sześciu. Ślady okutych butów prowadzą na płaskowyż, więc trzech orkowie wzięli żywcem.",
	["quest.warcampCages.p2"] = "W obozie Popielnych Orków stoją klatki z kości i kłód. Jeśli jeńcy żyją, są tam.",
	["quest.warcampCages.p3"] = "Kesra kazała ci powtórzyć: orkowie nie biorą jeńców bez powodu, ktoś za nich płaci. Jej zwiadowcy widzieli w klatce orczycę w szamańskich amuletach.",
	["quest.warcampCages.text"] = "Otwórz klatki w obozie orków, rozbij strażników i porozmawiaj z uwolnioną szamanką przy Gorącym Źródle.",
	["quest.warcampCages.done"] = "Woźnice są w obozie, cali. Ghasha nie wróci do swoich. Mówi, że wódz bierze od szarych ludzi złoto i topory z zimnego żelaza, a ona ich złota nie chciała, więc trafiła do klatki. Zimne żelazo nie rośnie na pustyni.",
	["quest.warcampCages.ghasha"] = "Szarzy ludzie dali wodzowi złoto, które nie grzeje w dłoni. I topory, które nie stygną, tylko mrożą. Kto bierze ich złoto, ten już nie jest z klanu.",
	["quest.warcampCages.say.gate"] = "Wejdę bramą.",
	["quest.warcampCages.say.gate.reply"] = "Głośno. Za to Kesra będzie wiedziała, gdzie cię szukać.",
	["quest.warcampCages.say.cages"] = "Najpierw klatki.",
	["quest.warcampCages.say.cages.reply"] = "Po zachodniej stronie obozu, przy płocie z kości.",
	["quest.warcampCages.say.why"] = "Po co orkom jeńcy?",
	["quest.warcampCages.say.why.reply"] = "Jeńcy to towar. Dowiedz się, kto kupuje.",
	["quest.warcampCages.bark.accept1"] = "Trzech żywych. Wróć z trzema.",
	["quest.warcampCages.bark.half1"] = "Klatka otwarta. Zostali strażnicy.",
	["quest.warcampCages.bark.near1"] = "Kraty z kości. Podważ zawias, nie zamek.",
	["quest.warcampCages.bark.done1"] = "Kesra pisze, że są cali. Trzech. Liczba się zgadza.",
	["quest.warcampCages.bark.stuck1"] = "Ghasha czeka przy Gorącym Źródle. Ona do ciebie nie przyjdzie.",
	["quest.orcs.p1"] = "Bęben wojenny bije co noc. Wódz zbiera klany, a skoro płaci mu kult, nie będziemy czekać, aż ruszą.",
	["quest.orcs.p2"] = "Kowale w naszym obozie potrzebują srebra na groty. Żyły srebra znajdziesz w skałach przy szlakach.",
	["quest.orcs.bark.accept1"] = "Obóz jest na płaskowyżu. Srebro w skałach przy szlakach.",
	["quest.orcs.bark.half1"] = "Bęben bije rzadziej. Ktoś tam liczy straty.",
	["quest.orcs.bark.done1"] = "Bęben ucichł. Na razie.",
	["quest.mineDepths.title"] = "Zimne żelazo",
	["quest.mineDepths.p1"] = "Orkowie wożą coś nocą do Opuszczonej Kopalni pod płaskowyżem i wracają z pustymi wozami.",
	["quest.mineDepths.p2"] = "Brokk mówi, że zimne żelazo poznasz po szronie na zawiasach skrzyń. Zejdź do szybów. Przodownicy, najsilniejsi z orków, noszą przy sobie spisy.",
	["quest.mineDepths.p3"] = "Uważaj w szybach. Orkowie znają je lepiej niż ty, a w ciemności każdy krok brzmi jak cudzy.",
	["quest.mineDepths.text"] = "Zejdź do Opuszczonej Kopalni, pokonaj przodowników orków i zdobądź spis dostaw.",
	["quest.mineDepths.done"] = "Spis mówi wprost: zimne żelazo idzie szybem w głąb, do Kuźni Głębin, a stamtąd na północ, do przełęczy. Ktoś kuje broń w Kuźni i wysyła ją w góry.",
	["quest.mineDepths.say.frost"] = "Brokk mówił o szronie.",
	["quest.mineDepths.say.frost.reply"] = "Zimne żelazo poci się szronem nawet w piecu, tak mówi. Białych zawiasów nie dotykaj gołą ręką.",
	["quest.mineDepths.say.dark"] = "W szybach jest ciemno.",
	["quest.mineDepths.say.dark.reply"] = "Orkowie widzą w ciemności. Ty masz pochodnię i złe przeczucie. Prawie remis.",
	["quest.mineDepths.say.quick"] = "Wejdę i wyjdę.",
	["quest.mineDepths.say.quick.reply"] = "Tak mówił każdy, kto tam został.",
	["quest.mineDepths.bark.accept1"] = "Szyb jest za obozem orków, u stóp płaskowyżu.",
	["quest.mineDepths.bark.half1"] = "Masz przodownika? Spis noszą przy pasie.",
	["quest.mineDepths.bark.done1"] = "Spis mówi więcej niż jeniec. I nie kłamie ze strachu.",
	["quest.mineDepths.bark.death1"] = "Szyby nie wybaczają. Odpocznij i wracaj.",
	["quest.emberCores.title"] = "Żarzące rdzenie",
	["quest.emberCores.p1"] = "Brokk mówi, że jego runy zgasły w drodze. Żeby je rozgrzać, potrzebuje ognia, który nie gaśnie, a taki noszą w piersiach ogniste golemy.",
	["quest.emberCores.p2"] = "Cztery rdzenie wystarczą. Golemy chodzą po Polach Golemów, wokół krateru.",
	["quest.emberCores.p3"] = "Zanim wrócisz, przyłóż jedną z jego run do oczu Śpiącego Kolosa. Brokk chce wiedzieć, czy to ten sam ogień.",
	["quest.emberCores.p3.notes"] = "Brokk prosi, żeby zapisać w jego notatkach, co zobaczysz. Strona dwieście czternasta jest wolna. Przyłóż runę do oczu Śpiącego Kolosa, on chce wiedzieć, czy to ten sam ogień.",
	["quest.emberCores.text"] = "Zdobądź cztery żarzące rdzenie z golemów, sprawdź runą oczy Śpiącego Kolosa i porozmawiaj z Brokkiem.",
	["quest.emberCores.done"] = "Na czerwono, nie na niebiesko? Brokk zbladł, kiedy to usłyszał. To ogień Azgora. Golemy na Polach są jego, a sam Azgor już nie siedzi w kajdanach.",
	["quest.emberCores.brokk"] = "Czerwień. Nie błękit. To jego ogień, a skoro golemy noszą go w piersiach, Azgor już nie siedzi w kajdanach.",
	["quest.emberCores.say.how"] = "Jak wyjąć rdzeń z golema?",
	["quest.emberCores.say.how.reply"] = "Brokk mówi: ostrożnie. I dopiero wtedy, kiedy przestanie się ruszać.",
	["quest.emberCores.say.colossus"] = "Najpierw Kolos.",
	["quest.emberCores.say.colossus.reply"] = "Dobrze. Brokk woli wiedzieć wcześniej niż później. Ja też.",
	["quest.emberCores.say.why"] = "Po co mu ogień, który nie gaśnie?",
	["quest.emberCores.say.why.reply"] = "Mówi, że runy zasypiają jak ludzie. Trzeba je obudzić, zanim zapomną, czym są.",
	["quest.emberCores.bark.accept1"] = "Cztery rdzenie. Nie pięć. Pięć to już chciwość.",
	["quest.emberCores.bark.half1"] = "Połowa roboty. Golemy też to zauważyły.",
	["quest.emberCores.bark.near1"] = "Przyłóż runę do oka. Nie do czoła. Do oka.",
	["quest.emberCores.bark.done1"] = "Czerwień, nie błękit. On jest wolny.",
	["quest.golems.p1"] = "Skoro golemy należą do Azgora, Pola są jego strażą. Droga do Kuźni prowadzi przez nie i przez skorpiony przy szlaku.",
	["quest.golems.p2"] = "Oczyść przejście, zanim wyślemy kogokolwiek pod Górę Kuźni.",
	["quest.golems.bark.accept1"] = "Golemy na Polach, skorpiony przy szlaku. Nie stój w lawie.",
	["quest.golems.bark.half1"] = "Połowa przejścia czysta. Golemy nie czują strachu, ty czuj.",
	["quest.golems.bark.done1"] = "Droga do Kuźni wolna. Wracaj.",
	["quest.burntTemple.title"] = "Dzwon za zmarłych",
	["quest.burntTemple.p1"] = "Na południu, za Ognistą Żyłą, było miasteczko. Teraz są tam tylko kominy i świątynia bez kopuły. Ktoś tam nadal pali świece.",
	["quest.burntTemple.p2"] = "To pustelnik, Brat Kaspar. Chcę wiedzieć, co widział, bo nikt z miasteczka nie uciekł na zachód.",
	["quest.burntTemple.p3"] = "Chochliki gnieżdżą się w zgliszczach. Kaspar nie wychodzi poza próg świątyni.",
	["quest.burntTemple.text"] = "Odszukaj Brata Kaspara w Spalonych Ruinach, przegoń chochliki i uderz w dzwon za zmarłych.",
	["quest.burntTemple.done"] = "Słyszałam dzwon aż tutaj. Kaspar mówi, że płomień spadł z nieba w jedną noc, a rano tych, którzy przeżyli, wyprowadzono łańcuchem na wschód, ku Kuźni. Prowadził ich człowiek w szarym płaszczu, przed którym ogień schodził z drogi. Ten sam człowiek co w rozkazach bandytów.",
	["quest.burntTemple.kaspar"] = "Widziałem go. Szary płaszcz, ręce puste. Szedł przez płomienie jak przez deszcz, a one się przed nim rozstępowały. Uderz w dzwon, jeśli możesz. Zmarli powinni wiedzieć, że ktoś ich jeszcze liczy.",
	["quest.burntTemple.say.empty"] = "Pójdę z pustymi rękami.",
	["quest.burntTemple.say.empty.reply"] = "Mądrze. Kto przeżył pożar, nie lubi ludzi z pochodnią.",
	["quest.burntTemple.say.way"] = "Jak tam dojść?",
	["quest.burntTemple.say.way.reply"] = "Mostem nad Ognistą Żyłą, potem prosto do placu. Świątynia stoi za fontanną.",
	["quest.burntTemple.say.candles"] = "Kto mu daje świece?",
	["quest.burntTemple.say.candles.reply"] = "Nikt. Zbiera ogarki po domach. Domów jest dużo.",
	["quest.burntTemple.bark.accept1"] = "Mów do niego cicho.",
	["quest.burntTemple.bark.half1"] = "Chochliki się rozpierzchły. Nie goń ich po piwnicach.",
	["quest.burntTemple.bark.near1"] = "Dzwon leży u stóp wieży.",
	["quest.burntTemple.bark.done1"] = "Słychać go aż tutaj.",
	["quest.wyvernLair.title"] = "Podniebny szlak",
	["quest.wyvernLair.p1"] = "Wywerny z Turni latają teraz nocą, na północ, i wracają bez ciężaru.",
	["quest.wyvernLair.p2"] = "W Leżu Wywerny najsilniejsze z nich noszą uprzęże. Zdejmij dwie i przynieś.",
	["quest.wyvernLair.p3"] = "Jeśli kult tresuje wywerny, to broń z Kuźni nie idzie drogą.",
	["quest.wyvernLair.text"] = "Zejdź do Leża Wywerny, pokonaj najsilniejsze wywerny i zdobądź dwie uprzęże kultu.",
	["quest.wyvernLair.done"] = "Na uprzężach jest płatek śniegu przebity cierniem, ten sam znak co na Łąkach i w Borze. Wywerny niosą broń z Kuźni na Lodowe Szczyty. To podniebny szlak kultu.",
	["quest.wyvernLair.say.dead"] = "Uprzęże zdejmę z martwych.",
	["quest.wyvernLair.say.dead.reply"] = "Z żywych byłoby trudniej.",
	["quest.wyvernLair.say.heat"] = "Leże jest gorące?",
	["quest.wyvernLair.say.heat.reply"] = "Jak piec. Weź to, Ysolde przysłała kilka na takie miejsca.",
	["quest.wyvernLair.say.north"] = "Dokąd latają?",
	["quest.wyvernLair.say.north.reply"] = "Na północ. To chcę wiedzieć dokładniej.",
	["quest.wyvernLair.bark.accept1"] = "Leże jest w płaskowyżu za Kamienną Wywerną.",
	["quest.wyvernLair.bark.half1"] = "Połowa za tobą. Wywerny w leżu już wiedzą, po co tu jesteś.",
	["quest.wyvernLair.bark.done1"] = "Płatek śniegu przebity cierniem. Znowu.",
	["quest.ashRoad.title"] = "Skamieniała karawana",
	["quest.ashRoad.p1"] = "Na Szlaku Popiołu stoi karawana zamieniona w kamień: wóz, woły, ludzie. Bazyliszki pilnują jej jak swojej.",
	["quest.ashRoad.p2"] = "Krasnoludzcy renegaci jeździli tym szlakiem. Ktoś mógł zostawić przy wozie coś, czego nie zdążył dostarczyć.",
	["quest.ashRoad.p3"] = "Przeszukaj wóz i przerzedź bazyliszki.",
	["quest.ashRoad.text"] = "Przeszukaj skamieniały wóz na Szlaku Popiołu i przerzedź bazyliszki.",
	["quest.ashRoad.done"] = "List do przywódcy renegatów. „Smoczy skarb za stopienie Kajdan. Nie gaście Azgora, dopóki ostatnie ogniwo nie spłynie.” Podpis: Głos Zimy. Anzelm wymawiał to imię szeptem.",
	["quest.ashRoad.say.what"] = "Czego szukam?",
	["quest.ashRoad.say.what.reply"] = "Czegoś, co nie jest z kamienia.",
	["quest.ashRoad.say.stone"] = "To bazyliszki ich skamieniły?",
	["quest.ashRoad.say.stone.reply"] = "Nie. Bazyliszki tylko się wprowadziły.",
	["quest.ashRoad.say.hunt"] = "Najpierw bazyliszki.",
	["quest.ashRoad.say.hunt.reply"] = "Rozsądnie. Nie lubią, kiedy ktoś grzebie w ich wozie.",
	["quest.ashRoad.bark.accept1"] = "Wóz stoi na Szlaku Popiołu, przy kamiennych królach.",
	["quest.ashRoad.bark.half1"] = "Bazyliszki rzedną. Nie patrz im w oczy dłużej, niż musisz.",
	["quest.ashRoad.bark.stuck1"] = "Wóz stoi przy drodze za aleją królów.",
	["quest.ashRoad.bark.done1"] = "Głos Zimy. Anzelm wymawiał to imię szeptem.",
	["quest.deepforge.p1"] = "Brama w Górze Kuźni stoi otwarta. Renegaci kują w środku broń ze znakiem smoczego pazura, a skrzynie czekają na wysyłkę na północ.",
	["quest.deepforge.p2"] = "Brokk zna drogę: przez Wielką Kuźnię do Serca, gdzie leżą Kajdany.",
	["quest.deepforge.p3"] = "Zacznij od tych, którzy pilnują kowadeł.",
	["quest.deepforge.bark.accept1"] = "Brama Kuźni stoi otwarta. Nie wchodź tam z pustymi bukłakami.",
	["quest.deepforge.bark.half1"] = "Kowadła cichną jedno po drugim.",
	["quest.deepforge.bark.done1"] = "Wystarczy. Wyjdź, zanim zauważą, kogo brakuje.",
	["quest.runesOfBinding.title"] = "Runy wiązania",
	["quest.runesOfBinding.p1"] = "Z Serca Kuźni przyszła wieść, której Brokk się bał: Kajdany Zimy są w połowie stopione. Przy nich leży grot włóczni, którego ogień nie ruszył.",
	["quest.runesOfBinding.p2"] = "Brokk mówi, że to grot Ciernia Vaela, oddany krasnoludom na przechowanie. Gołymi rękami nikt go nie wyniesie: trzeba oprawy z mithrilu i run.",
	["quest.runesOfBinding.p3"] = "Przynieś mithril i pokonaj magmowe golemy, które pilnują Serca. Brokk czeka przy Bramie z Żeber.",
	["quest.runesOfBinding.text"] = "Zbierz pięć żył mithrilu, pokonaj cztery elitarne magmowe golemy w Kuźni i wróć do Brokka.",
	["quest.runesOfBinding.done"] = "Oprawa gotowa. Spójrz, runy na grocie zapalają się błękitem. Kajdany nie wytrzymają długo. Ale grot jest nasz.",
	["quest.runesOfBinding.done.why"] = "Mówiłem, że runy trzeba obudzić. Patrz, zapalają się błękitem. Kajdany nie wytrzymają długo. Ale grot jest nasz.",
	["quest.runesOfBinding.brokk"] = "Mithril jest dobry. Daj, wykuję oprawę. Ręce jeszcze bolą, ale młot pamięta.",
	["quest.runesOfBinding.say.where"] = "Gdzie szukać mithrilu?",
	["quest.runesOfBinding.say.where.reply"] = "Brokk mówi: błękitna żyła w czarnej skale. Jak nie zobaczysz, zapytaj jeszcze raz.",
	["quest.runesOfBinding.say.spear"] = "Czyj to grot?",
	["quest.runesOfBinding.say.spear.reply"] = "Vaela. Krasnoludy przechowały go trzysta lat i omal nie zgubiły w jedną zimę.",
	["quest.runesOfBinding.say.who"] = "Kto jeszcze umie kuć takie runy?",
	["quest.runesOfBinding.say.who.reply"] = "Brokk mówi, że umiało czterech. Trzech kuje teraz dla smoka.",
	["quest.runesOfBinding.bark.accept1"] = "Pięć żył. Ani grama mniej.",
	["quest.runesOfBinding.bark.half1"] = "Mithril i golemy. Kolejność dowolna, wynik ten sam.",
	["quest.runesOfBinding.bark.done1"] = "Runy go poznały. Teraz nic go nie stopi.",
	["quest.forgeChains.title"] = "Skuci w Kuźni",
	["quest.forgeChains.p1"] = "W Hucie i w Zbrojowni pracują ludzie ze spalonego miasteczka i ci z moich braci, którzy nie przeszli do renegatów. Są przykuci do słupów przy paleniskach.",
	["quest.forgeChains.p1.gate"] = "Tym razem bez bramy. W Kuźni echo niesie się aż do Azgora. W Hucie i w Zbrojowni pracują przykuci do słupów ludzie ze spalonego miasteczka i moi wierni bracia.",
	["quest.forgeChains.p2"] = "Zanim staniesz przed Azgorem, rozkuj ich. Trzy słupy, trzy klucze z run. Kowale płomienia nie pozwolą ci na to po dobroci.",
	["quest.forgeChains.p3"] = "Renegaci nie są tam sami. W głębi Kuźni nie ma prawa: uważaj na każdego, kto nosi broń, nie tylko na kowali.",
	["quest.forgeChains.text"] = "Rozkuj jeńców w Hucie, w Zbrojowni i przy Sercu Kuźni oraz pokonaj dziesięciu kowali płomienia.",
	["quest.forgeChains.done"] = "Jeńcy doszli do obozu. Jeden z ludzi niósł mały dzwonek z kaplicy miasteczka i oddał go Brokkowi dla Kaspara. Teraz został tylko Azgor.",
	["quest.forgeChains.say.alone"] = "Pójdę bez ciebie.",
	["quest.forgeChains.say.alone.reply"] = "Nie pójdziesz. Klucze z run słuchają ręki, która je kuła.",
	["quest.forgeChains.say.smiths"] = "Najpierw kowale.",
	["quest.forgeChains.say.smiths.reply"] = "Dobrze. Jeńcy czekali miesiąc, poczekają jeszcze chwilę.",
	["quest.forgeChains.say.keys"] = "Pokaż klucze.",
	["quest.forgeChains.say.keys.reply"] = "Trzy runy, trzy słupy. Każda zna swój.",
	["quest.forgeChains.bark.accept1"] = "Spotkamy się w pierwszej sali Kuźni. Klucze mam przy sobie.",
	["quest.forgeChains.bark.half1"] = "Połowa roboty. Kowale już wiedzą, że tu jesteśmy.",
	["quest.forgeChains.bark.near1"] = "Mój dziad lał w tej Kuźni stal na zawiasy Kajdan.",
	["quest.forgeChains.bark.near2"] = "Czterysta dwanaście toporów ze znakiem pazura. Policzyłem dwa razy, za drugim wolniej.",
	["quest.forgeChains.bark.near3"] = "Siedem pokoleń kucia. Pół nocy, żeby to stopić.",
	["quest.forgeChains.bark.death1"] = "Wstawaj. Kowale nie czekają. Ja tak.",
	["quest.forgeChains.bark.done1"] = "Wszyscy wolni. Został tylko on.",
	["quest.forgeChains.comp.join1"] = "Klucze słuchają ręki, która je kuła. Prowadź, będę za tobą.",
	["quest.forgeChains.comp.wait1"] = "Czekam. Kowale płomienia nie.",
	["quest.forgeChains.comp.back1"] = "Wyprowadzę ich. Ty skończ z kowalami.",
	["quest.azgor.p1"] = "Przed bramą Paleniska Kajdany grzeją się dalej. Dopóki Azgor płonie, stop się nie zatrzyma.",
	["quest.azgor.p2"] = "Brokk mówi, że Azgor nie jest zły tak jak smok. To ogień, któremu ktoś otworzył klatkę i obiecał świat do spalenia.",
	["quest.azgor.p3"] = "Zgaś go.",
	["quest.azgor.bark.accept1"] = "Palenisko jest za Sercem Kuźni. Wróć do nas żywy, chwała poczeka.",
	["quest.azgor.bark.done1"] = "Azgor zgasł? Wracaj do miasta. Muszę to usłyszeć od ciebie.",
	["quest.coldFire.title"] = "Zimny ogień",
	["quest.coldFire.p1"] = "Azgor zgasł, ale Kajdany są już stopione. Druga pieczęć pękła, zanim ktokolwiek zdążył.",
	["quest.coldFire.p2"] = "Grot Ciernia jest jednak nasz. Zanieś go Dorganowi: Anzelm przyniósł mu już gałąź z Pradrzewa.",
	["quest.coldFire.p3"] = "Potem idź do Anzelma. Kronika ma jeszcze jedną kartę.",
	["quest.coldFire.p3.empty"] = "Kesra pisze o pustych rękach u pustelnika. Anzelm też tak przychodzi. Idź do niego, kiedy Dorgan skończy: kronika ma jeszcze jedną kartę.",
	["quest.coldFire.p4"] = "Północny wiatr niesie śnieg w środku lata. Na Lodowych Szczytach czeka Zwiadowca Halvar.",
	["quest.coldFire.text"] = "Zanieś Grot Ciernia Kowalowi Dorganowi i porozmawiaj z Bratem Anzelmem.",
	["quest.coldFire.done"] = "Dorgan osadził grot na drzewcu. Cierń jest prawie cały. Anzelm mówi, że brakuje tylko przysięgi Straży, a Zakon Lodowej Straży zamarzł na posterunku. Ruszaj na Szczyty, kiedy przyjdzie pora.",
	["quest.coldFire.blacksmith"] = "Grot Ciernia? Daj. Gałąź z Pradrzewa czeka u mnie od tygodnia, jakby wiedziała, że przyjdziesz.",
	["quest.coldFire.anzelm"] = "Ostatnia karta kroniki mówi o przysiędze Straży. Zakon Lodowej Straży trzymał ją na Szczytach. Od zimy nikt stamtąd nie wrócił.",
	["quest.coldFire.say.dorgan"] = "Najpierw Dorgan.",
	["quest.coldFire.say.dorgan.reply"] = "Jest w kuźni. Zawsze jest w kuźni.",
	["quest.coldFire.say.anzelm"] = "Najpierw Anzelm.",
	["quest.coldFire.say.anzelm.reply"] = "Jak wolisz. I tak powie, że wiedział.",
	["quest.coldFire.say.tired"] = "Pustkowia mnie wypaliły.",
	["quest.coldFire.say.tired.reply"] = "Wszystkich wypalają. Potem przychodzi zima i przestaje się to czuć.",
	["quest.coldFire.bark.accept1"] = "Dorgan jest w kuźni, Anzelm w świątyni. Kolejność twoja.",
	["quest.coldFire.bark.half1"] = "Jedno za tobą. Drugie czeka w mieście.",
	["quest.coldFire.bark.done1"] = "Odpocznij. Na Szczytach odpoczynku nie będzie.",
	["quest.item.supplyLedger"] = "Spis dostaw",
	["quest.item.emberCore"] = "Żarzący rdzeń",
	["quest.item.cultHarness"] = "Uprząż kultu",
	["quest.item.spearhead"] = "Grot Ciernia",
	["quest.use.chest"] = "Otwórz skrzynię",
	["quest.use.cage"] = "Otwórz klatkę",
	["quest.use.eyes"] = "Przyłóż runę do żaru",
	["quest.use.bell"] = "Uderz w dzwon",
	["quest.use.stoneWagon"] = "Przeszukaj skamieniały wóz",
	["quest.use.shackles"] = "Rozkuj kajdany",
	["place.caravanRemains"] = "Szczątki karawany w Martwej Oazie",
	["place.orcCages"] = "Klatki jeńców w obozie orków",
	["place.kasparThreshold"] = "Próg Brata Kaspara",
	["place.mithrilVein"] = "Żyła mithrilu na Polach Golemów",
	["npc.runesmith_brokk.name"] = "Runmistrz Brokk",
	["npc.runesmith_brokk.role"] = "Runmistrz",
	["npc.runesmith_brokk.greeting"] = "Runy nie kłamią. Ludzie tak. Czego chcesz?",
	["npc.runesmith_brokk.line1"] = "Kuźnia Głębin miała siedem bram i ani jednego zamka. Nikt nie kradł od krasnoludów.",
	["npc.runesmith_brokk.line2"] = "Kajdany kuło siedem pokoleń. Każde ogniwo ma imię kowala.",
	["npc.runesmith_brokk.line3"] = "Ogień nie jest zły. Ogień ma pana. Gorzej, kiedy pan się zmienia.",
	["npc.runesmith_brokk.where"] = "przy Bramie z Żeber, obok Kesry",
	["npc.shaman_ghasha.name"] = "Szamanka Ghasha",
	["npc.shaman_ghasha.role"] = "Szamanka orków",
	["npc.shaman_ghasha.greeting"] = "Twój zapach jest z klatki. Mój też. Siadaj przy wodzie.",
	["npc.shaman_ghasha.line1"] = "Złoto szarych ludzi nie grzeje w dłoni. Kto je bierze, ten już nie jest z klanu.",
	["npc.shaman_ghasha.line2"] = "W parze źródła mieszkają przodkowie. Mówią mało, ale nie kłamią.",
	["npc.shaman_ghasha.line3"] = "Młodzi z klanu słuchają bębna, nie starszych. A bęben bije za złoto.",
	["npc.shaman_ghasha.where"] = "przy Gorącym Źródle",
	["npc.hermit_kaspar.name"] = "Brat Kaspar",
	["npc.hermit_kaspar.role"] = "Pustelnik",
	["npc.hermit_kaspar.greeting"] = "Otrzep popiół z butów, zanim wejdziesz. Tu leżą ludzie.",
	["npc.hermit_kaspar.line1"] = "Dzwon pękł tej nocy, kiedy spadł ogień. Od tamtej pory nikt w niego nie uderzył.",
	["npc.hermit_kaspar.line2"] = "Widziałem go. Szary płaszcz, ręce puste. Szedł przez płomienie jak przez deszcz, a one się przed nim rozstępowały.",
	["npc.hermit_kaspar.line3"] = "Znam imiona wszystkich, którzy tu mieszkali. Mówię je co wieczór, żeby nie zginęły drugi raz.",
	["npc.hermit_kaspar.where"] = "przed spaloną świątynią w Spalonych Ruinach",
	["cutscene.ch3_title.title"] = "Spalone Pustkowia",
	["cutscene.ch3_title.l1"] = "Za Bramą z Żeber kończy się trawa. Popiół leży tu od czasów, których nikt nie pamięta.",
	["cutscene.ch3_title.l2"] = "Na wschodzie łuna nie gaśnie nawet w południe. Ktoś karmi ogień, który miał spać.",
	["cutscene.ch3_cages.l1"] = "Otwierasz klatkę obcej. Dlaczego?",
	["cutscene.ch3_cages.l2"] = "Bęben ucichł. Na chwilę. Nie stój tu, kiedy zacznie znowu.",
	["cutscene.ch3_cages.l3"] = "Bęben wojenny milknie, a potem znów zaczyna bić.",
	["cutscene.ch3_bell.l1"] = "Pierwszy raz od tamtej nocy.",
	["cutscene.ch3_bell.l2"] = "Słyszycie? Ktoś jeszcze was liczy.",
	["cutscene.ch3_bell.l3"] = "Z dzwonnicy przestaje się sączyć dym.",
	["cutscene.ch3_wyvern.l1"] = "Tam. Leci na północ, nisko, z ciężarem.",
	["cutscene.ch3_wyvern.l2"] = "Szlak przez niebo. Nie zatrzymamy go mieczem.",
	["cutscene.ch3_forge.title"] = "Kuźnia Głębin",
	["cutscene.ch3_forge.subtitle"] = "Tu kuto Kajdany Zimy",
	["cutscene.ch3_forge.l1"] = "Kamienni królowie wciąż trzymają młoty. Ktoś skuł im twarze i wyrył w ich miejscu płomień.",
	["cutscene.ch3_runes.l1"] = "Spójrz. Runy go poznały.",
	["cutscene.ch3_runes.l2"] = "Trzysta lat przeleżał przy kajdanach i nie stopniał. Teraz pójdzie tam, gdzie go potrzeba.",
	["cutscene.ch3_runes.l3"] = "Runy na grocie zapalają się błękitem.",
	["cutscene.ch3_freed.l1"] = "Myśleliśmy, że nikt nie przyjdzie.",
	["cutscene.ch3_freed.l2"] = "Mam dzwonek z naszej kaplicy. Brat Kaspar powinien go dostać.",
	["cutscene.ch3_azgor.l1"] = "Palenisko gaśnie. Fosa lawy czernieje i stygnie.",
	["cutscene.ch3_azgor.l2"] = "Zimny… zapłacił… za mój ogień…",
	["cutscene.ch3_end.l1"] = "Krasnoludzka robota. Trzyma się drzewca, jakby na nie czekała.",
	["cutscene.ch3_end.l2"] = "Brakuje tylko przysięgi. Straż jej udzieli albo nikt.",
	["cutscene.ch3_end.l3"] = "Północ czeka.",
	["cutscene.who.freedSmith"] = "Uwolniony kowal",
	["cutscene.who.freedVillager"] = "Uwolniony mieszczanin",
	["story.chapter.3.end"] = "Koniec rozdziału III",
	-- S105: story chapter IV "The Long Winter" and the finale "The First Spring" (docs/FABULA.md §2.5)
	["story.chapter.5"] = "Finał: Pierwsza Wiosna",
	["quest.frostpeak.p1"] = "Dorgan osadził grot na drzewcu z Pradrzewa. Cierń wygląda jak broń, ale jeszcze nią nie jest: brakuje mu przysięgi Straży.",
	["quest.frostpeak.p2"] = "Halvar pisze z północy, że przełęcze zajęły wilki i yeti, a nocami z gór niesie się ryk, od którego milkną psy w wioskach.",
	["quest.frostpeak.p3"] = "Zakon Lodowej Straży strzegł tych gór, zanim zamarzł na posterunku. Jeśli ktoś jeszcze pamięta jego przysięgę, to tam. Wejdź na Lodowe Szczyty i oczyść przełęcze.",
	["quest.frostpeak.bark.accept1"] = "Weź ciepły płaszcz. Na Szczytach lato kończy się przy pierwszym kopcu.",
	["quest.frostpeak.bark.half1"] = "Halvar pisze, że wilki się cofają. Yeti jeszcze nie.",
	["quest.frostpeak.bark.done1"] = "Przełęcze wolne. Teraz słychać tylko wiatr. I ten ryk.",
	["quest.trappersCamp.title"] = "Opuszczony obóz",
	["quest.trappersCamp.p1"] = "Jesienią drużyna traperów miała zejść z gór przed zamieciami. Nie zeszła. Nikt nie przyniósł ani skór, ani wieści.",
	["quest.trappersCamp.p2"] = "Ich przewodniczka, Sigrun, wróciła sama po ich ślad. Siedzi w opuszczonym obozie w dolinie i nie chce zejść do ludzi.",
	["quest.trappersCamp.p3"] = "Lamparty krążą wokół obozu od tygodnia. Idź do niej, zanim zrobią to, na co czekają. Obóz stoi w dolinie za kopcem z rogami.",
	["quest.trappersCamp.text"] = "Znajdź Sigrun w opuszczonym obozie traperów w Dolinie Lodowych Wilków i przerzedź lamparty, które go oblegają.",
	["quest.trappersCamp.done"] = "Mój brat Arne poprowadził drużynę starą ścieżką do Lodowej Groty. Dziewięć dni temu. Mówił, że wrócą przed pełnią. Pełnia była trzy noce temu.",
	["quest.trappersCamp.sigrun"] = "Nie stój tak. Lamparty patrzą na ciebie dłużej niż ja.",
	["quest.trappersCamp.say.where"] = "Gdzie jest ten obóz?",
	["quest.trappersCamp.say.where.reply"] = "W dolinie, za kopcem z rogami. Zaznaczę ci go.",
	["quest.trappersCamp.say.sigrun"] = "Kim jest Sigrun?",
	["quest.trappersCamp.say.sigrun.reply"] = "Przewodniczką. Spluwa przez lewe ramię przed każdym mostem. Jeszcze nikogo nie zgubiła.",
	["quest.trappersCamp.say.alone"] = "Wróciła sama? Odważna.",
	["quest.trappersCamp.say.alone.reply"] = "Albo uparta. W górach to jedno i to samo.",
	["quest.trappersCamp.bark.accept1"] = "Lamparty krążą od tygodnia. Nie chodź tam po zmroku.",
	["quest.trappersCamp.bark.half1"] = "Lamparty zaczynają cię omijać. Dobrze.",
	["quest.trappersCamp.bark.near1"] = "Stań na progu. Do pustego obozu nie wchodzi się bez słowa.",
	["quest.trappersCamp.bark.done1"] = "Przyszedłeś. Siadaj przy ognisku, choć zgasło dawno.",
	["quest.trappersCamp.bark.death1"] = "Lamparty polują nisko, przy samym śniegu. Patrz pod nogi.",
	["quest.iceGrotto.title"] = "Lód, który śpiewa",
	["quest.iceGrotto.p1"] = "Arne prowadził ich starą ścieżką zakonu, wyżej, niż chodzą traperzy. Dziennik nosił zawsze przy sobie i pisał w nim co wieczór.",
	["quest.iceGrotto.p1.sigrun"] = "Halvar mówił ci o moich przesądach. Dobrze. Nie muszę tłumaczyć, czemu zostawiam chleb na progu. Arne prowadził ich starą ścieżką zakonu. Dziennik nosił przy sobie.",
	["quest.iceGrotto.p2"] = "Ścieżka kończy się w Lodowej Grocie. Od tygodnia yeti schodzą stamtąd w dół zboczy, jakby przed czymś uciekały.",
	["quest.iceGrotto.p3"] = "Idź do Groty. Jeśli żyją, przyprowadź ich. Jeśli nie, przynieś dziennik Arnego. Pójdę z tobą do wylotu, dalej nie.",
	["quest.iceGrotto.text"] = "Idź z Sigrun do Lodowej Groty, pokonaj wodzów yeti i odszukaj dziennik jej brata Arnego.",
	["quest.iceGrotto.done"] = "Czytałem do świtu. Zamarzli w Grocie, wszyscy. Ostatnia strona mówi o starej ścieżce zakonu ku lodowcowi i o tym, że lód śpiewa. Lodowiec się budzi.",
	["quest.iceGrotto.done.promise"] = "Obiecałeś jej, że ich przyprowadzisz. Przyniosłeś ich słowa. Tyle się dało. Zamarzli w Grocie, a Arne pisze o ścieżce zakonu ku lodowcowi. Lodowiec się budzi.",
	["quest.iceGrotto.say.promise"] = "Przyprowadzę ich.",
	["quest.iceGrotto.say.promise.reply"] = "Nie obiecuj w górach. Góry słuchają i lubią się sprzeczać.",
	["quest.iceGrotto.say.wind"] = "Lód nie śpiewa. To wiatr.",
	["quest.iceGrotto.say.wind.reply"] = "Arne też tak mówił. Zapisał to w dzienniku.",
	["quest.iceGrotto.say.supplies"] = "Co mam zabrać?",
	["quest.iceGrotto.say.supplies.reply"] = "Ogień i mikstury. Yeti nie lubią ognia. Weź te dwie, są mocne.",
	["quest.iceGrotto.bark.accept1"] = "Splunę za tobą przez ramię. Nie oglądaj się.",
	["quest.iceGrotto.bark.half1"] = "Yeti uciekają w dół. Coś je stamtąd wygania.",
	["quest.iceGrotto.bark.near1"] = "Tu zostanę. Jeśli lód śpiewa, nie chcę słyszeć, czyim głosem.",
	["quest.iceGrotto.bark.done1"] = "Wracaj. Dziennik przeczytamy razem.",
	["quest.iceGrotto.comp.join1"] = "Pójdę z tobą do Groty. Do środka nie wejdę.",
	["quest.iceGrotto.comp.wait1"] = "Nie tak szybko. Na tym zboczu yeti chodzą parami.",
	["quest.iceGrotto.comp.back1"] = "Zgubiłam cię między skałami. Wracam do obozu.",
	["quest.harpyRocks.title"] = "Gniazda harpii",
	["quest.harpyRocks.p1"] = "Harpie znoszą do gniazd wszystko, co błyszczy. Klamry, groty, obrączki. Także to, co zostało po wspinaczach u stóp Iglicy Królowej.",
	["quest.harpyRocks.p2"] = "Wspinacze leżą tam od jesieni, bez kamienia na piersi. Pochowaj ich po naszemu, przerzedź harpie i sprawdź, co ukradły.",
	["quest.harpyRocks.text"] = "Pochowaj wspinaczy u stóp Iglicy Królowej Harpii, przerzedź harpie i przeszukaj ich gniazda.",
	["quest.harpyRocks.done"] = "Pieczęć Zakonu Lodowej Straży. Płatek śniegu przebity cierniem, ten sam znak co na Łąkach. Harpia zdjęła ją z czyjejś piersi. Zatrzymam ją na razie.",
	["quest.harpyRocks.say.shiny"] = "Harpie kradną świecidełka?",
	["quest.harpyRocks.say.shiny.reply"] = "Klamry, groty, obrączki. Raz zabrały mi dzwonek od sań. Razem z saniami.",
	["quest.harpyRocks.say.climbers"] = "Kim byli wspinacze?",
	["quest.harpyRocks.say.climbers.reply"] = "Ludźmi, którzy chcieli zobaczyć Iglicę z bliska. Zobaczyli.",
	["quest.harpyRocks.say.where"] = "Gdzie jest ich obóz?",
	["quest.harpyRocks.say.where.reply"] = "U stóp Iglicy Królowej Harpii. Zaznaczę.",
	["quest.harpyRocks.bark.accept1"] = "Weź łopatę. Harpie nie oddadzą zmarłych same.",
	["quest.harpyRocks.bark.half1"] = "Gniazda pustoszeją. Szukaj w nich metalu.",
	["quest.harpyRocks.bark.near1"] = "Kamień na pierś, czekan na wierzch. Tak się chowa w górach.",
	["quest.harpyRocks.bark.done1"] = "Ten sam znak co na Łąkach. Płatek i cierń.",
	["quest.giants.p1"] = "Mroźne olbrzymy zamknęły przełęcz. Nie polują już, tylko idą. Wszystkie w jedną stronę, ku Zamarzniętej Twierdzy.",
	["quest.giants.p2"] = "Zanim staniesz przeciw nim, ulepsz broń do +5. Olbrzym nie zauważy ciosu, który nie przebija skóry. Potem oczyść przełęcz.",
	["quest.giants.bark.accept1"] = "Olbrzymy idą w jedną stronę. Stań im na drodze.",
	["quest.giants.bark.half1"] = "Połowa przełęczy wolna. Reszta słyszy, że nadchodzisz.",
	["quest.giants.bark.done1"] = "Droga wolna. I nikt nie wie, dokąd szły.",
	["quest.mammothTundra.title"] = "Łupy olbrzymów",
	["quest.mammothTundra.p1"] = "W obozie łowieckim olbrzymów, na południe od cmentarzyska mamutów, leżą zbroje. Nie olbrzymie. Rycerskie, zdarte z oszronionych ciał.",
	["quest.mammothTundra.p2"] = "Zbierz je, zanim olbrzymy przekują je na groty. I przerzedź mamuty: olbrzymy pędzą je na wojnę.",
	["quest.mammothTundra.text"] = "Zbierz zbroje rycerzy zakonu w obozie łowieckim olbrzymów i przerzedź mamuty na Tundrze Mamutów.",
	["quest.mammothTundra.done"] = "Płatek i cierń na naramiennikach. Olbrzymy walczą z czymś w Zamarzniętej Twierdzy. Ktoś tam wciąż trzyma wartę.",
	["quest.mammothTundra.say.knights"] = "Czyje to zbroje?",
	["quest.mammothTundra.say.knights.reply"] = "Zakonu. Płatek i cierń na naramiennikach.",
	["quest.mammothTundra.say.herd"] = "Najpierw stado.",
	["quest.mammothTundra.say.herd.reply"] = "Rozsądnie. Martwe mamuty nie pilnują obozu.",
	["quest.mammothTundra.say.mammoths"] = "Mamuty idą na wojnę?",
	["quest.mammothTundra.say.mammoths.reply"] = "Olbrzym na mamucie to wojna. Olbrzym bez mamuta to tylko kłopot.",
	["quest.mammothTundra.bark.accept1"] = "Zbroje leżą w śniegu. Nie zostawiaj ich olbrzymom.",
	["quest.mammothTundra.bark.half1"] = "Stado rzednie. Olbrzymy to zauważą.",
	["quest.mammothTundra.bark.done1"] = "Zbroje zakonu. Ułożę je przy ogniu.",
	["quest.mammothTundra.bark.stuck1"] = "Obóz łowiecki jest na południe od cmentarzyska. Szukaj dymu.",
	["quest.frozenHold.title"] = "Zamarznięta Twierdza",
	["quest.frozenHold.p1"] = "Zamarznięta Twierdza była domem Zakonu Lodowej Straży, zanim lodowiec ją pochłonął. Olbrzymy wbiły się do niej wyłomem w murze.",
	["quest.frozenHold.p2"] = "Coś tam wciąż walczy. Wodzowie olbrzymów prowadzą swoich do środka i wracają ich mniej.",
	["quest.frozenHold.p3"] = "Zaprowadzę cię do Wyłomu. Dalej pójdziesz sam: pokonaj wodzów olbrzymów i zobacz, kogo tam spotkasz.",
	["quest.frozenHold.text"] = "Idź z Halvarem do Wyłomu Olbrzymów, wejdź do Zamarzniętej Twierdzy i pokonaj wodzów olbrzymów.",
	["quest.frozenHold.done"] = "Rycerze wciąż stoją na warcie, mówisz. Tylko już nie dla ludzi. A nad dziedzińcem wisi kwiat z lodu i pulsuje. Nie podoba mi się to.",
	["quest.frozenHold.say.order"] = "Co wiesz o Zakonie?",
	["quest.frozenHold.say.order.reply"] = "Babka mówiła, że Straż nie śpi. Myślałem, że to bajka na dobranoc.",
	["quest.frozenHold.say.breach"] = "Jak wejdę do Twierdzy?",
	["quest.frozenHold.say.breach.reply"] = "Przez Wyłom. Zaprowadzę cię. Czekam na tundrze, przy kamieniu.",
	["quest.frozenHold.bark.accept1"] = "Czekam przy kamieniu na tundrze. Nie każ mi marznąć.",
	["quest.frozenHold.bark.half1"] = "Wodzowie padają. Twierdza zaczyna milczeć.",
	["quest.frozenHold.bark.done1"] = "Wracaj ostrożnie. Lód w Twierdzy pamięta wszystko.",
	["quest.frozenHold.comp.join1"] = "Do Wyłomu poprowadzę cię sam. Dalej mury pamiętają tylko Straż.",
	["quest.frozenHold.comp.wait1"] = "Tundra jest płaska, mamuty nie. Trzymaj się blisko.",
	["quest.frozenHold.comp.arrive1"] = "Tu jest Wyłom. Olbrzymy nie pukają, więc zrobiły sobie drzwi.",
	["quest.frozenHold.comp.back1"] = "Zgubiłem cię na tundrze. Czekam przy kamieniu.",
	["quest.frozenLake.title"] = "Serce pod lodem",
	["quest.frozenLake.p1"] = "Kryształy na Zamarzniętym Jeziorze świecą wszystkie w jednym rytmie. Żywiołaki rodzą się przy nich jak muchy przy padlinie.",
	["quest.frozenLake.p2"] = "Przerzedź żywiołaki i rozbij jeden kryształ w ogrodzie z lodu. Potem przyłóż ucho do lodu i posłuchaj.",
	["quest.frozenLake.text"] = "Przerzedź żywiołaki lodu na Zamarzniętym Jeziorze i rozbij kryształ w ogrodzie z lodu.",
	["quest.frozenLake.done"] = "To nie kryształy. To bicie serca pod lodowcem. Coraz szybsze.",
	["quest.frozenLake.say.listen"] = "Jak posłuchać kryształu?",
	["quest.frozenLake.say.listen.reply"] = "Rozbij go i przyłóż ucho do lodu. Tak matka szukała ryb.",
	["quest.frozenLake.say.where"] = "Gdzie rosną kryształy?",
	["quest.frozenLake.say.where.reply"] = "W ogrodzie z lodu na jeziorze. Zaznaczę.",
	["quest.frozenLake.bark.accept1"] = "Lód na jeziorze trzyma. Żywiołaki też.",
	["quest.frozenLake.bark.half1"] = "Żywiołaków ubywa. Kryształy świecą dalej.",
	["quest.frozenLake.bark.near1"] = "Słyszysz? Raz, i jeszcze raz.",
	["quest.frozenLake.bark.done1"] = "Serce pod lodowcem. Wiedziałem, że coś tam jest.",
	["quest.iceWatch.title"] = "Ostatni z Lodowej Straży",
	["quest.iceWatch.p1"] = "Arne pisał, że ostatni brat zakonu zginął w Lodowej Strażnicy. Ale traperzy widywali tam światło. Trzy zimy z rzędu.",
	["quest.iceWatch.p1.wind"] = "Mówiłeś, że lód nie śpiewa. W Strażnicy ktoś śpiewa po nocach. Sprawdź, czy to też wiatr. Arne pisał, że ostatni brat zakonu zginął w Strażnicy, a traperzy widują tam światło.",
	["quest.iceWatch.p2"] = "Przed bramą stoją zamarznięci wartownicy. Nie wpuszczają nikogo, kto nie należy do Straży.",
	["quest.iceWatch.p3"] = "Weź pieczęć z gniazda harpii. Przejdź przez wartowników i zanieś ją do donżonu. Jeśli ktoś tam jeszcze czuwa, pozna ten znak.",
	["quest.iceWatch.text"] = "Przebij się przez zamarzniętych wartowników Lodowej Strażnicy i zanieś pieczęć zakonu na dziedziniec przed donżonem.",
	["quest.iceWatch.done"] = "Moja pieczęć. Zdjęli ją z piersi brata Edwina, kiedy padł na zboczu. Jestem Halgrim, ostatni, którego mróz nie złamał. Znam słowa przysięgi Straży.",
	["quest.iceWatch.halgrim"] = "Masz przy sobie znak Straży. Podejdź bliżej. Muszę go zobaczyć.",
	["quest.iceWatch.say.light"] = "Światło w martwej strażnicy?",
	["quest.iceWatch.say.light.reply"] = "Traperzy widzieli je trzy zimy z rzędu. Sigrun mówi, że to dusza. Ja mówię: sprawdź.",
	["quest.iceWatch.say.seal"] = "Czy Straż przyjmie obcego?",
	["quest.iceWatch.say.seal.reply"] = "Przyjmowała każdego, kto stanął między zimą a śpiącymi. Tak pisze Arne.",
	["quest.iceWatch.bark.accept1"] = "Weź pieczęć. Wartownicy przy bramie nie pytają o imię.",
	["quest.iceWatch.bark.half1"] = "Wartownicy rozsypują się w śnieg. Idź dalej.",
	["quest.iceWatch.bark.near1"] = "Brama. Sople w niej nie trzymają, przejdziesz.",
	["quest.iceWatch.bark.done1"] = "Podejdź. Pokaż mi znak.",
	["quest.oathWords.title"] = "Słowa przysięgi",
	["quest.oathWords.p1"] = "Dwadzieścia zim temu mróz przyszedł nocą, bez rogu i bez ognia. Moi bracia stanęli na murach i zostali tam. Stoją do dziś.",
	["quest.oathWords.p2"] = "Na dziedzińcu Twierdzy wisi Kwiat Szronu. Trzyma ich w niewoli i każe im pilnować tego, co ich zabiło. Rozbij go.",
	["quest.oathWords.p3"] = "Potem idź do Kaplicy Wiecznej Zimy. Przy mieczu zakonu, zamkniętym w lodzie, powtórz słowa przysięgi. Podam ci je.",
	["quest.oathWords.p4"] = "Kiedy je wypowiesz, Cierń Vaela będzie cały: drzewce, grot i przysięga. A rycerze, którzy wciąż stoją, zostaną zwolnieni ze służby.",
	["quest.oathWords.text"] = "Rozbij Kwiat Szronu na dziedzińcu Zamarzniętej Twierdzy i złóż przysięgę Straży przy mieczu w Kaplicy Wiecznej Zimy.",
	["quest.oathWords.done"] = "Spójrz na włócznię w świetle. Drzewce z Boru, grot z Kuźni i przysięga ze Szczytów. Królowa byłaby dumna.",
	["quest.oathWords.done.you"] = "Halgrim został, mówisz. Straż zawsze ktoś trzyma. Teraz także ty. Spójrz na włócznię: drzewce z Boru, grot z Kuźni i przysięga ze Szczytów.",
	["quest.oathWords.say.brothers"] = "Co stanie się z twoimi braćmi?",
	["quest.oathWords.say.brothers.reply"] = "Zasną. Dwadzieścia zim czekali na rozkaz, którego nikt nie wydał.",
	["quest.oathWords.say.you"] = "A ty?",
	["quest.oathWords.say.you.reply"] = "Zostanę. Ktoś musi pamiętać słowa, kiedy już je wypowiesz.",
	["quest.oathWords.say.words"] = "Naucz mnie przysięgi.",
	["quest.oathWords.say.words.reply"] = "Przy mieczu. Tam słowa ważą tyle, ile powinny.",
	["quest.oathWords.bark.accept1"] = "Najpierw kwiat, potem kaplica. Nie odwrotnie.",
	["quest.oathWords.bark.half1"] = "Bracia klękają. Słyszą cię.",
	["quest.oathWords.bark.done1"] = "Cierń jest cały. Czuję to nawet tutaj.",
	["quest.oathWords.bark.death1"] = "Straż nie kończy się na jednym upadku. Wstań.",
	["quest.glacier.p1"] = "Z Cierniem w ręku droga do leża stoi otworem. Serce Lodowca to rozpadlina w czole lodowca, za Smoczą Świątynią.",
	["quest.glacier.p2"] = "Kryształowi strażnicy pilnują wejścia do leża. Rozbij ich, zanim smok się obudzi.",
	["quest.glacier.bark.accept1"] = "Kryształowi strażnicy nie śpią. Smok jeszcze tak.",
	["quest.glacier.bark.half1"] = "Połowa strażników leży. Lód pęka coraz głośniej.",
	["quest.glacier.bark.done1"] = "Leże otwarte. Słyszysz, jak oddycha?",
	["quest.dragonTemple.title"] = "Pieśń przebudzenia",
	["quest.dragonTemple.p1"] = "Kult śpiewa w Smoczej Świątyni. Anzelm nazywa to pieśnią przebudzenia. Słychać ją aż w dolinie, kiedy wiatr ucichnie.",
	["quest.dragonTemple.p2"] = "Niebieskie ognie przy ołtarzach ofiarnych i u stóp kolosa niosą tę pieśń. Kto je karmi, ten śpiewa.",
	["quest.dragonTemple.p3"] = "Zgaś ognie i rozbij pomiot, który ich pilnuje. Może zdążysz, zanim pieśń wybrzmi.",
	["quest.dragonTemple.text"] = "Rozbij pomiot w Smoczej Świątyni i zgaś niebieskie ognie przy ołtarzach i u stóp kolosa.",
	["quest.dragonTemple.done"] = "Za późno. Pieśń wybrzmiała. I widziałeś go: Głos Zimy ma twarz. To Ilvar, archiwista z naszej świątyni.",
	["quest.dragonTemple.say.song"] = "Co to za pieśń?",
	["quest.dragonTemple.say.song.reply"] = "Anzelm nazywa ją pieśnią przebudzenia. Kto wysłucha jej do końca, nie śpi już spokojnie.",
	["quest.dragonTemple.say.cult"] = "Ilu ich jest?",
	["quest.dragonTemple.say.cult.reply"] = "Tylu, ilu wierzy, że zima ich oszczędzi.",
	["quest.dragonTemple.say.fires"] = "Najpierw zgaszę ognie.",
	["quest.dragonTemple.say.fires.reply"] = "Dobrze. Pomiot przyjdzie sam, kiedy zgasną.",
	["quest.dragonTemple.bark.accept1"] = "Pieśń słychać już z doliny. Spiesz się.",
	["quest.dragonTemple.bark.half1"] = "Śpiew cichnie. Ktoś wciąż prowadzi melodię.",
	["quest.dragonTemple.bark.done1"] = "Widziałeś go. Wracaj, zanim lodowiec ruszy.",
	["quest.wyrmSpire.title"] = "Obelisk wyrmów",
	["quest.wyrmSpire.p1"] = "Na Iglicy Wyrmów pomiot postawił obelisk. Runy na nim świecą najjaśniej nad Szlakiem Kości i wzywają wylęg do obrony leża.",
	["quest.wyrmSpire.p2"] = "Przerzedź wyrmy i rozbij obelisk, zanim smok się obudzi i usłyszy, kto go woła.",
	["quest.wyrmSpire.text"] = "Przerzedź wyrmy na Iglicy Wyrmów i rozbij obelisk pomiotu.",
	["quest.wyrmSpire.done"] = "Wyrmy rozpierzchły się po Iglicy. Droga do Serca wolna.",
	["quest.wyrmSpire.say.wyrms"] = "Wyrmy to też smoki?",
	["quest.wyrmSpire.say.wyrms.reply"] = "Wyrm to smok, któremu nie urosły skrzydła. Złości go to bardziej niż ciebie.",
	["quest.wyrmSpire.say.obelisk"] = "Gdzie stoi obelisk?",
	["quest.wyrmSpire.say.obelisk.reply"] = "Nad Szlakiem Kości, gdzie runy świecą najjaśniej. Zaznaczę.",
	["quest.wyrmSpire.bark.accept1"] = "Obelisk woła wylęg. Ucisz go.",
	["quest.wyrmSpire.bark.half1"] = "Wyrmów ubywa. Obelisk woła głośniej.",
	["quest.wyrmSpire.bark.done1"] = "Cisza na Iglicy. Pierwsza od tygodni.",
	["quest.wyrmSpire.bark.stuck1"] = "Obelisk stoi wyżej, nad szkieletem wyrma.",
	["quest.eveOfBattle.title"] = "W przeddzień",
	["quest.eveOfBattle.p1"] = "Zanim zejdziesz do smoka, wróć do miasta. Aldric chce cię widzieć. Brat Anzelm też.",
	["quest.eveOfBattle.p2"] = "Nie mów, że nie ma czasu. Smok spał trzysta lat, poczeka jeszcze jedną noc.",
	["quest.eveOfBattle.p3"] = "Potem przyjdź o świcie do Smoczych Schodów. Nie będziesz tam sam.",
	["quest.eveOfBattle.text"] = "Odwiedź kapitana Aldrica i Brata Anzelma w Vaelthornie, a o świcie przyjdź do Smoczych Schodów.",
	["quest.eveOfBattle.done"] = "Aldric dał ci chorągiew Vaelthornu, Anzelm cię pobłogosławił. A przy Schodach czekają zwiadowcy czterech krain. Pierwszy raz razem.",
	["quest.eveOfBattle.captain"] = "Weź chorągiew. Nie po to, żeby ją nieść. Po to, żebyś pamiętał, za kim idziesz.",
	["quest.eveOfBattle.anzelm"] = "Niech światło prowadzi twoje kroki tam, dokąd moje nie dojdą. I wróć.",
	["quest.eveOfBattle.say.captain"] = "Najpierw Aldric.",
	["quest.eveOfBattle.say.captain.reply"] = "Kapitan nie lubi czekać. Nawet w przeddzień.",
	["quest.eveOfBattle.say.anzelm"] = "Najpierw Anzelm.",
	["quest.eveOfBattle.say.anzelm.reply"] = "Anzelm modli się długo. Weź to pod uwagę.",
	["quest.eveOfBattle.say.afraid"] = "Boisz się?",
	["quest.eveOfBattle.say.afraid.reply"] = "Każdy zwiadowca się boi. Ci, którzy nie, nie wracają z raportem.",
	["quest.eveOfBattle.bark.accept1"] = "Idź do miasta. Wróć o świcie.",
	["quest.eveOfBattle.bark.half1"] = "Jeszcze jedna rozmowa. Potem Schody.",
	["quest.eveOfBattle.bark.done1"] = "Jesteś. Pozostali też.",
	["quest.vaelgrath.p1"] = "Vaelgrath się budzi. Lodowiec pęka od środka, a ryk słychać aż w Vaelthornie.",
	["quest.vaelgrath.p2"] = "Trzysta lat temu królowa Morvane zraniła go Cierniem Vaela. Teraz ten sam Cierń jest w twoich rękach.",
	["quest.vaelgrath.p3"] = "Zejdź do Leża i skończ to, dla Vaelthornu.",
	["quest.vaelgrath.bark.accept1"] = "Idź. Cierń wie, gdzie uderzyć.",
	["quest.vaelgrath.bark.done1"] = "Smok nie żyje. Vaelthorn będzie dziś świętował.",
	["quest.snowInSummer.title"] = "Śnieg w środku lata",
	["quest.snowInSummer.p1"] = "Tak myśleliśmy. Rynek świętował do północy, a potem zaczął padać śnieg. W środku lata, na stoły i na pochodnie.",
	["quest.snowInSummer.p2"] = "Anzelm mówi, że w ciele smoka nie było serca. Ktoś je wyniósł, zanim padł. Porozmawiaj z nim.",
	["quest.snowInSummer.p3"] = "Potem zejdź do Serca Lodowca i zobacz, co tam zostało. Wróć z tym do Halvara. Jeśli zima jeszcze żyje, on będzie wiedział gdzie.",
	["quest.snowInSummer.text"] = "Tak myśleliśmy. Porozmawiaj z Bratem Anzelmem, zejdź do Serca Lodowca i wróć do Halvara z tym, co zobaczysz.",
	["quest.snowInSummer.done"] = "Pusta komora w Sercu Lodowca. Ślady wylęgu, świeże, prowadzą na Szlak Kości. Ktoś niósł coś ciężkiego.",
	["quest.snowInSummer.anzelm"] = "Smok był pusty w środku. Serce zimy wyniesiono, zanim padł. Ktoś wiedział, że przyjdziesz.",
	["quest.snowInSummer.say.feast"] = "Może to tylko chłodna noc.",
	["quest.snowInSummer.say.feast.reply"] = "Chłodne noce nie sypią śniegiem na stoły w środku lata.",
	["quest.snowInSummer.say.where"] = "Gdzie mam szukać?",
	["quest.snowInSummer.say.where.reply"] = "W Sercu Lodowca. Halvar zna drogę lepiej niż kronika.",
	["quest.snowInSummer.say.anzelm"] = "Co mówi Anzelm?",
	["quest.snowInSummer.say.anzelm.reply"] = "Że serca nie było. Wierzę mu. Wolałbym nie.",
	["quest.snowInSummer.bark.accept1"] = "Śnieg na rynku. Idź, zanim ludzie zaczną się bać.",
	["quest.snowInSummer.bark.half1"] = "Anzelm się nie myli. Rzadko się myli.",
	["quest.snowInSummer.bark.done1"] = "Ślady wylęgu. Świeże. Sigrun pozna, dokąd idą.",
	["quest.dragonsBrood.title"] = "Szlak Kości",
	["quest.dragonsBrood.p1"] = "Młode smoki wyniosły Serce Zimy z lodowca. Wylęg wciąż kręci się w Sercu Lodowca i pilnuje pustej komory.",
	["quest.dragonsBrood.p1.wind"] = "Sigrun pyta, czy wciąż myślisz, że lód nie śpiewa. Odpowiesz jej sam, na Szlaku. Młode smoki wyniosły Serce Zimy z lodowca, a wylęg wciąż pilnuje pustej komory.",
	["quest.dragonsBrood.p2"] = "Pokonaj wylęg. Potem idź do Sigrun na rozwidlenie przy cmentarzysku mamutów. Ona zna Szlak Kości i doprowadzi cię do szkieletu wyrma.",
	["quest.dragonsBrood.text"] = "Pokonaj młode smoki w Sercu Lodowca, a potem idź z Sigrun Szlakiem Kości do szkieletu wyrma.",
	["quest.dragonsBrood.done"] = "Ślad prowadzi wyżej, do kręgu pod szczytem Iglicy. Tam ktoś czeka. Boso, mówi Sigrun? Wiem, kto chodzi boso po śniegu.",
	["quest.dragonsBrood.say.trail"] = "Kto zna Szlak Kości?",
	["quest.dragonsBrood.say.trail.reply"] = "Sigrun. Chodziła nim z bratem. Czeka przy cmentarzysku mamutów.",
	["quest.dragonsBrood.say.brood"] = "Młode smoki są groźne?",
	["quest.dragonsBrood.say.brood.reply"] = "Młode nie wiedzą jeszcze, czego się bać. To je czyni groźnymi.",
	["quest.dragonsBrood.bark.accept1"] = "Wylęg pilnuje pustej komory. Rozbij go.",
	["quest.dragonsBrood.bark.half1"] = "Młodych ubywa. Sigrun czeka przy kościach mamutów.",
	["quest.dragonsBrood.bark.near1"] = "Stój. Ślady wylęgu, a między nimi ludzkie. Ktoś szedł z nimi boso.",
	["quest.dragonsBrood.bark.done1"] = "Boso, mówi Sigrun? Wiem, kto chodzi boso po śniegu. Wracaj.",
	["quest.dragonsBrood.bark.death1"] = "Wstań. Góry jeszcze nie skończyły z nami rozmawiać.",
	["quest.dragonsBrood.comp.join1"] = "Halvar mówi, że idziemy po smoki. Ja idę po ślad. Trzymaj się drogi.",
	["quest.dragonsBrood.comp.join2"] = "Splunę przez ramię. Ty też możesz. Nie zaszkodzi.",
	["quest.dragonsBrood.comp.wait1"] = "Szybciej. Ten, z kim tu chodziłam, nigdy nie zostawał w tyle.",
	["quest.dragonsBrood.comp.wait2"] = "Nie przechodź pod żebrami. Kości wyrma pamiętają, kto je minął.",
	["quest.dragonsBrood.comp.arrive1"] = "Dalej pod żebra nie wejdę. Ślady idą w górę, do kręgu. Wróć do Halvara.",
	["quest.dragonsBrood.comp.back1"] = "Zgubiłam cię. Wracam na rozwidlenie. Nie chodź tu sam po zmroku.",
	["quest.voiceOfWinter.title"] = "Głos Zimy",
	["quest.voiceOfWinter.p1"] = "Sigrun zeszła z gór przed świtem. Mówi, że w kręgu pod szczytem Iglicy ktoś stoi przy Sercu Zimy i śpiewa.",
	["quest.voiceOfWinter.p2"] = "To Ilvar. Odprawia obrzęd, chce wziąć Serce w siebie i samemu stać się zimą. Wtedy nie będzie już kogo pokonać.",
	["quest.voiceOfWinter.p3"] = "Pomiot i wyrmy strzegą drogi do kręgu. Przebij się przez nie.",
	["quest.voiceOfWinter.p4"] = "Przerwij obrzęd, zanim się dopełni. Sigrun zaprowadzi cię do kręgu. Dalej pójdziesz sam.",
	["quest.voiceOfWinter.text"] = "Dojdź do Kręgu Obrzędu pod szczytem Iglicy, przebij się przez pomiot i wyrmy i przerwij obrzęd Ilvara.",
	["quest.voiceOfWinter.done"] = "Mróz, który wezwał, zabrał go. Stoi teraz w kręgu, z wyciągniętą ręką, z lodu. Ale Serce Zimy wciąż bije.",
	["quest.voiceOfWinter.say.alone"] = "Pójdę sam.",
	["quest.voiceOfWinter.say.alone.reply"] = "Nie całkiem. Sigrun czeka przy kościach. Doprowadzi cię do kręgu, dalej nikt.",
	["quest.voiceOfWinter.say.turn"] = "Czy da się go zawrócić?",
	["quest.voiceOfWinter.say.turn.reply"] = "Anzelm się za niego modli. Ja widziałem, co zostawił na Łąkach.",
	["quest.voiceOfWinter.say.supplies"] = "Co mam zabrać?",
	["quest.voiceOfWinter.say.supplies.reply"] = "Wszystko, co masz. I to, na drogę z powrotem.",
	["quest.voiceOfWinter.bark.accept1"] = "Sigrun czeka przy kościach. Nie każ jej czekać długo.",
	["quest.voiceOfWinter.bark.half1"] = "Obrzęd jeszcze trwa. Słychać go aż tutaj.",
	["quest.voiceOfWinter.bark.near1"] = "Widzisz go? Śpiewa. Dalej nie idę. Ktoś musi wrócić i opowiedzieć.",
	["quest.voiceOfWinter.bark.done1"] = "Serce Zimy wciąż bije. Wracaj.",
	["quest.voiceOfWinter.comp.join1"] = "Ślady idą w górę. Pójdę z tobą do kręgu.",
	["quest.voiceOfWinter.comp.wait1"] = "Nie zostawaj. Na tej wysokości wiatr zabiera głos.",
	["quest.voiceOfWinter.comp.back1"] = "Straciłam cię z oczu. Wracam do kości.",
	["quest.firstSpring.title"] = "Pierwsza Wiosna",
	["quest.firstSpring.p1"] = "Serce Zimy wciąż bije, choć nikt już go nie woła. Póki bije, każde lato w Vaelthornie będzie się kończyć śniegiem.",
	["quest.firstSpring.p2"] = "Królowa zraniła smoka Cierniem i odeszła. Ty zrobisz to, czego ona nie zdążyła: wbijesz Cierń Vaela w samo Serce.",
	["quest.firstSpring.p3"] = "Potem zostań w górach, aż staniesz się tym, kim królowa była dla tego kraju. Góry poznają, kiedy będziesz gotów.",
	["quest.firstSpring.p4"] = "Kiedy będziesz, wróć do Aldrica. Nic nie mów. Zobaczysz sam.",
	["quest.firstSpring.text"] = "Wbij Cierń Vaela w Serce Zimy w Kręgu Obrzędu, osiągnij 100. poziom i wróć do kapitana Aldrica.",
	["quest.firstSpring.done"] = "Spójrz na miasto. Pierwsza wiosna od trzystu lat.",
	["quest.firstSpring.done.afraid"] = "Halvar mówi, że w przeddzień pytałeś go o strach. Dobrze. Bali się wszyscy, którzy wrócili. Spójrz na miasto. Pierwsza wiosna od trzystu lat.",
	["quest.firstSpring.say.stay"] = "Zostanę, ile trzeba.",
	["quest.firstSpring.say.stay.reply"] = "Królowa też została. Góry pamiętają tych, którzy zostają.",
	["quest.firstSpring.say.city"] = "Co powiem w mieście?",
	["quest.firstSpring.say.city.reply"] = "Nic. Zobaczą sami.",
	["quest.firstSpring.say.thorn"] = "Czy Cierń wytrzyma?",
	["quest.firstSpring.say.thorn.reply"] = "Wytrzymał trzysta lat w ranie smoka. Wytrzyma i to.",
	["quest.firstSpring.bark.accept1"] = "Krąg czeka. Serce bije coraz ciszej, ale bije.",
	["quest.firstSpring.bark.half1"] = "Cierń jest w Sercu. Zostań w górach, aż będziesz gotów.",
	["quest.firstSpring.bark.done1"] = "Wracaj do miasta. Coś się tu zmieniło.",
	["quest.item.trapperJournal"] = "Dziennik Traperów",
	["quest.item.orderSeal"] = "Pieczęć Zakonu Lodowej Straży",
	["quest.use.burial"] = "Pochowaj zmarłych",
	["quest.use.gatherArmor"] = "Zbierz zbroje",
	["quest.use.shatter"] = "Rozbij kryształ",
	["quest.use.snuff"] = "Zgaś ogień",
	["quest.use.oath"] = "Złóż przysięgę",
	["quest.use.breakRite"] = "Przerwij obrzęd",
	["quest.use.thorn"] = "Wbij Cierń",
	["place.trapperCamp"] = "Opuszczony obóz traperów",
	["place.keep"] = "Dziedziniec Lodowej Strażnicy",
	["place.dragonStairs"] = "Smocze Schody",
	["place.wyrmBones"] = "Szkielet wyrma na Szlaku Kości",
	["place.giantsBreach"] = "Wyłom Olbrzymów",
	["place.summit"] = "Krąg Obrzędu pod szczytem Iglicy",
	["npc.trapper_sigrun.name"] = "Traperka Sigrun",
	["npc.trapper_sigrun.role"] = "Traperka",
	["npc.trapper_sigrun.greeting"] = "Obóz jest pusty od dziewięciu dni. Nie umiem czekać tak długo.",
	["npc.trapper_sigrun.line1"] = "Wnyki trzeba sprawdzać codziennie, nawet kiedy nie ma komu jeść.",
	["npc.trapper_sigrun.line2"] = "Każdą ścieżkę w tych górach ktoś kiedyś opłacił.",
	["npc.trapper_sigrun.line3"] = "Lamparty czują, kiedy obóz słabnie.",
	["npc.trapper_sigrun.where"] = "w opuszczonym obozie traperów w Dolinie Lodowych Wilków",
	["npc.ghost_halgrim.name"] = "Duch Brata Halgrima",
	["npc.ghost_halgrim.role"] = "Ostatni z Lodowej Straży",
	["npc.ghost_halgrim.greeting"] = "Straż trwa. Nawet gdy nikt nie pamięta, czego strzeże.",
	["npc.ghost_halgrim.line1"] = "Mróz przyszedł nocą, bez rogu i bez ognia.",
	["npc.ghost_halgrim.line2"] = "Moi bracia stoją na murach. Nie wiem, czy jeszcze mnie słyszą.",
	["npc.ghost_halgrim.line3"] = "Przysięgi nie składa się ustami. Składa się ją tym, co się potem robi.",
	["npc.ghost_halgrim.where"] = "na dziedzińcu Lodowej Strażnicy, przed donżonem",
	["npc.captain.greetingSpring"] = "Czujesz? Ziemia pachnie jak za czasów mojego dziadka.",
	["npc.brother_anzelm.greetingSpring"] = "Dzwony biją od rana. Pierwszy raz od lat nie modlę się o ciepło.",
	["npc.healer.greetingSpring"] = "Rany goją się szybciej, kiedy za oknem kwitną jabłonie.",
	["cutscene.who.journal"] = "Dziennik Traperów",
	["cutscene.ch4_title.title"] = "Lodowe Szczyty",
	["cutscene.ch4_title.l1"] = "Za kopcem z rogami kończy się droga kupców. Dalej śnieg nie topnieje nawet latem.",
	["cutscene.ch4_title.l2"] = "Z gór niesie się ryk. Psy w dolinie milkną, zanim usłyszą go ludzie.",
	["cutscene.grottoTrappers.l1"] = "Za lodem stoją trzy postacie. Jedna wciąż trzyma latarnię.",
	["cutscene.grottoTrappers.l2"] = "Dzień szósty. Lód śpiewa po nocach. Arne mówi, że to tylko wiatr.",
	["cutscene.grottoTrappers.l3"] = "Ścieżka zakonu prowadzi dalej, ku lodowcowi. Jutro pójdziemy nią.",
	["cutscene.frostBloom.l1"] = "Na dziedzińcu wisi kwiat z lodu. Pulsuje, jakby oddychał.",
	["cutscene.frostBloom.l2"] = "Rycerze Straży wciąż pełnią wartę. Tylko już nie dla ludzi.",
	["cutscene.crystalPulse.l1"] = "Kryształy rozbłyskują wszystkie naraz. Raz, i jeszcze raz.",
	["cutscene.crystalPulse.l2"] = "Pod lodowcem bije serce. Coraz szybciej.",
	["cutscene.halgrimRises.l1"] = "Dwadzieścia zim nikt nie przeszedł żywy przez tę bramę.",
	["cutscene.halgrimRises.l2"] = "Masz przy sobie znak Straży. Chodź. Muszę wiedzieć, skąd go masz.",
	["cutscene.thornWhole.title"] = "Cierń Vaela",
	["cutscene.thornWhole.l1"] = "Powtórz za mną: «Stoję między zimą a tymi, którzy śpią.»",
	["cutscene.thornWhole.l2"] = "Straż was zwalnia, bracia. Idźcie spać.",
	["cutscene.thornWhole.l3"] = "Cierń jest cały. Drzewce, grot i przysięga.",
	["cutscene.ilvarStairs.l1"] = "Zgasiłeś świece. Pieśń już wybrzmiała.",
	["cutscene.ilvarStairs.l2"] = "Nazywacie to zwycięstwem królowej. Ja czytałem, ile kosztowało.",
	["cutscene.ilvarStairs.l3"] = "Zima nie nienawidzi. Zima przykrywa. Pod śniegiem nikt już nie płacze.",
	["cutscene.ilvarStairs.l4"] = "Idź do niego, skoro musisz. Ja pójdę dalej.",
	["cutscene.eveOfBattle.l1"] = "Na Łąkach znów orzą. Pierwszy raz od roku.",
	["cutscene.eveOfBattle.l2"] = "W Borze palą się latarnie. Wszystkie.",
	["cutscene.eveOfBattle.l3"] = "Kuźnia wystygła. Zostało tylko to, co przed nami.",
	["cutscene.eveOfBattle.l4"] = "O świcie. Razem.",
	["cutscene.vaelgrathFalls.l1"] = "Cierń Vaela tkwi w ranie. Leże cichnie.",
	["cutscene.vaelgrathFalls.l2"] = "Trzysta lat snu kończy się w jednej chwili.",
	["cutscene.finaleTitle.title"] = "Vaelthorn",
	["cutscene.finaleTitle.l1"] = "Na rynku jeszcze grała muzyka, kiedy spadły pierwsze płatki.",
	["cutscene.finaleTitle.l2"] = "Śnieg w środku lata. Nikt w mieście nie pamięta takiej nocy.",
	["cutscene.snowInSummer.l1"] = "Spójrz w górę. Śnieg, w środku lata.",
	["cutscene.snowInSummer.l2"] = "W ciele smoka nie było serca. Ktoś je wyniósł, zanim padł.",
	["cutscene.snowInSummer.l3"] = "Idź do Halvara. Jeśli zima jeszcze żyje, on będzie wiedział gdzie.",
	["cutscene.voiceOfWinter.l1"] = "Przyszedłeś zobaczyć, jak zima dostaje imię?",
	["cutscene.voiceOfWinter.l2"] = "Smok był tylko naczyniem. Serce zostało. Wezmę je w siebie.",
	["cutscene.voiceOfWinter.l3"] = "Nie bój się. Pod śniegiem jest cicho.",
	["cutscene.voiceOfWinter.l4"] = "Obrzęd pęka. Mróz, który wezwał, wraca po niego.",
	["cutscene.thornSinks.l1"] = "Cierń zapada się w Serce Zimy. Lód pod stopami pęka i oddycha.",
	["cutscene.thornSinks.l2"] = "Po raz pierwszy od trzystu lat wiatr na Iglicy jest ciepły.",
	["cutscene.firstSpring.title"] = "Koniec",
	["cutscene.firstSpring.subtitle"] = "Pierwsza Wiosna",
	["cutscene.firstSpring.l1"] = "Trzysta lat czekaliśmy na tę wiosnę. Nie wiedzieliśmy nawet, że czekamy.",
	["cutscene.firstSpring.l2"] = "Ilvar chciał, żeby świat zasnął. Ty go obudziłeś.",
	["cutscene.firstSpring.l3"] = "Vaelthorn pamięta swoich. Ciebie zapamięta pierwszego.",
