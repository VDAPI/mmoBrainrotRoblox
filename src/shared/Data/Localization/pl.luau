	-- S101b: quest dialogue (answers, comments, companion; DESIGN-15 §3.5)
	["quest.say.unknown"] = "Nie ma takiej odpowiedzi.",
	["quest.say.already"] = "Ta odpowiedź już padła.",
	["quest.say.notOffered"] = "Ta rozmowa jest już nieaktualna.",
	["quest.say.pick"] = "Odpowiedz, zanim pójdziesz dalej.",
	["quest.say.later"] = "Plecak pełny. Zrób miejsce albo wybierz inną odpowiedź.",
	["quest.say.gift"] = "Otrzymujesz: {item} ×{n}",
	["quest.say.you"] = "Ty: „{answer}”",
	["menu.barks"] = "Komentarze NPC w trakcie questów",
