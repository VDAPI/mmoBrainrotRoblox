	["trait.bonebreaker.info"] = "Każde trafienie osłabia cel: zadaje {v}% mniej obrażeń przez {s} s (odświeża się, nie kumuluje; działa też na czerwone strefy).",
	["trait.beheading.info"] = "+{v}% obrażeń celom poniżej {threshold}% życia.",
	["trait.rendingGash.info"] = "{chance}% szansy na głęboką ranę: krwawienie zadaje razem {v}% obrażeń ciosu (liczonych po pancerzu) w {s} s, do {stacks} stosów od Ciebie.",
	["trait.sundering.info"] = "Każde trafienie zdejmuje {v}% pancerza celu, do {stacks} stosów (razem {max}%), jeden czas {s} s dla wszystkich stosów. Pomaga całej drużynie.",
	["trait.runThrough.info"] = "Atak podstawowy przeszywa cel: najbliższy wróg w pasie {width} st. szerokości do {depth} st. za celem dostaje {v}% obrażeń ciosu, bez efektów przy trafieniu.",
	["trait.parry.info"] = "{chance}% szansy na całkowite zablokowanie zwykłego ataku (nie czerwonej strefy ani obrażeń w czasie). Każdy blok leczy {v}% maks. HP. Szansa jest stała, rzadkość i ulepszenie podnoszą leczenie.",
	["trait.harrying.info"] = "{v}% szansy przy trafieniu: cel porusza się o {slow}% wolniej i atakuje o {attackSlow}% wolniej przez {s} s.",
	["trait.toxicBarbs.info"] = "{chance}% szansy na zatrucie: razem {v}% obrażeń strzału w {s} s, do {stacks} stosów od Ciebie; zatruty cel atakuje o {attackSlow}% wolniej. Odporność na truciznę osłabia tyknięcia.",
	["trait.criticalForce.info"] = "Trafienia krytyczne zadają +{v} pkt proc. obrażeń.",
	["trait.easyPrey.info"] = "+{v}% obrażeń przeciw celom spowolnionym, unieruchomionym, zamrożonym albo ogłuszonym (przez kogokolwiek).",
	["trait.bodkinBolt.info"] = "Twoje ciosy ignorują {v}% pancerza celu (liczone po niszczeniu pancerza).",
	["trait.fullDraw.info"] = "Po użyciu umiejętności ofensywnej następny atak podstawowy w ciągu {window} s zadaje +{v}% × szybkość broni głównej, więc każda broń zyskuje na jednym rzucie tyle samo.",
	["trait.elementalSpark.info"] = "Atak podstawowy z {v}% szansą budzi żywioł broni: ogień podpala (razem {burnPct}% ciosu w {burnDuration} s), lód spowalnia o {slowPct}% na {slowDuration} s i daje Przemarznięcie +{frostbite}%, błyskawica przeskakuje na drugiego wroga w {arcRadius} st. za {arcPct}% (bez niego ten sam cel za {sameTargetPct}%).",
	["trait.elementalMight.info"] = "Podpalenia, przeskoki i pola żywiołu broni z Twoich umiejętności są o {v}% silniejsze, a spowolnienia i zamrożenia trwają o tyle dłużej. Lód: Przemarznięcie +{frostbite}%; przeskok błyskawicy bez drugiego wroga trafia ten sam cel za samą premię.",
	["trait.runicSeal.info"] = "Po {still} s bez ruchu pod Tobą świeci pieczęć: wszystkie Twoje obrażenia +{v}%, dopóki się nie ruszysz (gasi ją krok dalej niż {step} st., teleport albo odrzut).",
	["trait.learnedFormulae.info"] = "Twoje umiejętności kosztują {v}% mniej many.",
	["trait.powerLens.info"] = "Twoje umiejętności zadają +{v}% obrażeń.",
	["trait.anointment.info"] = "Twoje leczenie i tarcze są silniejsze o {v}%.",
	["trait.savingBlow.info"] = "{v}% obrażeń Twoich ciosów i umiejętności leczy najbardziej rannego sojusznika w {radius} st. (albo Ciebie); tyknięcia się nie liczą. Leczenie siebie liczy się do limitu wampiryzmu.",
	["trait.concussion.info"] = "{v}% szansy na ogłuszenie celu na {s} s, najwyżej raz na {gap} s na cel; po ogłuszeniu potwór uderza dopiero po chwili. Bossy i Elity II są odporne.",
	["trait.prosperity.info"] = "+{v}% szansy na przedmiot z potworów, we wspólnym limicie z innymi źródłami; nie działa na bossy.",
	["trait.rendingGash.pvp"] = "W PvP tyknięcia ×{dot} (raz), a zraniony gracz leczy się o {healCut}% słabiej.",
	["trait.toxicBarbs.pvp"] = "W PvP tyknięcia ×{dot} (raz), słabsze od odporności na truciznę; spowolnienie ataku trwa ×{cc} czasu.",
	["trait.sundering.pvp"] = "Na graczu najwyżej {pvpStacks} stosy.",
	["trait.bonebreaker.pvp"] = "W walce z graczem trafiony zadaje {pvpV}% mniej przez {s} s.",
	["trait.harrying.pvp"] = "W PvP spowolnienie ruchu i ataku trwa ×{cc} czasu.",
