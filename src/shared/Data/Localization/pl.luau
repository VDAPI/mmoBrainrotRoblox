	["skill.bladeWhirl.desc"] = "Dwa obroty z bronią: {hits} ciosy po {dmg}% we wszystkich wrogów w promieniu {radius} st.",
	["skill.steelSkin.name"] = "Stalowa Skóra",
	["skill.steelSkin.desc"] = "Pasywna: +{armor}% obrony.",
	["skill.cleave.name"] = "Rozpłatanie",
	["skill.cleave.desc"] = "Trafia wrogów w stożku za {dmg}% i wywołuje krwawienie {bleed}% przez {bleedDuration} s.",
	["skill.taunt.name"] = "Prowokacja",
	["skill.taunt.desc"] = "Potwory w promieniu {radius} st. atakują Ciebie przez {tauntDuration} s; w tym czasie +{armor}% obrony.",
	["skill.fortitude.name"] = "Niezłomność",
	["skill.fortitude.desc"] = "Pasywna: +{hp}% maksymalnego życia i +{block}% szansy na blok zwykłego ataku potwora.",
	["skill.earthquake.name"] = "Trzęsienie Ziemi",
	["skill.earthquake.desc"] = "Wstrząsa ziemią wokół za {dmg}% i spowalnia wrogów o {slow}% na {slowDuration} s.",
	["skill.bloodlust.name"] = "Krwawy Szał",
	["skill.bloodlust.desc"] = "+{speed}% szybkości ataku i +{lifesteal}% wampiryzmu na {statBuffDuration} s.",
	["skill.riposte.name"] = "Kontratak",
	["skill.riposte.desc"] = "Pasywna: {chance}% szansy na kontrę atakiem podstawowym po każdym zwykłym ataku w Ciebie, także zablokowanym i unikniętym.",
	["skill.crushingBlow.name"] = "Miażdżący Cios",
	["skill.crushingBlow.desc"] = "Zadaje {dmg}% i obniża obronę celu o {armorBreak}% na {armorBreakDuration} s.",
	["skill.lastBastion.name"] = "Ostatni Bastion",
	["skill.lastBastion.desc"] = "Otrzymujesz o {reduction}% mniej obrażeń przez {damageReductionDuration} s.",
	["skill.titansWrath.name"] = "Gniew Tytana",
	["skill.titansWrath.desc"] = "Uderzasz w ziemię {hits} razy, każde uderzenie zadaje {dmg}% wrogom w promieniu {radius} st.",
	-- S74: Warrior path skills (ROZWOJ 10.3-10.5)
	["skill.intercept.name"] = "Przechwycenie",
	["skill.intercept.desc"] = "Doskakujesz do sojusznika do {range} st. i przez {interceptDuration} s przejmujesz {share}% każdego ciosu potwora w niego, także z czerwonej strefy. Bez zaznaczenia wybierasz sojusznika w czerwonej strefie, potem najbardziej rannego; gdy nikogo nie ma, otrzymujesz o {guard}% mniej obrażeń przez {damageReductionDuration} s.",
	["skill.shieldWall.name"] = "Mur Tarcz",
	["skill.shieldWall.desc"] = "Wbijasz tarczę w ziemię: przez {interceptDuration} s przejmujesz {share}% ciosów potworów w sojuszników do {radius} st. (najwyżej 25% swojego maksymalnego życia na sekundę), otrzymujesz o {reduction}% mniej obrażeń, a wrogowie do {hitRadius} st. są sprowokowani na {tauntDuration} s.",
	["skill.rend.name"] = "Rozdarcie",
	["skill.rend.desc"] = "Cios zadający {dmg}% ataku fizycznego i krwawienie {bleed}% ataku przez {bleedDuration} s. Zużywa całą Furię: +{furyDmg}% obrażeń ciosu za każdy stos.",
	["skill.carnage.name"] = "Rzeź",
	["skill.carnage.desc"] = "Zużywasz całą Furię: +{perFury}% ataku fizycznego za każdy stos na {carnageDuration} s. W tym czasie Furia nie opada i rośnie o 2 za trafienie, a każde zabójstwo odnawia Szarżę i Wir Ostrzy.",
	["skill.warBanner.name"] = "Sztandar Wojenny",
	["skill.warBanner.desc"] = "Wbijasz sztandar do {range} st. od siebie na {duration} s. Co sekundę sojusznicy w promieniu {radius} st., także ty, dostają +{haste}% szybkości ataku. Sztandar pada, gdy zginiesz.",
	["skill.advanceOrder.name"] = "Rozkaz Natarcia",
	["skill.advanceOrder.desc"] = "Wydajesz rozkaz i uderzasz w ziemię: wrogowie do {hitRadius} st. otrzymują {dmg}% ataku fizycznego, a sojusznicy do {radius} st., także ty, dostają +{crit} pkt proc. szansy na trafienie krytyczne na {statBuffDuration} s.",
	["skill.aimedShot.name"] = "Celny Strzał",
	["skill.aimedShot.desc"] = "Precyzyjna strzała zadająca {dmg}%.",
	["skill.doubleShot.name"] = "Podwójny Strzał",
	["skill.doubleShot.desc"] = "Dwie strzały, każda za {dmg}%.",
	["skill.disengage.name"] = "Odskok",
	["skill.disengage.desc"] = "Skok o {length} st. w tył; następny strzał zadaje +{bonus}%.",
	["skill.arrowRain.name"] = "Deszcz Strzał",
	["skill.arrowRain.desc"] = "{hits} fale strzał na obszar {radius} st., każda za {dmg}%.",
	["skill.hawkEye.name"] = "Sokole Oko",
	["skill.hawkEye.desc"] = "Pasywna: +{crit}% szansy na krytyk i +{critDmg}% obrażeń krytycznych.",
	["skill.venomArrow.name"] = "Zatruta Strzała",
	["skill.venomArrow.desc"] = "Zadaje {dmg}% i zatruwa na {poison}% przez {poisonDuration} s.",
	["skill.frostTrap.name"] = "Pułapka Lodowa",
	["skill.frostTrap.desc"] = "Zastawia pułapkę unieruchamiającą wrogów w promieniu {radius} st. na {rootDuration} s.",
	["skill.agility.name"] = "Zwinność",
	["skill.agility.desc"] = "Pasywna: +{dodge}% uniku i +{move}% szybkości ruchu.",
	["skill.piercingArrow.name"] = "Bełt Przebijający",
	["skill.piercingArrow.desc"] = "Bełt trafiający wszystko na linii {length} st. za {dmg}%.",
	["skill.huntersMark.name"] = "Znak Łowcy",
	["skill.huntersMark.desc"] = "Cel otrzymuje +{vuln}% obrażeń przez {vulnerabilityDuration} s.",
	["skill.predatorInstinct.name"] = "Instynkt Drapieżnika",
	["skill.predatorInstinct.desc"] = "Pasywna: +{speed}% szybkości ataku.",
	["skill.volley.name"] = "Salwa",
	["skill.volley.desc"] = "{hits} strzał w stożek, każda za {dmg}%.",
	["skill.camouflage.name"] = "Kamuflaż",
	["skill.camouflage.desc"] = "Potwory tracą Cię z oczu na {camouflageDuration} s; następny strzał to gwarantowany krytyk.",
	["skill.stormArrow.name"] = "Strzała Burzy",
	["skill.stormArrow.desc"] = "Zadaje {dmg}% celowi i {splash}% wrogom w promieniu {radius} st.",
	-- S77: Hunter path skills (ROZWOJ 11.3-11.5)
	["skill.drawBead.name"] = "Namierzenie",
	["skill.drawBead.desc"] = "Bierzesz cel na muszkę na {sightedDuration} s: twoje trafienia w niego mają +{crit}% szansy na krytyk i +{critDmg}% obrażeń krytycznych. Działa tylko na twoje trafienia.",
	["skill.heartseeker.name"] = "Strzał w Serce",
	["skill.heartseeker.desc"] = "Celujesz {castTime} s, stojąc w miejscu, i wypuszczasz strzałę za {dmg}%. Cel poniżej {finisherHp}% życia dostaje ×{finisherMul}. Ruch przerywa celowanie i oddaje energię oraz odnowienie; obrażenia go nie przerywają.",
	["skill.venomSnare.name"] = "Trujące Sidła",
	["skill.venomSnare.desc"] = "Rzucasz sidła do {range} st. Czekają {duration} s; pierwszy wróg w promieniu {radius} st. je zatrzaskuje. Złapani dostają {dmg}%, truciznę za {poison}% przez {poisonDuration} s i spowolnienie o {slow}% na {slowDuration} s.",
	["skill.snarefield.name"] = "Pole Sideł",
	["skill.snarefield.desc"] = "Rozstawiasz {hits} sideł w pierścieniu {ringRadius} st. wokół punktu do {range} st. Każde czeka {duration} s i łapie wrogów w promieniu {radius} st.: {dmg}%, +{vuln}% otrzymywanych obrażeń na {vulnerabilityDuration} s i unieruchomienie na {rootDuration} s (bossów nie unieruchamia).",
	["skill.falcon.name"] = "Sokół",
	["skill.falcon.desc"] = "Wypuszczasz sokoła na {duration} s. Co {interval} s spada na twój cel do {range} st., a bez celu na najbliższego wroga, z którym walczy twoja drużyna, do {radius} st., i zadaje {dmg}%. To wsparcie z powietrza: sokoła nie da się trafić i nie ściąga na siebie uwagi.",
	["skill.drive.name"] = "Nagonka",
	["skill.drive.desc"] = "Spędzasz zwierzynę: wrogowie do {pullRadius} st. od punktu zostają ściągnięci do środka, a wszyscy w promieniu {radius} st. dostają {dmg}%, spowolnienie o {slow}% na {slowDuration} s i +{vuln}% otrzymywanych obrażeń na {vulnerabilityDuration} s.",
	["skill.firebolt.name"] = "Ognisty Pocisk",
	["skill.firebolt.desc"] = "Ognisty pocisk zadający {dmg}% ataku magicznego, który dokłada {burnStacks} stos podpalenia.",
	["skill.iceShard.name"] = "Lodowy Odłamek",
	["skill.iceShard.desc"] = "Zadaje {dmg}% i spowalnia o {slow}% na {slowDuration} s.",
	["skill.blink.name"] = "Błysk",
	["skill.blink.desc"] = "Teleport o {length} st. w kierunku ruchu.",
	["skill.fireball.name"] = "Kula Ognia",
	["skill.fireball.desc"] = "Wybucha za {dmg}% w promieniu {radius} st. od punktu.",
	["skill.focus.name"] = "Skupienie",
	["skill.focus.desc"] = "Pasywna: rezerwa many +{reserve}%. Powiększa pulę many, ale nie przyspiesza regeneracji.",
	["skill.chainLightning.name"] = "Łańcuch Błyskawic",
	["skill.chainLightning.desc"] = "Błyskawica przeskakuje między {jumps} wrogami, {dmg}% (-10% na skok).",
	["skill.manaShield.name"] = "Tarcza Many",
	["skill.manaShield.desc"] = "Przez {duration} s 50% obrażeń zabiera manę zamiast życia.",
	["skill.frostNova.name"] = "Lodowa Nova",
	["skill.frostNova.desc"] = "Zadaje {dmg}% wokół i zamraża wrogów na {freezeDuration} s. Bossowie i Elity II nie zamarzają: dostają Głęboki Chłód, +{deepPct}% obrażeń od ciebie na {deepDuration} s.",
	["skill.meteor.name"] = "Meteor",
	["skill.meteor.desc"] = "Po chwili meteor uderza w obszar za {dmg}%.",
	["skill.firewall.name"] = "Burza Piorunów",
	["skill.firewall.desc"] = "Burza w kręgu {radius} st.: {hits} piorunów, co 0,5 s jeden uderza losowego wroga w kręgu za {dmg}%.",
	["skill.evocation.name"] = "Inwokacja",
	["skill.evocation.desc"] = "Kanałuj przez {duration} s, aby odzyskać {mana}% maksymalnej many. Obrażenia, ruch i każdy inny czar przerywają kanał.",
	["skill.meteorStorm.name"] = "Deszcz Meteorów",
	["skill.meteorStorm.desc"] = "{hits} meteorów spada w losowe miejsca kręgu {radius} st., każdy za {dmg}% w swoim małym obszarze i dokłada {burnStacks} stos podpalenia.",
	["skill.elementalVortex.name"] = "Wir Żywiołów",
	["skill.elementalVortex.desc"] = "Wir żywiołu Twojej broni krąży wokół Ciebie: {hits} fal co 0,4 s, każda zadaje {dmg}% ataku magicznego wrogom do {radius} st. Wir idzie za Tobą i nie przeszkadza w rzucaniu innych czarów. Żywioł broni dodaje swój efekt.",
	["skill.cataclysm.name"] = "Kataklizm",
	["skill.cataclysm.desc"] = "Ściąga wrogów z kręgu {radius} st. do jego środka (bossowie są odporni), potem {hits} fal co 0,6 s zadaje im po {dmg}% ataku magicznego. Żywioł broni dodaje swój efekt.",
	["skill.arcaneDischarge.name"] = "Wyładowanie Arkanów",
	["skill.arcaneDischarge.desc"] = "Pocisk czystej magii zadający {dmg}% ataku magicznego. Zużywa wszystkie Ładunki Arkanów: +{perCharge}% obrażeń za każdy. Ładunki podnoszą też jego koszt.",
	["skill.arcaneTorrent.name"] = "Strumień Arkanów",
	["skill.arcaneTorrent.desc"] = "Promień czystej magii w jeden cel do {range} st. przez {duration} s: {ticks} tyków po {dmg}% ataku magicznego, każdy kolejny o {growth}% mocniejszy. Każdy tyk pobiera {drain}% maks. many. Obrażenia go nie przerywają; kończy się przy ogłuszeniu, odrzuceniu, ruchu, innym czarze, braku many albo gdy cel zginie lub się oddali.",
	["skill.holyStrike.name"] = "Święte Uderzenie",
	["skill.holyStrike.desc"] = "Uderzenie światłem za {dmg}% ataku magicznego.",
	["skill.heal.name"] = "Leczenie",
	["skill.heal.desc"] = "Leczy Ciebie lub sojusznika o {healHp}% jego maks. życia + {healMag}% ataku magicznego.",
	["skill.renew.name"] = "Odnowa",
	["skill.renew.desc"] = "Leczy {healHp}% maks. życia celu + {healMag}% ataku magicznego przez {duration} s.",
	["skill.radiance.name"] = "Światłość",
	["skill.radiance.desc"] = "Zadaje {dmg}% wrogom w promieniu {radius} st. i leczy sojuszników o {heal}% tej wartości.",
	["skill.devotion.name"] = "Pobożność",
	["skill.devotion.desc"] = "Pasywna: +{heal}% leczenia.",
	["skill.circleOfLight.name"] = "Krąg Światła",
	["skill.circleOfLight.desc"] = "Leczy grupę w promieniu {radius} st. o {healHp}% maks. życia każdego + {healMag}% ataku magicznego.",
	["skill.purify.name"] = "Oczyszczenie",
	["skill.purify.desc"] = "Usuwa negatywne efekty i leczy o {healHp}% maks. życia celu + {healMag}% ataku magicznego.",
	["skill.auraOfEndurance.name"] = "Aura Wytrwałości",
	["skill.auraOfEndurance.desc"] = "Grupa w promieniu {radius} st. otrzymuje +{hp}% maksymalnego życia na {duration} s.",
	["skill.resurrection.name"] = "Wskrzeszenie",
	["skill.resurrection.desc"] = "Wskrzesza poległego sojusznika z {hp}% życia, pomijając licznik odrodzenia.",
	["skill.shieldOfFaith.name"] = "Tarcza Wiary",
	["skill.shieldOfFaith.desc"] = "Tarcza pochłaniająca {shieldHp}% maks. życia celu + {shieldMag}% ataku magicznego przez {duration} s.",
	["skill.divineWrath.name"] = "Boski Gniew",
	["skill.divineWrath.desc"] = "Pasywna: +{bonus}% obrażeń światła; Święte Uderzenie leczy Cię o {bonus}% zadanych obrażeń.",
	["skill.judgement.name"] = "Sąd",
	["skill.judgement.desc"] = "Zadaje {dmg}% i ogłusza na {stunDuration} s.",
	["skill.prayer.name"] = "Modlitwa",
	["skill.prayer.desc"] = "Kanałuj przez {duration} s: odnawia {mana}% many Tobie i {group}% grupie.",
	["skill.divineIntervention.name"] = "Boska Interwencja",
	["skill.divineIntervention.desc"] = "Grupa w promieniu {radius} st. staje się nietykalna na {invulnDuration} s i leczy {heal}% życia.",
	["skill.sanctuary.name"] = "Sanktuarium",
	["skill.sanctuary.desc"] = "Uświęca krąg {radius} st. w wybranym miejscu na {duration} s: co sekundę sojusznicy w środku odzyskują {healHp}% maks. życia i {healMag}% ataku magicznego.",
	["skill.guardianAngel.name"] = "Anioł Stróż",
	["skill.guardianAngel.desc"] = "Sojusznicy w promieniu {radius} st. są przez {guardianAngelDuration} s pod opieką anioła: pierwszy śmiertelny cios potwora zostawia ich z 1 pkt życia i leczy o {saveHeal}% maks. życia. Nie chroni przed graczami.",
	["skill.fortuneDice.name"] = "Rzut Kośćmi",
	["skill.fortuneDice.desc"] = "Rzucasz kośćmi dla drużyny w promieniu {radius} st.: każdy dostaje na {statBuffDuration} s jedną losową ścianę: Ostrze (+{crit} pkt. proc. szansy na krytyk), Wiatr (+{haste}% szybkości ataku) albo Źródło ({regen}% maks. życia co sekundę).",
	["skill.wheelOfFortune.name"] = "Koło Fortuny",
	["skill.wheelOfFortune.desc"] = "Drużyna w promieniu {radius} st. dostaje na {statBuffDuration} s wszystkie trzy ściany (krytyk +{crit} pkt. proc., szybkość ataku +{haste}%, {regen}% maks. życia co sekundę), a ściana wskazana przez koło działa o {boost}% mocniej. Wrogowie do {enemyRadius} st. chybiają zwykłe ataki z szansą {miss}%.",
	["skill.brandOfLight.name"] = "Piętno Światła",
	["skill.brandOfLight.desc"] = "Piętnuje cel światłem za {dmg}% ataku magicznego i podpala go: {dot}% ataku magicznego przez {burnDuration} s.",
	["skill.hammerOfHeaven.name"] = "Młot Niebios",
	["skill.hammerOfHeaven.desc"] = "Po chwili młot światła spada na krąg {radius} st.: {dmg}% ataku magicznego i ogłuszenie na {stunDuration} s (bossy i Elity II dostają tylko obrażenia).",

