	["event.invasion.name"] = "Inwazja",
	["event.invasion.desc"] = "Na łowisku otwiera się wyrwa: w jej kręgu ciągle pojawiają się potwory, z każdą fazą silniejsze, z Elitami, potem z Elitą II, a na końcu przychodzi ich dowódca: unikajcie jego ciosów i stańcie razem w złotym kręgu.",
