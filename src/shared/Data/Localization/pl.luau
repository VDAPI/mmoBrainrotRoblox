	["admin.companion.none"] = "{name}: brak towarzysza.",
	["admin.companion.reset"] = "{name}: towarzysz wrócił do punktu startu.",
	-- S101b: answers (Wit, Borys) and the page of side_den that remembers side_bears
	["quest.side_venom.say.where"] = "Gdzie te ropuchy siedzą?",
	["quest.side_venom.say.where.reply"] = "Na zachód od mojej chaty, przy wodzie. Zaznaczę ci, gdzie kumkają najgłośniej.",
	["quest.side_venom.say.luck"] = "Podobno ropuchy przynoszą szczęście.",
	["quest.side_venom.say.luck.reply"] = "Tym, które zostaną w bagnie. Tobie przyniosą wysypkę.",
	["quest.side_venom.say.jagna"] = "Jagna wyzdrowieje?",
	["quest.side_venom.say.jagna.reply"] = "Ysolde mówi, że tak. Wierzę jej, bo nie mam innego wyjścia.",
	["quest.side_bears.say.supplies"] = "Przyda mi się coś na rany.",
	["quest.side_bears.say.supplies.reply"] = "Masz dwie mikstury. Niedźwiedź nie pyta, czy jesteś gotów.",
	["quest.side_bears.say.quiet"] = "Mówisz o nich, jakby słuchały.",
	["quest.side_bears.say.quiet.reply"] = "Bo słuchają. Niedźwiedź słyszy, jak o nim mówisz. Ciszej.",
	["quest.side_bears.say.fire"] = "Nie boją się ognia? To niemożliwe.",
	["quest.side_bears.say.fire.reply"] = "Też tak myślałem. Do wczoraj.",
	["quest.side_den.say.denFirst"] = "Najpierw legowisko.",
	["quest.side_den.say.denFirst.reply"] = "Dobrze. Znak stawiamy, zanim ktoś tam wlezie.",
	["quest.side_den.say.goblinsFirst"] = "Najpierw gobliny.",
	["quest.side_den.say.goblinsFirst.reply"] = "Też dobrze. Mniej oczu w jarze.",
	["quest.side_den.say.drums"] = "W nocy było słychać bębny.",
	["quest.side_den.say.drums.reply"] = "To nie był wiatr. Wiatr nie trzyma rytmu.",
	["quest.side_den.p1.quiet"] = "Pamiętasz, co mówiłem? Ciszej. Największe legowisko leży pod skałą przy wodospadzie, a skała też ma uszy.",
	["quest.side_den.p1.fire"] = "Uważasz, że to niemożliwe? Pod skałą przy wodospadzie, gdzie leży największe legowisko, zobaczysz, co jest możliwe.",
	-- S101b: Borys walks with the player through side_den
	["quest.side_den.comp.join1"] = "Idę z tobą. Sam bym nie poszedł, ale we dwójkę niedźwiedź się zastanowi.",
	["quest.side_den.comp.join2"] = "Chodź. I nie mów głośno o niedźwiedziach.",
	["quest.side_den.comp.wait1"] = "Nie tak szybko. Jar ma uszy.",
	["quest.side_den.comp.back1"] = "Straciłem cię z oczu. Dołączę, jak wrócisz na Łąki.",
	-- S101b: comments during the story 1-20
	["quest.arrival.bark.accept1"] = "Rozejrzyj się po placu, a potem przyjdź do mnie. Mam dla ciebie robotę.",
	["quest.arrival.bark.done1"] = "Dobrze, że jesteś. Słuchaj uważnie, nie lubię powtarzać.",
	["quest.healer.bark.accept1"] = "Mikstura w pasie, nie w torbie. W walce nikt nie czeka, aż ją znajdziesz.",
	["quest.healer.bark.half1"] = "Smakuje paskudnie, wiem. Teraz idź do Mireli przy świątyni.",
	["quest.healer.bark.done1"] = "Widzę, że jeszcze stoisz. Tak trzymaj, mniej pracy dla mnie.",
	["quest.smith.bark.accept1"] = "Dorgan mówi, że stal lubi cierpliwość. Ludzie u niego jej nie mają.",
	["quest.smith.bark.half1"] = "Jedno ulepszenie jest. Teraz pokaż to Dorganowi, zanim zacznie narzekać.",
	["quest.smith.bark.done1"] = "Czterdzieści dwa uderzenia, liczyłem. Na pierwszy raz uczciwie.",
	["quest.portal.bark.accept1"] = "Brama na wschodzie, za nią portal. Nie zgub tego, co ci wykułem.",
	["quest.portal.bark.done1"] = "Nowa twarz? Stań tam, gdzie cię widzę, i nie płosz zwierzyny.",
	["quest.firstHunt.bark.accept1"] = "Króliki uciekają zygzakiem. Ty idź prosto, one i tak zawrócą.",
	["quest.firstHunt.bark.half1"] = "Nieźle. Jeszcze kilka i nie zapomnij zebrać, co po nich zostało.",
	["quest.firstHunt.bark.done1"] = "Wystarczy. Wróć do mnie, pogadamy o czymś, co gryzie.",
	["quest.gearUp.bark.accept1"] = "Załóż coś porządnego. Las nie lubi gołych rąk.",
	["quest.gearUp.bark.half1"] = "Już lepiej. Teraz zadbaj o siebie, nie tylko o to, co nosisz.",
	["quest.gearUp.bark.done1"] = "No proszę. Wyglądasz prawie groźnie.",
	["quest.wolves.bark.accept1"] = "Wataha krąży. Nie daj się otoczyć, wilki zawsze zachodzą od tyłu.",
	["quest.wolves.bark.half1"] = "Połowa watahy. Reszta już wie, że tu jesteś.",
	["quest.wolves.bark.done1"] = "Dosyć wilczej krwi. Wracaj, zanim zlecą się kruki.",
	["quest.wolfFangs.bark.accept1"] = "Ysolde płaci za całe kły, nie za ułamki. Celuj w żebra.",
	["quest.wolfFangs.bark.half1"] = "Połowa kłów. Wilki chyba zaczynają cię unikać.",
	["quest.wolfFangs.bark.done1"] = "Sześć całych kłów. Przynieś je, Ysolde przysłała coś w zamian.",
	["quest.boars.bark.accept1"] = "Dziki szarżują prosto. Ty nie musisz, zejdź im z drogi.",
	["quest.boars.bark.half1"] = "Las już mniej chrząka. Jeszcze kilka.",
	["quest.boars.bark.done1"] = "Drwale mogą wracać. Przyjdź, mam dla ciebie coś jeszcze.",
	["quest.herbs.bark.accept1"] = "Wiązówka pachnie miodem. Nie pomylisz, chyba że masz katar.",
	["quest.herbs.bark.half1"] = "Mirela potrzebuje pełnego naręcza, nie bukietu. Zbieraj dalej.",
	["quest.herbs.bark.done1"] = "Pachnie aż tutaj. Przynieś mi ją, zanim zwiędnie.",
	["quest.banditRoad.bark.accept1"] = "Bandyci mają nowe miecze. Ktoś je kupił i chcę wiedzieć kto.",
	["quest.banditRoad.bark.half1"] = "Trakt cichnie. Ci, co zostali, będą bardziej nerwowi.",
	["quest.banditRoad.bark.done1"] = "Droga wolna. Wracaj, kupcy coś dla ciebie zostawili.",
	["quest.banditOrders.bark.accept1"] = "Rozkazy noszą najważniejsi. Szukaj tych, którzy krzyczą najgłośniej.",
	["quest.banditOrders.bark.done1"] = "Masz te rozkazy? Nie czytaj po drodze. I tak przeczytasz, wiem.",
	["quest.goblinCamp.bark.accept1"] = "Obóz leży za wzgórzem na wschodzie. Dym widać z bramy.",
	["quest.goblinCamp.bark.half1"] = "Mira donosi, że gobliny się cofają. Nie zwalniaj.",
	["quest.goblinCamp.bark.done1"] = "Uciekają do jaskini. Przyjdź do mnie, wiem, gdzie się chowają.",
	["quest.mosshollow.bark.accept1"] = "W jaskini słychać bęben. Idź za nim, ale nie za szybko.",
	["quest.mosshollow.bark.half1"] = "Ich wojownicy nie ustąpią tak łatwo jak zwiadowcy. Uważaj.",
	["quest.mosshollow.bark.done1"] = "Wojownicy leżą. Wyjdź na światło, porozmawiamy o wodzu.",
	["quest.grimrok.bark.accept1"] = "Grimrok nie jest zwykłym goblinem. Wróć żywy, to wszystko, o co proszę.",
	["quest.grimrok.bark.done1"] = "Wódz goblinów nie żyje. Przyjdź do mnie, chcę to usłyszeć od ciebie.",
	-- S101b: comments during the Meadows side quests
	["quest.side_granary.bark.accept1"] = "Farma stoi za bramą, na zachód od kapliczki. Bartosz jest uparty, ale słowny.",
	["quest.side_granary.bark.done1"] = "Wiem, wiem, zamówienie. Chodź tu, sam zobaczysz, czemu się spóźniam.",
	["quest.side_rabbits.bark.accept1"] = "Na Polanie Królików jest ich więcej niż kapusty. Na razie.",
	["quest.side_rabbits.bark.half1"] = "Połowa. Reszta ucieka, ale jutro wróci z rodziną.",
	["quest.side_rabbits.bark.done1"] = "Od razu ciszej. Wracaj, mam kolejny kłopot.",
	["quest.side_fence.bark.accept1"] = "Cztery rogi warzywnika. Deski leżą przy stodole, młotek też.",
	["quest.side_fence.bark.half1"] = "Dwa rogi gotowe. Zostały te od strony lasu.",
	["quest.side_fence.bark.done1"] = "Teraz to jest płot. Przyjdź, niech ci podziękuję jak należy.",
	["quest.side_sheep.bark.accept1"] = "Dzwonki znajdziesz w wilkach. Szukaj na polanach i na zboczach wzgórz.",
	["quest.side_sheep.bark.half1"] = "Poznam je po dźwięku. Moje owce dzwoniły czysto.",
	["quest.side_sheep.bark.done1"] = "Pięć dzwonków. Przynieś je, chcę je zobaczyć.",
	["quest.side_grainCart.bark.accept1"] = "Worek dla Ignacego. Uważaj na wilki przy drodze, pogoda im służy.",
	["quest.side_grainCart.bark.half1"] = "Droga do miasta coraz czystsza. Mój chłopak może przestanie się bać.",
	["quest.side_grainCart.bark.done1"] = "Zboże od Bartosza? Przynieś je do spichlerza, zanim zmoknie.",
	["quest.side_shrine.bark.accept1"] = "Świece są w kapliczce. Zapal je powoli, dąb nie lubi pośpiechu.",
	["quest.side_shrine.bark.half1"] = "Czuję ciepło od strony Łąk. Zostało niewiele.",
	["quest.side_shrine.bark.done1"] = "Wróć do mnie, kiedy będziesz gotów. Modlitwa poczeka.",
	["quest.side_stoneCircle.bark.accept1"] = "Krąg stoi na grzbiecie Wilczych Wzgórz. Idź tam z czystą głową.",
	["quest.side_stoneCircle.bark.half1"] = "Krwi w kręgu ubywa. Jeszcze kilka rysi.",
	["quest.side_stoneCircle.bark.done1"] = "Krąg znów milczy. Wróć i opowiedz mi o nim.",
	["quest.side_father.bark.accept1"] = "Chata ojca stoi na północnym brzegu oczka. Pewnie siedzi przy sieciach.",
	["quest.side_father.bark.done1"] = "Czuję chleb Jagny aż tutaj. Chodź, nie stój tak.",
	["quest.side_toads.bark.accept1"] = "Ropuchy siedzą na mokradłach. Nie patrz im długo w oczy, to zły znak.",
	["quest.side_toads.bark.half1"] = "Już mniej rechotu. Ryby to słyszą.",
	["quest.side_toads.bark.done1"] = "Woda odetchnęła. Wracaj, mam jeszcze jedną sprawę.",
	["quest.side_venom.bark.accept1"] = "Woreczki zawiązuj szczelnie. Jad przeżera płótno szybciej niż skórę.",
	["quest.side_venom.bark.half1"] = "Trzy woreczki. Jagna już mniej kaszle, choć to pewnie przypadek.",
	["quest.side_venom.bark.done1"] = "Sześć woreczków, jak słyszę. Przynieś je ostrożnie, jad nie lubi wstrząsów.",
	["quest.side_venom.bark.stuck1"] = "Ropuchy trzymają się wody na Żabim Oczku. Na suchym ich nie znajdziesz.",
	["quest.side_net.bark.accept1"] = "Sieć utknęła za pomostem. Ciągnij od dołu, nie od góry.",
	["quest.side_net.bark.half1"] = "Sieć na brzegu. Teraz ryby, bez nich Jagna nie uwierzy.",
	["quest.side_net.bark.done1"] = "Ryby od ojca? Przynieś je, zanim przestaną pachnieć rzeką.",
	["quest.side_roast.bark.accept1"] = "Dziki w Starym Lesie są tłuste jak nigdy. Weź najlepsze udźce.",
	["quest.side_roast.bark.half1"] = "Trzy udźce. Kucharka już ostrzy noże.",
	["quest.side_roast.bark.done1"] = "Czuję pieczeń, zanim jeszcze ją upiekłem. Wracaj do karczmy.",
	["quest.side_woodcutter.bark.accept1"] = "Gerwazy mieszka na polanie przy leśnej ścieżce. Piwa nie otwieraj po drodze.",
	["quest.side_woodcutter.bark.done1"] = "Piwo od Wacława? Chodź, siadaj. Las poczeka, on zawsze czeka.",
	["quest.side_logs.bark.accept1"] = "Stosy są rozrzucone po lesie. Las oddaje, jak się go nie pogania.",
	["quest.side_logs.bark.half1"] = "Połowa roboty. Kruki już omijają moje stosy.",
	["quest.side_logs.bark.done1"] = "Znaki stoją, kruki precz. Wróć, coś mi jeszcze nie daje spokoju.",
	["quest.side_shiny.bark.accept1"] = "Kruki chowają błyskotki w gniazdach. Ten sygnet z herbem młyna nie daje mi spać.",
	["quest.side_shiny.bark.half1"] = "Guziki, gwoździe, moneta. Szukaj dalej, sygnet musi gdzieś być.",
	["quest.side_shiny.bark.done1"] = "Mówią, że masz coś dla mnie. Przyjdź, proszę.",
	["quest.side_mill.bark.accept1"] = "Zgliszcza leżą na Kruczym Polu. Uważaj na siebie, proszę.",
	["quest.side_mill.bark.half1"] = "Dziękuję, że tam jesteś. Nikt inny nie chciał iść.",
	["quest.side_mill.bark.done1"] = "Wróć do mnie z tym, co tam leży. Muszę wiedzieć.",
	["quest.side_smugglers.bark.accept1"] = "Kryjówka jest w jaskini na południu. Przynieś księgę, nic więcej mi nie trzeba.",
	["quest.side_smugglers.bark.half1"] = "Herszt jest blisko. Nie daj mu uciec z księgą.",
	["quest.side_smugglers.bark.done1"] = "Księga Herszta? Przynieś ją do wartowni, zanim ktoś zacznie jej szukać.",
	["quest.side_wagon.bark.accept1"] = "Konie wróciły same, z przeciętymi postronkami. Szukaj Lucjana przy trakcie.",
	["quest.side_wagon.bark.done1"] = "Ktoś mnie szuka? Tutaj, przy wozie. Albo przy tym, co z niego zostało.",
	["quest.side_goods.bark.accept1"] = "Osiem bel sukna, każda warta więcej niż ci łotrzy razem wzięci.",
	["quest.side_goods.bark.half1"] = "Cztery bele odzyskane. Jeszcze tyle samo.",
	["quest.side_goods.bark.done1"] = "Wszystkie bele? Wracaj, policzę je przy tobie, żeby nie było nieporozumień.",
	["quest.side_wanted.bark.accept1"] = "Piętnastu z traktu. Licz głośno, chcę to mieć w raporcie.",
	["quest.side_wanted.bark.half1"] = "Połowa listy. Nie zwalniaj, oni też umieją liczyć.",
	["quest.side_wanted.bark.done1"] = "Trakt czysty. Spocznij i zgłoś się do wartowni po nagrodę.",
	["quest.side_ore.bark.accept1"] = "Wyrobisko jest na wschodzie. List oddaj do rąk własnych, nie przez koboldy.",
	["quest.side_ore.bark.done1"] = "List od Dorgana? Dawaj, i tak wiem, co tam napisał.",
	["quest.side_tools.bark.accept1"] = "Kilofy mają mój znak na trzonku. Koboldy znaków nie czytają, ale kradną.",
	["quest.side_tools.bark.half1"] = "Trzy kilofy. To dziewięć godzin kopania więcej na dzień, policzyłem.",
	["quest.side_tools.bark.done1"] = "Wszystkie sześć? Wracaj, zanim koboldy zauważą, że ich nie ma.",
	["quest.side_tunnels.bark.accept1"] = "Trzy sztolnie na tarasach. Deski przybijaj na krzyż, tak trzyma najdłużej.",
	["quest.side_tunnels.bark.half1"] = "Dobrze idzie. Koboldy będą musiały kopać nowe nory, a to potrwa.",
	["quest.side_tunnels.bark.done1"] = "Ruda od Dobromira? Niech zgadnę, punktualnie. Przynieś ją do kuźni.",
	["quest.side_totem.bark.accept1"] = "Obóz na północnym wschodzie. Najpierw zwiadowcy, potem totem. Taki jest rozkaz.",
	["quest.side_totem.bark.half1"] = "Raport: zwiadowców ubywa, totem jeszcze stoi. Kontynuować.",
	["quest.side_totem.bark.done1"] = "Dym widać z wartowni. Zgłoś się z raportem.",
	["quest.side_foreman.bark.accept1"] = "Kopiec leży pod wzgórzami. Dwóch brygadzistów, bez zbędnego bohaterstwa.",
	["quest.side_foreman.bark.half1"] = "Raport z Kopca dobry. Brygadziści trzymają się przy rudzie.",
	["quest.side_foreman.bark.done1"] = "Brygadziści leżą? Wracaj, górnicy chcą ci podziękować.",
	["quest.side_hunter.bark.accept1"] = "Borys poluje nad Niedźwiedzim Jarem. Zanieś mu to, zanim zje własne buty.",
	["quest.side_hunter.bark.done1"] = "Czuję suchary Wacława. Chodź tu, tylko cicho, jar słucha.",
	["quest.side_bears.bark.accept1"] = "Dziesięć niedźwiedzi i cztery pazury. Zachodź je pod wiatr.",
	["quest.side_bears.bark.half1"] = "Niedźwiedzie się burzą. Coś je goni od strony skał.",
	["quest.side_bears.bark.done1"] = "Pokaż mi pazury. Muszę wiedzieć, gdzie bywały.",
	["quest.side_bears.bark.stuck1"] = "Niedźwiedzie trzymają się jaru, poniżej mojego obozu. Tam ich szukaj.",
	["quest.side_den.bark.accept1"] = "Prowadź. Ja patrzę na krzaki.",
	["quest.side_den.bark.half1"] = "Znak stoi. Teraz ci, co tu bębnią.",
	["quest.side_den.bark.near1"] = "Czujesz smołę? Niedźwiedzie tak nie pachną.",
	["quest.side_den.bark.done1"] = "Dosyć. Wracajmy do obozu, zanim przyjdą następni.",
	["quest.side_den.bark.death1"] = "Wstawaj. Nie zostawię cię tu.",
	["quest.side_den.bark.stuck1"] = "Gobliny trzymają się wyżej, przy skałach. Tam patrz.",
	-- S101b: comments during the stable arc (S96)
	["quest.side_stable_harness.bark.accept1"] = "Trzy części uprzęży. Gobliny rozkradły ją w obozie, pewnie noszą jak ozdoby.",
	["quest.side_stable_harness.bark.half1"] = "Większość uprzęży już jest. Jeszcze trochę i zaczynam szyć.",
	["quest.side_stable_harness.bark.done1"] = "Uprząż nie gryzie, w przeciwieństwie do konia. Przynieś ją.",
	["quest.side_stable_stallion.bark.accept1"] = "Podchodź cicho, z pustymi rękami. Ogier czyta ręce szybciej niż twarz.",
	["quest.side_stable_stallion.bark.half1"] = "Coraz spokojniej nad jarem. Ogier to czuje.",
	["quest.side_stable_stallion.bark.done1"] = "Ogier stoi przy moim obozie. Przyjdź, tylko nie trzaskaj gałęziami.",
	["quest.side_stable_ride.bark.accept1"] = "Pięty w dół, głowa do góry. I nie ciągnij za postronek, prowadź.",
	["quest.side_stable_ride.bark.done1"] = "Widzę was od bramy. Prowadź go prosto do boksu.",
	-- S102: story chapter I "The Frost Sign" (pages, new quests, answers, comments, cutscenes, admin)
	["quest.arrival.p1"] = "Witaj w Vaelthornie. Miasto potrzebuje ludzi. Od kilku tygodni kupcy z północy przestali dojeżdżać i nikt nie wie dlaczego.",
	["quest.arrival.p2"] = "Zanim pójdziesz za mury, naucz się podstaw. Zacznij od Lekarki Mireli przy świątyni.",
	["quest.healer.p1"] = "Mikstura ratuje życie częściej niż miecz. Zawsze noś kilka przy sobie.",
	["quest.healer.p2"] = "Wypij jedną teraz, żeby wiedzieć, jak działa, i idź do Mireli. Ona nauczy cię reszty.",
	["quest.smith.p1"] = "Z taką bronią daleko nie zajdziesz. Widziałam, co zostaje z ludzi, którzy myśleli inaczej.",
	["quest.smith.p2"] = "Idź do Kowala Dorgana i ulepsz coś do +1. Potem porozmawiaj z nim, lubi wiedzieć, dla kogo kuje.",
	["quest.portal.p1"] = "Za wschodnią bramą stoi portal na Szepczące Łąki. Kilka kroków i jesteś poza miastem.",
	["quest.portal.p2"] = "Po drugiej stronie czeka Zwiadowczyni Mira. Słuchaj jej. Zna każdą norę na Łąkach.",
	["quest.firstHunt.p1"] = "Najpierw króliki. Nie śmiej się, nauczą cię celować i nie tracić tchu.",
	["quest.firstHunt.p2"] = "Upoluj kilka i zbierz, co po nich zostanie. Łup nie leży długo, las szybko go zabiera.",
	["quest.gearUp.p1"] = "Łup w torbie nic ci nie da. Rzecz działa dopiero wtedy, kiedy ją nosisz.",
	["quest.gearUp.p2"] = "Załóż to, co lepsze, i rozdziel punkty w oknie plecaka (B). Potem wracaj, coś dla ciebie znajdę.",
	["quest.wolves.p1"] = "Wilki schodzą ze wzgórz coraz niżej. W tym roku za wcześnie i za śmiało.",
	["quest.wolves.p2"] = "Przerzedź watahę. A przy okazji naucz się czegoś nowego, sama siła nie wystarczy.",
	["quest.wolfFangs.p1"] = "Ysolde płaci za wilcze kły. Garnizon potrzebuje jej wywarów, a ona potrzebuje kłów.",
	["quest.wolfFangs.p2"] = "Przynieś sześć. Całe, nie połamane, bo inaczej będzie marudzić.",
	["quest.boars.p1"] = "Dziki w Starym Lesie są nerwowe. Jakby coś wypłoszyło je z głębi lasu.",
	["quest.boars.p2"] = "Przetrzeb je, zanim stratują drwali. Potem pomyślimy, co je goni.",
	["quest.herbs.p1"] = "Mirela prosiła o wiązówkę. Rośnie na polach i pachnie miodem.",
	["quest.herbs.p2"] = "Pięć gałązek. Mirela leczy ostatnio rzeczy, których sama nie rozumie, i potrzebuje wszystkiego, co ma pod ręką.",
	["quest.banditRoad.p1"] = "Na starym trakcie znów rabują. Kupcy boją się jechać nawet z eskortą.",
	["quest.banditRoad.p2"] = "Bandytów jest więcej niż zwykle i mają lepszą broń. Ktoś im płaci. Oczyść trakt.",
	["quest.banditOrders.p1"] = "Bandyci, których zabiłeś, nosili przy sobie kartki. Rozkazy, nie listy miłosne.",
	["quest.banditOrders.p2"] = "Zdobądź jeden taki list. Któryś z nich na pewno go ma.",
	["quest.banditOrders.p3"] = "Nie czytaj go przy ognisku. Zanieś go prosto do Kapitana Aldrica.",
	["quest.goblinCamp.p1"] = "Gobliny ze wschodu zbierają się w obozie. Za dużo ich jak na zwykły rabunek.",
	["quest.goblinCamp.p2"] = "Rozbij obóz, zanim ruszą na trakt. Mira pokaże ci drogę.",
	["quest.mosshollow.p1"] = "W Jaskini Mchów gobliny mają wodza. Uciekinierzy z obozu poszli prosto do niego.",
	["quest.mosshollow.p2"] = "Przerzedź jego straż. Bez wojowników wódz zostanie sam.",
	["quest.grimrok.p1"] = "Grimrok czeka w swojej komnacie w głębi jaskini. Wie, że po niego przyjdziemy.",
	["quest.grimrok.p2"] = "Nie idź sam. Weź ludzi, którym ufasz.",
	["quest.grimrok.p3"] = "Jeśli wie, kim jest pan z północy, powie to przed śmiercią. Słuchaj uważnie.",
	["quest.frostRuins.title"] = "Szron w środku lata",
	["quest.frostRuins.p1"] = "Wczoraj opatrywałam drwala ze Starego Lasu. Miał odmrożone palce, choć mamy środek lata.",
	["quest.frostRuins.p2"] = "Mówił o starej wieży w lesie. Kamienie są tam podobno białe od szronu.",
	["quest.frostRuins.p3"] = "Idź i zobacz to na własne oczy. Potem powiedz Mirze, co tam znalazłeś.",
	["quest.frostRuins.text"] = "Lekarka Mirela opatrzyła drwala z odmrożonymi dłońmi. Zbadaj ruiny wieży w Starym Lesie i powiedz Mirze, co tam znalazłeś.",
	["quest.frostRuins.done"] = "Płatek śniegu przebity cierniem? Nie znam tego herbu. A runa jest świeża, ktoś ją wyrył niedawno. Na razie trzymajmy się tego, co znamy: bandytów.",
	["quest.frostSign.title"] = "Znak Długiej Zimy",
	["quest.frostSign.p1"] = "Sierżant Dobiesław przesłuchał schwytanych bandytów. Dowiedz się od niego, kto im płacił.",
	["quest.frostSign.p2"] = "Ten herb z rozkazu widziałeś już na ruinach wieży. To nie jest przypadek.",
	["quest.frostSign.p3"] = "Pokaż go Bratu Anzelmowi w świątyni. Jeśli ktoś jeszcze pamięta stare znaki, to on.",
	["quest.frostSign.text"] = "Dowiedz się od Sierżanta Dobiesława, kto płacił bandytom, i pokaż znak Bratu Anzelmowi w świątyni.",
	["quest.frostSign.done"] = "Ilvar. Pamiętam go: spokojny człowiek, zawsze z książką. Jeśli Anzelm ma rację, mamy większy kłopot niż bandyci.",
	["quest.frostSign.done.chance"] = "Przypadek, mówiłeś. Przypadki nie mają imion. Ten ma: Ilvar. Spokojny człowiek, zawsze z książką. Jeśli Anzelm ma rację, mamy większy kłopot niż bandyci.",
	["quest.frostSign.sergeant"] = "Płacił im człowiek w szarym płaszczu. Mówił cicho i równo, jak kapłan z ambony. Twarzy nikt nie pamięta, tylko zimne ręce.",
	["quest.frostSign.anzelm"] = "Płatek przebity cierniem. Znak Długiej Zimy i tego, który ją przyniósł. Jego imienia nie wymawiamy.",
	["quest.warrenCharms.title"] = "Amulety, które nie topnieją",
	["quest.warrenCharms.p1"] = "Gobliny z obozu uciekły do Goblińskiego Kopca. Część miała na szyjach coś białego.",
	["quest.warrenCharms.p2"] = "Ich wojownicy nie oddadzą tego po dobroci.",
	["quest.warrenCharms.p3"] = "Zejdź do Kopca, pokonaj wojowników i przynieś mi te amulety.",
	["quest.warrenCharms.text"] = "W Goblińskim Kopcu pokonaj goblińskich wojowników i zdobądź ich Szronowe Amulety.",
	["quest.warrenCharms.done"] = "Trzymałam jeden nad ogniem przez całą wartę. Nawet nie zwilgotniał. Gobliny mówią, że to dar od pana z północy.",
	["quest.warCouncil.title"] = "Narada w Vaelthornie",
	["quest.warCouncil.p1"] = "Grimrok nie żyje, ale to nie on wymyślił tę wojnę.",
	["quest.warCouncil.p1.jewelry"] = "Mira powtarza w koszarach twój żart o goblinach w biżuterii. Nikt się nie śmieje, ale powtarza. Grimrok nie żyje, ale to nie on wymyślił tę wojnę.",
	["quest.warCouncil.p1.ready"] = "Mówiłeś Mirze, że dasz radę. Dałeś. Grimrok nie. Ale to nie on wymyślił tę wojnę.",
	["quest.warCouncil.p2"] = "Dorgan chce obejrzeć jego topór, a Ysolde amulet.",
	["quest.warCouncil.p3"] = "Wysłuchaj ich obu i wróć do mnie.",
	["quest.warCouncil.p4"] = "Wtedy zdecydujemy, dokąd pójdziesz dalej.",
	["quest.warCouncil.text"] = "Pokaż topór Grimroka Kowalowi Dorganowi i zanieś Szronowy Amulet Alchemiczce Ysolde. Potem wróć do Kapitana Aldrica.",
	["quest.warCouncil.done"] = "Krasnoludzka stal, łuska czegoś zimnego i kapłan, który odszedł na północ. Ilvar zniknął w Mrocznym Borze. Tam pójdziesz.",
	["quest.warCouncil.blacksmith"] = "Runy na tym toporze są krasnoludzkie, stal też. Taką kuje się tylko w Kuźni Głębin, daleko na wschodzie. Gobliny nie miały za co jej kupić.",
	["quest.warCouncil.alchemist"] = "W amulecie jest pył z łuski. Czegoś, co żyje i jest zimne. Nie wiem, co ma takie łuski, i wolałabym się nie dowiedzieć.",
	["quest.frostRuins.say.go"] = "Idę od razu.",
	["quest.frostRuins.say.go.reply"] = "Weź płaszcz. Wiem, że jest lato.",
	["quest.frostRuins.say.exaggerate"] = "Drwale lubią przesadzać.",
	["quest.frostRuins.say.exaggerate.reply"] = "Palce mu nie przesadzały. Były sine.",
	["quest.frostRuins.say.supplies"] = "Co mam zabrać?",
	["quest.frostRuins.say.supplies.reply"] = "Dwie mikstury. Drwal też myślał, że wystarczy mu siekiera.",
	["quest.frostSign.say.chance"] = "Może to przypadek.",
	["quest.frostSign.say.chance.reply"] = "W wojsku przypadkiem nazywamy to, czego jeszcze nie rozumiemy.",
	["quest.frostSign.say.same"] = "Ten sam znak. Ktoś za tym stoi.",
	["quest.frostSign.say.same.reply"] = "Też tak myślę. Dlatego nie mówimy o tym na placu.",
	["quest.frostSign.say.who"] = "Kim jest Brat Anzelm?",
	["quest.frostSign.say.who.reply"] = "Pamięta więcej niż kroniki. Mów cicho, nie lubi pośpiechu.",
	["quest.warrenCharms.say.count"] = "Ilu ich jest?",
	["quest.warrenCharms.say.count.reply"] = "Za dużo, żeby liczyć na głos. Zaznaczę ci wejście do Kopca.",
	["quest.warrenCharms.say.jewelry"] = "Gobliny w biżuterii. Świat schodzi na psy.",
	["quest.warrenCharms.say.jewelry.reply"] = "Psy przynajmniej nie noszą amuletów. Na razie.",
	["quest.warrenCharms.say.ready"] = "Dam radę.",
	["quest.warrenCharms.say.ready.reply"] = "Wszyscy tak mówią. Część potem wraca.",
	["quest.warCouncil.say.smithFirst"] = "Najpierw Dorgan.",
	["quest.warCouncil.say.smithFirst.reply"] = "Dobrze. Nie daj mu tylko zacząć o hartowaniu.",
	["quest.warCouncil.say.alchemistFirst"] = "Najpierw Ysolde.",
	["quest.warCouncil.say.alchemistFirst.reply"] = "Rozsądnie. Ysolde nie lubi czekać.",
	["quest.warCouncil.say.burn"] = "Może po prostu spalić te amulety?",
	["quest.warCouncil.say.burn.reply"] = "Mira próbowała. Amulet przetrwał, ognisko nie.",
	["quest.frostRuins.bark.accept1"] = "Przy bramie czeka Mira. Powiedz jej, że to ode mnie.",
	["quest.frostRuins.bark.near1"] = "Czujesz? Zimno jak w piwnicy, a słońce praży.",
	["quest.frostRuins.bark.half1"] = "Kruki zawsze pierwsze wiedzą, gdzie coś jest nie tak.",
	["quest.frostRuins.bark.done1"] = "Wracaj do bramy. Chcę to obejrzeć jeszcze raz, na spokojnie.",
	["quest.frostRuins.bark.death1"] = "Wstawaj. Kruki już ustawiają się w kolejce.",
	["quest.frostRuins.comp.join1"] = "Mirela cię przysłała? Chodź, znam skrót przez Stary Las.",
	["quest.frostRuins.comp.wait1"] = "Nie zostawaj w tyle. Las nie lubi samotnych.",
	["quest.frostRuins.comp.back1"] = "Zgubiłam cię. Wracam do bramy, tam mnie znajdziesz.",
	["quest.frostSign.bark.accept1"] = "Dobiesław stoi przy wschodniej bramie. Nie daj mu się rozgadać o musztrze.",
	["quest.frostSign.bark.half1"] = "Świątynia za fontanną. Jeszcze kawałek.",
	["quest.frostSign.bark.done1"] = "Wróć do mnie. Wolę usłyszeć to imię od ciebie niż z plotek.",
	["quest.frostSign.bark.stuck1"] = "Anzelm siedzi w świątyni, obok lekarki. Nie przegapisz go.",
	["quest.frostSign.comp.join1"] = "Do świątyni? Prowadzę. Krok równy, nie biegniemy.",
	["quest.frostSign.comp.wait1"] = "Tempo, rekrucie. Świątynia sama do nas nie przyjdzie.",
	["quest.frostSign.comp.arrive1"] = "Dalej sam. Ja do świątyni wchodzę tylko na pogrzeby.",
	["quest.frostSign.comp.back1"] = "Zgubić się we własnym mieście? Czekam przy bramie.",
	["quest.warrenCharms.bark.accept1"] = "Kopiec jest za obozem. Nie wchodź tam bez mikstur.",
	["quest.warrenCharms.bark.half1"] = "Połowa. Te amulety dzwonią jak krowie dzwonki.",
	["quest.warrenCharms.bark.done1"] = "Starczy. Wracaj, zanim policzą straty.",
	["quest.warrenCharms.bark.death1"] = "Wstań. Gobliny i tak nie umieją się chwalić.",
	["quest.warrenCharms.bark.stuck1"] = "Amulety mają tylko wojownicy. Szukaj tych z lepszymi toporami.",
	["quest.warCouncil.bark.accept1"] = "Najpierw kowal i alchemiczka. Potem rozmowa, której nie lubię.",
	["quest.warCouncil.bark.half1"] = "Jedno już wiesz. Teraz drugie.",
	["quest.warCouncil.bark.done1"] = "Wracaj na plac. Złożymy to w całość.",
	["story.chapter.1"] = "Rozdział I: Znak Mrozu",
	["story.chapter.2"] = "Rozdział II: Zapomniany Ród",
	["story.chapter.3"] = "Rozdział III: Zimny Ogień",
	["story.chapter.4"] = "Rozdział IV: Długa Zima",
	["story.chapter.1.end"] = "Koniec rozdziału I",
	["quest.item.frostCharm"] = "Szronowy Amulet",
	["place.towerRuins"] = "Ruiny wieży w Starym Lesie",
	["place.temple"] = "Świątynia Vaelthornu",
	["quest.use.crest"] = "Oczyść herb ze szronu",
	["cutscene.ch1_open.title"] = "Vaelthorn",
	["cutscene.ch1_open.l1"] = "Od tygodni z północy wieje wiatr, który nie pasuje do lata. Kupcy przestali dojeżdżać.",
	["cutscene.ch1_open.l2"] = "Vaelthorn potrzebuje rąk, które utrzymają miecz. Zacznij od podstaw, a potem idź za mury.",
	["cutscene.portal_gate.l1"] = "Nowy? Aldric przysyła mi coraz młodszych.",
	["cutscene.portal_gate.l2"] = "Łąki wyglądają spokojnie. Nie daj się zwieść. Chodź, pokażę ci, jak się tu poluje.",
	["cutscene.frost_ruins.l1"] = "Kamień pod palcami jest zimny jak w środku zimy. Spod szronu wyłania się herb: płatek śniegu przebity cierniem.",
	["cutscene.frost_ruins.l2"] = "Z wieży zrywają się kruki. Przez chwilę słychać tylko ich krzyk.",
	["cutscene.bandit_orders.l1"] = "Złoto goblinów… i ten znak.",
	["cutscene.bandit_orders.l2"] = "Płatek śniegu przebity cierniem. Ten sam, który widziałeś na ruinach wieży.",
	["cutscene.bandit_orders.l3"] = "Ktoś pisze rozkazy dla bandytów. I nie podpisuje się imieniem.",
	["cutscene.frost_sign.l1"] = "Zakazaną kronikę o Długiej Zimie czytał w tej świątyni tylko jeden człowiek.",
	["cutscene.frost_sign.l2"] = "Brat Ilvar. Mój współbrat. Dziesięć lat temu odszedł na północ i nie wrócił.",
	["cutscene.frost_sign.l3"] = "Modliłem się, żeby nie żył. Chyba się nie doczekam.",
	["cutscene.grimrok_end.l1"] = "Myślisz… że wygrałeś? Pan z północy obiecał nam ciepło, kiedy przyjdzie zima.",
	["cutscene.grimrok_end.l2"] = "Przyjdzie po was wszystkich…",
	["cutscene.grimrok_end.l3"] = "Wódz goblinów milknie. Na ostrzu jego topora lśnią obce runy.",
	["cutscene.ch1_close.l1"] = "Na skraju Mrocznego Boru, tam gdzie kończą się Łąki, stoi ktoś w szarym płaszczu.",
	["cutscene.ch1_close.l2"] = "Długo patrzy na południe, jakby liczył dachy Vaelthornu. Potem powietrze zasnuwa szron i postaci już nie ma.",
	["cutscene.who.ilvar"] = "Głos Zimy",
	["cutscene.skip"] = "Pomiń",
	["cutscene.next"] = "Dalej ▸",
	["quest.journal.pages"] = "Przypomnij rozmowę",
	["quest.journal.replay"] = "Obejrzyj scenę ponownie",
