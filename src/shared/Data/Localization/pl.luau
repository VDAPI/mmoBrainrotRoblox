	-- Main story (S11)
	["quest.arrival.title"] = "Przybycie",
	["quest.arrival.text"] = "Kapitan Aldric czeka na placu. Zgłoś się do niego.",
	["quest.arrival.done"] = "Dobrze. Vaelthorn potrzebuje ludzi, którzy utrzymają miecz. Słuchaj uważnie.",
	["quest.healer.title"] = "Rany się goją",
	["quest.healer.text"] = "Zanim wyruszysz, naucz się o siebie dbać: wypij miksturę i odwiedź Lekarkę Mirelę przy świątyni.",
	["quest.healer.done"] = "Mikstury, bandaże, modlitwy — używaj wszystkiego. Martwi nie walczą.",
	["quest.smith.title"] = "Stal pamięta",
	["quest.smith.text"] = "Kowal Dorgan wzmacnia broń. Ulepsz dowolny przedmiot do +1 i porozmawiaj z nim.",
	["quest.smith.done"] = "Nieźle jak na pierwszy raz. Im wyżej, tym łatwiej coś pęknie.",
	["quest.portal.title"] = "Za murami",
	["quest.portal.text"] = "Przejdź przez portal przy wschodniej bramie na Szepczące Łąki. Czeka tam Zwiadowczyni Mira.",
	["quest.portal.done"] = "A więc kapitan cię przysłał. Zobaczmy, co potrafisz.",
	["quest.firstHunt.title"] = "Pierwsze łowy",
	["quest.firstHunt.text"] = "Kliknij królika, by go wybrać — atakujesz sam. Upoluj pięć i podnieś, co zostawią (F).",
	["quest.firstHunt.done"] = "Czysta robota. Króliki nie gryzą. Wilki gryzą.",
	["quest.gearUp.title"] = "Ekwipunek",
	["quest.gearUp.text"] = "Załóż przedmiot z plecaka i rozdaj punkt statystyk w oknie postaci (C).",
	["quest.gearUp.done"] = "Lepiej. Weź ten większy plecak — przyda się miejsce.",
	["quest.wolves.title"] = "Wataha",
	["quest.wolves.text"] = "Szare wilki napadają podróżnych na polach. Przerzedź watahę i połóż nową umiejętność na pasku (K).",
	["quest.wolves.done"] = "Wataha cię zapamięta. To dobrze.",
	["quest.wolfFangs.title"] = "Kły dla alchemiczki",
	["quest.wolfFangs.text"] = "Alchemiczka potrzebuje wilczych kłów do wywarów. Przynieś sześć.",
	["quest.wolfFangs.done"] = "Proszę, błogosławieństwo od niej. Użyj go mądrze.",
	["quest.boars.title"] = "Kły w lesie",
	["quest.boars.text"] = "Dziki opanowały las na północ od pól. Przegoń je.",
	["quest.boars.done"] = "Drwale mogą wrócić do pracy. Dziękuję.",
	["quest.herbs.title"] = "Wiązówka",
	["quest.herbs.text"] = "Lekarce Mirelce kończą się zioła. Zbierz wiązówkę na polach i zanieś jej.",
	["quest.herbs.done"] = "Dokładnie tego potrzebowałam. Weź te mikstury.",
	["quest.banditRoad.title"] = "Stary trakt",
	["quest.banditRoad.text"] = "Bandyci rabują karawany na starym trakcie. Uczyń drogę bezpieczną.",
	["quest.banditRoad.done"] = "Kupcy przesyłają podziękowania — i plecak.",
	["quest.banditOrders.title"] = "Rozkazy z północy",
	["quest.banditOrders.text"] = "Ktoś płaci tym bandytom. Znajdź ich rozkazy i zanieś Kapitanowi Aldricowi.",
	["quest.banditOrders.done"] = "Złoto goblinów... i znak mrozu. To gorsze, niż myślałem.",
	["quest.goblinCamp.title"] = "Obóz goblinów",
	["quest.goblinCamp.text"] = "Gobliny ze wschodu się gromadzą. Rozbij ich obóz, zanim wyruszą.",
	["quest.goblinCamp.done"] = "Uciekają do jaskini. Mają dokąd uciekać.",
	["quest.mosshollow.title"] = "Jaskinia Mchów",
	["quest.mosshollow.text"] = "Podążaj za goblinami do Jaskini Mchów. Uwaga: w środku każdy może cię zaatakować.",
	["quest.mosshollow.done"] = "Ich wojownicy padają. Został ich wódz.",
	["quest.grimrok.title"] = "Grimrok",
	["quest.grimrok.text"] = "Grimrok, Wódz Goblinów, czeka w swojej komnacie w głębi jaskini. Zbierz towarzyszy i skończ z nim.",
	["quest.grimrok.done"] = "Umierając, Grimrok mówił o panu z północy... Odpocznij i ruszaj dalej.",
	["quest.toDuskwood.title"] = "W głąb Mrocznego Boru",
	["quest.toDuskwood.text"] = "Trop prowadzi do Mrocznego Boru. Znajdź Zwiadowcę Borina wśród latarni.",
	["quest.toDuskwood.done"] = "Witaj w ciemności. Trzymaj się blisko światła.",
	["quest.werewolves.title"] = "Wycie",
	["quest.werewolves.text"] = "Wilkołaki polują w zachodnim lesie. Zapoluj na nie pierwszy.",
	["quest.werewolves.done"] = "Wycie ucichło. Na tę noc.",
	["quest.ruins.title"] = "Zapomniane ruiny",
	["quest.ruins.text"] = "Zjawy nawiedzają stare ruiny. Zniszcz je i zbierz ich esencję.",
	["quest.ruins.done"] = "Ta esencja... ktoś ją związał. Krypta.",
	["quest.ents.title"] = "Gnijące serce",
	["quest.ents.text"] = "Serce lasu gnije, a jego enty szaleją. Ukój je i zbierz psiankę.",
	["quest.ents.done"] = "Las oddycha lżej.",
	["quest.cult.title"] = "Kult",
	["quest.cult.text"] = "Kultyści mroku zbierają się na północnym wschodzie. Powstrzymaj ich i zanieś pieczęcie kapitanowi.",
	["quest.cult.done"] = "Te pieczęcie przedstawiają smoka. Czczą Vaelgratha.",
	["quest.swamp.title"] = "Czarne Bagno",
	["quest.swamp.text"] = "Trolle blokują ścieżki na bagnach. Oczyść je i przynieś garnizonowi kilka ryb.",
	["quest.swamp.done"] = "Garnizon zje dziś do syta.",
	["quest.crypt.title"] = "Krypta",
	["quest.crypt.text"] = "Wejdź do Krypty Zapomnianych i rozbij jej szkieletowych strażników.",
	["quest.crypt.done"] = "Jej strażnicy to proch. Teraz królowa.",
	["quest.morvane.title"] = "Morvane",
	["quest.morvane.text"] = "Morvane, Królowa Krypt, wiąże umarłych dla smoka. Zakończ jej panowanie.",
	["quest.morvane.done"] = "Umarli znów odpoczywają. Ale ognie na wschodzie płoną jaśniej.",
	["quest.ashen.title"] = "Spalone Pustkowia",
	["quest.ashen.text"] = "Wyrusz na Spalone Pustkowia, spotkaj Zwiadowczynię Kesrę i przerzedź salamandry.",
	["quest.ashen.done"] = "Przetrwałeś upał. Większość nie przetrwa.",
	["quest.orcs.title"] = "Orkowie popiołu",
	["quest.orcs.text"] = "Orkowie popiołu zbroją się do wojny. Rozbij ich bandę i wydobądź srebro dla naszych kowali.",
	["quest.orcs.done"] = "Ich bębny wojenne ucichły.",
	["quest.golems.title"] = "Żywy ogień",
	["quest.golems.text"] = "Ogniste golemy i skorpiony strzegą dróg do Kuźni Głębin. Oczyść przejście.",
	["quest.golems.done"] = "Droga do kuźni jest otwarta.",
	["quest.deepforge.title"] = "Kuźnia Głębin",
	["quest.deepforge.text"] = "Krasnoludy renegaci kują w Kuźni Głębin broń dla smoka. Powstrzymaj ich.",
	["quest.deepforge.done"] = "Kowadła wystygły. Został tylko ich pan.",
	["quest.azgor.title"] = "Azgor",
	["quest.azgor.text"] = "Azgor, Pan Płomieni, karmi ogniem armie smoka. Zgaś jego palenisko.",
	["quest.azgor.done"] = "Ogień zgasł. Został tylko chłód — i nadchodzi.",
	["quest.frostpeak.title"] = "Lodowe Szczyty",
	["quest.frostpeak.text"] = "Wejdź na Lodowe Szczyty. Zwiadowca Halvar potrzebuje przełęczy wolnych od wilków i yeti.",
	["quest.frostpeak.done"] = "Przełęcze są nasze. Teraz olbrzymy.",
	["quest.giants.title"] = "Przełęcz olbrzymów",
	["quest.giants.text"] = "Mroźne olbrzymy trzymają przełęcz. Pokonaj je — i ulepsz broń do +5, będzie potrzebna.",
	["quest.giants.done"] = "Droga do lodowca wolna.",
	["quest.glacier.title"] = "Serce Lodowca",
	["quest.glacier.text"] = "W Sercu Lodowca kryształowi strażnicy pilnują leża smoka. Rozbij ich.",
	["quest.glacier.done"] = "Leże jest otwarte. On wie, że nadchodzisz.",
	["quest.vaelgrath.title"] = "Vaelgrath",
	["quest.vaelgrath.text"] = "Vaelgrath, Smok Mrozu, budzi się. Skończ to — dla Vaelthornu.",
	["quest.vaelgrath.done"] = "To koniec. Vaelthorn będzie śpiewał o tobie przez sto zim.",

