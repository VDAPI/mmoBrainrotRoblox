	["quest.boss_grimrok.title"] = "Pogromca Grimroka",
	["quest.boss_grimrok.p1"] = "Grimrok zebrał goblinów z całych Łąk pod jedną włócznią. Wódz, który umie liczyć do stu, to wódz, który zaczyna planować najazdy na farmy.",
	["quest.boss_grimrok.p2"] = "Jego leże jest w Jaskini Mchów, najgłębszej grocie Łąk. Zejdź do lochu i powal go. Kapitanat płaci za pierwszą głowę wodza, a ja chcę ją zobaczyć na własne oczy.",
	["quest.boss_grimrok.progress"] = "Pokonaj Grimroka w lochu Jaskini Mchów i wróć do Zwiadowczyni Miry.",
	["quest.boss_grimrok.done"] = "Bez wodza gobliny pokłócą się o łupy, zanim zdążą o cokolwiek innego. Łąki odetchną. Weź to, kapitanat dotrzymuje słowa.",
	["quest.boss_morvane.title"] = "Pogromca Morvane",
	["quest.boss_morvane.p1"] = "Morvane rządzi zmarłymi Boru. Każdej nocy z Krypty Zapomnianych wychodzi ich więcej, a latarnie gasną jedna po drugiej.",
	["quest.boss_morvane.p2"] = "Krypta to ostatnia jaskinia lasu. Zejdź na jej dno i złam władzę królowej. Kapitanat wynagrodzi pierwsze zwycięstwo nad nią.",
	["quest.boss_morvane.progress"] = "Pokonaj Morvane w Krypcie Zapomnianych i wróć do Zwiadowcy Borina.",
	["quest.boss_morvane.done"] = "Słyszałem, jak krypta ucichła. Zmarli wrócą do snu, przynajmniej na jakiś czas. Należy ci się nagroda.",
	["quest.boss_azgor.title"] = "Pogromca Azgora",
	["quest.boss_azgor.p1"] = "Azgor rozpala kuźnie, w których orkowie kują broń na całe Pustkowia. Dopóki płonie jego ogień, ich wojna się nie skończy.",
	["quest.boss_azgor.p2"] = "Siedzi w Kuźni Głębin, ostatniej grocie Pustkowi, nad rzeką lawy. Zgaś go. Kapitanat zapłaci za pierwszą wygraną.",
	["quest.boss_azgor.progress"] = "Pokonaj Azgora w Kuźni Głębin i wróć do Zwiadowczyni Kesry.",
	["quest.boss_azgor.done"] = "Dym znad kuźni rzednie. Orkowie stracili swojego pana, a my zyskaliśmy czas. Oto zapłata.",
	["quest.boss_vaelgrath.title"] = "Pogromca Vaelgratha",
	["quest.boss_vaelgrath.p1"] = "Vaelgrath, Smok Mrozu, budzi się w Sercu Lodowca. Jego ryk niesie się po całych Szczytach, a śnieg pod nim nie topnieje nawet w ogniu.",
	["quest.boss_vaelgrath.p2"] = "Serce Lodowca to ostatnia grota Szczytów. Nikt jeszcze nie wrócił stamtąd ze smoczą łuską. Jeśli ci się uda, kapitanat wynagrodzi to jak żadne inne zwycięstwo.",
	["quest.boss_vaelgrath.progress"] = "Pokonaj Vaelgratha w Sercu Lodowca i wróć do Zwiadowcy Halvara.",
	["quest.boss_vaelgrath.done"] = "Góry milczą pierwszy raz od lat. Opowiem o tym w każdej strażnicy. Weź nagrodę, zasłużyłeś na nią.",
