	["quest.item.vigdisTreatise"] = "Traktat „O wylęgu”",
	["place.leopardLedge"] = "Lamparcia Półka nad potokiem",
	["place.thrones"] = "Sala Tronów olbrzymów",
	["place.frozenBoat"] = "Łódź w lodzie",
	["place.howlRock"] = "Wyjąca Skała",
	["place.avalanche"] = "Stożek lawiny",
	["place.wyrmBurrows"] = "Nory w skarpach lodowych",
	["npc.scout_frostpeak.where"] = "przy kopcu u wejścia na Lodowe Szczyty",
	["npc.cairn_ingrid.name"] = "Stara Ingrid",
	["npc.cairn_ingrid.role"] = "Strażniczka Kopca",
	["npc.cairn_ingrid.greeting"] = "Idziesz w górę czy wracasz? Pytam, bo od tego zależy, co zawiążę.",
	["npc.cairn_ingrid.line1"] = "Mój mąż prowadził ludzi przez przełęcz czterdzieści zim. Teraz pilnuję tych, którzy idą sami.",
	["npc.cairn_ingrid.line2"] = "Wiatr od północy niesie śnieg, od wschodu niesie wilki. Od zachodu niesie tylko kupców.",
	["npc.cairn_ingrid.line3"] = "Kto wraca, odwiązuje swoją wstążkę sam. Nie robię tego za nikogo.",
	["npc.cairn_ingrid.where"] = "przy kopcu z rogami u wejścia na Lodowe Szczyty",
	["npc.hornblower_eskil.name"] = "Eskil Trębacz",
	["npc.hornblower_eskil.role"] = "Strażnik Rogu",
	["npc.hornblower_eskil.greeting"] = "Śnieg na górnej ławie urósł o dłoń. Ty też to widzisz, czy tylko ja?",
	["npc.hornblower_eskil.line1"] = "Mój dziad trąbił, mój ojciec trąbił. Ja trąbię i liczę, ile razy ktoś nie posłuchał.",
	["npc.hornblower_eskil.line2"] = "Lawina nie pyta, czy masz miecz. Ma swoje zdanie i zawsze je wygłasza.",
	["npc.hornblower_eskil.line3"] = "Na Zboczach słychać róg w całej dolinie. Kiedy go nie słychać, to też jest wiadomość.",
	["npc.hornblower_eskil.where"] = "na dolnej ławie Zboczy Yeti",
	["npc.skald_ragnvald.name"] = "Skald Ragnvald",
	["npc.skald_ragnvald.role"] = "Skald",
	["npc.skald_ragnvald.greeting"] = "Stań tak, żeby światło padało z lewej. Bohaterów opisuje się z lewej.",
	["npc.skald_ragnvald.line1"] = "Przyszedłem z południa po pieśni, których nikt nie spisał. Olbrzymy nie pozwalają czytać.",
	["npc.skald_ragnvald.line2"] = "Każda saga ma dwa końce: ten, który śpiewam, i ten, który się wydarzył.",
	["npc.skald_ragnvald.line3"] = "Zimą słowa zamarzają w ustach. Dlatego na północy sagi są krótkie.",
	["npc.skald_ragnvald.where"] = "przy Bramie Olbrzymów na Przełęczy",
	["npc.icefisher_torvi.name"] = "Torvi Przeręblarz",
	["npc.icefisher_torvi.role"] = "Rybak spod lodu",
	["npc.icefisher_torvi.greeting"] = "Ciszej. Ryby słyszą kroki przez lód.",
	["npc.icefisher_torvi.line1"] = "Moja wioska łowiła przez lód, odkąd ktoś pamięta. Teraz łowię sam.",
	["npc.icefisher_torvi.line2"] = "Jezioro dało nam jeść sto zim. Nie pytam, czemu przestało.",
	["npc.icefisher_torvi.line3"] = "Nie stawaj dwa razy w tym samym śladzie. Lód pamięta ciężar.",
	["npc.icefisher_torvi.where"] = "na brzegu Zamarzniętego Jeziora",
	["npc.bonecarver_gunnar.name"] = "Gunnar Kościarz",
	["npc.bonecarver_gunnar.role"] = "Rzeźbiarz w kości",
	["npc.bonecarver_gunnar.greeting"] = "Siadaj, jeśli masz czas. Kość nie lubi pośpiechu.",
	["npc.bonecarver_gunnar.line1"] = "Mamuty przychodzą tu umierać. My tylko pilnujemy, żeby nikt im nie przeszkadzał.",
	["npc.bonecarver_gunnar.line2"] = "Ludzie tundry biorą kość tylko od tych, które padły same. Reszta jest ich.",
	["npc.bonecarver_gunnar.line3"] = "Stado wie, kiedy idzie burza. Ja wiem, kiedy idzie stado.",
	["npc.bonecarver_gunnar.where"] = "na skraju cmentarzyska mamutów na Mamuciej Tundrze",
	["npc.squire_asmund.name"] = "Asmund",
	["npc.squire_asmund.role"] = "Dawny giermek Straży",
	["npc.squire_asmund.greeting"] = "Nie pytaj, czemu stoję po tej stronie bramy.",
	["npc.squire_asmund.line1"] = "Siodłałem konie Straży. Znałem każdego rycerza po krokach.",
	["npc.squire_asmund.line2"] = "Mury są te same. Tylko cisza za nimi jest inna.",
	["npc.squire_asmund.line3"] = "Wróciłem po kilku zimach. Za późno, żeby pomóc, za wcześnie, żeby zapomnieć.",
	["npc.squire_asmund.where"] = "przed bramą Lodowej Strażnicy",
	["npc.scholar_vigdis.name"] = "Uczona Vigdis",
	["npc.scholar_vigdis.role"] = "Uczona",
	["npc.scholar_vigdis.greeting"] = "Proszę nie deptać notatek. Leżą tam, gdzie ich miejsce.",
	["npc.scholar_vigdis.line1"] = "Przyszłam z południowego archiwum. Książki o smokach pisali ludzie, którzy smoka nie widzieli.",
	["npc.scholar_vigdis.line2"] = "Wyrm to nie smok. Proszę to zapamiętać, będę pytać.",
	["npc.scholar_vigdis.line3"] = "Mróz dobrze przechowuje kości. Ludzi gorzej.",
	["npc.scholar_vigdis.where"] = "u podnóża Smoczych Schodów",
	-- A. Kopiec z rogami
	["quest.side_fp_flask.title"] = "Bukłak od Halvara",
	["quest.side_fp_flask.p1"] = "Przy kopcu z rogami mieszka stara Ingrid, wdowa po przewodniku, który nauczył mnie czytać tropy. Nie byłem u niej od jesieni.",
	["quest.side_fp_flask.p2"] = "Zanieś jej ten bukłak miodu. Powiedz, że jeszcze żyję. Ona zrozumie resztę.",
	["quest.side_fp_flask.progress"] = "Zanieś bukłak Halvara Starej Ingrid przy kopcu z rogami.",
	["quest.side_fp_flask.done"] = "Miód od Halvara? Znaczy, że żyje i pamięta. Mój mąż mówił, że z tego chłopaka będzie przewodnik. Postaw bukłak przy kopcu, wypiję wieczorem.",
	["quest.side_fp_flask.say.drink"] = "A jeśli wypiję po drodze?",
	["quest.side_fp_flask.say.drink.reply"] = "Ingrid pozna po bukłaku. Zna moje łyki lepiej niż ja.",
	["quest.side_fp_flask.say.who"] = "Kim jest Ingrid?",
	["quest.side_fp_flask.say.who.reply"] = "Wdową po człowieku, który nauczył mnie czytać tropy. Kłaniaj się nisko.",
	["quest.side_fp_flask.say.word"] = "Coś jej przekazać?",
	["quest.side_fp_flask.say.word.reply"] = "Że jeszcze żyję. Resztę wie sama.",
	["quest.side_fp_flask.bark.accept1"] = "Kopiec stoi przy drodze, zaraz za moim ogniem. Nie da się go minąć.",
	["quest.side_fp_flask.bark.done1"] = "Halvar przysłał? Znaczy, że żyje i pamięta.",
	["quest.side_fp_ribbons.title"] = "Zerwane wstążki",
	["quest.side_fp_ribbons.p1"] = "Kto idzie w góry, wiąże na kopcu wstążkę ze swoim imieniem. Kto wraca, odwiązuje ją sam. Te, które zostają, to imiona tych, którzy nie wrócili.",
	["quest.side_fp_ribbons.p2"] = "Nocna zamieć zerwała je z rogów, a wilki, szalone od mrozu, rozwlekły je po dolinie aż do nor. Każda wstążka to czyjeś imię.",
	["quest.side_fp_ribbons.p3"] = "Przynieś mi sześć. I przerzedź watahę, zanim zaczną wyciągać ludzi z drogi tak jak wstążki z kopca.",
	["quest.side_fp_ribbons.progress"] = "Zabij dziesięć lodowych wilków i odzyskaj sześć wstążek w Dolinie Lodowych Wilków.",
	["quest.side_fp_ribbons.done"] = "Sześć. Ta jest Olafa, ta jego brata. Zawiążę je przed zmierzchem, żeby nie spędziły nocy na ziemi.",
	["quest.side_fp_ribbons.say.names"] = "Pamiętasz wszystkie imiona?",
	["quest.side_fp_ribbons.say.names.reply"] = "Każde. Niektóre lepiej niż twarze.",
	["quest.side_fp_ribbons.say.wolves"] = "Czemu wilki je biorą?",
	["quest.side_fp_ribbons.say.wolves.reply"] = "Pachną ludźmi. Wilk nie pyta, czyje.",
	["quest.side_fp_ribbons.say.first"] = "Od czego zacząć?",
	["quest.side_fp_ribbons.say.first.reply"] = "Od wstążek. Wilki same cię znajdą.",
	["quest.side_fp_ribbons.bark.accept1"] = "Każda wstążka to imię. Nie zostawiaj żadnej w śniegu.",
	["quest.side_fp_ribbons.bark.half1"] = "Wilki zawsze zostawiają najładniejsze na koniec.",
	["quest.side_fp_ribbons.bark.done1"] = "Wracaj. Zawiążę je przed zmierzchem.",
	["quest.side_fp_ribbons.bark.stuck1"] = "Szukaj przy norach. Wilki znoszą do nich wszystko, co pachnie człowiekiem.",
	["quest.side_fp_howl.title"] = "Ofiara pod Wyjącą Skałą",
	["quest.side_fp_howl.p1"] = "Stary zwyczaj doliny: kto chce przejść, zostawia pod Wyjącą Skałą łój i kość dla Wilka Przełęczy. Wtedy wataha go przepuszcza.",
	["quest.side_fp_howl.p2"] = "Od jesieni nikt tego nie zrobił, a ja jestem za stara na tę drogę. Skała stoi na północy, przy szlaku nad Jeziorem Harpii.",
	["quest.side_fp_howl.p3"] = "Potem wróć i zawiąż wstążki na rogach kopca. Podwójnym węzłem, tak jak wiąże się imiona.",
	["quest.side_fp_howl.progress"] = "Złóż ofiarę pod Wyjącą Skałą i zawiąż wstążki na kopcu z rogami.",
	["quest.side_fp_howl.done"] = "Wiszą. Wiesz, ta nowa, bez imienia, zawiązali ją niedawno traperzy, którzy poszli do Lodowej Groty. Nie odwiązuj jej. Niech czeka.",
	["quest.side_fp_howl.done.names"] = "Pytałeś o imiona. Ta nowa wstążka jeszcze nie ma imienia. Zawiązali ją traperzy, którzy poszli do Lodowej Groty. Oby tak zostało.",
	["quest.side_fp_howl.say.believe"] = "Wierzysz w Wilka Przełęczy?",
	["quest.side_fp_howl.say.believe.reply"] = "Wierzę w zwyczaj. Ci, co go łamali, mają tu wstążki.",
	["quest.side_fp_howl.say.little"] = "Łój i kość? Tylko tyle?",
	["quest.side_fp_howl.say.little.reply"] = "Wilk nie jest chciwy. Chciwi są ci, co chodzą górami.",
	["quest.side_fp_howl.say.road"] = "Którędy do Skały?",
	["quest.side_fp_howl.say.road.reply"] = "Na północ, wzdłuż potoku. Zaznaczę.",
	["quest.side_fp_howl.bark.accept1"] = "Łój i kość. Nic więcej, wilk nie lubi przesady.",
	["quest.side_fp_howl.bark.near1"] = "Słyszysz, jak skała wyje na wietrze? Stąd nazwa.",
	["quest.side_fp_howl.bark.half1"] = "Teraz wstążki. Podwójny węzeł, nie zapomnij.",
	["quest.side_fp_howl.bark.done1"] = "Dolina znów ma swój zwyczaj.",
	-- B. Ostatni łup traperów
	["quest.side_fp_snares.title"] = "Wnyki traperów",
	["quest.side_fp_snares.p1"] = "Zanim drużyna poszła do Lodowej Groty, nastawiła wnyki wokół obozu. Arne powiedział: cokolwiek się stanie, obóz musi jeść.",
	["quest.side_fp_snares.p2"] = "Lamparty wybierają zdobycz z pętli, zanim ktokolwiek do niej dojdzie. Trzy wnyki trzeba nastawić na nowo.",
	["quest.side_fp_snares.p3"] = "Przegoń lamparty z doliny. Inaczej będziemy karmić je, a nie siebie.",
	["quest.side_fp_snares.progress"] = "Nastaw trzy wnyki przy obozie traperów i zabij osiem śnieżnych lampartów w Dolinie Lodowych Wilków.",
	["quest.side_fp_snares.done"] = "Pętle trzymają. Obóz będzie jadł, nawet jeśli nie ma komu. Arne by się z tego śmiał. Ja nie umiem.",
	["quest.side_fp_snares.say.eat"] = "Dla kogo jedzenie, skoro obóz pusty?",
	["quest.side_fp_snares.say.eat.reply"] = "Dla tych, co wrócą. Wnyki stawia się dla żywych.",
	["quest.side_fp_snares.say.learn"] = "Lamparty znają wasze pętle?",
	["quest.side_fp_snares.say.learn.reply"] = "Szybciej się uczą niż Arne. On uczył się trzy zimy.",
	["quest.side_fp_snares.say.which"] = "Najpierw wnyki czy lamparty?",
	["quest.side_fp_snares.say.which.reply"] = "Lamparty. Wnyki poczekają, one nie.",
	["quest.side_fp_snares.bark.accept1"] = "Trzy pętle wokół obozu. Arne stawiał je przy każdym wyjściu.",
	["quest.side_fp_snares.bark.half1"] = "Któraś pętla zawsze się zaciśnie. Trzeba tylko poczekać.",
	["quest.side_fp_snares.bark.done1"] = "Obóz zje. Wracaj.",
	["quest.side_fp_snares.bark.death1"] = "Wstań powoli. Lampart wraca, kiedy ofiara się rusza.",
	["quest.side_fp_ledge.title"] = "Nóż Arnego",
	["quest.side_fp_ledge.p1"] = "Byłeś w Grocie. Widziałeś ich. Arne, mój brat, prowadził tę drużynę.",
	["quest.side_fp_ledge.p2"] = "Zeszłej zimy stracił nóż na Lamparciej Półce, w walce ze starą lamparcicą. Chcę go odzyskać i położyć przy nim.",
	["quest.side_fp_ledge.p3"] = "Półki nie widać z drogi. Zaprowadzę cię, a lamparcicę zostawię tobie.",
	["quest.side_fp_ledge.progress"] = "Idź z Sigrun na Lamparcią Półkę i odbierz nóż Arnego lampartom w Dolinie Lodowych Wilków.",
	["quest.side_fp_ledge.done"] = "To on. Krzywa rękojeść, rzeźbił ją sam i nigdy nie przyznał, że krzywo. Położę go przy nim, kiedy go zniesiemy.",
	["quest.side_fp_ledge.say.knife"] = "Jaki to nóż?",
	["quest.side_fp_ledge.say.knife.reply"] = "Rękojeść z rogu kozicy. Rzeźbił ją sam, krzywo. Poznam po tym.",
	["quest.side_fp_ledge.say.alone"] = "Mogę iść bez ciebie.",
	["quest.side_fp_ledge.say.alone.reply"] = "Nie możesz. Półki nie widać z drogi, a ja widzę ją we śnie.",
	["quest.side_fp_ledge.say.lead"] = "Prowadź.",
	["quest.side_fp_ledge.say.lead.reply"] = "Idź za mną i nie depcz śladów lampartów.",
	["quest.side_fp_ledge.bark.accept1"] = "Ja znam drogę, ty masz miecz. Idziemy razem.",
	["quest.side_fp_ledge.bark.near1"] = "Tu Arne uczył mnie stawiać wnyki. Szło mi gorzej niż jemu.",
	["quest.side_fp_ledge.bark.half1"] = "Nóż ma lamparcica, która nie ucieka. Szukaj jej.",
	["quest.side_fp_ledge.bark.done1"] = "To on. Krzywa rękojeść. Dziękuję.",
	["quest.side_fp_ledge.comp.join1"] = "Trzymaj się blisko. Za obozem lamparty chodzą parami.",
	["quest.side_fp_ledge.comp.wait1"] = "Nie zostawaj. Tu łatwo zgubić ślad.",
	["quest.side_fp_ledge.comp.arrive1"] = "To tu. Stara lamparcica bierze wszystko, co błyszczy. Szukaj u niej.",
	["quest.side_fp_ledge.comp.back1"] = "Zgubiłam cię. Wracam do obozu, tam czekam.",
	["quest.side_fp_sledge.title"] = "Sanie na dół",
	["quest.side_fp_sledge.p1"] = "Chcę znieść ich na dół. Nie mogę zostawić brata w lodzie na zawsze.",
	["quest.side_fp_sledge.p2"] = "Mamy stare sanie, ale płoza pękła przy ostatnim zjeździe. Trzeba ją naprawić, zanim spadnie nowy śnieg.",
	["quest.side_fp_sledge.p3"] = "Droga w dół idzie przez Zbocza. Lamparty chodzą za zapachem obozu i czekają na każdego, kto schodzi.",
	["quest.side_fp_sledge.p4"] = "Kiedy sanie zjadą, zostanę tu do wiosny. Ktoś musi.",
	["quest.side_fp_sledge.progress"] = "Napraw płozę sań w obozie traperów i oczyść drogę przez Zbocza Yeti z dziesięciu śnieżnych lampartów.",
	["quest.side_fp_sledge.done"] = "Sanie są gotowe. Góry oddają zmarłych dopiero, kiedy puszczają śniegi. Zostanę do wiosny. Weź coś z rzeczy drużyny, oni by chcieli.",
	["quest.side_fp_sledge.done.alone"] = "Półka bez przewodnika zabrała już jednego. Dobrze, że szliśmy razem. Sanie są gotowe, zostanę do wiosny. Weź coś z rzeczy drużyny.",
	["quest.side_fp_sledge.say.bury"] = "Gdzie ich pochowasz?",
	["quest.side_fp_sledge.say.bury.reply"] = "Przy kopcu w dolinie. Ingrid zawiąże im wstążki.",
	["quest.side_fp_sledge.say.stay"] = "Zostaniesz tu sama?",
	["quest.side_fp_sledge.say.stay.reply"] = "Do wiosny. Ktoś musi pilnować, żeby góry nie wzięły ich drugi raz.",
	["quest.side_fp_sledge.say.rope"] = "Czym związać płozę?",
	["quest.side_fp_sledge.say.rope.reply"] = "Rzemieniem z sań Arnego. Weź też to.",
	["quest.side_fp_sledge.bark.accept1"] = "Najpierw płoza, potem droga. W tej kolejności.",
	["quest.side_fp_sledge.bark.half1"] = "Sanie muszą zjechać za jednym razem. Drugi raz nie dam rady.",
	["quest.side_fp_sledge.bark.done1"] = "Do wiosny będą przy kopcu. Wracaj.",
	-- C. Róg Lawinowy
	["quest.side_fp_horn.title"] = "Przysypany róg",
	["quest.side_fp_horn.p1"] = "Mój ród od pokoleń dmie w wielki róg, kiedy śnieg na stokach rośnie. Dolina słyszy i schodzi z drogi.",
	["quest.side_fp_horn.p2"] = "Ostatnia lawina, którą zrzuciły yeti, przysypała stojak z rogiem u stopy stożka. Odkop go, ostrożnie.",
	["quest.side_fp_horn.p3"] = "Yeti nie schodziły tak nisko za mojego życia. Przerzedź je, zanim zrzucą następną.",
	["quest.side_fp_horn.progress"] = "Odkop róg u stopy stożka lawiny i zabij dziesięć yeti na Zboczach Yeti.",
	["quest.side_fp_horn.done"] = "Cały. Drewno pęknięte tylko na okuciu, to się zrobi. Ale ustnika nie ma. Srebrnego. Bez niego róg tylko charczy.",
	["quest.side_fp_horn.say.count"] = "Ile lawin pamiętasz?",
	["quest.side_fp_horn.say.count.reply"] = "Czterdzieści jedną. Czterdzieści przeżyłem, jedną przespałem.",
	["quest.side_fp_horn.say.why"] = "Po co róg, skoro śnieg widać?",
	["quest.side_fp_horn.say.why.reply"] = "Z góry widać śnieg. Z dołu widać tylko, że już za późno.",
	["quest.side_fp_horn.say.where"] = "Gdzie stał stojak?",
	["quest.side_fp_horn.say.where.reply"] = "U stopy stożka lawiny. Zaznaczę.",
	["quest.side_fp_horn.bark.accept1"] = "Stojak jest pod śniegiem. Kop ostrożnie, to stare drewno.",
	["quest.side_fp_horn.bark.half1"] = "Cały. Tylko ustnika nie ma. Ktoś ma gust.",
	["quest.side_fp_horn.bark.done1"] = "Zagram, jak dostanę usta. Wracaj.",
	["quest.side_fp_boulders.title"] = "Głazy yeti",
	["quest.side_fp_boulders.p1"] = "Yeti znoszą głazy na środkową ławę i układają je w sterty. Myślałem, że to zabawa.",
	["quest.side_fp_boulders.p2"] = "To nie zabawa. Spychają je w dół, kiedy śnieg jest ciężki, i ruszają lawiny umyślnie. Rozwal trzy sterty.",
	["quest.side_fp_boulders.p3"] = "Na ławie polują lamparty. Czekają na tych, którzy tam chodzą, więc uważaj na plecy.",
	["quest.side_fp_boulders.progress"] = "Rozwal trzy sterty głazów na środkowej ławie i zabij osiem śnieżnych lampartów na Zboczach Yeti.",
	["quest.side_fp_boulders.done"] = "Trzy sterty mniej to trzy lawiny mniej. Policzyłem. Zawsze liczę.",
	["quest.side_fp_boulders.say.purpose"] = "Yeti robią to umyślnie?",
	["quest.side_fp_boulders.say.purpose.reply"] = "Umyślnie. Uczą się od nas, tylko szybciej.",
	["quest.side_fp_boulders.say.nobody"] = "Czemu nikt ich nie powstrzymał?",
	["quest.side_fp_boulders.say.nobody.reply"] = "Dolina płaci mi za trąbienie, nie za głazy.",
	["quest.side_fp_boulders.say.cats"] = "Najpierw lamparty?",
	["quest.side_fp_boulders.say.cats.reply"] = "Tak. Na ławie nie ma dokąd uciec i one o tym wiedzą.",
	["quest.side_fp_boulders.bark.accept1"] = "Trzy sterty na środkowej ławie. Rozwal je, zanim yeti je zepchną.",
	["quest.side_fp_boulders.bark.half1"] = "Dwie sterty mniej to dwie lawiny mniej.",
	["quest.side_fp_boulders.bark.done1"] = "Ława czysta. Na razie. Wracaj.",
	["quest.side_fp_boulders.bark.stuck1"] = "Sterty są wyżej, niż myślisz. Yeti noszą głazy pod górę.",
	["quest.side_fp_matriarch.title"] = "Srebrny ustnik",
	["quest.side_fp_matriarch.p1"] = "Ustnik zabrał wielki yeti i zaniósł go do Lodowej Groty. Najstarsze yeti noszą błyskotki, im starsze, tym więcej.",
	["quest.side_fp_matriarch.p2"] = "Yeti nie schodziły tak nisko za mojego życia. Uciekają od czegoś, co budzi się pod lodowcem.",
	["quest.side_fp_matriarch.p3"] = "Ale róg musi grać, cokolwiek się budzi. Odbierz ustnik najstarszym z nich.",
	["quest.side_fp_matriarch.progress"] = "Wejdź do Lodowej Groty, pokonaj trzy elitarne yeti i odbierz srebrny ustnik.",
	["quest.side_fp_matriarch.done"] = "Pasuje. Posłuchaj. Ten dźwięk dolina zna od trzystu lat. Teraz zna go też twoja głowa.",
	["quest.side_fp_matriarch.done.count"] = "Czterdzieści dwie. Tę policzę jako twoją. Posłuchaj, jak brzmi róg z ustnikiem. Dolina zna ten dźwięk od trzystu lat.",
	["quest.side_fp_matriarch.say.trinkets"] = "Po co yeti błyskotki?",
	["quest.side_fp_matriarch.say.trinkets.reply"] = "Nie wiem. Może też chcą, żeby ich było słychać.",
	["quest.side_fp_matriarch.say.flee"] = "Przed czym uciekają?",
	["quest.side_fp_matriarch.say.flee.reply"] = "Przed czymś pod lodowcem. Zwierzęta słyszą wcześniej niż ludzie.",
	["quest.side_fp_matriarch.say.cave"] = "Gdzie Grota?",
	["quest.side_fp_matriarch.say.cave.reply"] = "Na końcu solnej drogi pod górą. Zaznaczę wejście.",
	["quest.side_fp_matriarch.bark.accept1"] = "Szukaj najstarszego i najdumniejszego. Ustnik nosi ten, kto ma najwięcej do stracenia.",
	["quest.side_fp_matriarch.bark.half1"] = "Słyszę stąd, jak Grota się trzęsie. Dobrze ci idzie.",
	["quest.side_fp_matriarch.bark.done1"] = "Wracaj. Dolina pozna ten dźwięk.",
	["quest.side_fp_matriarch.bark.death1"] = "Wstawaj. W Grocie nie jesteś zdobyczą, tylko gościem bez zaproszenia.",
	-- D. Saga olbrzymów
	["quest.side_fp_colossi.title"] = "Runy na cokołach",
	["quest.side_fp_colossi.p1"] = "Zbieram pieśni północy, te, których nikt nie spisał. Najstarsza saga olbrzymów jest wyryta na cokołach kolosów Bramy.",
	["quest.side_fp_colossi.p2"] = "Odbij runy węglem na pergaminie, z obu cokołów. Ja nie mam rąk do węgla, a olbrzymy nie mają cierpliwości do skaldów.",
	["quest.side_fp_colossi.p3"] = "Nie dopuszczają nikogo do posągów przodków. Przekonaj ich, że tym razem mogą.",
	["quest.side_fp_colossi.progress"] = "Odbij runy z cokołów obu kolosów Bramy Olbrzymów i zabij dziesięciu mroźnych olbrzymów na Przełęczy.",
	["quest.side_fp_colossi.done"] = "Czyste odbicia. Pierwsza strofa zgadza się z moją, druga nie. Albo mój mistrz się mylił, albo kamień kłamie. Kamienie rzadko kłamią.",
	["quest.side_fp_colossi.say.sing"] = "Zaśpiewasz coś?",
	["quest.side_fp_colossi.say.sing.reply"] = "Po sadze. Za darmo śpiewam tylko kozom, a i one wychodzą.",
	["quest.side_fp_colossi.say.giants"] = "Olbrzymy pozwolą?",
	["quest.side_fp_colossi.say.giants.reply"] = "Nie. Dlatego pytam ciebie, nie ich.",
	["quest.side_fp_colossi.say.charcoal"] = "Czym mam odbijać?",
	["quest.side_fp_colossi.say.charcoal.reply"] = "Węglem. Weź też to, przy olbrzymach przyda się bardziej niż węgiel.",
	["quest.side_fp_colossi.bark.accept1"] = "Dwa cokoły. Olbrzymy nie lubią kopistów, więc kopiuj szybko.",
	["quest.side_fp_colossi.bark.half1"] = "Pierwsza strofa zgadza się z moją. Na razie.",
	["quest.side_fp_colossi.bark.done1"] = "Węgiel na palcach to cena sztuki. Wracaj.",
	["quest.side_fp_thrones.title"] = "Kamienie tronów",
	["quest.side_fp_thrones.p1"] = "Dalszy ciąg sagi był na kamieniach tronów w Sali Tronów, za ogniem olbrzymów.",
	["quest.side_fp_thrones.p2"] = "Olbrzymy odłupały runy i noszą je na szyjach jak amulety. Noszą przeszłość, a nie pamiętają, co znaczy.",
	["quest.side_fp_thrones.p3"] = "Pójdę z tobą. Chcę stanąć w tej sali, zanim zaśpiewam o niej jeszcze raz.",
	["quest.side_fp_thrones.progress"] = "Idź ze Skaldem Ragnvaldem do Sali Tronów i odbierz trzy runy z tronów mroźnym olbrzymom na Przełęczy.",
	["quest.side_fp_thrones.done"] = "Trzy runy, ta sama strofa. Kiedy smok schodził z gór pierwszy raz, olbrzymy trzymały przełęcz razem z Zakonem Lodowej Straży. Razem, nie przeciw sobie.",
	["quest.side_fp_thrones.say.come"] = "Idziesz ze mną?",
	["quest.side_fp_thrones.say.come.reply"] = "Oczywiście. Saga bez świadka to plotka.",
	["quest.side_fp_thrones.say.danger"] = "Tam są olbrzymy.",
	["quest.side_fp_thrones.say.danger.reply"] = "Dlatego idę za tobą, nie przed tobą.",
	["quest.side_fp_thrones.say.why"] = "Czemu ta saga tyle dla ciebie znaczy?",
	["quest.side_fp_thrones.say.why.reply"] = "Śpiewam ją trzydzieści lat. Chcę wiedzieć, czy śpiewam prawdę.",
	["quest.side_fp_thrones.bark.accept1"] = "Sala jest za ogniem olbrzymów. Prowadź, ja idę za tobą.",
	["quest.side_fp_thrones.bark.near1"] = "Tu stoi „razem”. Olbrzymy i Zakon. A ja trzydzieści lat śpiewam „przeciw”.",
	["quest.side_fp_thrones.bark.half1"] = "Druga runa mówi to samo. Mój mistrz kłamał albo nie umiał czytać.",
	["quest.side_fp_thrones.bark.done1"] = "Wróciłem przed tobą. Skald zawsze zna skrót, kiedy saga się zmienia.",
	["quest.side_fp_thrones.bark.death1"] = "Wstawaj. Elegii jeszcze nie ułożyłem i nie zamierzam.",
	["quest.side_fp_thrones.bark.stuck1"] = "Runy noszą na szyjach. Trzeba ich zapytać. Mieczem, niestety.",
	["quest.side_fp_thrones.comp.join1"] = "Prowadź. Ja będę opisywał, jak dzielnie prowadzisz.",
	["quest.side_fp_thrones.comp.join2"] = "Tylko nie za szybko. Bohater, który biegnie, w sadze ucieka.",
	["quest.side_fp_thrones.comp.back1"] = "Zgubiłem cię między głazami. Wracam pod Bramę.",
	["quest.side_fp_verse.title"] = "Ostatnia strofa",
	["quest.side_fp_verse.p1"] = "Mam całą sagę poza ostatnią strofą. Na kamieniach jej nie ma, ktoś jej nigdy nie wyrył albo wiatr ją zjadł.",
	["quest.side_fp_verse.p1.why"] = "Pytałeś, czy śpiewam prawdę. Teraz zaśpiewam. Brakuje mi tylko ostatniej strofy, a na kamieniach jej nie ma.",
	["quest.side_fp_verse.p2"] = "Ułożę ją sam. Ale harpie rozniosły moje karty do gniazd na skałach Przełęczy i bez nich zgubię rytm.",
	["quest.side_fp_verse.p3"] = "Odzyskaj cztery karty. Potem wyryj strofę na strąconej głowie kolosa przy drodze.",
	["quest.side_fp_verse.p4"] = "Żeby olbrzymy pamiętały, kim byli. I żeby ludzie z południa przestali śpiewać kłamstwa.",
	["quest.side_fp_verse.progress"] = "Odzyskaj cztery karty sagi od harpii szczytów na Przełęczy i wyryj ostatnią strofę na głowie kolosa przy drodze.",
	["quest.side_fp_verse.done"] = "Posłuchaj: „Stali na przełęczy olbrzymi i ludzie, a smok zawrócił, bo nie znalazł szczeliny”. Krótko. Na północy sagi muszą być krótkie. Weź coś za trud.",
	["quest.side_fp_verse.say.write"] = "Ułożysz ją sam?",
	["quest.side_fp_verse.say.write.reply"] = "Ułożę. Ty wyryjesz, mnie drżą ręce, gdy coś ma przetrwać.",
	["quest.side_fp_verse.say.harpies"] = "Po co harpiom twoje karty?",
	["quest.side_fp_verse.say.harpies.reply"] = "Moja saga ogrzewa pisklęta. Lepszej krytyki nie miałem.",
	["quest.side_fp_verse.say.truth"] = "Napiszesz, jak było?",
	["quest.side_fp_verse.say.truth.reply"] = "Tym razem tak. Olbrzymy i Zakon, ramię w ramię.",
	["quest.side_fp_verse.bark.accept1"] = "Karty są u harpii, strofa w mojej głowie. Najpierw karty.",
	["quest.side_fp_verse.bark.half1"] = "Brakuje mi tylko rymu i odwagi.",
	["quest.side_fp_verse.bark.done1"] = "Wyryte. Olbrzymy mogą zapomnieć, kamień nie.",
	-- E. Przerębel
	["quest.side_fp_icehole.title"] = "Głodny przerębel",
	["quest.side_fp_icehole.p1"] = "Od tygodni nie jadłem świeżej ryby. Z przerębli wypełzają żywiołaki i pilnują ich, jakby woda była ich.",
	["quest.side_fp_icehole.p2"] = "Złów mi trzy ryby, gdzie chcesz, i przerzedź żywiołaki na jeziorze. Potem pogadamy o czymś ważniejszym.",
	["quest.side_fp_icehole.progress"] = "Złów trzy ryby i zabij osiem lodowych żywiołaków na Zamarzniętym Jeziorze.",
	["quest.side_fp_icehole.done"] = "Świeża ryba. Pierwsza od tygodni. Jezioro jeszcze coś daje, kiedy ktoś je poprosi grzecznie.",
	["quest.side_fp_icehole.say.bait"] = "Na co biorą?",
	["quest.side_fp_icehole.say.bait.reply"] = "Na cierpliwość. Na robaka, kiedy cierpliwość się skończy.",
	["quest.side_fp_icehole.say.why"] = "Skąd żywiołaki w przerębli?",
	["quest.side_fp_icehole.say.why.reply"] = "Jezioro je wypluwa. Nie pytaj jeziora, czemu.",
	["quest.side_fp_icehole.say.where"] = "Gdzie łowić?",
	["quest.side_fp_icehole.say.where.reply"] = "Byle nie tu. Przy łodzi ojca jest przerębel. Zaznaczę.",
	["quest.side_fp_icehole.bark.accept1"] = "Trzy ryby. Więcej nie trzeba, jezioro nie lubi chciwych.",
	["quest.side_fp_icehole.bark.near1"] = "Ciszej. Jezioro słucha.",
	["quest.side_fp_icehole.bark.half1"] = "Słyszę, jak lód pęka pod żywiołakami. Mniej ich.",
	["quest.side_fp_icehole.bark.done1"] = "Pierwsza świeża ryba od tygodni. Wracaj.",
	["quest.side_fp_boat.title"] = "Łódź ojca",
	["quest.side_fp_boat.p1"] = "Jednej nocy jezioro zamarzło w godzinę, od dna do wierzchu. Razem z łodzią mojego ojca. On był w środku.",
	["quest.side_fp_boat.p2"] = "Łódź wciąż stoi w lodzie przy przerębli. Zaprowadzę cię, sam po lodzie nie chodź. Wykuj ją ostrożnie.",
	["quest.side_fp_boat.p3"] = "I przynieś mi rdzenie żywiołaków. Stary zwyczaj: jezioro ma dostać z powrotem, co mu zabrano.",
	["quest.side_fp_boat.progress"] = "Idź z Torvim po lodzie do łodzi, wykuj ją z lodu i zdobądź cztery rdzenie mrozu od lodowych żywiołaków na jeziorze.",
	["quest.side_fp_boat.done"] = "Dziennik ojca. „Jezioro śpiewało, kryształy świeciły w rytm.” Nic więcej. Rdzenie wrzucę do przerębla. Jezioro dostało swoje. My też.",
	["quest.side_fp_boat.say.lead"] = "Prowadź.",
	["quest.side_fp_boat.say.lead.reply"] = "Krok w krok. Lód pamięta ciężar.",
	["quest.side_fp_boat.say.father"] = "Jaki był twój ojciec?",
	["quest.side_fp_boat.say.father.reply"] = "Cichy. Jak ja, tylko lepiej łowił.",
	["quest.side_fp_boat.say.straight"] = "Czemu nie prosto?",
	["quest.side_fp_boat.say.straight.reply"] = "Prosto chodzą ci, co jeszcze nie wpadli.",
	["quest.side_fp_boat.bark.accept1"] = "Sam nie idź na lód. Poczekaj na mnie przy brzegu.",
	["quest.side_fp_boat.bark.half1"] = "Dziennik ojca jest cały. Rdzenie oddamy jezioru.",
	["quest.side_fp_boat.bark.done1"] = "Jezioro dostało swoje. My też.",
	["quest.side_fp_boat.comp.join1"] = "Krok w krok za mną. Lód pamięta ciężar.",
	["quest.side_fp_boat.comp.wait1"] = "Nie stój długo w jednym miejscu. Lód tego nie lubi.",
	["quest.side_fp_boat.comp.arrive1"] = "Tu. Kuj ostrożnie. To drewno pamięta ręce ojca.",
	["quest.side_fp_boat.comp.back1"] = "Bez mnie nie wchodź na lód. Czekam na brzegu.",
	["quest.side_fp_hoard.title"] = "Skarbiec w lodzie",
	["quest.side_fp_hoard.p1"] = "Kiedy jezioro zamarzło, wzięło też rzeczy wioski. Leżą w lodzie przy zachodnim brzegu: skrzynia, tarcza, miecz.",
	["quest.side_fp_hoard.p2"] = "Każda rzecz ma właściciela albo jego dzieci. Wykuj je, oddam rodzinom.",
	["quest.side_fp_hoard.p3"] = "Mamuty schodzą na lód po sól i kruszą go przy skarbcu. Rzeczy toną drugi raz. Odgoń je.",
	["quest.side_fp_hoard.progress"] = "Wykuj z lodu skrzynię, tarczę i miecz w skarbcu na jeziorze i zabij osiem lodowych mamutów na Zamarzniętym Jeziorze.",
	["quest.side_fp_hoard.done"] = "Skrzynia Halldory, tarcza znad drzwi sąsiadów, miecz starego Bjorna. Oddam je. A to weź ty, ktoś musi coś od nas pamiętać.",
	["quest.side_fp_hoard.done.bait"] = "Robak się przydał. Jem świeżą rybę od tygodnia. Skrzynię, tarczę i miecz oddam rodzinom. A to weź ty, ktoś musi coś od nas pamiętać.",
	["quest.side_fp_hoard.say.families"] = "Rodziny jeszcze żyją?",
	["quest.side_fp_hoard.say.families.reply"] = "Część zeszła do Pustkowi. Wrócą, kiedy jezioro ucichnie.",
	["quest.side_fp_hoard.say.keep"] = "A jeśli coś zatrzymam?",
	["quest.side_fp_hoard.say.keep.reply"] = "Jezioro zapamięta twoją twarz. Ja też.",
	["quest.side_fp_hoard.say.mammoths"] = "Czemu mamuty kruszą lód?",
	["quest.side_fp_hoard.say.mammoths.reply"] = "Szukają soli. Lód pęka, a rzeczy wioski toną drugi raz.",
	["quest.side_fp_hoard.bark.accept1"] = "Każda rzecz ma właściciela. Kuj ostrożnie.",
	["quest.side_fp_hoard.bark.half1"] = "Ta tarcza wisiała nad drzwiami sąsiadów. Poznaję.",
	["quest.side_fp_hoard.bark.done1"] = "Oddam rodzinom. Jedno zostanie dla ciebie.",
	-- F. Cmentarzysko mamutów
	["quest.side_fp_tusks.title"] = "Łuk z kłów",
	["quest.side_fp_tusks.p1"] = "Łuk z kłów nad drogą znaczy wejście na cmentarzysko. Stado wie, że za nim kończy się pastwisko, a zaczyna spoczynek.",
	["quest.side_fp_tusks.p2"] = "Stado w szale wyłamało kieł z łuku. Potrzebuję pięciu kłów na nowy słup.",
	["quest.side_fp_tusks.p3"] = "Bierz tylko od tych, które musiały paść. Potem przywiąż słup u zachodniej stopy łuku.",
	["quest.side_fp_tusks.progress"] = "Zdobądź pięć kłów od lodowych mamutów na Mamuciej Tundrze i przywiąż nowy słup przy łuku z kłów.",
	["quest.side_fp_tusks.done"] = "Stoi. Stado pozna łuk, zanim go zobaczy. Mamuty pamiętają drogę lepiej niż ludzie.",
	["quest.side_fp_tusks.say.rule"] = "Tylko z martwych?",
	["quest.side_fp_tusks.say.rule.reply"] = "Z tych, które musiały paść. Reszta niech nosi swoje kły.",
	["quest.side_fp_tusks.say.carve"] = "Co rzeźbisz?",
	["quest.side_fp_tusks.say.carve.reply"] = "Mamuty. Kupcy biorą tylko te ze smutnymi oczami.",
	["quest.side_fp_tusks.say.arch"] = "Po co ten łuk?",
	["quest.side_fp_tusks.say.arch.reply"] = "Żeby stado wiedziało, gdzie kończy się pastwisko, a zaczyna spoczynek.",
	["quest.side_fp_tusks.bark.accept1"] = "Kły tylko z tych, co musiały paść. Pamiętaj.",
	["quest.side_fp_tusks.bark.half1"] = "Pięć kłów to jeden słup. Ładny rachunek.",
	["quest.side_fp_tusks.bark.done1"] = "Stado pozna łuk. Wracaj.",
	["quest.side_fp_stampede.title"] = "Żywy mur",
	["quest.side_fp_stampede.p1"] = "Olbrzymy pędzą stada w stronę Zamarzniętej Twierdzy, jak żywy mur. Walczą tam z czymś, czego się boją.",
	["quest.side_fp_stampede.p2"] = "Pasterze nie pędzą stad na wojnę. Te olbrzymy pędzą. Mamuty padają na lodzie, zanim dojdą do bram.",
	["quest.side_fp_stampede.p3"] = "Rozbij zagon. Pędzących i tych, którzy już oszaleli w stadzie.",
	["quest.side_fp_stampede.progress"] = "Zabij dwanaście lodowych mamutów i sześciu mroźnych olbrzymów na Mamuciej Tundrze.",
	["quest.side_fp_stampede.done"] = "Słyszysz? Stado zwalnia. Kilka wróciło na pastwiska, reszta stoi i nie wie, dokąd iść. To już coś.",
	["quest.side_fp_stampede.say.war"] = "Olbrzymy idą na wojnę?",
	["quest.side_fp_stampede.say.war.reply"] = "Z czymś w Twierdzy. Pasterze nie pędzą stad na wojnę. Te olbrzymy pędzą.",
	["quest.side_fp_stampede.say.pity"] = "Szkoda mamutów.",
	["quest.side_fp_stampede.say.pity.reply"] = "Szkoda. Dlatego najpierw ci, co je pędzą.",
	["quest.side_fp_stampede.say.many"] = "Ile ich jest?",
	["quest.side_fp_stampede.say.many.reply"] = "Za dużo na jeden nóż, za mało na stado.",
	["quest.side_fp_stampede.bark.accept1"] = "Najpierw olbrzymy. Stado bez pędzących samo zwolni.",
	["quest.side_fp_stampede.bark.half1"] = "Słyszysz? Stado zwalnia.",
	["quest.side_fp_stampede.bark.done1"] = "Zagon rozbity. Wracaj.",
	["quest.side_fp_stampede.bark.stuck1"] = "Olbrzymy idą za stadem, nie przed nim. Szukaj z tyłu.",
	["quest.side_fp_warhorn.title"] = "Róg z czaszki",
	["quest.side_fp_warhorn.p1"] = "Olbrzymy w Twierdzy wołają stada rogiem zrobionym z czaszki mamuta. Mamuty idą na ten dźwięk jak na zew przodków.",
	["quest.side_fp_warhorn.p2"] = "Róg nosi wódz. Nie odda go grzecznie, a w Twierdzy mróz gryzie mocniej niż olbrzymy.",
	["quest.side_fp_warhorn.p3"] = "Przynieś mi go. Stada przestaną schodzić, kiedy nikt ich nie zawoła.",
	["quest.side_fp_warhorn.progress"] = "Wejdź do Zamarzniętej Twierdzy, pokonaj trzech elitarnych mroźnych olbrzymów i odbierz róg z czaszki mamuta.",
	["quest.side_fp_warhorn.done"] = "Zawieszę go na łuku z kłów. Niech stada wiedzą, że wojna nie jest ich. Weź coś ode mnie, rzeźbię też rzeczy przydatne.",
	["quest.side_fp_warhorn.done.pity"] = "Mówiłeś, że szkoda mamutów. Stado zeszło na pastwiska. Wszystkie, policzyłem. Róg zawieszę na łuku. Weź coś ode mnie.",
	["quest.side_fp_warhorn.say.horn"] = "Jak wygląda róg?",
	["quest.side_fp_warhorn.say.horn.reply"] = "Czaszka mamuta w żelazie. Usłyszysz, zanim zobaczysz. Zaznaczę wejście.",
	["quest.side_fp_warhorn.say.cold"] = "W Twierdzy pełno olbrzymów.",
	["quest.side_fp_warhorn.say.cold.reply"] = "I lodu. Weź to, mróz gryzie tam mocniej niż oni.",
	["quest.side_fp_warhorn.say.hang"] = "Co z nim zrobisz?",
	["quest.side_fp_warhorn.say.hang.reply"] = "Zawieszę na łuku. Niech stada wiedzą, kto je teraz woła.",
	["quest.side_fp_warhorn.bark.accept1"] = "Wódz nie odda rogu grzecznie. Nie proś go.",
	["quest.side_fp_warhorn.bark.half1"] = "Stado na tundrze podnosi głowy. Coś się zmienia w Twierdzy.",
	["quest.side_fp_warhorn.bark.done1"] = "Stada wiedzą, że wojna nie jest ich. Wracaj.",
	["quest.side_fp_warhorn.bark.death1"] = "Wstawaj. Twierdza nie lubi leżących.",
	-- G. Giermek Strażnicy
	["quest.side_fp_squire.title"] = "Bracia na murach",
	["quest.side_fp_squire.p1"] = "Byłem giermkiem brata Halgrima. Siodłałem konie, czyściłem zbroje, nosiłem wodę na mury.",
	["quest.side_fp_squire.p2"] = "Tej nocy, kiedy mróz przyszedł na Strażnicę, uciekłem. Wróciłem po kilku zimach. Nie umiem przejść przez bramę.",
	["quest.side_fp_squire.p3"] = "Moi bracia wciąż chodzą po murach. Zamarznięci, w zbrojach, z mieczami w dłoniach. Nie poznają nikogo.",
	["quest.side_fp_squire.p4"] = "Daj im spokój. Ja nie potrafię podnieść na nich ręki.",
	["quest.side_fp_squire.progress"] = "Zabij dziesięciu zamarzniętych rycerzy w Lodowej Strażnicy.",
	["quest.side_fp_squire.done"] = "Mur jest cichszy. Słyszałem stąd, jak padali. Każdego poznawałem po krokach.",
	["quest.side_fp_squire.say.why"] = "Dlaczego uciekłeś?",
	["quest.side_fp_squire.say.why.reply"] = "Byłem młody i bałem się mrozu. Teraz jestem stary i boję się bramy.",
	["quest.side_fp_squire.say.know"] = "Poznają cię?",
	["quest.side_fp_squire.say.know.reply"] = "Nie. To gorsze niż miecz.",
	["quest.side_fp_squire.say.how"] = "Jak im dać spokój?",
	["quest.side_fp_squire.say.how.reply"] = "Mieczem. Pamiętają tylko jedno: że mają pilnować.",
	["quest.side_fp_squire.bark.accept1"] = "Nie zabijaj ich. Daj im spocząć.",
	["quest.side_fp_squire.bark.half1"] = "To był brat Tomir. Poznałem po kroku. Zawsze powłóczył lewą nogą.",
	["quest.side_fp_squire.bark.done1"] = "Mur jest cichszy. Wracaj.",
	["quest.side_fp_shields.title"] = "Jałowiec dla tarcz",
	["quest.side_fp_shields.p1"] = "Na zewnętrznym murze wiszą tarcze z imionami rycerzy. Wiszą tam, odkąd Strażnica stoi.",
	["quest.side_fp_shields.p2"] = "Połóż gałązkę jałowca pod trzema, które znałem. Pachnie jak kaplica Strażnicy.",
	["quest.side_fp_shields.p3"] = "I przynieś mi pieczęcie z ich płaszczy. Pochowam je w dolinie, niech coś z nich zejdzie z gór.",
	["quest.side_fp_shields.progress"] = "Połóż jałowiec pod trzema tarczami na zachodnim murze Strażnicy i zdobądź cztery pieczęcie od zamarzniętych rycerzy.",
	["quest.side_fp_shields.done"] = "Cztery pieczęcie. Pochowam je przy kopcu w dolinie. Ingrid zawiąże im wstążki, choć nikt ich już nie odwiąże.",
	["quest.side_fp_shields.say.names"] = "Czyje to tarcze?",
	["quest.side_fp_shields.say.names.reply"] = "Brata Eryka, brata Tomira, brata Haralda. Uczyli mnie siodłać.",
	["quest.side_fp_shields.say.juniper"] = "Czemu jałowiec?",
	["quest.side_fp_shields.say.juniper.reply"] = "Pachnie jak kaplica Strażnicy. Może poznają.",
	["quest.side_fp_shields.say.seals"] = "Pieczęcie też?",
	["quest.side_fp_shields.say.seals.reply"] = "Pochowam je w dolinie. Niech coś z nich zejdzie z gór.",
	["quest.side_fp_shields.bark.accept1"] = "Trzy tarcze na zachodnim murze. Ich imiona są wyryte na umbach.",
	["quest.side_fp_shields.bark.half1"] = "Ostatnia tarcza. Brat Harald lubił jałowiec. Śmiał się, że pachnie domem.",
	["quest.side_fp_shields.bark.done1"] = "Pieczęcie pochowam przy kopcu. Wracaj.",
	["quest.side_fp_spurs.title"] = "Ostrogi giermka",
	["quest.side_fp_spurs.p1"] = "Mam jeszcze ostrogi giermka. Nie zasłużyłem na nie tamtej nocy i nie zasłużę już nigdy.",
	["quest.side_fp_spurs.p2"] = "Połóż je przed zaryglowaną bramą i zapal świece. Niech brama zobaczy, że wróciłem.",
	["quest.side_fp_spurs.p3"] = "Żywiołaki krążą wokół bramy jak wartownicy. Odgoń je, zanim zgaszą świece.",
	["quest.side_fp_spurs.progress"] = "Złóż ostrogi i zapal świece przed bramą Lodowej Strażnicy, zabij ośmiu lodowych żywiołaków przy Strażnicy.",
	["quest.side_fp_spurs.done"] = "Świece się palą. Jeśli brat Halgrim wciąż czuwa, niech wie, że jego giermek wrócił. Weź to. Mnie już nic z tego nie trzeba.",
	["quest.side_fp_spurs.done.why"] = "Mówiłem, że boję się bramy. Dziś stałem przy niej długo. Jeśli brat Halgrim wciąż czuwa, niech wie, że jego giermek wrócił. Weź to.",
	["quest.side_fp_spurs.say.forgive"] = "Wybaczą ci?",
	["quest.side_fp_spurs.say.forgive.reply"] = "Nie po to je zostawiam. Są ich, nie moje.",
	["quest.side_fp_spurs.say.enter"] = "Wejdziesz potem?",
	["quest.side_fp_spurs.say.enter.reply"] = "Nie dziś. Może kiedy brama mnie pozna.",
	["quest.side_fp_spurs.say.wind"] = "Świece zgasną na wietrze.",
	["quest.side_fp_spurs.say.wind.reply"] = "Zgasną. Wtedy zapalę nowe.",
	["quest.side_fp_spurs.bark.accept1"] = "Brama zobaczy, że wróciłem. Tylko tyle chcę.",
	["quest.side_fp_spurs.bark.near1"] = "Tu stałem tamtej nocy. Tu się odwróciłem.",
	["quest.side_fp_spurs.bark.half1"] = "Żywiołaki krążą bliżej świec. Nie pozwól im zgasić.",
	["quest.side_fp_spurs.bark.done1"] = "Jeśli brat Halgrim wciąż czuwa, niech wie, że jego giermek wrócił.",
	-- H. Kości wyrmów
	["quest.side_fp_letter.title"] = "List do Vigdis",
	["quest.side_fp_letter.p1"] = "Od lat piszę z uczoną Vigdis z południowego archiwum. Pisze o smokach lepiej niż ktokolwiek, kogo znam. Teraz przyszła pod Smocze Schody sama.",
	["quest.side_fp_letter.p2"] = "Zanieś jej ten list. Proszę ją, żeby zeszła z gór. Wiem, że nie zejdzie, ale muszę poprosić.",
	["quest.side_fp_letter.progress"] = "Zanieś list Brata Anzelma Uczonej Vigdis u podnóża Smoczych Schodów.",
	["quest.side_fp_letter.done"] = "Anzelm. Pisze, żebym zeszła. Pisze tak od dwudziestu lat. Odpiszę mu stąd, z góry. Skoro już tu jesteś, przydasz się.",
	["quest.side_fp_letter.say.who"] = "Kim jest Vigdis?",
	["quest.side_fp_letter.say.who.reply"] = "Uczoną z południowego archiwum. Upartą, jak wszyscy uczeni.",
	["quest.side_fp_letter.say.warn"] = "Przed czym ją ostrzegasz?",
	["quest.side_fp_letter.say.warn.reply"] = "Przed ciekawością. Mnie kiedyś kosztowała dużo.",
	["quest.side_fp_letter.say.where"] = "Gdzie ją znajdę?",
	["quest.side_fp_letter.say.where.reply"] = "U podnóża Smoczych Schodów. Zaznaczę.",
	["quest.side_fp_letter.bark.accept1"] = "Daj jej list, zanim zacznie mówić. Potem nie zdążysz.",
	["quest.side_fp_letter.bark.done1"] = "Od Anzelma? Odpiszę mu z góry. Niech się martwi z widokiem.",
	["quest.side_fp_clutches.title"] = "Lęgi w skarpach",
	["quest.side_fp_clutches.p1"] = "Wyrmy składają lęgi w norach skarp lodowych za Szlakiem Kości. Skorupy są cienkie jak szkło i ciepłe mimo mrozu.",
	["quest.side_fp_clutches.p2"] = "Trzeba je rozbić, zanim się wyklują. Zanotuję każdą skorupę, ale rozbić muszę ręką kogoś innego.",
	["quest.side_fp_clutches.p3"] = "Smoczy pomiot pilnuje nor jak świątyni. Przerzedź go, inaczej nie podejdziesz.",
	["quest.side_fp_clutches.progress"] = "Rozbij trzy lęgi w norach skarp lodowych i zabij dwunastu smoczych pomiotów na Iglicy Wyrmów.",
	["quest.side_fp_clutches.done"] = "Tej wiosny nic się tu nie wykluje. Skorupy rosną słojami, jak drewno. To ważne, choć jeszcze nie wiem dlaczego. Zapiszę.",
	["quest.side_fp_clutches.say.spawn"] = "Lęgi smoczego pomiotu?",
	["quest.side_fp_clutches.say.spawn.reply"] = "Wyrmów. Pomiot ich pilnuje. Proszę nie mylić, piszę traktat.",
	["quest.side_fp_clutches.say.eggs"] = "To tylko jaja.",
	["quest.side_fp_clutches.say.eggs.reply"] = "Za rok to tylko wyrmy. Za dziesięć lat tylko twoja dolina.",
	["quest.side_fp_clutches.say.burrows"] = "Gdzie nory?",
	["quest.side_fp_clutches.say.burrows.reply"] = "W skarpach za Szlakiem Kości. Zaznaczę.",
	["quest.side_fp_clutches.bark.accept1"] = "Trzy nory. Pomiot ich pilnuje, proszę o tym pamiętać.",
	["quest.side_fp_clutches.bark.half1"] = "Skorupy cienkie jak szkło. Zanotuję.",
	["quest.side_fp_clutches.bark.done1"] = "Tej wiosny nic się tu nie wykluje.",
	["quest.side_fp_clutches.bark.death1"] = "Wstań. Notatki prowadzę, nekrologów nie.",
	["quest.side_fp_bonetrail.title"] = "Żebra wyrma",
	["quest.side_fp_bonetrail.p1"] = "Szkielet na Szlaku Kości to wyrm starszy niż pamięć ludzi. Żebra tworzą nad drogą bramę.",
	["quest.side_fp_bonetrail.p2"] = "Chcę go porównać z łuskami żywych wyrmów. Jeśli rosną tak samo, mam odpowiedź, której się boję.",
	["quest.side_fp_bonetrail.p3"] = "Idź do szkieletu i obejrzyj żebra. Potem przynieś trzy łuski. Żywych, proszę, martwe już mam.",
	["quest.side_fp_bonetrail.progress"] = "Dojdź do szkieletu wyrma na Szlaku Kości i zdobądź trzy łuski od mroźnych wyrmów na Iglicy Wyrmów.",
	["quest.side_fp_bonetrail.done"] = "Rosną tak samo. Słojami, jak drzewa i jak smok. To nie zwierzęta gór. To potomstwo smoka.",
	["quest.side_fp_bonetrail.say.age"] = "Ile lat ma ten szkielet?",
	["quest.side_fp_bonetrail.say.age.reply"] = "Więcej niż kroniki. Kroniki są młodsze, niż się wydaje.",
	["quest.side_fp_bonetrail.say.scales"] = "Po co łuski żywych?",
	["quest.side_fp_bonetrail.say.scales.reply"] = "Do porównania przyrostu. Najpierw łuski, potem kości.",
	["quest.side_fp_bonetrail.say.trail"] = "Którędy?",
	["quest.side_fp_bonetrail.say.trail.reply"] = "Z tundry na płaskowyż. Kości same pokazują drogę.",
	["quest.side_fp_bonetrail.bark.accept1"] = "Szkielet i trzy łuski. Kolejność dowolna, proszę tylko wrócić.",
	["quest.side_fp_bonetrail.bark.near1"] = "Patrz na żebra. Rosną słojami, jak u smoka.",
	["quest.side_fp_bonetrail.bark.half1"] = "Łuski żywych rosną tak samo. Tego się bałam.",
	["quest.side_fp_bonetrail.bark.done1"] = "Mam dowód. Wracaj, zanim go zgubię w notatkach.",
	["quest.side_fp_treatise.title"] = "O wylęgu",
	["quest.side_fp_treatise.p1"] = "Kończę traktat. Tytuł: „O wylęgu”. Wyrmy to potomstwo smoka, i to w górach już wiedzą, a w dolinach jeszcze nie.",
	["quest.side_fp_treatise.p1.eggs"] = "Mówiłeś, że to tylko jaja. Teraz wiesz, czyje. Kończę traktat „O wylęgu”. W górach to już wiedzą, w dolinach jeszcze nie.",
	["quest.side_fp_treatise.p2"] = "Wyrmy krążą nad moim obozem, odkąd rozbiłeś lęgi. Pamiętają. Przerzedź je, muszę skończyć w ciszy.",
	["quest.side_fp_treatise.p3"] = "Potem zanieś traktat Anzelmowi. Do archiwum, nie do kominka.",
	["quest.side_fp_treatise.p4"] = "Ja zostanę. Anzelm prosił, żebym zeszła. Zejdę, kiedy skończę następny.",
	["quest.side_fp_treatise.progress"] = "Zabij dziesięciu mroźnych wyrmów na Iglicy Wyrmów i zanieś traktat „O wylęgu” Bratu Anzelmowi w mieście.",
	["quest.side_fp_treatise.done"] = "„O wylęgu.” Odłożę go do archiwum, tam, gdzie kiedyś stała inna księga, której nie powinno się było czytać. Ta jest inna. Tę trzeba czytać. Weź to za drogę.",
	["quest.side_fp_treatise.say.title"] = "Czemu „O wylęgu”?",
	["quest.side_fp_treatise.say.title.reply"] = "Bo „O tym, czego się boję” brzmi mniej naukowo.",
	["quest.side_fp_treatise.say.down"] = "Anzelm prosił, żebyś zeszła.",
	["quest.side_fp_treatise.say.down.reply"] = "Zejdę, kiedy skończę. Traktat zejdzie pierwszy.",
	["quest.side_fp_treatise.say.blood"] = "Smok i wyrmy to jedna krew?",
	["quest.side_fp_treatise.say.blood.reply"] = "Jedna. Dlatego ten traktat nie może zostać w górach.",
