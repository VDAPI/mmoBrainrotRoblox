	-- NPCs (S27)
	["npc.granary_keeper.name"] = "Zarządca Ignacy",
	["npc.granary_keeper.role"] = "Zarządca spichlerza",
	["npc.granary_keeper.greeting"] = "Każdy worek zapisany, każde ziarno policzone. Tylko worków coraz mniej.",
	["npc.granary_keeper.line1"] = "Zima przychodzi zawsze w tym samym miesiącu. Ludzie co roku są zdziwieni.",
	["npc.granary_keeper.line2"] = "Spichlerz to serce miasta. Puste serce długo nie pobije.",
	["npc.granary_keeper.line3"] = "Myszy liczę osobno. Też jedzą, a podatku nie płacą.",
	["npc.granary_keeper.where"] = "przy spichlerzu",
	["npc.brother_anzelm.name"] = "Brat Anzelm",
	["npc.brother_anzelm.role"] = "Zakonnik",
	["npc.brother_anzelm.greeting"] = "Niech światło prowadzi twoje kroki. A gdy zgaśnie, niech prowadzi rozsądek.",
	["npc.brother_anzelm.line1"] = "Stare miejsca pamiętają więcej niż kroniki. Trzeba tylko umieć słuchać.",
	["npc.brother_anzelm.line2"] = "Modlitwa nie zastąpi miecza. Ale miecz bez modlitwy łatwo się gubi.",
	["npc.brother_anzelm.line3"] = "Lekarka Mirela leczy ciała. Ja próbuję reszty, z różnym skutkiem.",
	["npc.brother_anzelm.where"] = "przed świątynią",
	["npc.fishwife.name"] = "Rybaczka Jagna",
	["npc.fishwife.role"] = "Rybaczka",
	["npc.fishwife.greeting"] = "Świeże z rana! No, z wczoraj rana. Ale pachną jeszcze jak ryby.",
	["npc.fishwife.line1"] = "Ojciec łowi na Łąkach, ja sprzedaję w mieście. Tak jest od zawsze.",
	["npc.fishwife.line2"] = "Kto kupuje rybę bez wąchania, ten kupuje kłopot.",
	["npc.fishwife.line3"] = "Wiatr od bramy. Będzie deszcz, a w deszczu ryba lepiej bierze.",
	["npc.fishwife.where"] = "przy straganie z rybami",
	["npc.innkeeper.name"] = "Karczmarz Wacław",
	["npc.innkeeper.role"] = "Karczmarz",
	["npc.innkeeper.greeting"] = "Siadaj, wędrowcze. Piwo zimne, ława ciepła, a plotki za darmo.",
	["npc.innkeeper.line1"] = "W karczmie słychać wszystko. Sztuka w tym, żeby zapamiętać tylko to, co się opłaca.",
	["npc.innkeeper.line2"] = "Kto płaci za kolejkę, ten słyszy więcej. Taka zasada.",
	["npc.innkeeper.line3"] = "Ostatni bohater, który tu nocował, zostawił długi i pół miecza.",
	["npc.innkeeper.gossip1"] = "Słyszałem, że {npc} {where} szuka kogoś do roboty.",
	["npc.innkeeper.gossip2"] = "Ludzie gadają, że {npc} {where} potrzebuje pomocy. Podobno płaci uczciwie.",
	["npc.innkeeper.gossip3"] = "{npc} {where} — tam podobno jest robota dla kogoś takiego jak ty.",
	["npc.innkeeper.where"] = "w karczmie",
	["npc.miller_widow.name"] = "Młynarzowa Hanna",
	["npc.miller_widow.role"] = "Wdowa po młynarzu",
	["npc.miller_widow.greeting"] = "Mąż prowadził młyn na Łąkach. Teraz został mi tylko ten, tutaj.",
	["npc.miller_widow.line1"] = "Woda kręci kołem bez względu na to, kto umarł. Może to i dobrze.",
	["npc.miller_widow.line2"] = "Mąka z miejskiego młyna jest gorsza. Ale nikt jej nie podpali.",
	["npc.miller_widow.line3"] = "Pytają mnie, czy wrócę na Łąki. Nie wiem. Jeszcze nie.",
	["npc.miller_widow.where"] = "przy młynie nad rzeką",
	["npc.stablemaster.name"] = "Stajenny Radosz",
	["npc.stablemaster.role"] = "Stajenny",
	["npc.stablemaster.greeting"] = "Konie są uczciwsze od ludzi. Zawsze wiesz, kiedy chcą cię kopnąć.",
	["npc.stablemaster.line1"] = "Koń zna drogę do domu lepiej niż jeździec. Pamiętaj o tym w mgle.",
	["npc.stablemaster.line2"] = "Kupcy płacą mi za postój, bandyci za milczenie. Tym drugim odmawiam.",
	["npc.stablemaster.line3"] = "Owies zdrożał. Wszystko zdrożało, odkąd na trakcie jest niebezpiecznie.",
	["npc.stablemaster.where"] = "w stajni przy bramie",
	["npc.sergeant.name"] = "Sierżant Dobiesław",
	["npc.sergeant.role"] = "Sierżant straży",
	["npc.sergeant.greeting"] = "Mów krótko. Straż ma więcej roboty niż ludzi.",
	["npc.sergeant.line1"] = "Listy gończe wiszą na ścianie wartowni. Jeśli umiesz czytać i walczyć, zajrzyj.",
	["npc.sergeant.line2"] = "Kapitan pilnuje murów. Ja pilnuję, żeby za murami nie było gorzej.",
	["npc.sergeant.line3"] = "Każdy bandyta ma kogoś, kto mu sprzedaje informacje. Szukam tego kogoś.",
	["npc.sergeant.where"] = "w wartowni",
	["npc.blacksmith.where"] = "w kuźni",
	["npc.farmer_bartosz.name"] = "Farmer Bartosz",
	["npc.farmer_bartosz.role"] = "Farmer",
	["npc.farmer_bartosz.greeting"] = "Ziemia tu dobra, tylko wszystko na niej chce mnie zjeść albo okraść.",
	["npc.farmer_bartosz.line1"] = "Kapusta rośnie sama. To, co ją zjada, też.",
	["npc.farmer_bartosz.line2"] = "Ignacy myśli, że zboże rośnie w workach. Niech raz tu przyjdzie.",
	["npc.farmer_bartosz.line3"] = "Pszczoły w tym roku łagodne. Przynajmniej one.",
	["npc.farmer_bartosz.where"] = "na farmie za bramą Łąk",
	["npc.fisher_wit.name"] = "Rybak Wit",
	["npc.fisher_wit.role"] = "Rybak",
	["npc.fisher_wit.greeting"] = "Cicho. Ryby słyszą kroki. Ropuchy niestety też.",
	["npc.fisher_wit.line1"] = "Moja Jagna sprzedaje w mieście wszystko, co tu złowię. Mądra dziewczyna.",
	["npc.fisher_wit.line2"] = "Na Oczku najlepiej bierze o świcie. Wtedy nawet bagno pachnie lepiej.",
	["npc.fisher_wit.line3"] = "Wędkę mogę ci sprzedać. Cierpliwości nie sprzedam, musisz mieć własną.",
	["npc.fisher_wit.where"] = "nad Żabim Oczkiem",
	["npc.woodcutter_gerwazy.name"] = "Drwal Gerwazy",
	["npc.woodcutter_gerwazy.role"] = "Drwal",
	["npc.woodcutter_gerwazy.greeting"] = "Uważaj, gdzie stoisz. Drzewa padają tam, gdzie chcą, nie tam, gdzie mówię.",
	["npc.woodcutter_gerwazy.line1"] = "Stary Las był stary, zanim ktokolwiek nazwał go starym.",
	["npc.woodcutter_gerwazy.line2"] = "Kruki tu są bezczelne. Wczoraj jeden ukradł mi chleb z ręki.",
	["npc.woodcutter_gerwazy.line3"] = "Topór ostrzę co rano. Siebie co wieczór, przy piwie od Wacława.",
	["npc.woodcutter_gerwazy.where"] = "na polanie w Starym Lesie",
	["npc.merchant_lucjan.name"] = "Kupiec Lucjan",
	["npc.merchant_lucjan.role"] = "Kupiec z rozbitego wozu",
	["npc.merchant_lucjan.greeting"] = "Kiedyś miałem wóz, konie i towar. Dziś mam tylko dobre maniery.",
	["npc.merchant_lucjan.line1"] = "Jeździłem tym traktem dwadzieścia lat. Pierwszy raz ktoś mi przeszkodził.",
	["npc.merchant_lucjan.line2"] = "Sukno z południa jest warte więcej niż mój wóz. Bandyci to wiedzieli.",
	["npc.merchant_lucjan.line3"] = "Nie odejdę od wozu, dopóki nie odzyskam swojego. Uparty jestem.",
	["npc.merchant_lucjan.where"] = "przy rozbitym wozie na trakcie",
	["npc.miner_dobromir.name"] = "Górnik Dobromir",
	["npc.miner_dobromir.role"] = "Górnik",
	["npc.miner_dobromir.greeting"] = "Wyrobisko jest stare, ruda jeszcze jest. Tylko te koboldy...",
	["npc.miner_dobromir.line1"] = "Koboldy kopią lepiej niż ludzie. Szkoda, że kopią w moim wyrobisku.",
	["npc.miner_dobromir.line2"] = "Kilof sprzedam. Kto nie ma kilofa, ten nie ma tu czego szukać.",
	["npc.miner_dobromir.line3"] = "Dorgan krzyczy, że ruda późno. Niech sam zejdzie na trzeci taras.",
	["npc.miner_dobromir.where"] = "na skraju Starego Wyrobiska",
	["npc.hunter_borys.name"] = "Myśliwy Borys",
	["npc.hunter_borys.role"] = "Myśliwy",
	["npc.hunter_borys.greeting"] = "Mów szeptem. W jarze echo niesie się daleko, a niedźwiedzie mają dobry słuch.",
	["npc.hunter_borys.line1"] = "Niedźwiedź nie atakuje bez powodu. Kiedy atakuje, szukaj powodu.",
	["npc.hunter_borys.line2"] = "Wodospad zagłusza wszystko. Dobre miejsce na zasadzkę. Dla kogokolwiek.",
	["npc.hunter_borys.line3"] = "Skóry suszę przy ogniu, mięso wędzę. Reszta to cierpliwość.",
	["npc.hunter_borys.where"] = "nad Niedźwiedzim Jarem",

	-- Side quests (S27): title, pages, progress line, thanks
	["quest.side_granary.title"] = "Zamówienie na zboże",
	["quest.side_granary.p1"] = "Spichlerz świeci pustkami, a zima nie pyta, czy zdążyliśmy. Bartosz z farmy za bramą miał przysłać zboże dwa tygodnie temu.",
	["quest.side_granary.p2"] = "Ani wozu, ani wiadomości. Bartosz jest uparty, ale słowny — coś musiało go zatrzymać.",
	["quest.side_granary.p3"] = "Zanieś mu to zamówienie z pieczęcią spichlerza. Farma stoi przy trakcie, na zachód od kapliczki pod starym dębem.",
	["quest.side_granary.progress"] = "Bartosz czeka na zamówienie. Farma leży tuż za bramą Łąk.",
	["quest.side_granary.done"] = "Zamówienie od Ignacego? Wiem, wiem, spóźniam się. Rozejrzyj się, a zrozumiesz dlaczego.",
	["quest.side_rabbits.title"] = "Plaga uszatych",
	["quest.side_rabbits.p1"] = "Króliki. Setki królików. Wyżarły mi pół pola kapusty, zanim zdążyłem złapać za widły.",
	["quest.side_rabbits.p2"] = "Przetrzebij je na Polanie Królików. Dziesięć sztuk wystarczy, żeby reszta zrozumiała. Potem pogadamy o zbożu.",
	["quest.side_rabbits.progress"] = "Dziesięć królików z Polany. Te z mojego pola liczą się podwójnie, ale tylko w mojej głowie.",
	["quest.side_rabbits.done"] = "Od razu ciszej. Dobra robota. Ale to dopiero początek moich kłopotów.",
	["quest.side_fence.title"] = "Dziurawy płot",
	["quest.side_fence.p1"] = "Wilki przechodzą przez mój płot jak przez sito. Cztery rogi warzywnika, każdy połamany.",
	["quest.side_fence.p2"] = "Deski leżą przy stodole. Wymień je w każdym rogu, a ja w tym czasie popilnuję kapusty.",
	["quest.side_fence.progress"] = "Cztery rogi płotu przy warzywniku. Wbijaj deski mocno — wilki nie pukają.",
	["quest.side_fence.done"] = "Teraz to jest płot! Niech któryś szary spróbuje.",
	["quest.side_sheep.title"] = "Dzwonki moich owiec",
	["quest.side_sheep.p1"] = "Płot to jedno, ale owce przepadły już wcześniej. Wilki porwały je z pastwiska, jedną po drugiej.",
	["quest.side_sheep.p2"] = "Każda miała dzwonek z moim znakiem. Wilki łykają je razem z mięsem, takie to głupie bestie.",
	["quest.side_sheep.p3"] = "Przynieś mi pięć dzwonków. Owiec nie wskrzeszę, ale chcę wiedzieć, ile ich naprawdę straciłem.",
	["quest.side_sheep.progress"] = "Dzwonki znajdziesz w wilkach. Szukaj na polanach i na zboczach Wilczych Wzgórz.",
	["quest.side_sheep.done"] = "Pięć... Wszystkie z mojego stada. Przynajmniej wiem, na czym stoję. Dzięki.",
	["quest.side_grainCart.title"] = "Wóz do miasta",
	["quest.side_grainCart.p1"] = "Na farmie spokój, to i zboże jest. Ten worek jest dla Ignacego, pierwszy z wielu.",
	["quest.side_grainCart.p2"] = "Tylko że przy drodze do miasta znów kręcą się wilki. Mój chłopak boi się jechać.",
	["quest.side_grainCart.p3"] = "Zanieś worek do spichlerza i przetrzeb wilki po drodze. Ignacy będzie wiedział, jak się odwdzięczyć.",
	["quest.side_grainCart.progress"] = "Worek zboża dla Ignacego w mieście. I sześć wilków mniej przy drodze.",
	["quest.side_grainCart.done"] = "Zboże od Bartosza! Myślałem, że go już pochowali. Spichlerz ma wobec ciebie dług — wybierz coś ze skrzyni straży.",
	["quest.side_shrine.title"] = "Świece pod dębem",
	["quest.side_shrine.p1"] = "Pod starym dębem na Łąkach stoi kapliczka starsza niż mury tego miasta. Od jesieni nikt nie zapalił tam świecy.",
	["quest.side_shrine.p2"] = "Podróżni mówią, że noce na Łąkach zrobiły się dziwnie ciche. Ja mówię, że to nie przypadek.",
	["quest.side_shrine.p3"] = "Zapal świece w kapliczce i złóż ofiarę z trzech gałązek wiązówki. Modlitwę zostaw mnie.",
	["quest.side_shrine.progress"] = "Świece w kapliczce pod dębem i trzy gałązki wiązówki z łąk.",
	["quest.side_shrine.done"] = "Czuję to nawet tutaj. Dąb znów czuwa. Dziękuję.",
	["quest.side_stoneCircle.title"] = "Kamienny krąg",
	["quest.side_stoneCircle.p1"] = "Gdy płomień w kapliczce się zajął, przeczytałem stare zapiski. Kapliczka to tylko brama. Prawdziwe miejsce leży wyżej.",
	["quest.side_stoneCircle.p2"] = "Na grzbiecie Wilczych Wzgórz stoi kamienny krąg. Rysie zrobiły sobie z niego legowisko i kalają go krwią.",
	["quest.side_stoneCircle.p3"] = "Idź do kręgu, zobacz go na własne oczy i przegoń rysie ze wzgórz. Osiem powinno wystarczyć.",
	["quest.side_stoneCircle.progress"] = "Kamienny krąg na grzbiecie Wilczych Wzgórz i osiem rysi z okolicy.",
	["quest.side_stoneCircle.done"] = "Krąg znów jest pusty i cichy. Tak ma być. Weź to — błogosławieństwo nie zastąpi stali.",
	["quest.side_father.title"] = "Chleb dla ojca",
	["quest.side_father.p1"] = "Ojciec siedzi nad Żabim Oczkiem od tygodnia i nie chce wracać do miasta. Mówi, że sieci same się nie wyciągną.",
	["quest.side_father.p2"] = "Zanieś mu ten koszyk z chlebem. I powiedz, że jak nie zje, to przyjdę osobiście.",
	["quest.side_father.progress"] = "Koszyk z chlebem dla Wita. Chata rybaka stoi na północnym brzegu Żabiego Oczka.",
	["quest.side_father.done"] = "Od Jagny? Uparta jak matka. Dobrze, zjem. A skoro już tu jesteś...",
	["quest.side_toads.title"] = "Ropuchy z bagna",
	["quest.side_toads.p1"] = "Ropuchy rozpleniły się na mokradłach. Zjadają narybek, zanim zdąży urosnąć do patelni.",
	["quest.side_toads.p2"] = "Dwanaście sztuk mniej i woda odetchnie. Uważaj na jad, piecze jak diabli.",
	["quest.side_toads.progress"] = "Dwanaście ropuch z bagien przy Żabim Oczku.",
	["quest.side_toads.done"] = "Od razu słychać ryby zamiast rechotu. Mam dla ciebie jeszcze jedną sprawę.",
	["quest.side_venom.title"] = "Jad na lekarstwo",
	["quest.side_venom.p1"] = "Moja Jagna kaszle od zimy. Alchemiczka w mieście mówi, że z jadu bagiennych ropuch zrobi syrop.",
	["quest.side_venom.p2"] = "Ja jestem za stary na łażenie po bagnie, a ropuchy nie oddają jadu po dobroci.",
	["quest.side_venom.p3"] = "Zbierz sześć woreczków jadu i zanieś je Ysolde. Tylko szczelnie zawiązane, na miłość bogów.",
	["quest.side_venom.progress"] = "Sześć woreczków jadu ropuch dla Alchemiczki Ysolde w mieście.",
	["quest.side_venom.done"] = "Świeży, gęsty jad... Wystarczy na syrop dla Jagny i parę eliksirów dla mnie. Uczciwa wymiana, nieprawdaż?",
	["quest.side_net.title"] = "Sieć przy brzegu",
	["quest.side_net.p1"] = "Syrop pomógł, Jagna mi napisała. Teraz moja kolej, żeby jej coś posłać.",
	["quest.side_net.p2"] = "Moja najlepsza sieć utknęła przy brzegu, za pomostem. Sam jej nie wyciągnę, plecy już nie te.",
	["quest.side_net.p3"] = "Wyciągnij sieć i złów trzy ryby. Zanieś je Jagnie — niech wie, że ojciec o niej pamięta.",
	["quest.side_net.progress"] = "Sieć przy brzegu Żabiego Oczka i trzy złowione ryby dla Jagny.",
	["quest.side_net.done"] = "Ryby od ojca? Stary uparciuch... Dziękuję. Weź coś ode mnie, nie odmawiaj.",
	["quest.side_roast.title"] = "Pieczeń na święto",
	["quest.side_roast.p1"] = "Święto za pasem, a ja nie mam mięsa. Dziki w Starym Lesie są tłuste jak nigdy.",
	["quest.side_roast.p2"] = "Sześć udźców i masz u mnie piwo do końca miesiąca. No, do końca tygodnia.",
	["quest.side_roast.progress"] = "Sześć udźców dzika ze Starego Lasu.",
	["quest.side_roast.done"] = "To jest mięso! Kucharka się popłacze ze szczęścia. Słuchaj, mam jeszcze jedną prośbę.",
	["quest.side_woodcutter.title"] = "Baryłka dla drwala",
	["quest.side_woodcutter.p1"] = "Gerwazy, drwal ze Starego Lasu, dostarcza mi drewno na opał. Od miesiąca nie przysłał ani polana.",
	["quest.side_woodcutter.p2"] = "Zanieś mu baryłkę piwa i zapytaj, co się dzieje. Piwo zwykle rozwiązuje mu język.",
	["quest.side_woodcutter.progress"] = "Baryłka piwa dla Gerwazego. Chata drwala stoi na polanie przy leśnej ścieżce.",
	["quest.side_woodcutter.done"] = "Piwo od Wacława? Stary lis wie, jak mnie przekupić. Siadaj, opowiem ci o tych przeklętych ptaszyskach.",
	["quest.side_logs.title"] = "Ścięte i oznaczone",
	["quest.side_logs.p1"] = "Ścinam drzewa, układam stosy, a rano połowa jest rozgrzebana. To nie ludzie. To kruki.",
	["quest.side_logs.p2"] = "Ścierwniki wyciągają spod kory robactwo i rozwalają mi stosy, a potem jeszcze dziobią konie.",
	["quest.side_logs.p3"] = "Oznacz moim znakiem pięć stosów w lesie, żeby nikt mi ich nie podebrał, i przegoń ośmiu ścierwników.",
	["quest.side_logs.progress"] = "Pięć stosów drewna w Starym Lesie do oznaczenia i ośmiu ścierwników mniej.",
	["quest.side_logs.done"] = "Znaki na stosach, kruki precz. Mogę znów pracować. Tylko jedno nie daje mi spokoju...",
	["quest.side_shiny.title"] = "Skarb ścierwników",
	["quest.side_shiny.p1"] = "Kruki znoszą do gniazd wszystko, co się błyszczy. Guziki, gwoździe, monety. Ostatnio coś więcej.",
	["quest.side_shiny.p2"] = "Jeden upuścił pierścień z herbem młyna. Młyn spłonął zeszłej jesieni, razem z młynarzem.",
	["quest.side_shiny.p3"] = "Odbierz krukom pięć błyszczących drobiazgów. Jeśli wśród nich jest sygnet młynarza, zanieś go wdowie, Hannie, do miasta.",
	["quest.side_shiny.progress"] = "Pięć błyszczących drobiazgów od ścierwników. Wszystko dla Hanny, młynarzowej przy młynie w mieście.",
	["quest.side_shiny.done"] = "To... to jego sygnet. Nosił go do końca. Skąd kruk miałby go wziąć, skoro mąż spłonął w młynie? Przyjmij to, proszę. I wróć do mnie.",
	["quest.side_mill.title"] = "Zgliszcza młyna",
	["quest.side_mill.p1"] = "Mówili mi, że to był wypadek. Iskra spod kamienia, sucha mąka, ogień w minutę.",
	["quest.side_mill.p2"] = "Ale sygnet nie spada sam z ręki martwego człowieka. Ktoś go zdjął, zanim młyn się zawalił.",
	["quest.side_mill.p3"] = "Przeszukaj zgliszcza na Kruczym Polu. Kręcą się tam bandyci, więc uważaj — sześciu mniej nie zaszkodzi.",
	["quest.side_mill.progress"] = "Zgliszcza spalonego młyna na Kruczym Polu i sześciu bandytów z okolicy.",
	["quest.side_mill.done"] = "Skrzynka pod popiołem... i list przemytnika, który chciał kupić młyn. Mąż mu odmówił. Teraz wiem, czym za to zapłacił.",
	["quest.side_smugglers.title"] = "Kryjówka Przemytników",
	["quest.side_smugglers.p1"] = "Ten przemytnik ma kryjówkę w jaskini na południu Łąk. Wszyscy o niej wiedzą i nikt nic nie robi.",
	["quest.side_smugglers.p2"] = "Na czele stoi Herszt Bandytów. To on kazał spalić młyn, gdy mąż odmówił przechowywania jego towaru.",
	["quest.side_smugglers.p3"] = "Nie chcę zemsty. Chcę dowodu. Herszt prowadzi księgę rachunkową — tam jest wszystko.",
	["quest.side_smugglers.p4"] = "Zdobądź tę księgę i zanieś ją sierżantowi Dobiesławowi do wartowni. On będzie wiedział, co z tym zrobić.",
	["quest.side_smugglers.progress"] = "Kryjówka Przemytników, Herszt Bandytów i jego księga rachunkowa dla sierżanta Dobiesława.",
	["quest.side_smugglers.done"] = "Księga Herszta... Tu jest pół traktu. Wszystkie łapówki, wszystkie spalone domy. Hanna dostanie sprawiedliwość, a ty nagrodę z kasy straży.",
	["quest.side_wagon.title"] = "Konie bez wozu",
	["quest.side_wagon.p1"] = "Dwa konie kupca Lucjana wróciły wczoraj same, z przeciętymi postronkami. Wozu ani śladu.",
	["quest.side_wagon.p2"] = "Lucjan jechał Kupieckim Traktem. Jeśli żyje, jest gdzieś przy drodze. Znajdź go.",
	["quest.side_wagon.progress"] = "Odszukaj kupca Lucjana przy Kupieckim Trakcie.",
	["quest.side_wagon.done"] = "Konie wróciły? Bogom dzięki, chociaż one. Mnie zostawili tylko życie i rozbity wóz.",
	["quest.side_goods.title"] = "Rozbity wóz",
	["quest.side_goods.p1"] = "Bandyci napadli mnie w biały dzień. Zabrali sukno, osiem bel najlepszego sukna z południa.",
	["quest.side_goods.p2"] = "Coś mogło zostać w wozie. Przeszukaj go, ja nie mam odwagi tam wracać.",
	["quest.side_goods.p3"] = "A potem odbierz moje bele tym łotrom z traktu. Każdy z nich nosi teraz moje sukno pod płaszczem.",
	["quest.side_goods.progress"] = "Przeszukaj rozbity wóz i odbierz osiem bel sukna bandytom z Kupieckiego Traktu.",
	["quest.side_goods.done"] = "Moje sukno! I list przewozowy z wozu, z pieczęcią straży, którą ktoś przekupił. Pokaż to sierżantowi.",
	["quest.side_wanted.title"] = "List gończy",
	["quest.side_wanted.p1"] = "List przewozowy od Lucjana potwierdza to, co podejrzewałem. Bandyci z traktu mają kogoś w straży.",
	["quest.side_wanted.p2"] = "Zanim go znajdę, trzeba oczyścić drogę. Piętnastu bandytów z Kupieckiego Traktu. Żywych czy martwych — wolę to drugie.",
	["quest.side_wanted.progress"] = "Piętnastu bandytów z Kupieckiego Traktu.",
	["quest.side_wanted.done"] = "Trakt znów jest przejezdny. Kupcy już pytają, komu mają dziękować. Weź nagrodę ze zbrojowni straży.",
	["quest.side_ore.title"] = "List do górnika",
	["quest.side_ore.p1"] = "Dobromir ze Starego Wyrobiska nie przysłał mi rudy od trzech tygodni. A bez rudy nie ma stali.",
	["quest.side_ore.p2"] = "Zanieś mu mój list. Napisałem w nim, co myślę o jego punktualności. Kulturalnie, w miarę.",
	["quest.side_ore.progress"] = "List od Kowala Dorgana dla górnika Dobromira przy Starym Wyrobisku.",
	["quest.side_ore.done"] = "Dorgan się złości? Niech przyjdzie i sam spróbuje kopać z koboldami za plecami.",
	["quest.side_tools.title"] = "Kilofy z wyrobiska",
	["quest.side_tools.p1"] = "Koboldy z wyrobiska kradną mi narzędzia. Kilofy, łopaty, nawet taczkę wynieśli w nocy.",
	["quest.side_tools.p2"] = "Bez kilofów nie ma rudy, a bez rudy Dorgan dalej będzie krzyczał.",
	["quest.side_tools.p3"] = "Odbierz koboldom sześć kilofów. Rozpoznasz je po moim znaku na trzonku.",
	["quest.side_tools.progress"] = "Sześć kilofów od koboldów-górników ze Starego Wyrobiska.",
	["quest.side_tools.done"] = "Moje kilofy, wszystkie z moim znakiem. Zostało jedno: zatkać im te ich nory.",
	["quest.side_tunnels.title"] = "Zabezpieczone sztolnie",
	["quest.side_tunnels.p1"] = "Koboldy wychodzą z trzech starych sztolni na tarasach wyrobiska. Zabite deskami wytrzymają chociaż sezon.",
	["quest.side_tunnels.p2"] = "Zabezpiecz wszystkie trzy, a potem wydobądź osiem razy rudę z żył żelaza na dole.",
	["quest.side_tunnels.p3"] = "Rudę zanieś Dorganowi. Niech zobaczy, że Dobromir dotrzymuje słowa, kiedy ma czym kopać.",
	["quest.side_tunnels.progress"] = "Trzy sztolnie do zabezpieczenia i osiem razy żyła żelaza w Starym Wyrobisku. Potem do Kowala Dorgana.",
	["quest.side_tunnels.done"] = "Ruda od Dobromira, i to przez ciebie. Dobrej jakości. Za to wykuję ci coś porządnego — wybieraj.",
	["quest.side_totem.title"] = "Totem goblinów",
	["quest.side_totem.p1"] = "Gobliny w obozie na północnym wschodzie Łąk przestały się chować. Zwiadowcy widzieli totem i bębny.",
	["quest.side_totem.p2"] = "Totem to ich duma i ich znak dla innych plemion. Dopóki stoi, będzie ich więcej.",
	["quest.side_totem.p3"] = "Przetrzeb dwunastu zwiadowców z obozu i podpal totem. Niech dym będzie widać aż z murów.",
	["quest.side_totem.progress"] = "Dwunastu goblińskich zwiadowców w Goblińskim Obozie i podpalony totem.",
	["quest.side_totem.done"] = "Widziałem dym z wartowni. Dobra robota. Ale te gobliny nie wzięły się znikąd...",
	["quest.side_foreman.title"] = "Kobold Brygadzista",
	["quest.side_foreman.p1"] = "Jeńcy z obozu gadali o Goblińskim Kopcu, norach pod wzgórzami. Tam koboldy harują dla goblinów.",
	["quest.side_foreman.p2"] = "Brygadziści pędzą je do kopania i kradną rudę z wyrobiska. To ich Dobromir ma na karku.",
	["quest.side_foreman.p3"] = "Zejdź do Goblińskiego Kopca i pokonaj dwóch brygadzistów. Potem daj znać Dobromirowi — należy mu się spokój.",
	["quest.side_foreman.progress"] = "Gobliński Kopiec i dwóch Koboldów Brygadzistów. Potem do Dobromira przy wyrobisku.",
	["quest.side_foreman.done"] = "Brygadziści leżą? Koniec kradzieży rudy. Masz, to od górników — a raczej ode mnie i od Dorgana.",
	["quest.side_hunter.title"] = "Prowiant dla myśliwego",
	["quest.side_hunter.p1"] = "Borys poluje w Niedźwiedzim Jarze i zawsze bierze u mnie prowiant. Tym razem nie przyszedł.",
	["quest.side_hunter.p2"] = "Zanieś mu bukłak i suchary. Jeśli jest ranny, przynajmniej nie będzie głodny.",
	["quest.side_hunter.progress"] = "Bukłak i suchary dla myśliwego Borysa nad Niedźwiedzim Jarem.",
	["quest.side_hunter.done"] = "Wacław o mnie pamięta, poczciwiec. Dobrze, że jesteś. Przydasz się.",
	["quest.side_bears.title"] = "Rozjuszone niedźwiedzie",
	["quest.side_bears.p1"] = "Niedźwiedzie w jarze oszalały. Atakują za dnia, wychodzą z legowisk, nie boją się ognia.",
	["quest.side_bears.p2"] = "Coś je drażni. Zanim się dowiem co, trzeba ich mniej. Dziesięć.",
	["quest.side_bears.p3"] = "I przynieś mi cztery pazury. Po nich zobaczę, gdzie bywały.",
	["quest.side_bears.progress"] = "Dziesięć brunatnych niedźwiedzi w Niedźwiedzim Jarze i cztery pazury.",
	["quest.side_bears.done"] = "Na pazurach jest smoła i farba. Niedźwiedzie same się nie malują. Ktoś je szczuje.",
	["quest.side_den.title"] = "Legowisko w jarze",
	["quest.side_den.p1"] = "Największe legowisko leży pod skałą niedaleko wodospadu. Tam zaczęło się to szaleństwo.",
	["quest.side_den.p2"] = "Zbadaj je i zostaw mój znak, żeby myśliwi wiedzieli, gdzie nie chodzić.",
	["quest.side_den.p3"] = "Jeśli to gobliny podjudzają niedźwiedzie, ich zwiadowcy muszą kręcić się po jarze. Sześciu i będzie spokój.",
	["quest.side_den.progress"] = "Legowisko w Niedźwiedzim Jarze i sześciu goblińskich zwiadowców z okolicy.",
	["quest.side_den.done"] = "Gobliny z bębnami, smoła na pazurach... Teraz rozumiem. Jar znów jest nasz. Weź to — należy ci się.",
