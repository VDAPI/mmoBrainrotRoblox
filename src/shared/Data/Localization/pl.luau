	["path.trapper.woodsman.desc"] = "+{woodsman}% maks. życia.",
	["path.trapper.snarefield2.name"] = "Pole Śmierci",
	["path.trapper.snarefield2.desc"] = "Sidła Pola Sideł trują złapanych: {deathField}% przez 6 s.",
	["path.scout.eye.name"] = "Oko Zwiadowcy",
	["path.scout.eye.desc"] = "Elity i Elity II widzisz na minimapie o {eye} st. dalej (zwykle 140 st.); te poza kołem mapy wskazują znaczniki na jego krawędzi. Drużyna do 80 st. od Ciebie widzi to samo.",
	["path.scout.spotting.name"] = "Oznaczenie",
	["path.scout.spotting.desc"] = "Twoje ataki podstawowe i Celny Strzał osłabiają cel: przez 5 s otrzymuje o {spotting}% więcej obrażeń od wszystkich. Nie sumuje się ze Znakiem Łowcy, liczy się silniejszy.",
	["path.scout.vigilance.name"] = "Czujność",
	["path.scout.vigilance.desc"] = "Gdy potwór do 30 st. od Ciebie zaczyna atak z czerwoną strefą, drużyna do 40 st. (także Ty) porusza się o {vigilance}% szybciej do końca zamachu i 0,5 s po nim. Najwyżej raz na 8 s.",
	["path.scout.quickFingers.name"] = "Szybkie Palce",
	["path.scout.quickFingers.desc"] = "+{quickFingers}% szybkości ataku.",
	["path.scout.lightStep.name"] = "Lekka Stopa",
	["path.scout.lightStep.desc"] = "+{lightStep} pkt proc. uniku.",
	["path.scout.talons.name"] = "Ostre Szpony",
	["path.scout.talons.desc"] = "Uderzenia Sokoła zadają +{talons} pkt proc. obrażeń.",
	["path.scout.bond.name"] = "Sokola Więź",
	["path.scout.bond.desc"] = "Sokół zostaje z Tobą {bond} s dłużej. Z Królewskim Sokołem jego nurkowanie zadaje zamiast tego +{bondDive} pkt proc. obrażeń.",
	["path.scout.hardy.name"] = "Wytrwały Zwiadowca",
	["path.scout.hardy.desc"] = "+{hardy}% maks. życia.",
	["path.scout.retreat.name"] = "Odwrót",
	["path.scout.retreat.desc"] = "Odnowienie Odskoku jest krótsze o {retreatPct}%.",
	["path.scout.warning.name"] = "Ostrzeżenie",
	["path.scout.warning.desc"] = "Gdy potwór do 30 st. od Ciebie zaczyna atak z czerwoną strefą, drużyna do 40 st. (także Ty) otrzymuje o {warning}% mniej obrażeń do końca zamachu i 0,5 s po nim. Najwyżej raz na 8 s; działa razem z Czujnością.",
	["path.scout.trail.name"] = "Tropem Rannego",
	["path.scout.trail.desc"] = "Gdy wróg ze Znakiem Łowcy ginie, znak z resztą czasu przechodzi na najbliższego wroga do {trail} st.",
	["path.scout.royalFalcon.name"] = "Królewski Sokół",
	["path.scout.royalFalcon.desc"] = "Po użyciu Sokoła ptak zostaje z Tobą do końca walki (odlatuje 5 s po niej), a z węzłem Oznaczenie jego uderzenia nakładają Oznaczenie. Znak Łowcy posyła go w nurkowanie na oznaczony cel: 150% obrażeń i ogłuszenie na 1 s (nie działa na bossy ani graczy). To wsparcie z powietrza: sokoła nie można trafić.",
	["path.scout.quickMark.name"] = "Szybki Znak",
	["path.scout.quickMark.desc"] = "Odnowienie Znaku Łowcy jest krótsze o {quickMarkPct}%.",
	["path.scout.duet.name"] = "Zgrany Duet",
	["path.scout.duet.desc"] = "Uderzenia i nurkowanie Sokoła zadają o {duet}% więcej obrażeń.",
	["path.scout.beater.name"] = "Wytrawny Naganiacz",
	["path.scout.beater.desc"] = "Podatność i spowolnienie z Nagonki trwają {beater} s dłużej.",
	["path.scout.royalFalcon2.name"] = "Sokół Władcy",
	["path.scout.royalFalcon2.desc"] = "Odstęp między uderzeniami sokoła jest o {sovereignPace}% krótszy (zwykle 2 s), a Oznaczenie daje +{sovereignMark} pkt proc. podatności więcej.",
	-- S81: Mage paths (ROZWOJ 12), breakpoints B, the rework paragraph
	["rework.class.Mage"] = "Mag: Mistrz Żywiołów, Tarcza Many, Gniew Żywiołów, Inwokacja, Skupienie i Tajemny Umysł należą teraz do ścieżek i kupuje się je za punkty ścieżek. Bez Skupienia do 45. poziomu masz mniejszą pulę many i wolniejszą regenerację. Meteor odblokowuje się na 30., Burza Piorunów na 45. poziomie; nowe umiejętności podstawy połóż na pasku przyciskiem „Na pasek”. Bez broni swojej ścieżki rzędy 3–11 są wyłączone.",
	["skill.firebolt.bp5b"] = "Odnowienie krótsze o 12%",
	["skill.firebolt.bp10b"] = "Dwa pociski, każdy słabszy o 104 pkt proc. (razem o 19% więcej)",
