	["npc.trapper_sigrun.name"] = "Sigrun the Trapper",
	["npc.trapper_sigrun.role"] = "Trapper",
	["npc.trapper_sigrun.greeting"] = "The camp has stood empty for nine days. I cannot wait that long.",
	["npc.trapper_sigrun.line1"] = "Snares must be checked every day, even when there is no one left to eat.",
	["npc.trapper_sigrun.line2"] = "Every path in these mountains was paid for by someone, once.",
	["npc.trapper_sigrun.line3"] = "Leopards can tell when a camp grows weak.",
	["npc.trapper_sigrun.where"] = "in the abandoned trappers' camp in the Ice Wolf Valley",
	["npc.ghost_halgrim.name"] = "The Ghost of Brother Halgrim",
	["npc.ghost_halgrim.role"] = "The Last of the Ice Guard",
	["npc.ghost_halgrim.greeting"] = "The Watch endures. Even when no one remembers what it guards.",
	["npc.ghost_halgrim.line1"] = "The frost came by night, with no horn and no fire.",
	["npc.ghost_halgrim.line2"] = "My brothers stand on the walls. I do not know if they still hear me.",
	["npc.ghost_halgrim.line3"] = "An oath is not sworn with the lips. It is sworn with what you do after.",
	["npc.ghost_halgrim.where"] = "in the courtyard of the Ice Watch, before the keep",
	["npc.captain.greetingSpring"] = "Can you smell it? The earth smells the way it did in my grandfather's day.",
	["npc.brother_anzelm.greetingSpring"] = "The bells have rung since morning. For the first time in years I do not pray for warmth.",
	["npc.healer.greetingSpring"] = "Wounds heal faster when the apple trees bloom outside the window.",
	["cutscene.who.journal"] = "The Trappers' Journal",
	["cutscene.ch4_title.title"] = "The Frost Peaks",
	["cutscene.ch4_title.l1"] = "Beyond the horned cairn the merchants' road ends. Further up the snow does not melt even in summer.",
	["cutscene.ch4_title.l2"] = "A roar comes down from the mountains. The dogs in the valley fall silent before the people hear it.",
	["cutscene.grottoTrappers.l1"] = "Three figures stand behind the ice. One still holds a lantern.",
	["cutscene.grottoTrappers.l2"] = "Day six. The ice sings at night. Arne says it is only the wind.",
	["cutscene.grottoTrappers.l3"] = "The order's path goes on, towards the glacier. Tomorrow we take it.",
	["cutscene.frostBloom.l1"] = "A flower of ice hangs over the courtyard. It pulses, as if breathing.",
	["cutscene.frostBloom.l2"] = "The knights of the Watch still keep their post. Only no longer for people.",
	["cutscene.crystalPulse.l1"] = "The crystals flash all at once. Once, and once again.",
	["cutscene.crystalPulse.l2"] = "A heart beats under the glacier. Faster and faster.",
	["cutscene.halgrimRises.l1"] = "For twenty winters no one has come through this gate alive.",
	["cutscene.halgrimRises.l2"] = "You carry the sign of the Watch. Come. I must know where you got it.",
	["cutscene.thornWhole.title"] = "The Thorn of Vael",
	["cutscene.thornWhole.l1"] = 'Say after me: "I stand between the winter and those who sleep."',
	["cutscene.thornWhole.l2"] = "The Watch releases you, brothers. Go to sleep.",
	["cutscene.thornWhole.l3"] = "The Thorn is whole. Shaft, spearhead and oath.",
	["cutscene.ilvarStairs.l1"] = "You put out the candles. The song has already been sung.",
	["cutscene.ilvarStairs.l2"] = "You call it the queen's victory. I have read what it cost.",
	["cutscene.ilvarStairs.l3"] = "Winter does not hate. Winter covers. Under the snow no one weeps any more.",
	["cutscene.ilvarStairs.l4"] = "Go to him, if you must. I will go further.",
	["cutscene.eveOfBattle.l1"] = "They are ploughing on the Meadows again. For the first time in a year.",
	["cutscene.eveOfBattle.l2"] = "The lanterns in the Wood are lit. All of them.",
	["cutscene.eveOfBattle.l3"] = "The Forge has gone cold. Only what lies ahead is left.",
	["cutscene.eveOfBattle.l4"] = "At dawn. Together.",
	["cutscene.vaelgrathFalls.l1"] = "The Thorn of Vael sits in the wound. The lair falls silent.",
	["cutscene.vaelgrathFalls.l2"] = "Three hundred years of sleep end in a single moment.",
	["cutscene.finaleTitle.title"] = "Vaelthorn",
	["cutscene.finaleTitle.l1"] = "The music on the square was still playing when the first flakes fell.",
	["cutscene.finaleTitle.l2"] = "Snow in midsummer. No one in the city remembers a night like it.",
	["cutscene.snowInSummer.l1"] = "Look up. Snow, in midsummer.",
	["cutscene.snowInSummer.l2"] = "There was no heart in the dragon's body. Someone carried it away before it fell.",
	["cutscene.snowInSummer.l3"] = "Go to Halvar. If the winter still lives, he will know where.",
	["cutscene.voiceOfWinter.l1"] = "Did you come to see winter given a name?",
	["cutscene.voiceOfWinter.l2"] = "The dragon was only a vessel. The Heart remains. I will take it into myself.",
	["cutscene.voiceOfWinter.l3"] = "Do not be afraid. It is quiet under the snow.",
	["cutscene.voiceOfWinter.l4"] = "The rite breaks. The frost he called comes back for him.",
	["cutscene.thornSinks.l1"] = "The Thorn sinks into the Heart of Winter. The ice underfoot cracks and breathes.",
	["cutscene.thornSinks.l2"] = "For the first time in three hundred years the wind on the Spire is warm.",
	["cutscene.firstSpring.title"] = "The End",
	["cutscene.firstSpring.subtitle"] = "The First Spring",
	["cutscene.firstSpring.l1"] = "We waited three hundred years for this spring. We did not even know we were waiting.",
	["cutscene.firstSpring.l2"] = "Ilvar wanted the world to fall asleep. You woke it.",
	["cutscene.firstSpring.l3"] = "Vaelthorn remembers its own. It will remember you first.",
