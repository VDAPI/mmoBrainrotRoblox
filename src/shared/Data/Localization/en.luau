	-- S106: the eight new people of the Duskwood
	["npc.huntress_wanda.name"] = "Wanda the Huntress",
	["npc.huntress_wanda.role"] = "Lantern Warden",
	["npc.huntress_wanda.greeting"] = "Keep to the light. Past the lanterns a road stops being a road.",
	["npc.huntress_wanda.line1"] = "The lanterns by the road burn with a cold fire. Beasts do not like it. Worse things do not either.",
	["npc.huntress_wanda.line2"] = "Moon-moss oil burns long and gives no smoke. The captaincy is always late with it.",
	["npc.huntress_wanda.line3"] = "Every night I walk the road. I count lanterns, not steps.",
	["npc.huntress_wanda.where"] = "by the Dusk Gate in the Duskwood",
	["npc.beekeeper_maciej.name"] = "Maciej the Beekeeper",
	["npc.beekeeper_maciej.role"] = "Beekeeper",
	["npc.beekeeper_maciej.greeting"] = "Quietly, please. Bees hear more than people think.",
	["npc.beekeeper_maciej.line1"] = "Thirty years I have kept hives in this hollow. The bees remember me better than people do.",
	["npc.beekeeper_maciej.line2"] = "A frightened swarm hums low. This hollow has hummed low since spring.",
	["npc.beekeeper_maciej.line3"] = "Duskwood honey is dark and bitter. In the city they pay for it like wine.",
	["npc.beekeeper_maciej.where"] = "by the giant fallen trunk over Bear Hollow",
	["npc.gravedigger_bogumil.name"] = "Bogumił the Gravedigger",
	["npc.gravedigger_bogumil.role"] = "Gravedigger",
	["npc.gravedigger_bogumil.greeting"] = "Alive? Good. I have enough work with the other sort.",
	["npc.gravedigger_bogumil.line1"] = "I keep the graves of the manor's old servants. The ghouls dig them up, I fill them in. So the year goes.",
	["npc.gravedigger_bogumil.line2"] = "The dead are not hard. The hard ones are those who will not stay in the ground.",
	["npc.gravedigger_bogumil.line3"] = "A spade, a lantern, a crust of bread. A gravedigger needs no more.",
	["npc.gravedigger_bogumil.where"] = "before the cemetery gate in the Haunted Ruins",
	["npc.herbalist_dobrawa.name"] = "Dobrawa the Herbalist",
	["npc.herbalist_dobrawa.role"] = "Herbalist",
	["npc.herbalist_dobrawa.greeting"] = "Mind where you step. Under that moss grows something worth more than your boots.",
	["npc.herbalist_dobrawa.line1"] = "The mushrooms in the Forest Heart have rime on their caps. In the middle of summer.",
	["npc.herbalist_dobrawa.line2"] = "City alchemists know herbs from books. I know them from the earth.",
	["npc.herbalist_dobrawa.line3"] = "The trees here rot from within. The bark is sound, and under it, cold.",
	["npc.herbalist_dobrawa.where"] = "in the hollow of the Elder Tree in the Forest Heart",
	["npc.warden_zbyszko.name"] = "Zbyszko the Road Warden",
	["npc.warden_zbyszko.role"] = "Road Warden",
	["npc.warden_zbyszko.greeting"] = "Halt. Where to, and why? I ask everyone. Those are my orders.",
	["npc.warden_zbyszko.line1"] = "The captaincy sent me to the Crossroads because travellers went missing here. They kept going missing until I started counting.",
	["npc.warden_zbyszko.line2"] = "I do not like this gallows. But it stands by the road, and I keep the road.",
	["npc.warden_zbyszko.line3"] = "In the mist every sign looks like a road sign. That is why I check every one.",
	["npc.warden_zbyszko.where"] = "by the gallows at the Misty Crossroads",
	["npc.ferryman_oldrzych.name"] = "Ołdrzych the Ferryman",
	["npc.ferryman_oldrzych.role"] = "Ferryman",
	["npc.ferryman_oldrzych.greeting"] = "The crossing costs. The advice is free: do not look into the water.",
	["npc.ferryman_oldrzych.line1"] = "Thirty years I have ferried people across the Troll Swamp. The swamp knows me by now.",
	["npc.ferryman_oldrzych.line2"] = "Whoever boards my boat spits over the left shoulder. Whoever does not, rows alone.",
	["npc.ferryman_oldrzych.line3"] = "Trolls are stupid, but they can count. Other people's coins, especially.",
	["npc.ferryman_oldrzych.where"] = "by the jetty in the Troll Swamp",
	["npc.exorcist_kalina.name"] = "Sister Kalina",
	["npc.exorcist_kalina.role"] = "Temple Exorcist",
	["npc.exorcist_kalina.greeting"] = "May the light keep you. Here, every bit of it helps.",
	["npc.exorcist_kalina.line1"] = "Brother Anzelm sent me to lift the hexes of the marsh. There is more work than he thought.",
	["npc.exorcist_kalina.line2"] = "The witches of the coven hang hexes by the paths. I take them down, they hang new ones.",
	["npc.exorcist_kalina.line3"] = "I pray briefly. The marsh does not wait for me to finish.",
	["npc.exorcist_kalina.where"] = "by the hanging tree in the Witch Marsh",
	["npc.mason_wojslaw.name"] = "Wojsław the Stonemason",
	["npc.mason_wojslaw.role"] = "Stonemason",
	["npc.mason_wojslaw.greeting"] = "Careful by the wall. Stone is patient, but not for ever.",
	["npc.mason_wojslaw.line1"] = "Years ago I cut this road into the Blood Cliffs. I came back to mend its shoring.",
	["npc.mason_wojslaw.line2"] = "Red stone is soft under the chisel and hard under the rain. You have to know it.",
	["npc.mason_wojslaw.line3"] = "A good mason hears a crack before he sees it.",
	["npc.mason_wojslaw.where"] = "on the Blood Cliffs plateau, by the road to the Crypt",
	-- S106: K. The Dusk Lanterns
	["quest.side_moonOil.title"] = "Moon-moss Oil",
	["quest.side_moonOil.p1"] = "The captaincy promised the lantern wardens a cask of moon-moss oil. It promised a month ago, and the cask still stands in my corner.",
	["quest.side_moonOil.p2"] = "The lanterns by the road in the Duskwood are going out. And in the Duskwood that means the road stops being a road. Take the oil to Wanda the Huntress by the Dusk Gate.",
	["quest.side_moonOil.progress"] = "A cask of oil for Wanda the Huntress by the Dusk Gate in the Duskwood.",
	["quest.side_moonOil.done"] = "From Dobiesław? The oil will be of use. Worse is that someone keeps knocking our lanterns down.",
	["quest.side_moonOil.say.why"] = "What does the Duskwood need oil for?",
	["quest.side_moonOil.say.why.reply"] = "A lantern is a border. Past it, the forest begins.",
	["quest.side_moonOil.say.quick"] = "I will bring it before dusk.",
	["quest.side_moonOil.say.quick.reply"] = "Before dusk, in the Duskwood? Ambitious. It is always dusk there.",
	["quest.side_moonOil.bark.accept1"] = "The cask is sealed tight. Just do not open it near a fire.",
	["quest.side_moonOil.bark.done1"] = "Set it here, not on the road. On the road someone will knock it over.",
	["quest.side_darkLanterns.title"] = "The Dark Lanterns",
	["quest.side_darkLanterns.p1"] = "Three lanterns by the road lie in the mud. The posts snapped like matches, claw marks on the iron.",
	["quest.side_darkLanterns.p2"] = "Set them up and light them, we have oil enough now. Werewolves prowl by the road. Drive them off before they come back for the rest.",
	["quest.side_darkLanterns.p3"] = "The first lies not far from the gate, the other two deeper into the Werewolf Thicket. Keep to the road and you will find them.",
	["quest.side_darkLanterns.progress"] = "Three lanterns raised by the road and eight werewolves in the Werewolf Thicket.",
	["quest.side_darkLanterns.done"] = "The claws on this cage are too narrow for a common werewolf. And the tracks lead towards the Bone Tree. I need to think about this.",
	["quest.side_darkLanterns.say.lanterns"] = "The lanterns first.",
	["quest.side_darkLanterns.say.lanterns.reply"] = "Good. Light first, then the rest.",
	["quest.side_darkLanterns.say.wolves"] = "The wolves first.",
	["quest.side_darkLanterns.say.wolves.reply"] = "Also good. Fewer teeth around the work.",
	["quest.side_darkLanterns.say.alone"] = "You guard them alone?",
	["quest.side_darkLanterns.say.alone.reply"] = "Alone. Lanterns do not ask for company.",
	["quest.side_darkLanterns.bark.accept1"] = "Take a flint. A lantern without fire is just iron on a stick.",
	["quest.side_darkLanterns.bark.half1"] = "One is burning already. I can see it from here.",
	["quest.side_darkLanterns.bark.near1"] = "The post broke from below. Something hugged it and pulled.",
	["quest.side_darkLanterns.bark.done1"] = "The road has light again. Come back, show me what lay out there.",
	["quest.side_boneTree.title"] = "Under the Bone Tree",
	["quest.side_boneTree.p1"] = "Under the Bone Tree the pack lays down its trophies. Antlers, skulls, and the things of people who left the road.",
	["quest.side_boneTree.p2"] = "I will walk with you, I know the way. You search the trophies and leave the hunters' mark. Bears come there for carrion, mind them.",
	["quest.side_boneTree.p3"] = "My brother Stach was a lamplighter. At the last full moon he went to walk the road and never came back. If there is something there, I want to know.",
	["quest.side_boneTree.progress"] = "To the Bone Tree with Wanda, the hunters' mark at the trophies and six black bears in the Werewolf Thicket.",
	["quest.side_boneTree.done"] = "A lantern hook with an 'S' carved in it. And that oil on the trophies. Stach was there, not long ago. The tracks lead to Wolfden Hollow.",
	["quest.side_boneTree.say.brother"] = "Tell me about Stach.",
	["quest.side_boneTree.say.brother.reply"] = "He laughed too loud. That is all.",
	["quest.side_boneTree.say.silent"] = "You need not talk.",
	["quest.side_boneTree.say.silent.reply"] = "Good. Let us go.",
	["quest.side_boneTree.bark.accept1"] = "We go. Keep close and do not touch the bones.",
	["quest.side_boneTree.bark.half1"] = "The mark stands. Now the bears, before they scent us both.",
	["quest.side_boneTree.bark.near1"] = "Stach said it smells of iron here. He was right.",
	["quest.side_boneTree.bark.done1"] = "Show me what you found. Back to the gate.",
	["quest.side_boneTree.bark.death1"] = "Get up. My brother would laugh at you. I will not.",
	["quest.side_boneTree.comp.join1"] = "Come. Keep to the lanterns while they stand.",
	["quest.side_boneTree.comp.wait1"] = "Do not fall behind. Here, those who stay behind stay for good.",
	["quest.side_boneTree.comp.wait2"] = "Watch your feet, not the trees. The trees watch on their own.",
	["quest.side_boneTree.comp.arrive1"] = "Smell that? Moon-moss oil. On the trophies. Only lamplighters carry it.",
	["quest.side_boneTree.comp.back1"] = "Back to the gate. The Duskwood does not like haste.",
	["quest.side_lampLighter.title"] = "The Lamplighter",
	["quest.side_lampLighter.p1"] = "I know what he has become. I knew it the moment I saw those claws. I did not want to say it aloud.",
	["quest.side_lampLighter.p1.brother"] = "You asked about him. Now you know more than I wanted to tell you. I know what he has become. I knew it the moment I saw those claws.",
	["quest.side_lampLighter.p1.silent"] = "You did not ask then. Thank you. Now I must say it anyway: I know what he has become. I knew it the moment I saw those claws.",
	["quest.side_lampLighter.p2"] = "In Wolfden Hollow lives a werewolf with a lantern at its belt. The hunters have seen it twice. I saw it once and did not shoot.",
	["quest.side_lampLighter.p3"] = "Do what I cannot. End it quickly. He would want that, if he could still want anything.",
	["quest.side_lampLighter.p4"] = "Bring me his lantern. Not him.",
	["quest.side_lampLighter.progress"] = "The werewolf with a lantern at its belt (Elite) in Wolfden Hollow, and its lantern for Wanda.",
	["quest.side_lampLighter.done"] = "I will light it by the gate. It will burn the longest of them all. Take this caparison of the lantern wardens. Stach would want someone to wear it.",
	["quest.side_lampLighter.say.promise"] = "I will bring the lantern.",
	["quest.side_lampLighter.say.promise.reply"] = "Only the lantern.",
	["quest.side_lampLighter.say.come"] = "Come with me.",
	["quest.side_lampLighter.say.come.reply"] = "No. If I saw him, I would not shoot. Take the salves.",
	["quest.side_lampLighter.bark.accept1"] = "The Hollow lies at the north edge of the Thicket. Go, before I change my mind.",
	["quest.side_lampLighter.bark.half1"] = "You are close to him. Do not listen when he howls.",
	["quest.side_lampLighter.bark.done1"] = "Come back slowly. Carry the lantern before you.",
	["quest.side_lampLighter.bark.stuck1"] = "Wolfden Hollow lies north in the Thicket, at the end of the side road, by the rocks.",
	-- S106: L. The Ravine Hives
	["quest.side_clayJars.title"] = "Jars for the Beekeeper",
	["quest.side_clayJars.p1"] = "Since autumn I have had no honey from the Duskwood. No honey, no mead, and without mead my guests drink water and look at me reproachfully.",
	["quest.side_clayJars.p2"] = "Maciej the Beekeeper has sent nothing for months. Take him new jars and ask what is wrong. He lives above Bear Hollow, by the giant fallen trunk.",
	["quest.side_clayJars.progress"] = "Clay jars for Maciej the Beekeeper above Bear Hollow.",
	["quest.side_clayJars.done"] = "Jars I have. Honey I have not. Sit down, I will tell you why.",
	["quest.side_clayJars.say.mead"] = "Will the inn fall without honey?",
	["quest.side_clayJars.say.mead.reply"] = "The inn will not. I will.",
	["quest.side_clayJars.say.maciej"] = "What about Maciej?",
	["quest.side_clayJars.say.maciej.reply"] = "I do not know. And that worries me. Maciej was never late.",
	["quest.side_clayJars.bark.accept1"] = "The jars are not empty. They are ready.",
	["quest.side_clayJars.bark.done1"] = "Jars from Wacław? I know the clay. Good that someone remembers.",
	["quest.side_smokedHives.title"] = "Smoked Hives",
	["quest.side_smokedHives.p1"] = "The bears break my hives and scatter the swarms. A frightened bee flies off and does not come back.",
	["quest.side_smokedHives.p2"] = "They must be smoked and calmed before they leave for good. And the bears at the hives must be thinned, or they will be back tomorrow.",
	["quest.side_smokedHives.p3"] = "The first hive is the fallen one at the edge of the Werewolf Thicket. The other two are in trunks on the floor of the hollow.",
	["quest.side_smokedHives.progress"] = "Three hives to smoke and eight black bears in Bear Hollow.",
	["quest.side_smokedHives.done"] = "The swarms stayed. But the bears had time to eat the combs, every last one. The bees will forgive it. I have not yet.",
	["quest.side_smokedHives.say.hive"] = "I will start with the hives.",
	["quest.side_smokedHives.say.hive.reply"] = "Good. Smoke first, teeth later.",
	["quest.side_smokedHives.say.bears"] = "The bears first.",
	["quest.side_smokedHives.say.bears.reply"] = "Also good. Bees like quiet.",
	["quest.side_smokedHives.say.sting"] = "Will the bees not sting me?",
	["quest.side_smokedHives.say.sting.reply"] = "They will. But respectfully.",
	["quest.side_smokedHives.bark.accept1"] = "Hold the smoker low. The smoke goes inside, not at you.",
	["quest.side_smokedHives.bark.half1"] = "The swarm is calming. It hums higher now.",
	["quest.side_smokedHives.bark.near1"] = "Hear that? They hum low. That means they are afraid.",
	["quest.side_smokedHives.bark.done1"] = "The swarms will stay. Come back, we will talk about the combs.",
	["quest.side_stolenHoney.title"] = "Stolen Honey",
	["quest.side_stolenHoney.p1"] = "The bears carry the combs off to their dens, and what they do not eat at once they carry in their fur. It sticks to them like resin.",
	["quest.side_stolenHoney.p2"] = "Whatever can be saved, take to Wacław at the inn. A bargain is a bargain, even if the bees never signed it.",
	["quest.side_stolenHoney.p3"] = "The bears have grown bolder since Old Shaggy came back. But let someone else tell you about that.",
	["quest.side_stolenHoney.progress"] = "Six wild honeycombs from the black bears in Bear Hollow, for Wacław the Innkeeper.",
	["quest.side_stolenHoney.done"] = "Duskwood honey, at last. Old Shaggy is back, you say? Twenty years ago that bear killed Maciej's father. Maciej will ask you for nothing. I am asking.",
	["quest.side_stolenHoney.say.fur"] = "From their fur? Truly?",
	["quest.side_stolenHoney.say.fur.reply"] = "A bear has no pockets.",
	["quest.side_stolenHoney.say.shaggy"] = "Who is Old Shaggy?",
	["quest.side_stolenHoney.say.shaggy.reply"] = "Ask Wacław. I cannot talk about him.",
	["quest.side_stolenHoney.bark.accept1"] = "Combs from fur will be dirty. Wacław will take them anyway.",
	["quest.side_stolenHoney.bark.half1"] = "Half the combs. Wacław is already counting jars.",
	["quest.side_stolenHoney.bark.done1"] = "It smells of the Duskwood from here to the inn. Bring it over.",
	["quest.side_stolenHoney.bark.stuck1"] = "The bears of the hollow carry combs in their fur. Look for them on the gorge floor.",
	["quest.side_oldShaggy.title"] = "Old Shaggy",
	["quest.side_oldShaggy.p1"] = "Twenty years ago old Maciej, our beekeeper's father, followed a bear into Wolfden Hollow. He never came back.",
	["quest.side_oldShaggy.p1.shaggy"] = "Maciej told you to ask me. Good that you did. Twenty years ago his father followed a bear into Wolfden Hollow and never came back.",
	["quest.side_oldShaggy.p2"] = "Beekeepers hang a bell at their belt so the bears hear them from afar and get out of the way. That one bear did not.",
	["quest.side_oldShaggy.p3"] = "The beekeepers call him Old Shaggy. He is old, huge, and to this day has old Maciej's bell tangled in his fur. This spring he came back to the Hollow.",
	["quest.side_oldShaggy.p4"] = "Bring that bell to Maciej. Not for revenge. So it can be heard by the hives again.",
	["quest.side_oldShaggy.progress"] = "Old Shaggy and another black bear (Elites) in Wolfden Hollow, and the old beekeeper's bell for Maciej.",
	["quest.side_oldShaggy.done"] = "My father's bell. The very one. I will hang it by the hives. Let us be heard from afar again, as before. Thank you.",
	["quest.side_oldShaggy.say.bell"] = "I will bring the bell.",
	["quest.side_oldShaggy.say.bell.reply"] = "Take two flasks. Old Shaggy does not bite by halves.",
	["quest.side_oldShaggy.say.revenge"] = "I will kill him for Maciej's father.",
	["quest.side_oldShaggy.say.revenge.reply"] = "Not for his father. For the hives. That is how Maciej would want it.",
	["quest.side_oldShaggy.bark.accept1"] = "The Hollow is in the Werewolf Thicket. You will know Old Shaggy by his size.",
	["quest.side_oldShaggy.bark.half1"] = "One is down. Old Shaggy is somewhere deeper.",
	["quest.side_oldShaggy.bark.done1"] = "Wacław said you went to the Hollow. Come back. I am waiting by the hives.",
	["quest.side_oldShaggy.bark.death1"] = "Get up. Old Shaggy has taken one beekeeper already. He will not have you.",
	-- S106: M. The Nameless
	["quest.side_nameless.title"] = "The Nameless",
	["quest.side_nameless.p1"] = "Ghouls dig up the graves of the manor's servants. They drag the bones all over the cemetery, and I gather what I can afterwards.",
	["quest.side_nameless.p2"] = "Tend the four graves still standing and drive off the ghouls. I no longer have the strength to chase them with a spade.",
	["quest.side_nameless.p3"] = "And look at this headstone. Someone carefully chiselled the name off it. A vandal would smash it. This one worked with a chisel.",
	["quest.side_nameless.progress"] = "Four servants' graves to tend and eight ghouls in the Haunted Ruins.",
	["quest.side_nameless.done"] = "The same on all four. The names chiselled off evenly, letter by letter. Someone wanted these people to vanish a second time.",
	["quest.side_nameless.say.graves"] = "The graves first.",
	["quest.side_nameless.say.graves.reply"] = "Good. The dead will wait, if unwillingly.",
	["quest.side_nameless.say.ghouls"] = "The ghouls first.",
	["quest.side_nameless.say.ghouls.reply"] = "Rightly. Those who bite come first.",
	["quest.side_nameless.say.pay"] = "Who pays you for this?",
	["quest.side_nameless.say.pay.reply"] = "No one. That is why I do it properly.",
	["quest.side_nameless.bark.accept1"] = "I do not lend my spade. The graves are dug already.",
	["quest.side_nameless.bark.half1"] = "Half done. The cemetery has gone quieter.",
	["quest.side_nameless.bark.done1"] = "Come back to me. I must show you something on these stones.",
	["quest.side_servantTokens.title"] = "The Servants' Tokens",
	["quest.side_servantTokens.p1"] = "The wraiths drifting through the Ruins are the manor's old servants. I know them by their aprons and the way they stand.",
	["quest.side_servantTokens.p2"] = "Each wears a brass service token with a number. The master counted his people like spoons in a cupboard.",
	["quest.side_servantTokens.p3"] = "From the tokens I can tell who lies in which grave. Bring me six.",
	["quest.side_servantTokens.progress"] = "Six brass tokens from the forest wraiths in the Haunted Ruins.",
	["quest.side_servantTokens.done"] = "The numbers match the graves. All I lack is a roll of who had which number. The temple in the city once kept such a roll.",
	["quest.side_servantTokens.say.numbers"] = "Why did they have numbers?",
	["quest.side_servantTokens.say.numbers.reply"] = "The master counted people like spoons. Now that helps.",
	["quest.side_servantTokens.say.fear"] = "Will the wraiths give them up?",
	["quest.side_servantTokens.say.fear.reply"] = "No. But afterwards they are calmer.",
	["quest.side_servantTokens.bark.accept1"] = "The wraiths are in the Ruins, by the manor. Fear them no more than you must.",
	["quest.side_servantTokens.bark.half1"] = "Three tokens. I am starting to count graves.",
	["quest.side_servantTokens.bark.near1"] = "The one in the apron was a cook. I know her by the way she stands.",
	["quest.side_servantTokens.bark.done1"] = "That is all of them. Bring them before they tarnish.",
	["quest.side_householdRoll.title"] = "The Household Roll",
	["quest.side_householdRoll.p1"] = "I copied the numbers from the tokens onto a sheet. Three nights by a candle, and my eyes are not what they were.",
	["quest.side_householdRoll.p2"] = "Take it to Brother Anzelm at the temple. The temple once kept the books of the Duskwood manors. Perhaps he will find who had which number.",
	["quest.side_householdRoll.progress"] = "The list of tokens for Brother Anzelm at the temple.",
	["quest.side_householdRoll.done"] = "I have the roll of that manor's servants. Without the master's name: the page with the coat of arms is cut out. Someone got here before me. I will copy the names onto a tablet.",
	["quest.side_householdRoll.say.careful"] = "I will carry it carefully.",
	["quest.side_householdRoll.say.careful.reply"] = "Good. I wrote it for three nights.",
	["quest.side_householdRoll.say.why"] = "Why not go yourself?",
	["quest.side_householdRoll.say.why.reply"] = "When I leave, the ghouls come in. They keep my hours better than I do.",
	["quest.side_householdRoll.bark.accept1"] = "The sheet is dry. Let it stay that way.",
	["quest.side_householdRoll.bark.done1"] = "Bogumił? I have not had a word from him in years. Show me.",
	["quest.side_restingPlace.title"] = "A Place of Rest",
	["quest.side_restingPlace.p1"] = "I copied the servants' names onto a tablet. Forty-two names. Each of them someone once called in to supper.",
	["quest.side_restingPlace.p2"] = "Hang the tablet on the servants' common grave, behind the cemetery's back fence, and light candles beside it.",
	["quest.side_restingPlace.p3"] = "The wraiths that will not go must be dispersed. Not in anger. They no longer know that they may go.",
	["quest.side_restingPlace.p4"] = "And I ask you: tell no one of the cut page until I learn myself who cut it.",
	["quest.side_restingPlace.progress"] = "The tablet of names on the common grave behind the cemetery and ten forest wraiths in the Haunted Ruins. Then to Bogumił the Gravedigger.",
	["quest.side_restingPlace.done"] = "I read the names aloud, one after another. Do you know that for the first time in years this cemetery is quiet? Thank you.",
	["quest.side_restingPlace.done.pay"] = "I said no one pays me. Today I am rich. I read the names aloud, one after another, and the cemetery is quiet.",
	["quest.side_restingPlace.say.keep"] = "I will tell no one.",
	["quest.side_restingPlace.say.keep.reply"] = "Thank you. Take this for the road.",
	["quest.side_restingPlace.say.ask"] = "Who cut that page out?",
	["quest.side_restingPlace.say.ask.reply"] = "If I knew, I would not ask for silence.",
	["quest.side_restingPlace.bark.accept1"] = "The tablet is heavy. Names weigh more than one would think.",
	["quest.side_restingPlace.bark.half1"] = "Half behind you. Let the candles burn to the end.",
	["quest.side_restingPlace.bark.done1"] = "It is quiet. Do you hear? Come back, I want to tell you something.",
	-- S106: N. The Cold Rot
	["quest.side_rotSap.title"] = "Cold Sap",
	["quest.side_rotSap.p1"] = "The rotting ents ooze sap. Touch it and you feel cold like ice. In the middle of summer.",
	["quest.side_rotSap.p2"] = "I need that sap, and moon petals, which grow by the water in the marshes along the Black Stream. Then I will understand what this sickness is.",
	["quest.side_rotSap.p3"] = "I will come with you. You pick too fast and too deep, I can see it in your hands.",
	["quest.side_rotSap.progress"] = "Five portions of cold sap from the rot ents in the Forest Heart and four moon petals from the marshes.",
	["quest.side_rotSap.done"] = "The sap does not melt by a fire. I held it over the flame all night. This is not rot. This is winter pretending to be rot.",
	["quest.side_rotSap.say.sap"] = "The sap first.",
	["quest.side_rotSap.say.sap.reply"] = "Good. The ents will not run, but the sap thickens.",
	["quest.side_rotSap.say.petals"] = "The petals first.",
	["quest.side_rotSap.say.petals.reply"] = "Good. The petals close at dusk, and in the Duskwood dusk is long.",
	["quest.side_rotSap.say.alch"] = "Ask the alchemist in the city?",
	["quest.side_rotSap.say.alch.reply"] = "I will. Once I know what to ask.",
	["quest.side_rotSap.bark.accept1"] = "Do you have a jar for the sap? No? Take mine.",
	["quest.side_rotSap.bark.half1"] = "Half. Are your hands cold? That is the sap.",
	["quest.side_rotSap.bark.near1"] = "Not with the root. The root is mine for next year.",
	["quest.side_rotSap.bark.done1"] = "Enough. Back to my camp before the sap sets.",
	["quest.side_rotSap.bark.death1"] = "The dead gather no herbs. Get up.",
	["quest.side_rotSap.comp.join1"] = "I am coming with you. Someone has to watch what you pick.",
	["quest.side_rotSap.comp.join2"] = "The ent will not run away. Nor will I, so do not hurry.",
	["quest.side_rotSap.comp.back1"] = "Fire, a bandage, onwards. In that order.",
	["quest.side_ghoulBurrows.title"] = "Ghoul Burrows",
	["quest.side_ghoulBurrows.p1"] = "Ghouls dig burrows under the roots and carry the rot further. Where they pass, the trees start to rot from within.",
	["quest.side_ghoulBurrows.p2"] = "Fill in the three burrows I found and thin out the ghouls. Otherwise in a month the whole hollow will be cold.",
	["quest.side_ghoulBurrows.p3"] = "You will know the burrows by the smell. Or rather, by the ground beside them being cold.",
	["quest.side_ghoulBurrows.progress"] = "Three ghoul burrows to fill in and ten ghouls in the Forest Heart.",
	["quest.side_ghoulBurrows.done"] = "I wrote to Ysolde in the city and sent her a sample of the sap. If anyone can make a tincture to stop this sickness, it is her. Do not tell her I said so.",
	["quest.side_ghoulBurrows.say.burrows"] = "The burrows first.",
	["quest.side_ghoulBurrows.say.burrows.reply"] = "Good. A filled burrow means fewer ghouls tomorrow.",
	["quest.side_ghoulBurrows.say.ghouls"] = "The ghouls first.",
	["quest.side_ghoulBurrows.say.ghouls.reply"] = "Good. An empty burrow fills more easily.",
	["quest.side_ghoulBurrows.say.smell"] = "What is that stench?",
	["quest.side_ghoulBurrows.say.smell.reply"] = "Ghouls. This rot does not smell at all. That is worse.",
	["quest.side_ghoulBurrows.bark.accept1"] = "Take a bigger spade. The burrows are deeper than they look.",
	["quest.side_ghoulBurrows.bark.half1"] = "Half. The forest breathes a little easier.",
	["quest.side_ghoulBurrows.bark.near1"] = "The ground by the burrow is cold. In the middle of summer.",
	["quest.side_ghoulBurrows.bark.done1"] = "Come back. I have an idea, but I need the city's alchemist for it.",
	["quest.side_rotCure.title"] = "A Tincture for the Rot",
	["quest.side_rotCure.p1"] = "Ysolde wrote back. She writes better than she brews, but her recipe is good. I brewed the first tincture by it.",
	["quest.side_rotCure.p2"] = "I want her to test it herself. Take her the bottle. Carefully, the glass is thin and the tincture thick.",
	["quest.side_rotCure.p3"] = "Before you go: the ents that were choking the healthy trees round my camp are back. Thin them out, so there is something left to heal.",
	["quest.side_rotCure.progress"] = "Dobrawa's tincture for Alchemist Ysolde in the city and eight rot ents in the Forest Heart.",
	["quest.side_rotCure.done"] = "The tincture stops the sickness. It does not cure it. Whatever holds that forest in the cold sits deeper, in the very heart of the forest. Dobrawa did what she could. So did I.",
	["quest.side_rotCure.done.alch"] = "Dobrawa writes that you asked about me. Nice that someone asks. The tincture stops the sickness, but does not cure it. The cause sits deeper, in the very heart of the forest.",
	["quest.side_rotCure.say.test"] = "Ysolde will test it.",
	["quest.side_rotCure.say.test.reply"] = "She will test it and say she would have done better. Let her talk.",
	["quest.side_rotCure.say.drink"] = "Have you drunk it?",
	["quest.side_rotCure.say.drink.reply"] = "Once. It tastes like winter compost.",
	["quest.side_rotCure.bark.accept1"] = "Keep the bottle warm. The tincture does not like the Duskwood.",
	["quest.side_rotCure.bark.half1"] = "The ents are thinning. The trees creak more calmly.",
	["quest.side_rotCure.bark.done1"] = "A tincture from Dobrawa? Bring it to me before it thickens.",
	-- S106: O. False Waymarks
	["quest.side_falseMarks.title"] = "False Marks",
	["quest.side_falseMarks.p1"] = "By the road to the Cultist Village stand stones with violet marks, just like the marks of the road.",
	["quest.side_falseMarks.p2"] = "Whoever follows them in the mist leaves the road and does not come back. Scrub out three marks with the wardens' chalk.",
	["quest.side_falseMarks.p3"] = "Serpents from the floods hunt those who have strayed. While you are there, thin them out.",
	["quest.side_falseMarks.progress"] = "Three false marks to scrub out by the road to the village and eight bog serpents at the Misty Crossroads.",
	["quest.side_falseMarks.done"] = "Look at my glove. Fresh paint. They painted this week. And they had a brush, not a finger.",
	["quest.side_falseMarks.say.chalk"] = "Why chalk?",
	["quest.side_falseMarks.say.chalk.reply"] = "The wardens' paint is at the captaincy. The captaincy is far away.",
	["quest.side_falseMarks.say.follow"] = "Did anyone follow them and come back?",
	["quest.side_falseMarks.say.follow.reply"] = "No one. That is why I stand here.",
	["quest.side_falseMarks.bark.accept1"] = "The chalk is in the bag. One mark, one cross.",
	["quest.side_falseMarks.bark.half1"] = "Half. The mist does not like having its work spoiled.",
	["quest.side_falseMarks.bark.done1"] = "Come back. I want to see what they painted with.",
	["quest.side_falseMarks.bark.stuck1"] = "The marks stand right by the road to the village, on its east side.",
	["quest.side_lostLetters.title"] = "Letters of the Missing",
	["quest.side_lostLetters.p1"] = "The cultists at the Crossroads carry travellers' letters and papers. They search them for money or names, I suppose.",
	["quest.side_lostLetters.p2"] = "From those letters I can work out who went missing and where they came from. Bring me five.",
	["quest.side_lostLetters.p3"] = "Someone still watches a window for some of these people. I want to write them more than 'missing'.",
	["quest.side_lostLetters.progress"] = "Five travellers' letters from the dark cultists at the Misty Crossroads.",
	["quest.side_lostLetters.done"] = "The letters repeat the same thing: the missing were paid for a guide by a man in a grey cloak who spoke like a priest. Some are alive. They sit in cages in the village.",
	["quest.side_lostLetters.say.names"] = "Will you write down their names?",
	["quest.side_lostLetters.say.names.reply"] = "All of them. Someone is waiting for them.",
	["quest.side_lostLetters.say.read"] = "Reading other people's letters?",
	["quest.side_lostLetters.say.read.reply"] = "The regulations forbid it. The regulations were not written at the Crossroads.",
	["quest.side_lostLetters.bark.accept1"] = "The letters are in the cultists' bags. The bags are on the cultists.",
	["quest.side_lostLetters.bark.half1"] = "Half. Different hands, the same story.",
	["quest.side_lostLetters.bark.done1"] = "Bring them. I have ink and a blank sheet ready.",
	["quest.side_cultCages.title"] = "The Cages in the Village",
	["quest.side_cultCages.p1"] = "In the yard of the Cultist Village stand two cages. In them, people from the road, the ones from the letters.",
	["quest.side_cultCages.p2"] = "Open them and give them time to run. The cultists in the village should have better things to do than give chase, so thin them out.",
	["quest.side_cultCages.p3"] = "I cannot go. Someone has to keep the road, or tomorrow the next ones will be in those cages.",
	["quest.side_cultCages.p4"] = "Take the captaincy's key and my glove. The captives know it, half of them once asked me the way.",
	["quest.side_cultCages.progress"] = "Two cages to open and ten dark cultists in the Cultist Village.",
	["quest.side_cultCages.done"] = "They reached the gallows, all of them. One kept repeating the cultists' words: about a winter that will cleanse the Duskwood. I am writing it down for the captain. Thank you, on behalf of the road.",
	["quest.side_cultCages.done.names"] = "It matches the letters. Three more than I thought. They reached the gallows, all of them. One kept repeating the cultists' words about a winter that will cleanse the Duskwood.",
	["quest.side_cultCages.say.glove"] = "I will show them the glove.",
	["quest.side_cultCages.say.glove.reply"] = "They know it. Half of them asked me the way.",
	["quest.side_cultCages.say.where"] = "Where do the cages stand?",
	["quest.side_cultCages.say.where.reply"] = "In the yard, on the west side.",
	["quest.side_cultCages.bark.accept1"] = "The key fits both padlocks. Do not lose it.",
	["quest.side_cultCages.bark.half1"] = "The first cage is open. People are running towards the Crossroads.",
	["quest.side_cultCages.bark.done1"] = "I can see them on the road. Come back before the village notices.",
	-- S106: P. The Swamp Toll
	["quest.side_eelTraps.title"] = "Eel Traps",
	["quest.side_eelTraps.p1"] = "I live by the ferry and by eels. Little ferrying of late, and even fewer eels.",
	["quest.side_eelTraps.p2"] = "Serpents bite through my traps, and I no longer go into the reeds myself. Set two new ones by the jetty and drive off the serpents.",
	["quest.side_eelTraps.p3"] = "The traps lie by the jetty, one on each side. You only have to cast them. My hands are not what they were, nor my knees.",
	["quest.side_eelTraps.progress"] = "Two eel traps set by the jetty and eight bog serpents in the Troll Swamp.",
	["quest.side_eelTraps.done"] = "An eel, a good one. And... an old ferry coin with a hole in it. Nothing. Nothing at all. I will put it away, do not ask.",
	["quest.side_eelTraps.say.traps"] = "The traps first.",
	["quest.side_eelTraps.say.traps.reply"] = "Good. An eel does not wait.",
	["quest.side_eelTraps.say.snakes"] = "The serpents first.",
	["quest.side_eelTraps.say.snakes.reply"] = "Sensible. A dead serpent bites no nets.",
	["quest.side_eelTraps.say.reeds"] = "Why do you not go into the reeds?",
	["quest.side_eelTraps.say.reeds.reply"] = "Something lives in the reeds. The eels think so too.",
	["quest.side_eelTraps.bark.accept1"] = "Spit over your left shoulder before you step into the water.",
	["quest.side_eelTraps.bark.half1"] = "I hear a splash. Either an eel or trouble.",
	["quest.side_eelTraps.bark.done1"] = "Come, let us see what we caught.",
	["quest.side_trollToll.title"] = "The Toll",
	["quest.side_trollToll.p1"] = "I will tell you, since you will see it anyway. The trolls take a toll from me. A coin for every passenger.",
	["quest.side_trollToll.p2"] = "Whoever does not pay, does not reach the other side. I pay, because I would rather pay than row alone.",
	["quest.side_trollToll.p3"] = "The trolls wear those coins on strings, like beads. Get them back. You will know mine: they have holes I drill myself.",
	["quest.side_trollToll.progress"] = "Six ferry coins from the swamp trolls in the Troll Swamp.",
	["quest.side_trollToll.done"] = "They are mine, every one with its hole. But the box with the rest is missing. It lies in the heap of bones in the troll village, on the island.",
	["quest.side_trollToll.say.pay"] = "You paid them a toll?",
	["quest.side_trollToll.say.pay.reply"] = "Everyone pays. At least I count how much.",
	["quest.side_trollToll.say.guard"] = "Why not the guard?",
	["quest.side_trollToll.say.guard.reply"] = "Does the guard have a boat? No. Then why ask.",
	["quest.side_trollToll.bark.accept1"] = "You can smell trolls from afar. The one good thing about trolls.",
	["quest.side_trollToll.bark.half1"] = "Three coins. I have counted them in my head for years.",
	["quest.side_trollToll.bark.done1"] = "Come back. Coins are better counted on dry land.",
	["quest.side_trollToll.bark.death1"] = "I told you. Water does not like haste.",
	["quest.side_trollHoard.title"] = "The Ferryman's Box",
	["quest.side_trollHoard.p1"] = "The troll village stands on an island. By the great cauldron they keep a heap of bones, and in it everything they ever took from anyone.",
	["quest.side_trollHoard.p2"] = "Somewhere in that heap lies my box. Small, iron-bound, with a lock the trolls could not open.",
	["quest.side_trollHoard.p3"] = "Dig into the heap and thin out the trolls, so they do not come back for the toll for a long while.",
	["quest.side_trollHoard.p4"] = "If the box is open, do not look inside. Bring it. Please.",
	["quest.side_trollHoard.progress"] = "The troll village on the island, the heap of bones by the cauldron and eight swamp trolls in the Troll Swamp.",
	["quest.side_trollHoard.done"] = "The coins are here. And a letter from my wife, from years ago. I thought it was lost. From today, anyone who comes from you, I ferry for free.",
	["quest.side_trollHoard.say.island"] = "How do I reach the island?",
	["quest.side_trollHoard.say.island.reply"] = "By the ford from the north. And do not look into the water.",
	["quest.side_trollHoard.say.box"] = "What is in the box?",
	["quest.side_trollHoard.say.box.reply"] = "Mine. Ask no more.",
	["quest.side_trollHoard.bark.accept1"] = "On the island keep to dry ground. Trolls do not like guests.",
	["quest.side_trollHoard.bark.half1"] = "The heap is dug open. Now the trolls, before they come back.",
	["quest.side_trollHoard.bark.near1"] = "The heap by the cauldron. It stinks like my toll.",
	["quest.side_trollHoard.bark.done1"] = "You have it? Bring it. Carefully.",
	-- S106: Q. Hexes of the Marsh
	["quest.side_hexCharms.title"] = "Hexes by the Path",
	["quest.side_hexCharms.p1"] = "On the hanging tree and on two posts by the path through the marsh hang hexes. Bones, hair, string.",
	["quest.side_hexCharms.p2"] = "I cannot touch them with bare hands. You burn them, and in their place set boards with the temple's sign.",
	["quest.side_hexCharms.p3"] = "The witches will come to see who is spoiling their work. They will come, because they always do.",
	["quest.side_hexCharms.progress"] = "Three hexes to burn by the path and eight marsh witches in the Witch Marsh.",
	["quest.side_hexCharms.done"] = "The ash of the hexes is cold. Look, it glitters like rime. No fire leaves ash like this.",
	["quest.side_hexCharms.say.bare"] = "Why not with bare hands?",
	["quest.side_hexCharms.say.bare.reply"] = "A hex seeks warmth. You have gloves.",
	["quest.side_hexCharms.say.pray"] = "Will you pray for me?",
	["quest.side_hexCharms.say.pray.reply"] = "Briefly. Long prayers are for those who have time. Take the water.",
	["quest.side_hexCharms.bark.accept1"] = "Keep the fire away from your face. Hexes crack as they burn.",
	["quest.side_hexCharms.bark.half1"] = "Half. The marsh is quieter.",
	["quest.side_hexCharms.bark.near1"] = "Do not touch it yet. Fire first.",
	["quest.side_hexCharms.bark.done1"] = "Come back. I will show you what is left in the ash.",
	["quest.side_hexPouches.title"] = "Hex Pouches",
	["quest.side_hexPouches.p1"] = "Every witch of the coven carries a pouch with hair and a slip of paper. On the slip is the name of the one she has hexed.",
	["quest.side_hexPouches.p2"] = "Gather five such pouches and take them to Brother Anzelm. He knows the people of the city and around it, he will know the names.",
	["quest.side_hexPouches.p3"] = "Do not open them. Do not read them. A name read by a stranger only strengthens the hex.",
	["quest.side_hexPouches.progress"] = "Five hex pouches from the marsh witches in the Witch Marsh, for Brother Anzelm.",
	["quest.side_hexPouches.done"] = "These names... lantern wardens, ferrymen, beekeepers. The people who keep the roads of the Duskwood. And in every pouch, dust of scales, cold to the touch. The same as in the charms from the Meadows.",
	["quest.side_hexPouches.say.names"] = "Whose names are inside?",
	["quest.side_hexPouches.say.names.reply"] = "I do not read them. Brother Anzelm reads them.",
	["quest.side_hexPouches.say.burn"] = "Let us burn them at once.",
	["quest.side_hexPouches.say.burn.reply"] = "First the names. Then the fire.",
	["quest.side_hexPouches.bark.accept1"] = "Carry the pouches apart. Do not let them touch.",
	["quest.side_hexPouches.bark.half1"] = "Half. I can feel them from here, like a cold wind.",
	["quest.side_hexPouches.bark.done1"] = "Kalina sends you to me? Bring them. Only do not open them.",
	["quest.side_witchCauldron.title"] = "The Marsh Cauldron",
	["quest.side_witchCauldron.p1"] = "Those hexes were brewed in the cauldron by the hut on stilts, at the edge of the Witch Marsh. There the coven does what it does.",
	["quest.side_witchCauldron.p1.burn"] = "You wanted to burn them at once. Kalina was right that we did not. Those hexes were brewed in the cauldron by the hut on stilts, at the edge of the Witch Marsh.",
	["quest.side_witchCauldron.p2"] = "An overturned cauldron will drink no one's blood again. Go there and overturn it.",
	["quest.side_witchCauldron.p3"] = "Trolls guard the hut for the witches' pay. Kalina waits by the hanging tree and prays for you. Start wherever you like.",
	["quest.side_witchCauldron.p4"] = "When you return, do not speak in the city of those names. The ones who hunt those people should not know that we know.",
	["quest.side_witchCauldron.progress"] = "The witch's hut on stilts, the cauldron to overturn and six swamp trolls in the Witch Marsh. Then to Sister Kalina.",
	["quest.side_witchCauldron.done"] = "I burnt the last pouch by the tree. Whoever pays them in scales will pay more. But not on this path.",
	["quest.side_witchCauldron.say.cauldron"] = "Straight to the cauldron.",
	["quest.side_witchCauldron.say.cauldron.reply"] = "Good. The source first, then the rest.",
	["quest.side_witchCauldron.say.trolls"] = "The trolls first.",
	["quest.side_witchCauldron.say.trolls.reply"] = "Good. The cauldron will not run away.",
	["quest.side_witchCauldron.say.kalina"] = "Will Kalina come with me?",
	["quest.side_witchCauldron.say.kalina.reply"] = "No. She waits and prays. Everyone has their work.",
	["quest.side_witchCauldron.bark.accept1"] = "Go. Kalina is already praying for you.",
	["quest.side_witchCauldron.bark.half1"] = "Do not go into the hut. The cauldron stands beside it, not inside.",
	["quest.side_witchCauldron.bark.done1"] = "The cauldron is down. I feel it from here. Come back to the tree.",
	["quest.side_witchCauldron.bark.stuck1"] = "The hut stands on stilts at the west edge of the marsh.",
	-- S106: R. The Stonemason's Apprentice
	["quest.side_roadCut.title"] = "The Shoring",
	["quest.side_roadCut.p1"] = "The shoring in the road's cut up the Blood Cliffs is cracking. The beams are new, yet they crack like old ones.",
	["quest.side_roadCut.p2"] = "Shore up three places with new planks before the wall comes down on the road.",
	["quest.side_roadCut.p3"] = "The bats will not let anyone work in peace. They fly at every knock of a hammer. Thin them out.",
	["quest.side_roadCut.progress"] = "Three places of shoring to prop up in the road's cut and ten blood bats on the Blood Cliffs.",
	["quest.side_roadCut.done"] = "Look at these beams. The cuts are even, made with a mason's chisel. Someone was undercutting them. Only my apprentice Leszek had such a chisel.",
	["quest.side_roadCut.say.beams"] = "The beams first.",
	["quest.side_roadCut.say.beams.reply"] = "Good. The wall will not wait.",
	["quest.side_roadCut.say.bats"] = "The bats first.",
	["quest.side_roadCut.say.bats.reply"] = "Good. Peace at work is half the work.",
	["quest.side_roadCut.say.stone"] = "Will the stone not hold on its own?",
	["quest.side_roadCut.say.stone.reply"] = "Stone holds anything. The people under it do not.",
	["quest.side_roadCut.bark.accept1"] = "The planks are by the wall. Do not spare the nails.",
	["quest.side_roadCut.bark.half1"] = "Half. The wall no longer creaks.",
	["quest.side_roadCut.bark.done1"] = "Come back. Something about those beams I do not like.",
	["quest.side_batRoost.title"] = "The Bat Roost",
	["quest.side_batRoost.p1"] = "Leszek vanished a month ago by the bat roost. He went to look at the rock and never came back.",
	["quest.side_batRoost.p2"] = "The bats carry everything that glints into their nests. If anything of his is left, it is there.",
	["quest.side_batRoost.p3"] = "Go under the overhang and bring his tools. I will know them. I sharpened every one myself before I gave it to him.",
	["quest.side_batRoost.progress"] = "The bat roost on the Blood Cliffs and five of Leszek's chisels from the blood bats.",
	["quest.side_batRoost.done"] = "Covered in rime. And here, on the handle, someone scratched: 'Gate. Forging a seal. Making us'. It breaks off. The Gate above the Crypt. I know where it is.",
	["quest.side_batRoost.say.leszek"] = "What was Leszek like?",
	["quest.side_batRoost.say.leszek.reply"] = "He held a chisel crooked. He thought straight.",
	["quest.side_batRoost.say.bats"] = "Bats steal chisels?",
	["quest.side_batRoost.say.bats.reply"] = "Anything that glints. They have not stolen me yet.",
	["quest.side_batRoost.bark.accept1"] = "The overhang is above the road. You will hear them before you see them.",
	["quest.side_batRoost.bark.half1"] = "Half. I know those handles, that is his work.",
	["quest.side_batRoost.bark.near1"] = "Here. He dressed this stone, I know his hand.",
	["quest.side_batRoost.bark.done1"] = "Bring them all. And do not clean any of them.",
	["quest.side_apprentice.title"] = "The Apprentice",
	["quest.side_apprentice.p1"] = "People in grey hired masons for work at the Crypt Gate. They paid well. Leszek went because he wanted to buy his own chisels.",
	["quest.side_apprentice.p2"] = "Those who finished the work they left inside. In the Crypt of the Forgotten they now stand in the ranks of the bone guard.",
	["quest.side_apprentice.p3"] = "Leszek wore an iron guild ring. I gave it to him when he cut his first threshold without a crack. Bring me that ring.",
	["quest.side_apprentice.p4"] = "If he stands there with the others, let him lie down.",
	["quest.side_apprentice.progress"] = "Two skeleton guards (Elites) in the Crypt of the Forgotten and Leszek's guild ring for Wojsław.",
	["quest.side_apprentice.done"] = "I will cut his name into the stone by the road. The first mark on the new shoring. It will hold better than the beams.",
	["quest.side_apprentice.say.lay"] = "I will let him lie down.",
	["quest.side_apprentice.say.lay.reply"] = "Thank you.",
	["quest.side_apprentice.say.bring"] = "I will bring him to you.",
	["quest.side_apprentice.say.bring.reply"] = "You will not. Bring the ring.",
	["quest.side_apprentice.bark.accept1"] = "The Crypt is under the Gate, at the end of the road. Go carefully.",
	["quest.side_apprentice.bark.half1"] = "You are inside. Do not count them. Look for the ring.",
	["quest.side_apprentice.bark.done1"] = "You have it? Come back. The stone is waiting.",
	["quest.side_apprentice.bark.death1"] = "Get up. I do not want to cut two names.",
