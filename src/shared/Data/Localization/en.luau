	["quest.side_stable_harness.title"] = "The Stolen Harness",
	["quest.side_stable_harness.p1"] = "A wild stallion grazes at the edge of Bear Ravine. It broke away from a merchant herd when bandits raided the road, and nobody has caught it since.",
	["quest.side_stable_harness.p2"] = "I want it in my stable, and you, I see, need a horse. But without a harness there is no point going near it.",
	["quest.side_stable_harness.p3"] = "My last harness travelled on Lucjan's wagon. The goblins from the camp tore it apart for the pieces. Bring me three.",
	["quest.side_stable_harness.progress"] = "Three harness pieces from the goblin scouts of the Goblin Camp.",
	["quest.side_stable_harness.done"] = "The straps are whole, the buckles too. I will stitch it together by evening. Now comes the hard part.",
	["quest.side_stable_stallion.title"] = "The Wild Stallion",
	["quest.side_stable_stallion.p1"] = "The stallion grazes on the grass above Bear Ravine. Borys the hunter sees it there at dawn.",
	["quest.side_stable_stallion.p2"] = "Walk up slowly, no weapon in hand, and put the harness on it. Do not pull. A horse that is frightened once remembers it for a long time.",
	["quest.side_stable_stallion.p3"] = "The bears scare it off every night. Drive six of them out of the ravine, then go to Borys. He will look after the stallion.",
	["quest.side_stable_stallion.progress"] = "Calm the stallion above Bear Ravine and drive off six brown bears. Then go to Borys.",
	["quest.side_stable_stallion.done"] = "Radosz was right, it is a good horse. It can stay by my camp until the bears settle down.",
	["quest.side_stable_ride.title"] = "The First Ride",
	["quest.side_stable_ride.p1"] = "The stallion knows you now. It eats from your hand and keeps its ears up when you come near. Time it went to the stable.",
	["quest.side_stable_ride.p2"] = "Here is the lead rope. Take it to Radosz, to the stable by the city gate. He will saddle it.",
	["quest.side_stable_ride.progress"] = "Lead the stallion to the stable by the city gate and talk to Radosz.",
	["quest.side_stable_ride.done"] = "It walked into the stall as if it had always lived here. The saddle and the bridle are ready. It is yours. Ride it with the mount button.",
