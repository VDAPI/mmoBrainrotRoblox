	["admin.usage.scene"] = "/scene play <id> | list | reset",
	-- S103: story chapter II "The Forgotten House" (pages, new quests, NPCs of Duskwood, answers, comments, cutscenes)
	["quest.toDuskwood.p1"] = "Grimrok spoke of a lord in the north, Anzelm of Ilvar. Ten years ago Ilvar went into Duskwood.",
	["quest.toDuskwood.p2"] = "If his people are anywhere, they are there. Past the Dusk Gate, Scout Borin keeps the road. Find him.",
	["quest.toDuskwood.p3"] = "Keep to the blue lanterns; in Duskwood the light is the border. And take this pack: there are no merchants in Duskwood.",
	["quest.toDuskwood.bark.accept1"] = "The road to Duskwood starts past the portal. Look for the blue lanterns.",
	["quest.toDuskwood.bark.done1"] = "You made it. Rest by a lantern before you go on.",
	["quest.werewolves.p1"] = "They have been howling for three nights, and the full moon is far off. Werewolves were always here, but these do not flee from fire and hunt in broad daylight.",
	["quest.werewolves.p2"] = "Thin them out in the western woods before the full moon makes an army of them.",
	["quest.werewolves.bark.accept1"] = "The western woods. Follow the howling, it will lead you.",
	["quest.werewolves.bark.half1"] = "Half the pack. The rest already know you are coming.",
	["quest.werewolves.bark.done1"] = "The woods are quiet. Come back before the moon rises.",
	["quest.moonstone.title"] = "The Moonstone",
	["quest.moonstone.p1"] = "There was a hunters' camp at the edge of the forest. The wolves tore it apart in one night. Only Forester Radomir lived.",
	["quest.moonstone.p2"] = "Radomir says things I do not want to believe. That the wolves came straight from the Moon Glade, and that someone was there before them.",
	["quest.moonstone.p3"] = "He sits in what is left of the camp. Hear him out, then go to the glade and see for yourself.",
	["quest.moonstone.text"] = "Find Forester Radomir in the ravaged camp, chisel the rune off the Moonstone and thin out the werewolves in the Werewolf Thicket.",
	["quest.moonstone.done"] = "The stone shines silver again. The rune was ice that would not melt in the hand: a snowflake pierced by a thorn. I can see on your face that you know that sign.",
	["quest.moonstone.radomir"] = "Someone carved a fresh rune into the menhir. The stone's silver light turned cold and blue, and near it the wolves go mad. Chisel it out.",
	["quest.moonstone.say.believe"] = "I believe him. Where is the stone?",
	["quest.moonstone.say.believe.reply"] = "The glade north of the camp. Watch the stone, not the wolves.",
	["quest.moonstone.say.doubt"] = "Runes on a stone? Maybe he was drinking.",
	["quest.moonstone.say.doubt.reply"] = "Radomir drinks only water. Since that night, not much of that either.",
	["quest.moonstone.say.wolves"] = "How many are there?",
	["quest.moonstone.say.wolves.reply"] = "More than I care to count. Take these.",
	["quest.moonstone.bark.accept1"] = "Radomir sits by the cold fire. Speak to him gently.",
	["quest.moonstone.bark.half1"] = "Less howling. Do not slow down.",
	["quest.moonstone.bark.near1"] = "The stone is cold. In the middle of summer.",
	["quest.moonstone.bark.done1"] = "They have gone quiet. The first owls I have heard in a week.",
	["quest.lostHunters.title"] = "The Lost Hunters",
	["quest.lostHunters.p1"] = "My son, Milosz, followed the wolves' trail down into Bear Hollow. He did not come back.",
	["quest.lostHunters.p1.doubt"] = "Borin says you do not believe me. Good. We will go down and you will see with your own eyes. My son, Milosz, followed the wolves into Bear Hollow. He did not come back.",
	["quest.lostHunters.p2"] = "The bears in the hollow are as restless as the wolves. The hunters have avoided it for a month. So did I.",
	["quest.lostHunters.p3"] = "I will go down with you. I know the hollow. I did not have the courage alone, and he was a good hunter. The best I ever taught.",
	["quest.lostHunters.text"] = "Go with Radomir to the lost camp at the bottom of Bear Hollow, search it and thin out the black bears. Bring the news to Borin.",
	["quest.lostHunters.done"] = "Milosz's notes. Men in grey cloaks carried a coffin covered in frost through the hollow, towards the Ruins. They end here. There is no body, and Radomir's hunters cut that mark when they go on. I will tell him there is hope.",
	["quest.lostHunters.done.son"] = "Stubborn, he said? The stubborn live long. Men in grey carried a frosted coffin through the hollow, towards the Ruins. No body, but a hunter's mark. I will tell Radomir there is hope.",
	["quest.lostHunters.say.together"] = "Will you come with me?",
	["quest.lostHunters.say.together.reply"] = "I will. I know the hollow better than my own hut. I do not sleep anyway.",
	["quest.lostHunters.say.son"] = "What is your son like?",
	["quest.lostHunters.say.son.reply"] = "Stubborn. He shoots better than I do. Do not tell him that.",
	["quest.lostHunters.say.bears"] = "And the bears?",
	["quest.lostHunters.say.bears.reply"] = "As restless as the wolves. Here, these are no use to me.",
	["quest.lostHunters.bark.accept1"] = "Stay close. In the hollow the echo lies.",
	["quest.lostHunters.bark.half1"] = "The bears are quieting. The hollow breathes again.",
	["quest.lostHunters.bark.near1"] = "There, under the rock. Someone made a fire after the attack.",
	["quest.lostHunters.bark.done1"] = "You have his notes? Bring them before they get wet.",
	["quest.lostHunters.bark.death1"] = "Get up. The hollow gives a second chance, never a third.",
	["quest.lostHunters.comp.join1"] = "The road, then down by the fallen giant. Do not fall behind.",
	["quest.lostHunters.comp.join2"] = "Milosz says I lead like a bear. Slow, but I always get there.",
	["quest.lostHunters.comp.wait1"] = "I am waiting. The forest will not run off, but wolves may come.",
	["quest.lostHunters.comp.wait2"] = "Do not pick mushrooms. Here they pick people.",
	["quest.lostHunters.comp.arrive1"] = "Milosz's crossbow. A fresh notch on the stock: that is how we mark that we go on.",
	["quest.lostHunters.comp.arrive2"] = "He was alive when he was here. Search the rest. I will… watch the path.",
	["quest.lostHunters.comp.back1"] = "I am going back to the camp. Come, we will go down again.",
	["quest.ruins.p1"] = "The tracks from the hollow lead up to the hill with the ruins. For weeks the wraiths there have come out by day, as if someone woke them.",
	["quest.ruins.p2"] = "Destroy them and collect their essence. Ysolde will tell us what keeps them in that place.",
	["quest.ruins.bark.accept1"] = "The ruins are on the hill past the fork. Wraiths do not like the light.",
	["quest.ruins.bark.half1"] = "Halfway. The wraiths return to where they were bound.",
	["quest.ruins.bark.done1"] = "Come back with the essence. Ysolde is waiting.",
	["quest.houseOfVael.title"] = "The House of Vael",
	["quest.houseOfVael.p1"] = "The essence was bound. Someone has been holding rites in the ruins, and not long ago.",
	["quest.houseOfVael.p2"] = "On the hill stands a manor whose name nobody in Duskwood remembers. Behind it, a cemetery, a chapel and a family crypt.",
	["quest.houseOfVael.p3"] = "Look at the stained glass in the chapel, and at the crypt. They say a pale man in livery is sometimes seen by the chapel.",
	["quest.houseOfVael.text"] = "Search the manor in the Haunted Ruins: the stained glass in the chapel and the family crypt. Hear out the ghost who keeps them.",
	["quest.houseOfVael.done"] = "Morvane. The Queen of the Crypts is the last of the house that saved the north? And it was her coffin they carried through the hollow.",
	["quest.houseOfVael.oswin"] = "I was the steward of this house. The men in grey went down into the crypt and carried out my lady's coffin. I could do nothing. The dead can do little.",
	["quest.houseOfVael.say.ghosts"] = "A pale man in livery?",
	["quest.houseOfVael.say.ghosts.reply"] = "I do not believe in ghosts. But I keep away from that chapel.",
	["quest.houseOfVael.say.whose"] = "Whose manor was it?",
	["quest.houseOfVael.say.whose.reply"] = "Nobody remembers. That troubles me more than ghosts.",
	["quest.houseOfVael.say.way"] = "Where is that chapel?",
	["quest.houseOfVael.say.way.reply"] = "Behind the manor, past the cemetery. You can see the stained glass from afar.",
	["quest.houseOfVael.bark.accept1"] = "The manor stands on the hill. Take the road from the fork.",
	["quest.houseOfVael.bark.half1"] = "Do not stay there after dark longer than you must.",
	["quest.houseOfVael.bark.near1"] = "The manor starts here. The silence here is too deep.",
	["quest.houseOfVael.bark.done1"] = "Come back. I want to know whose crypt that is.",
	["quest.houseOfVael.bark.stuck1"] = "The chapel stands past the cemetery, the crypt right beside it.",
	["quest.ents.p1"] = "The Forest Heart is rotting from within. The ents that guarded the Elder Tree attack anything that moves.",
	["quest.ents.p2"] = "Put them to rest. Ysolde also wants nightshade from the pools there; she says she will make something against this rot.",
	["quest.ents.bark.accept1"] = "The Forest Heart lies in a hollow to the north. Mind the roots.",
	["quest.ents.bark.half1"] = "The ents are weakening. Nightshade grows by the pools.",
	["quest.ents.bark.done1"] = "The forest breathes easier. Come back.",
	["quest.elderHeart.title"] = "Heart of the Elder Tree",
	["quest.elderHeart.p1"] = "The rot has not stopped. The rot in the Forest Heart is cold, and something blue glows in the crack of the Elder Tree.",
	["quest.elderHeart.p1.ghosts"] = "After that chapel you do not ask about ghosts any more. Good, because now it is trees. The rot in the Forest Heart is cold, and something blue glows in the Elder Tree's crack.",
	["quest.elderHeart.p2"] = "The ghouls are drawn to that light. Pull out whatever is stuck in the tree before all of it rots.",
	["quest.elderHeart.text"] = "Pull out what is stuck in the crack of the Elder Tree and thin out the ghouls in the Forest Heart.",
	["quest.elderHeart.done"] = "The shard of ice melted in the hand, and the crack glows gold? And the tree gave you a branch, warm and humming like a string. I do not know what it is. But the forest gave it to you. Keep it.",
	["quest.elderHeart.say.cold"] = "Rot that is cold?",
	["quest.elderHeart.say.cold.reply"] = "I touched it. My fingers ached until morning. A forest rots warm. That is not the forest.",
	["quest.elderHeart.say.ghouls"] = "How many ghouls?",
	["quest.elderHeart.say.ghouls.reply"] = "Dozens. They are drawn to that light like moths to a flame.",
	["quest.elderHeart.say.path"] = "How do I get down to the Elder Tree?",
	["quest.elderHeart.say.path.reply"] = "Along the roots, not through the mud. The mud there has teeth.",
	["quest.elderHeart.bark.accept1"] = "The Elder Tree stands in the hollow. Go down carefully.",
	["quest.elderHeart.bark.half1"] = "The ghouls are thinning. The tree seems to feel it.",
	["quest.elderHeart.bark.near1"] = "That blue in the crack… do not touch it with a bare hand.",
	["quest.elderHeart.bark.done1"] = "The forest gives nothing to anyone. Show me what you have.",
	["quest.cult.p1"] = "The cultists of the dark have a village in the north-east, behind a palisade, with a stone circle and violet fire. They carried the coffin.",
	["quest.cult.p2"] = "Stop them and gather their sigils. Take them to the captain. He will know whom to show them.",
	["quest.cult.bark.accept1"] = "The village is behind the palisade to the north-east. Do not use the main gate.",
	["quest.cult.bark.half1"] = "They wear the sigils on their belts. Keep looking.",
	["quest.cult.bark.done1"] = "The cult's sigils? Bring them straight to me.",
	["quest.turncoat.title"] = "The Turncoat",
	["quest.turncoat.p1"] = "Borin sent word. A cultist who ran from his own is hiding at the wayside shrine at the Misty Crossroads.",
	["quest.turncoat.p2"] = "He will speak only to someone from the city. His former brothers are combing the crossroads, so he will not live long there.",
	["quest.turncoat.p3"] = "Go, hear him out and drive off those who are looking for him. Promise him nothing I cannot keep.",
	["quest.turncoat.text"] = "Find the runaway cultist at the wayside shrine at the Misty Crossroads, hear him out and drive off those who hunt him.",
	["quest.turncoat.done"] = "Three seals keep the dragon asleep: Blood, Rune and Watch. The Blood is Queen Morvane. Ilvar has her body and means to raise her in the Barrow, so that her blood serves the Winter. I will not give him the time.",
	["quest.turncoat.done.trust"] = "I said I did not trust him. I would rather he had lied. Three seals: Blood, Rune and Watch. The Blood is Morvane. Ilvar has her body and means to raise her in the Barrow. I will not give him the time.",
	["quest.turncoat.jorund"] = "I was one of them. I ran when I saw what they do with the dead. Tell the captain everything I tell you. Everything.",
	["quest.turncoat.say.trust"] = "You trust a runaway cultist?",
	["quest.turncoat.say.trust.reply"] = "No. I trust Borin, and Borin trusts no one. It comes to the same.",
	["quest.turncoat.say.bring"] = "Should I bring him here?",
	["quest.turncoat.say.bring.reply"] = "He would not cross Duskwood alive. Hear him out where he is.",
	["quest.turncoat.say.hunters"] = "Who is hunting him?",
	["quest.turncoat.say.hunters.reply"] = "His brothers. They prowl the crossroads. Them first.",
	["quest.turncoat.bark.accept1"] = "The shrine stands by the road to the village. Hand on your weapon.",
	["quest.turncoat.bark.half1"] = "A few more brothers in the mist. Do not leave him alone.",
	["quest.turncoat.bark.near1"] = "Look for the lantern. He will not come out first.",
	["quest.turncoat.bark.done1"] = "Come back. I want to hear it word for word.",
	["quest.swamp.p1"] = "Before we move on the Barrow, Borin's garrison has to hold out. Trolls have cut the paths through the swamp; the men are eating roots.",
	["quest.swamp.p2"] = "Clear the way and bring them fish. A hungry scout sees wolves where there are none.",
	["quest.swamp.bark.accept1"] = "The trolls sit on the causeway. Take a rod, the garrison is hungry.",
	["quest.swamp.bark.half1"] = "The path is getting clearer. Do not forget the fish.",
	["quest.swamp.bark.done1"] = "Fish and a clear road. My men will not forget it.",
	["quest.barrow.title"] = "Heart of the Barrow",
	["quest.barrow.p1"] = "The Cultist Barrow. Jorund said it would be there. In the Heart of the Barrow the cult's chosen guard the altar.",
	["quest.barrow.p2"] = "Go before they finish. Take the Book of Rites from them. The cult writes down everything it does.",
	["quest.barrow.text"] = "Enter the Cultist Barrow, defeat their chosen and take the Book of Rites from them.",
	["quest.barrow.done"] = "“The queen has risen and binds the dead for the Winter.” We are too late. But now we know where to look for her.",
	["quest.barrow.say.late"] = "Will we make it?",
	["quest.barrow.say.late.reply"] = "No. But go as if we could.",
	["quest.barrow.say.book"] = "What should I look for?",
	["quest.barrow.say.book.reply"] = "A book. The cult writes down every rite, and this one was the greatest.",
	["quest.barrow.say.supplies"] = "I need supplies.",
	["quest.barrow.say.supplies.reply"] = "Take these. Nobody will sell you anything in the Barrow.",
	["quest.barrow.bark.accept1"] = "The Barrow is at the end of the road below the manor. Go before they finish.",
	["quest.barrow.bark.half1"] = "The chosen are falling. One of them must carry the book.",
	["quest.barrow.bark.done1"] = "You have the book? Come back before the cult sees what is missing.",
	["quest.barrow.bark.death1"] = "The cult's chosen do not fight fair. Come back with a better plan.",
	["quest.barrow.bark.stuck1"] = "Not every one of the chosen carries the book. Keep looking.",
	["quest.crypt.p1"] = "They took her to the Crypt of the Forgotten under the Blood Cliffs. The Barrow was only a stop on the way.",
	["quest.crypt.p2"] = "Skeleton guards hold the way in. First them, then we think about the queen.",
	["quest.crypt.bark.accept1"] = "The Crypt is under the Blood Cliffs, at the end of the road.",
	["quest.crypt.bark.half1"] = "The guards are falling. The Crypt grows quieter.",
	["quest.crypt.bark.done1"] = "Her guards are dust. Come back before the Crypt wakes.",
	["quest.witchCounsel.title"] = "The Witch's Counsel",
	["quest.witchCounsel.p1"] = "A queen is not killed like a troll. Steel will pass through her like mist if we do not know what we are fighting.",
	["quest.witchCounsel.p2"] = "In the abandoned village on stilts, in the Troll Swamp, lives Ragna. People say she is a witch. She says she is not.",
	["quest.witchCounsel.p3"] = "Ask her about the queen. The coven of the Witch Marsh serves the cult, but Ragna does not belong to it. So she claims.",
	["quest.witchCounsel.text"] = "Speak with Ragna of the Stilts, thin out the coven's witches in the Witch Marsh and bring three bone chimes.",
	["quest.witchCounsel.done"] = "The coven has gone quiet all the way here. Ragna sent a flask and a word: when the queen falters, speak her name. The dead remember themselves only when someone reminds them.",
	["quest.witchCounsel.ragna"] = "I am not of the coven. From their bone chimes I will brew a Draught of the True Name. A dead woman who hears her name remembers who she was.",
	["quest.witchCounsel.say.witch"] = "A witch?",
	["quest.witchCounsel.say.witch.reply"] = "She says not. I would not argue with her.",
	["quest.witchCounsel.say.trust"] = "Do you trust her?",
	["quest.witchCounsel.say.trust.reply"] = "She healed my men. She took fish for it. A fair price.",
	["quest.witchCounsel.say.way"] = "Where do I find her?",
	["quest.witchCounsel.say.way.reply"] = "The west shore of the Troll Swamp, by the huts on stilts.",
	["quest.witchCounsel.bark.accept1"] = "Ragna does not like guests. Knock and wait.",
	["quest.witchCounsel.bark.half1"] = "I tuned this chime myself. Forty years ago. Do not ask.",
	["quest.witchCounsel.bark.near1"] = "The marsh. Breathe through your mouth, the nose is not worth it.",
	["quest.witchCounsel.bark.done1"] = "The coven has gone quiet all the way here. Ragna sent a flask. Come back.",
	["quest.witchCounsel.bark.death1"] = "Get up. Only those who will never rise lie in the marsh.",
	["quest.witchCounsel.comp.join1"] = "I will come. A chime has to be taken off right, or it keeps ringing.",
	["quest.witchCounsel.comp.back1"] = "Here I am. Old legs, but they remember the way to the marsh.",
	["quest.cryptGate.title"] = "The Seal on the Gate",
	["quest.cryptGate.p1"] = "The cult hung a seal under the Crypt Gate. Since then wraiths come out onto the cliffs, even by day.",
	["quest.cryptGate.p2"] = "Break it, then go down into the Crypt and thin out its chosen specters. Keep Ragna's flask close, you will need it later.",
	["quest.cryptGate.text"] = "Shatter the cult's seal on the Crypt Gate and defeat the chosen specters of the Crypt of the Forgotten.",
	["quest.cryptGate.done"] = "So it is him. A grey cloak, a priest's voice. Now we know whom we are fighting.",
	["quest.cryptGate.say.ready"] = "I am going.",
	["quest.cryptGate.say.ready.reply"] = "Go. The cliffs do not like those who hesitate.",
	["quest.cryptGate.say.seal"] = "How do I break the seal?",
	["quest.cryptGate.say.seal.reply"] = "With steel, a stone, anything. Just be quick, before the wraiths gather.",
	["quest.cryptGate.say.supplies"] = "Can you spare anything?",
	["quest.cryptGate.say.supplies.reply"] = "Two. The third went on my own wounds.",
	["quest.cryptGate.bark.accept1"] = "The gate is at the end of the road, up the cliffs. Do not stray.",
	["quest.cryptGate.bark.half1"] = "The specters are thinning. The Crypt feels it.",
	["quest.cryptGate.bark.near1"] = "That sign… the same as on the Moonstone.",
	["quest.cryptGate.bark.done1"] = "Come back. Do not stand under that gate longer than you must.",
	["quest.cryptGate.bark.death1"] = "The Crypt takes the warmth. Go back to a fire and try again.",
	["quest.morvane.p1"] = "Morvane's Tomb lies beyond the Crypt. That is where they laid her, and from there she binds the dead for the Winter.",
	["quest.morvane.p2"] = "Take Ragna's draught. When the queen falters in the fight, speak her name: Morvane of House Vael.",
	["quest.morvane.p3"] = "You are not killing a monster. You are giving peace to a queen who once saved the north.",
	["quest.morvane.bark.accept1"] = "You have Ragna's draught with you? Good. Go.",
	["quest.morvane.bark.done1"] = "Come back to Vaelthorn. I want to hear how she went.",
	["quest.queensLegacy.title"] = "The Queen's Legacy",
	["quest.queensLegacy.p1"] = "She sleeps at last. And you come back with her ring, and with the branch the Elder Tree gave you.",
	["quest.queensLegacy.p2"] = "Brother Anzelm should see both. He reads the chronicles of houses everyone has forgotten.",
	["quest.queensLegacy.p3"] = "Then go to Ysolde. She wanted to speak with you about something in the east. She would not tell me what.",
	["quest.queensLegacy.text"] = "Take Queen Morvane's ring and the branch from the Elder Tree to Brother Anzelm, then speak with Alchemist Ysolde.",
	["quest.queensLegacy.done"] = "The Thorn of Vael broke into three parts. The shaft was given to the forest, the head to the dwarves, the oath to the Watch. You hold the shaft. Ysolde says the fires in the east burn brighter. If the cult seeks the head, it seeks it in fire.",
	["quest.queensLegacy.anzelm"] = "The ring of House Vael. This crest opens the last page of the chronicle, the one nobody could read. Give me a moment. And the branch too.",
	["quest.queensLegacy.alchemist"] = "The fires in the east burn brighter. My suppliers from the east do not come back, and those who did speak of dwarves forging for strangers.",
	["quest.queensLegacy.say.rest"] = "She sleeps at last.",
	["quest.queensLegacy.say.rest.reply"] = "Thanks to you. This time the chronicles will remember her name.",
	["quest.queensLegacy.say.anzelm"] = "Why Anzelm?",
	["quest.queensLegacy.say.anzelm.reply"] = "Because he reads the chronicles of houses nobody remembers any more.",
	["quest.queensLegacy.say.east"] = "What is in the east?",
	["quest.queensLegacy.say.east.reply"] = "Wastes and fire. Ysolde will tell you more.",
	["quest.queensLegacy.bark.accept1"] = "Anzelm sits over his books in the temple, as always.",
	["quest.queensLegacy.bark.half1"] = "Anzelm has both? Now Ysolde. She does not like to wait.",
	["quest.queensLegacy.bark.done1"] = "Come back to me. I want to hear it all at once.",
