	["path.scout.eye.name"] = "Scout's Eye",
	["path.scout.eye.desc"] = "You see Elites and Elite IIs {eye} studs farther on the minimap (normally 140 studs); those beyond its edge are shown by markers on the rim. Party members within 80 studs of you see them too.",
	["path.scout.spotting.name"] = "Spotting",
	["path.scout.spotting.desc"] = "Your basic attacks and Aimed Shot expose the target: for 5 s it takes {spotting}% more damage from everyone. It does not stack with Hunter's Mark; the stronger one counts.",
	["path.scout.vigilance.name"] = "Vigilance",
	["path.scout.vigilance.desc"] = "When a monster within 30 studs starts a red-zone attack, your party within 40 studs (you included) moves {vigilance}% faster until the wind-up ends and for 0.5 s after. At most once every 8 s.",
	["path.scout.quickFingers.name"] = "Quick Fingers",
	["path.scout.quickFingers.desc"] = "+{quickFingers}% attack speed.",
