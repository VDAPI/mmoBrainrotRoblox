	["quest.firstHunt.text"] = "Click a rabbit to target it — you attack on your own. Kill five and pick up what they drop (F).",
	["quest.firstHunt.done"] = "Clean work. Rabbits do not bite back. Wolves do.",
	["quest.gearUp.title"] = "Gear up",
	["quest.gearUp.text"] = "Put on an item from your backpack and spend a stat point in the character window (C).",
	["quest.gearUp.done"] = "Better. Take this bigger backpack — you will need room.",
	["quest.wolves.title"] = "The pack",
	["quest.wolves.text"] = "Grey wolves attack travellers on the fields. Thin the pack and put a new skill on your bar (K).",
	["quest.wolves.done"] = "The pack will remember you. That is a good thing.",
	["quest.wolfFangs.title"] = "Fangs for the alchemist",
	["quest.wolfFangs.text"] = "The alchemist needs wolf fangs for her brews. Bring six.",
	["quest.wolfFangs.done"] = "Here, a blessing from her. Use it wisely.",
	["quest.boars.title"] = "Tusks in the forest",
	["quest.boars.text"] = "Wild boars have taken over the forest north of the fields. Drive them back.",
	["quest.boars.done"] = "The woodcutters can work again. Thank you.",
	["quest.herbs.title"] = "Meadowsweet",
	["quest.herbs.text"] = "Healer Mirela runs short of herbs. Gather meadowsweet on the fields and take it to her.",
	["quest.herbs.done"] = "Exactly what I needed. Take these potions.",
	["quest.banditRoad.title"] = "The old road",
	["quest.banditRoad.text"] = "Bandits rob the caravans on the old trade road. Make the road safe.",
	["quest.banditRoad.done"] = "The merchants send their thanks — and a backpack.",
	["quest.banditOrders.title"] = "Orders from the north",
	["quest.banditOrders.text"] = "Someone pays these bandits. Find their orders and bring them to Captain Aldric.",
	["quest.banditOrders.done"] = "Goblin gold... and a sign of frost. This is worse than I thought.",
	["quest.goblinCamp.title"] = "Goblin camp",
	["quest.goblinCamp.text"] = "The goblins of the east are gathering. Break their camp before they march.",
	["quest.goblinCamp.done"] = "They are fleeing into the cave. They have somewhere to run to.",
	["quest.mosshollow.title"] = "Mosshollow",
	["quest.mosshollow.text"] = "Follow the goblins into Mosshollow Cave. Beware: inside, anyone may attack you.",
	["quest.mosshollow.done"] = "Their warriors fall. Their chief remains.",
	["quest.grimrok.title"] = "Grimrok",
	["quest.grimrok.text"] = "Grimrok, the Goblin Warchief, waits in his chamber deep in the cave. Gather friends and end him.",
	["quest.grimrok.done"] = "Grimrok spoke of a master in the north before he died... Rest, then go on.",
	["quest.toDuskwood.title"] = "Into Duskwood",
	["quest.toDuskwood.text"] = "The trail leads into Duskwood. Find Scout Borin among the lanterns.",
	["quest.toDuskwood.done"] = "Welcome to the dark. Stay close to the light.",
	["quest.werewolves.title"] = "Howling",
	["quest.werewolves.text"] = "Werewolves hunt in the western woods. Hunt them first.",
	["quest.werewolves.done"] = "The howling has stopped. For tonight.",
	["quest.ruins.title"] = "Forgotten ruins",
	["quest.ruins.text"] = "Wraiths haunt the old ruins. Destroy them and collect their essence.",
	["quest.ruins.done"] = "This essence... it was bound by someone. The crypt.",
	["quest.ents.title"] = "The rotting heart",
	["quest.ents.text"] = "The heart of the forest rots and its ents go mad. Put them to rest and gather nightshade.",
	["quest.ents.done"] = "The forest breathes easier.",
	["quest.cult.title"] = "The cult",
	["quest.cult.text"] = "Cultists of the dark gather in the north-east. Stop them and take their sigils to the captain.",
	["quest.cult.done"] = "These sigils show a dragon. They worship Vaelgrath.",
	["quest.swamp.title"] = "Blackwater",
	["quest.swamp.text"] = "Trolls block the swamp paths. Clear them and bring back a few fish for the garrison.",
	["quest.swamp.done"] = "The garrison eats well tonight.",
	["quest.crypt.title"] = "The crypt",
	["quest.crypt.text"] = "Enter the Crypt of the Forgotten and break its skeleton guards.",
	["quest.crypt.done"] = "Her guards are dust. Now the queen.",
	["quest.morvane.title"] = "Morvane",
	["quest.morvane.text"] = "Morvane, Queen of the Crypts, binds the dead for the dragon. End her reign.",
	["quest.morvane.done"] = "The dead rest again. But the fires in the east are burning brighter.",
	["quest.ashen.title"] = "The Ashen Wastes",
	["quest.ashen.text"] = "Travel to the Ashen Wastes, meet Scout Kesra and thin out the salamanders.",
	["quest.ashen.done"] = "You made it through the heat. Most don't.",
	["quest.orcs.title"] = "Ash orcs",
	["quest.orcs.text"] = "The ash orcs arm for war. Break their warband and mine silver for our smiths.",
	["quest.orcs.done"] = "Their war drums are silent.",
	["quest.golems.title"] = "Living fire",
	["quest.golems.text"] = "Fire golems and scorpions guard the paths to Deepforge. Clear the way.",
	["quest.golems.done"] = "The way to the forge is open.",
	["quest.deepforge.title"] = "Deepforge",
	["quest.deepforge.text"] = "Renegade dwarves forge weapons for the dragon in Deepforge. Stop them.",
	["quest.deepforge.done"] = "The anvils are cold. Only their lord remains.",
	["quest.azgor.title"] = "Azgor",
	["quest.azgor.text"] = "Azgor, Lord of Flames, feeds the dragon's armies with fire. Put out his furnace.",
	["quest.azgor.done"] = "The fire is out. Only the cold remains — and it is coming.",
	["quest.frostpeak.title"] = "Frostpeak",
	["quest.frostpeak.text"] = "Go up to Frostpeak. Scout Halvar needs the passes cleared of wolves and yetis.",
	["quest.frostpeak.done"] = "The passes are ours. The giants are next.",
	["quest.giants.title"] = "Giants' pass",
	["quest.giants.text"] = "Frost giants hold the pass. Defeat them — and upgrade your weapon to +5, you will need it.",
	["quest.giants.done"] = "The way to the glacier is free.",
	["quest.glacier.title"] = "Glacier Heart",
	["quest.glacier.text"] = "In the Glacier Heart crystal guardians watch over the dragon's lair. Break them.",
	["quest.glacier.done"] = "The lair is open. He knows you are coming.",
	["quest.vaelgrath.title"] = "Vaelgrath",
	["quest.vaelgrath.text"] = "Vaelgrath, the Frost Dragon, wakes. End this — for Vaelthorn.",
	["quest.vaelgrath.done"] = "It is over. Vaelthorn will sing of you for a hundred winters.",

