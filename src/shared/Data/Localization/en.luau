	-- S107: the five new people of the Ashen Wastes; where the givers of the Ashen arcs stand (the innkeeper's gossip)
	["npc.scout_ashen.where"] = "by the Ribcage Gate in the Ashen Wastes",
	["npc.alchemist.where"] = "in the alchemy workshop",
	["npc.waterkeeper_orren.name"] = "Orren the Wellkeeper",
	["npc.waterkeeper_orren.role"] = "Wellkeeper",
	["npc.waterkeeper_orren.greeting"] = "Water hears you talk about it. Speak softly.",
	["npc.waterkeeper_orren.line1"] = "My family has kept this water since the oasis was a lake. Now there is me and the last pond.",
	["npc.waterkeeper_orren.line2"] = "Water does not die. It leaves when people stop caring for it, and comes back when someone calls.",
	["npc.waterkeeper_orren.line3"] = "A grey traveller drank from my well. That night the water in it froze, though the sand burned the feet.",
	["npc.waterkeeper_orren.where"] = "by the jetty in the Dead Oasis",
	["npc.prospector_dragan.name"] = "Dragan the Prospector",
	["npc.prospector_dragan.role"] = "Silver prospector",
	["npc.prospector_dragan.greeting"] = "Mind where you dig. Every hole here belongs to someone.",
	["npc.prospector_dragan.line1"] = "I came from the city for silver with three partners. I am going back alone, and in debt.",
	["npc.prospector_dragan.line2"] = "I count everything: silver, days, promises. Promises are the hardest.",
	["npc.prospector_dragan.line3"] = "The orcs of the camp do not dig. They take what others have dug.",
	["npc.prospector_dragan.where"] = "at the fork of the road to the mine",
	["npc.wyvernhunter_wieslawa.name"] = "Wiesława the Wyvern Hunter",
	["npc.wyvernhunter_wieslawa.role"] = "Wyvern hunter",
	["npc.wyvernhunter_wieslawa.greeting"] = "Keep your head down. Everything that flies here wants to eat you.",
	["npc.wyvernhunter_wieslawa.line1"] = "They pay by the wyvern's head. Honest work, if you live through it.",
	["npc.wyvernhunter_wieslawa.line2"] = "Mirko has hunted with me for ten years. Now he lies in the camp and cannot feel his leg.",
	["npc.wyvernhunter_wieslawa.line3"] = "A wyvern strikes out of the sun. Whoever watches the ground does not watch for long.",
	["npc.wyvernhunter_wieslawa.where"] = "under the rock arch on the Wyvern Crags",
	["npc.tombwarden_ezra.name"] = "Ezra the Tombwarden",
	["npc.tombwarden_ezra.role"] = "Warden of the necropolis",
	["npc.tombwarden_ezra.greeting"] = "Speak softly. They sleep here. They should, at least.",
	["npc.tombwarden_ezra.line1"] = "I am the last warden of the tombs of the Ash Kings. I remember rites nobody performs any more.",
	["npc.tombwarden_ezra.line2"] = "Since the forge burns again in Deepforge, the sand does not sleep. Nor do the dead.",
	["npc.tombwarden_ezra.line3"] = "Forty years I have walked this road. Every stone knows my steps.",
	["npc.tombwarden_ezra.where"] = "before the pyramid in the Desert Tombs",
	["npc.wagoner_bogna.name"] = "Bogna the Wagoner",
	["npc.wagoner_bogna.role"] = "Caravan wagoner",
	["npc.wagoner_bogna.greeting"] = "The caravan has stopped. So have I. Say what you want.",
	["npc.wagoner_bogna.line1"] = "We hauled salt from the Salt Valley to the city. Twenty years on the same road.",
	["npc.wagoner_bogna.line2"] = "Oxen smell a basilisk before people do. Pity people do not listen to oxen.",
	["npc.wagoner_bogna.line3"] = "My husband stands by the pit. Do not ask yet.",
	["npc.wagoner_bogna.where"] = "by the robbed wagons on the Ash Road",
	-- S107: S. Fire in the Cracks
	["quest.side_ash_salve.title"] = "Salve for the Scouts",
	["quest.side_ash_salve.p1"] = "Kesra writes that her people come back from the plains with their hands burnt to the bone. The cracks in the ground spit fire when anyone comes near.",
	["quest.side_ash_salve.p2"] = "This salve cools the skin and closes the wounds. Take her the jar before it is too late for the next one.",
	["quest.side_ash_salve.progress"] = "Take the Ember Salve to Scout Kesra in the Ashen Wastes.",
	["quest.side_ash_salve.done"] = "From Ysolde? May the gods keep her. Two of my people could no longer hold a bow.",
	["quest.side_ash_salve.say.hurry"] = "I will be there soon.",
	["quest.side_ash_salve.say.hurry.reply"] = "Do not run on the ash. The cracks like runners.",
	["quest.side_ash_salve.say.enough"] = "Is there enough for everyone?",
	["quest.side_ash_salve.say.enough.reply"] = "No. Take two potions, you will get burnt too.",
	["quest.side_ash_salve.bark.accept1"] = "Kesra waits by the portals. Hold the jar upright, the salve likes to spill.",
	["quest.side_ash_salve.bark.done1"] = "First time in a month something here smells good.",
	["quest.side_ash_glands.title"] = "Glands and Cairns",
	["quest.side_ash_glands.p1"] = "The salamanders crawl further out of the cracks than ever. Ysolde needs their fire glands for more salve, and I need more salve.",
	["quest.side_ash_glands.p2"] = "I want basalt cairns by the cracks, with a red rag on top. So my people can see from afar where not to step.",
	["quest.side_ash_glands.p3"] = "Three places: by the slabs where the salamanders bask, above the Glowing Pit and under the Ribcage Gate. There is no shortage of stone there.",
	["quest.side_ash_glands.progress"] = "Six fire glands from the salamanders of the Salamander Flats and three cairns by the cracks.",
	["quest.side_ash_glands.done"] = "The cairns stand, the glands are here. Ysolde will be pleased, and my people can finally see where the ground ends.",
	["quest.side_ash_glands.say.rag"] = "Why a red rag?",
	["quest.side_ash_glands.say.rag.reply"] = "The ash is grey, the fire is red, and my people are tired.",
	["quest.side_ash_glands.say.cairns"] = "The cairns first.",
	["quest.side_ash_glands.say.cairns.reply"] = "Good. People walk there today.",
	["quest.side_ash_glands.say.glands"] = "The glands first.",
	["quest.side_ash_glands.say.glands.reply"] = "Good. Just do not leave the cairns long, the cracks do not wait.",
	["quest.side_ash_glands.bark.accept1"] = "The gland is under the jaw. Cut quickly, before it cools.",
	["quest.side_ash_glands.bark.half1"] = "The glands are still warm. Good, keep going.",
	["quest.side_ash_glands.bark.done1"] = "The cairns can be seen from the portals. Come back, I have something more for you.",
	["quest.side_ash_glands.bark.death1"] = "Get up. It caught my people out too, the first time.",
	["quest.side_ash_den.title"] = "The Den under the Skull",
	["quest.side_ash_den.p1"] = "The hyenas from the den under the skull driven into the ash follow the wounded. They keep pace and wait for a man to fall.",
	["quest.side_ash_den.p2"] = "Pitch in the skull's eye sockets will smoke them out of the den. Light it and step back, the smoke bites.",
	["quest.side_ash_den.p3"] = "Twelve hyenas of the Flats and the road from the portals will be quiet. My people will be able to come back alone again.",
	["quest.side_ash_den.progress"] = "Twelve waste hyenas on the Salamander Flats and the pitch lit in the skull over their den.",
	["quest.side_ash_den.done"] = "We could see the smoke from the camp. Take this, you have earned it. The Wastes will remember that someone set things right.",
	["quest.side_ash_den.done.rag"] = "My people call the cairns your rags. A better name than mine. Take this, you have earned it, and the den smokes now instead of howling.",
	["quest.side_ash_den.say.pitch"] = "Pitch in a skull? A strange custom.",
	["quest.side_ash_den.say.pitch.reply"] = "Not a custom. Hyenas cannot stand smoke, and I cannot stand hyenas.",
	["quest.side_ash_den.say.count"] = "How many are there?",
	["quest.side_ash_den.say.count.reply"] = "I saw twelve. Count on more.",
	["quest.side_ash_den.say.smoke"] = "I will smoke them out first.",
	["quest.side_ash_den.say.smoke.reply"] = "Good. Fight in the open, not in the den.",
	["quest.side_ash_den.bark.accept1"] = "The pitch is in the sack. Do not carry it near the cracks.",
	["quest.side_ash_den.bark.half1"] = "They howl less and less. Keep at it.",
	["quest.side_ash_den.bark.near1"] = "Pitch in the sockets and walk away. The smoke bites.",
	["quest.side_ash_den.bark.done1"] = "The den is smoking. Come back before the wind turns.",
	["quest.side_ash_den.bark.death1"] = "The hyenas wait for someone to fall. Do not give them that.",
	-- S107: T. The Last Water
	["quest.side_ash_cask.title"] = "A Cask of Fresh Water",
	["quest.side_ash_cask.p1"] = "A letter came from the burnt oasis. An old man's hand, the letters crooked as branches. He asks for a cask of fresh water, because the last pond stinks of carrion.",
	["quest.side_ash_cask.p2"] = "The cask is heavy, but old Orren has kept that water for ever. Someone has to take it to him, and I will not leave the inn.",
	["quest.side_ash_cask.progress"] = "Take the cask of fresh water to Orren the Wellkeeper by the jetty in the Dead Oasis.",
	["quest.side_ash_cask.done"] = "From Wacław? A good lad, though he pours wine. Put it in the shade, fresh water does not like the sun.",
	["quest.side_ash_cask.say.wine"] = "What if I took wine?",
	["quest.side_ash_cask.say.wine.reply"] = "Orren drinks only water and has ninety years of proof for it.",
	["quest.side_ash_cask.say.who"] = "Who is Orren?",
	["quest.side_ash_cask.say.who.reply"] = "The last one keeping the oasis. Stubborn as that cask.",
	["quest.side_ash_cask.bark.accept1"] = "The cask is tight. See that it stays so.",
	["quest.side_ash_cask.bark.done1"] = "Fresh. I had forgotten how fresh tastes.",
	["quest.side_ash_wells.title"] = "Wells under the Sand",
	["quest.side_ash_wells.p1"] = "The water has gone, but it has not died. It hid under the sand and waits for someone to call it.",
	["quest.side_ash_wells.p2"] = "The ferryman of the boat that stands on the dry bed kept a journal. There was a map of the wells in it, from the days when the oasis was a lake.",
	["quest.side_ash_wells.p3"] = "I will take you to the boat. Then three wells: by the boat, by the jetty and by the caravan graveyard. Dig them out.",
	["quest.side_ash_wells.progress"] = "Walk with Orren to the boat on the dry bed, search it and dig out three wells in the Dead Oasis.",
	["quest.side_ash_wells.done"] = "My father wrote the journal. He knew the wells and kept quiet, afraid I would leave to look for water elsewhere. You dug them out for him.",
	["quest.side_ash_wells.say.dead"] = "That water is dead.",
	["quest.side_ash_wells.say.dead.reply"] = "Water does not die. It goes under the sand when nobody cares for it.",
	["quest.side_ash_wells.say.boat"] = "Where is the boat?",
	["quest.side_ash_wells.say.boat.reply"] = "I will take you. Alone you would search until dark.",
	["quest.side_ash_wells.say.alone"] = "I will go alone.",
	["quest.side_ash_wells.say.alone.reply"] = "Seventy years I have walked this bed. Sitting is the hard part.",
	["quest.side_ash_wells.bark.accept1"] = "Come, while the shadows are long.",
	["quest.side_ash_wells.bark.half1"] = "Father wrote crooked, but he counted the wells right.",
	["quest.side_ash_wells.bark.near1"] = "This was the deep. As a boy I dived for shells and never touched the bottom.",
	["quest.side_ash_wells.bark.done1"] = "Three wells. Do not drink yet, let it settle.",
	["quest.side_ash_wells.bark.stuck1"] = "Look where the sand is darker. Watch your feet, not the sky.",
	["quest.side_ash_wells.comp.join1"] = "Come. I will show you where the water stood.",
	["quest.side_ash_wells.comp.wait1"] = "Do not fall behind. The sand swallows tracks.",
	["quest.side_ash_wells.comp.wait2"] = "I am ninety years old and I walk faster than you.",
	["quest.side_ash_wells.comp.arrive1"] = "My father's mark on the stern. He said a storm took the boat.",
	["quest.side_ash_wells.comp.back1"] = "I lost you. I am going back to the jetty, I will not shout across the desert.",
	["quest.side_ash_seals.title"] = "The Merchants' Seals",
	["quest.side_ash_seals.p1"] = "The vultures carry the merchants' shining seals off the caravan graveyard. I see them from the jetty, flying with them in their beaks.",
	["quest.side_ash_seals.p1.dead"] = "You said the water was dead. It came back. Now it is time for those who died by it. The vultures carry their seals off the caravan graveyard.",
	["quest.side_ash_seals.p2"] = "Every seal is someone's name and some family that does not know where their kin lies. I want to give them back.",
	["quest.side_ash_seals.p3"] = "Hyenas guard the wells you dug out. First them, then the seals.",
	["quest.side_ash_seals.progress"] = "Eight waste hyenas and five merchants' seals from the ash vultures in the Dead Oasis.",
	["quest.side_ash_seals.done"] = "Five houses will learn where to look. This one is dwarven, that runesmith of yours will want to see it. Take this, from me and from the water.",
	["quest.side_ash_seals.say.families"] = "How will you find the families?",
	["quest.side_ash_seals.say.families.reply"] = "A seal is a house's name. Houses remember longer than people.",
	["quest.side_ash_seals.say.wells"] = "Hyenas at the wells?",
	["quest.side_ash_seals.say.wells.reply"] = "At all three. Start with them.",
	["quest.side_ash_seals.bark.accept1"] = "The vultures settle on the wagons. Look for them there.",
	["quest.side_ash_seals.bark.half1"] = "This one is from the Salt Valley. I knew that house.",
	["quest.side_ash_seals.bark.done1"] = "Bring them. I will lay them in the shade, as is right.",
	-- S107: U. Blood and Ash
	["quest.side_ash_rite.title"] = "The Cleansing Rite",
	["quest.side_ash_rite.p1"] = "A cage leaves the smell of fear on the body. The ancestors cannot stand it and will not speak to me.",
	["quest.side_ash_rite.p2"] = "On the stones by the spring one burns herbs, fire bloom from the shore and sulphur. The smoke carries words to the ancestors.",
	["quest.side_ash_rite.p3"] = "Lay the herbs on the stones and bring the fire bloom, and I will hold the rite. Then we will talk about the clan.",
	["quest.side_ash_rite.progress"] = "Herbs laid on the stones by the Hot Spring and four fire blooms for Ghasha the Shaman.",
	["quest.side_ash_rite.done"] = "The smoke rises straight up. The ancestors hear me again. Now I can think of those who stayed in the camp.",
	["quest.side_ash_rite.say.smell"] = "I smell no fear.",
	["quest.side_ash_rite.say.smell.reply"] = "You do not. The ancestors have a better nose than you and a worse temper than me.",
	["quest.side_ash_rite.say.cage"] = "What was it like in the cage?",
	["quest.side_ash_rite.say.cage.reply"] = "I counted the days by the drops from the roof. I will say no more.",
	["quest.side_ash_rite.say.herbs"] = "The fire bloom first.",
	["quest.side_ash_rite.say.herbs.reply"] = "It grows by the cracks and above the spring.",
	["quest.side_ash_rite.bark.accept1"] = "Pick the fire bloom at the root. A flower without a root says nothing.",
	["quest.side_ash_rite.bark.half1"] = "The smoke goes straight. They are listening.",
	["quest.side_ash_rite.bark.done1"] = "Come back to the spring. The ancestors want to see who helped them.",
	["quest.side_ash_drum.title"] = "The War Drum",
	["quest.side_ash_drum.p1"] = "The great drum in the camp beats for the grey men's gold. The young warriors hear nothing else through it.",
	["quest.side_ash_drum.p2"] = "Slash the drum's skin. When it falls silent, perhaps they will hear the old ones.",
	["quest.side_ash_drum.p3"] = "The orcs will defend the drum like a banner. Ten must fall before you get near it.",
	["quest.side_ash_drum.progress"] = "Ten ash orcs and the war drum's skin slashed in the Ash Orc Warcamp.",
	["quest.side_ash_drum.done"] = "I heard the drum lose its beat, then fall silent. In the camp they now argue about who will mend it. Good. Let them argue.",
	["quest.side_ash_drum.say.gold"] = "How much do the grey ones pay?",
	["quest.side_ash_drum.say.gold.reply"] = "Enough that the young stopped hearing the old.",
	["quest.side_ash_drum.say.chief"] = "It would be simpler to kill the chief.",
	["quest.side_ash_drum.say.chief.reply"] = "Simpler. And they would follow the next one who takes the gold.",
	["quest.side_ash_drum.bark.accept1"] = "The drum stands on a dais at the back of the camp. You will hear it.",
	["quest.side_ash_drum.bark.half1"] = "Do you hear? The drum is losing its beat.",
	["quest.side_ash_drum.bark.done1"] = "Silence. For the first time since summer I hear the wind over the camp.",
	["quest.side_ash_drum.bark.death1"] = "Get up. Orcs sing over the fallen. Do not give them the song.",
	["quest.side_ash_fang.title"] = "The Ancestors' Fang",
	["quest.side_ash_fang.p1"] = "The Ancestors' Fang is the clan's talisman. It remembers the names of every chief, from the first.",
	["quest.side_ash_fang.p2"] = "The chief pledged it for axes of cold iron. It lies in his tent like any common thing.",
	["quest.side_ash_fang.p3"] = "Whoever carries the Fang speaks for the clan. The young will follow it, not the gold.",
	["quest.side_ash_fang.p4"] = "I do not want the chief's blood. I only want the clan to have a choice. Bring the Fang, and they will do the rest themselves.",
	["quest.side_ash_fang.progress"] = "Eight ash orcs and the Ancestors' Fang from the chief's tent in the Ash Orc Warcamp.",
	["quest.side_ash_fang.done"] = "They came to the spring at night. Seven of the young, with their mothers' names on their lips. The camp still stands, but not all of it. Take this, you have earned it.",
	["quest.side_ash_fang.done.smell"] = "The ancestors say you smell like one of the clan. It is a compliment. Seven of the young came to the spring at night. The camp still stands, but not all of it. Take this.",
	["quest.side_ash_fang.say.pledge"] = "He pledged a talisman for axes?",
	["quest.side_ash_fang.say.pledge.reply"] = "For cold iron. The Fang remembers chiefs who pledged nothing.",
	["quest.side_ash_fang.say.young"] = "How many of the young will come?",
	["quest.side_ash_fang.say.young.reply"] = "Those who remember their mother's name. That is enough.",
	["quest.side_ash_fang.bark.accept1"] = "Go quietly. The Fang lies where the chief sleeps.",
	["quest.side_ash_fang.bark.half1"] = "The tent stands behind the drum. The one that is silent.",
	["quest.side_ash_fang.bark.done1"] = "You have it? Show it to no one in the camp. Come back.",
	-- S107: V. Silver and Mithril
	["quest.side_ash_silver.title"] = "Dragan's Debts",
	["quest.side_ash_silver.p1"] = "I am counting debts. My partners left families behind, and I left them a promise that the men would come back richer. Only I came back.",
	["quest.side_ash_silver.p2"] = "Silver lies in the rocks of the wastes. The vultures from the dump under the orc camp peck at anyone who digs. Bring six lumps and thin out those birds.",
	["quest.side_ash_silver.progress"] = "Six lumps of silver from the veins of the wastes and eight ash vultures by the Ash Orc Warcamp.",
	["quest.side_ash_silver.done"] = "Six lumps. I counted twice. The widows will get theirs, if not at once.",
	["quest.side_ash_silver.say.debt"] = "How much do you owe?",
	["quest.side_ash_silver.say.debt.reply"] = "Four hundred and twelve silver and three promises. The promises cost more.",
	["quest.side_ash_silver.say.town"] = "Why not go back to the city?",
	["quest.side_ash_silver.say.town.reply"] = "With an empty purse I cannot look the widows in the eye.",
	["quest.side_ash_silver.say.vultures"] = "The vultures first.",
	["quest.side_ash_silver.say.vultures.reply"] = "They peck anyone who digs. Sensible.",
	["quest.side_ash_silver.bark.accept1"] = "Silver veins gleam grey. Do not mistake them for ash.",
	["quest.side_ash_silver.bark.half1"] = "Half. I take it off the debt, not off the shame.",
	["quest.side_ash_silver.bark.done1"] = "Come back with it. Counting is better by the fire.",
	["quest.side_ash_partners.title"] = "The Partners' Tags",
	["quest.side_ash_partners.p1"] = "Three partners went down into the Abandoned Mine ahead of the orcs. Juro, Stach and Benek. None came back.",
	["quest.side_ash_partners.p2"] = "Each wore a tag with his name round his neck. The hyenas that lair in the tunnels swallow anything that shines.",
	["quest.side_ash_partners.p3"] = "Bring the tags. Let the families get something more than my words.",
	["quest.side_ash_partners.progress"] = "Three miners' tags from the waste hyenas (Elites) in the Abandoned Mine.",
	["quest.side_ash_partners.done"] = "Juro, Stach, Benek. Three tags, three houses. I will carry them myself, I owe them that.",
	["quest.side_ash_partners.say.names"] = "What were their names?",
	["quest.side_ash_partners.say.names.reply"] = "Juro, Stach and Benek. Benek was the youngest.",
	["quest.side_ash_partners.say.way"] = "Where is the entrance?",
	["quest.side_ash_partners.say.way.reply"] = "In the northern ridge. I will mark the adit for you.",
	["quest.side_ash_partners.bark.accept1"] = "The mine lies beyond the orc camp, in the ridge. Keep to the road.",
	["quest.side_ash_partners.bark.half1"] = "One. Juro. Always first.",
	["quest.side_ash_partners.bark.done1"] = "You have all three? Come back. Careful in the tunnels.",
	["quest.side_ash_partners.bark.stuck1"] = "The hyenas in the tunnels are bigger. Look for the biggest.",
	["quest.side_ash_columns.title"] = "Under the Columns",
	["quest.side_ash_columns.p1"] = "For years I have dreamt of mithril. Basalt cracks where there is something harder beneath it.",
	["quest.side_ash_columns.p2"] = "In the Golem Fields, under the basalt columns, the columns crack evenly, as if cut with a knife.",
	["quest.side_ash_columns.p3"] = "The golems guard that place. Chip a sample off the cracked column, and I will tell you whether I am still dreaming.",
	["quest.side_ash_columns.progress"] = "Ten fire golems and a sample from the cracked column in the Golem Fields.",
	["quest.side_ash_columns.done"] = "Look at that gleam under the basalt. I am not dreaming. For the first time in twenty years I am not dreaming.",
	["quest.side_ash_columns.say.dream"] = "You dream of mithril?",
	["quest.side_ash_columns.say.dream.reply"] = "For twenty years. In the dream I am always rich and I always wake up.",
	["quest.side_ash_columns.say.sample"] = "The sample first.",
	["quest.side_ash_columns.say.sample.reply"] = "Go ahead. The golems will notice you anyway.",
	["quest.side_ash_columns.bark.accept1"] = "The cracked column stands at the edge of the field. You cannot miss it.",
	["quest.side_ash_columns.bark.half1"] = "The golems fall heavy. The ground booms.",
	["quest.side_ash_columns.bark.done1"] = "Bring the sample. My hands are shaking.",
	["quest.side_ash_claim.title"] = "The Prospector's Stake",
	["quest.side_ash_claim.p1"] = "The sample was good. The mithril lies shallow, right under the crust of basalt.",
	["quest.side_ash_claim.p2"] = "Drive my stake in among the columns and take a few lumps of mithril to Dorgan. The smith will say what it is worth.",
	["quest.side_ash_claim.p3"] = "Part of it goes to my partners' families. I promised them that when I still thought the men would come back.",
	["quest.side_ash_claim.progress"] = "Four lumps of mithril from the Golem Fields, Dragan's stake among the columns and Dorgan the smith in the city.",
	["quest.side_ash_claim.done"] = "Pure mithril. I will give an honest price for it, and set part aside for the partners' families, as Dragan wanted. Take this for your trouble.",
	["quest.side_ash_claim.done.debt"] = "Dragan writes that he has three promises left. You have just paid off two. The mithril is pure, the price will be honest, part goes to the widows. Take this for your trouble.",
	["quest.side_ash_claim.say.share"] = "How much for the families?",
	["quest.side_ash_claim.say.share.reply"] = "Half. I counted three times and it is always too little.",
	["quest.side_ash_claim.say.dorgan"] = "Will Dorgan pay an honest price?",
	["quest.side_ash_claim.say.dorgan.reply"] = "He counts more carefully than I do. That is why I trust him.",
	["quest.side_ash_claim.bark.accept1"] = "Drive the stake deep. The golems like knocking things over.",
	["quest.side_ash_claim.bark.half1"] = "Mithril is heavier than it looks. Do not lose a single lump.",
	["quest.side_ash_claim.bark.done1"] = "Real mithril. I will weigh it twice, there are widows in this.",
	-- S107: W. Names of the Dead
	["quest.side_ash_chimneys.title"] = "The Chimneys",
	["quest.side_ash_chimneys.p1"] = "The houses burned in a single night, the chimneys stayed. On each one the family carved its name when it built it.",
	["quest.side_ash_chimneys.p2"] = "Imps nest in the hearths and howl at night. Drive them out.",
	["quest.side_ash_chimneys.p3"] = "At three chimneys in the alley light a candle and read out the names. I will write them down.",
	["quest.side_ash_chimneys.progress"] = "Ten fire imps and the names on three chimneys in the Burnt Ruins.",
	["quest.side_ash_chimneys.done"] = "Say them once more, slowly. I am writing. Every name is a house where someone laughed.",
	["quest.side_ash_chimneys.say.why"] = "Why write down the names?",
	["quest.side_ash_chimneys.say.why.reply"] = "So that someone says them once more. That is all that is left.",
	["quest.side_ash_chimneys.say.knew"] = "Did you know these people?",
	["quest.side_ash_chimneys.say.knew.reply"] = "I baptised their children. Their names are here too.",
	["quest.side_ash_chimneys.say.imps"] = "The imps first.",
	["quest.side_ash_chimneys.say.imps.reply"] = "Yes. They will not live where people lived.",
	["quest.side_ash_chimneys.bark.accept1"] = "The candles are in the bag. Light them from the embers, not from the imps.",
	["quest.side_ash_chimneys.bark.half1"] = "Say the names aloud. I am writing.",
	["quest.side_ash_chimneys.bark.near1"] = "Light a candle before you read. That is how we did it at funerals.",
	["quest.side_ash_chimneys.bark.done1"] = "Come back. I want to write them down before the wind wears off the rest.",
	["quest.side_ash_heirlooms.title"] = "Keepsakes in the Fountain",
	["quest.side_ash_heirlooms.p1"] = "When the fire came, people threw what they treasured most into the fountain. They believed the water would save it.",
	["quest.side_ash_heirlooms.p2"] = "Today the fountain is full of embers. Rake them out. Something may be left beneath.",
	["quest.side_ash_heirlooms.p3"] = "The scorpions dragged the rest of the keepsakes into their nests under the eastern drifts. Bring as many as you can.",
	["quest.side_ash_heirlooms.progress"] = "The embers raked out of the dry fountain and five family keepsakes from the desert scorpions in the Burnt Ruins.",
	["quest.side_ash_heirlooms.done"] = "A ring, a little bell, a bone comb. I will put each thing next to a name. Some of them I know.",
	["quest.side_ash_heirlooms.say.water"] = "The fountain saved no one.",
	["quest.side_ash_heirlooms.say.water.reply"] = "No. But they believed to the end. Respect that.",
	["quest.side_ash_heirlooms.say.drifts"] = "The nests first.",
	["quest.side_ash_heirlooms.say.drifts.reply"] = "The eastern drifts. Mind the tails.",
	["quest.side_ash_heirlooms.bark.accept1"] = "The fountain's embers have smouldered since that night. Use a shovel.",
	["quest.side_ash_heirlooms.bark.half1"] = "Carefully with them. That is all that is left of them.",
	["quest.side_ash_heirlooms.bark.done1"] = "Bring them. I will lay them on the temple's threshold.",
	["quest.side_ash_names.title"] = "Brother Kaspar's List",
	["quest.side_ash_names.p1"] = "The list is ready. The dead, and those taken to the Forge. By the second I write taken, not dead.",
	["quest.side_ash_names.p2"] = "Brother Anzelm will read the names at the altar of the temple in the city. Perhaps the families will learn of it.",
	["quest.side_ash_names.p2.why"] = "You asked why the names. There are two hundred and seven. Brother Anzelm will read them at the altar in the city, and someone will finally say them.",
	["quest.side_ash_names.p3"] = "The scorpions by the road first. I do not want you to die with the list at your belt.",
	["quest.side_ash_names.progress"] = "Eight desert scorpions in the Burnt Ruins and Brother Kaspar's list for Brother Anzelm in the city.",
	["quest.side_ash_names.done"] = "Two hundred and seven names. I will read them on the next holy day, each one apart. I promise nothing about the taken, but I will remember them. Take this, with a blessing.",
	["quest.side_ash_names.say.forge"] = "Are those taken to the Forge alive?",
	["quest.side_ash_names.say.forge.reply"] = "I do not know. That is why I write taken, not dead.",
	["quest.side_ash_names.say.anzelm"] = "Will Anzelm read it?",
	["quest.side_ash_names.say.anzelm.reply"] = "He will. He has the voice for names, I only have the pen.",
	["quest.side_ash_names.bark.accept1"] = "The list is in a leather case. Do not get it wet.",
	["quest.side_ash_names.bark.half1"] = "The list matters more than haste.",
	["quest.side_ash_names.bark.done1"] = "I will read them. Each one apart.",
	-- S107: X. The Crag Hunt
	["quest.side_ash_lookout.title"] = "The Wyvern Trail",
	["quest.side_ash_lookout.p1"] = "The wyverns fly low and bold, as if something were driving them out of the Lair.",
	["quest.side_ash_lookout.p2"] = "Ten heads means a bounty and quiet on the road. We will share, as is proper.",
	["quest.side_ash_lookout.p3"] = "By the Stone Wyvern mark the trail they fly. My people will know where to set the nets.",
	["quest.side_ash_lookout.progress"] = "Ten wyverns on the Wyvern Crags and the trail marked by the Stone Wyvern.",
	["quest.side_ash_lookout.done"] = "Ten heads and the trail as plain as day. Wyverns come back the same way, the dumb beasts. Now I have them.",
	["quest.side_ash_lookout.say.bold"] = "Bold?",
	["quest.side_ash_lookout.say.bold.reply"] = "Yesterday one stole my dinner. Out of my hand.",
	["quest.side_ash_lookout.say.driven"] = "What drives them out of the Lair?",
	["quest.side_ash_lookout.say.driven.reply"] = "Something a wyvern fears. I do not want to meet it.",
	["quest.side_ash_lookout.say.mark"] = "The trail first.",
	["quest.side_ash_lookout.say.mark.reply"] = "By the Stone Wyvern. You will not miss it.",
	["quest.side_ash_lookout.bark.accept1"] = "Aim for the wings. A wyvern on the ground is just a big lizard.",
	["quest.side_ash_lookout.bark.half1"] = "They fly low. All the easier to count.",
	["quest.side_ash_lookout.bark.done1"] = "Come back. Mirko will want to hear about every one.",
	["quest.side_ash_lookout.bark.death1"] = "A wyvern strikes out of the sun. Look up.",
	["quest.side_ash_eyes.title"] = "Basilisk Eyes",
	["quest.side_ash_eyes.p1"] = "Mirko lies in the camp with his leg turned to stone up to the knee, and the stone is climbing. A finger higher every morning.",
	["quest.side_ash_eyes.p2"] = "Ysolde in the city knows how to brew a draught against stone, if she gets basilisk eyes.",
	["quest.side_ash_eyes.p3"] = "Take her four. I cannot leave Mirko.",
	["quest.side_ash_eyes.progress"] = "Four basilisk eyes from the Wyvern Crags for Ysolde the alchemist in the city.",
	["quest.side_ash_eyes.done"] = "Basilisk eyes, fresh. The draught will take a moment. Come back to me before the stone climbs further.",
	["quest.side_ash_eyes.say.mirko"] = "How is Mirko holding up?",
	["quest.side_ash_eyes.say.mirko.reply"] = "He asks about the weather. He cannot ask about anything else.",
	["quest.side_ash_eyes.say.road"] = "It is a long way to the city.",
	["quest.side_ash_eyes.say.road.reply"] = "Take these for the road.",
	["quest.side_ash_eyes.bark.accept1"] = "Do not look a basilisk in the eye while it still has them.",
	["quest.side_ash_eyes.bark.half1"] = "Two. Do not lose them.",
	["quest.side_ash_eyes.bark.done1"] = "Four. Enough for one draught, if nothing boils over.",
	["quest.side_ash_nest.title"] = "The Draught and the Nest",
	["quest.side_ash_nest.p1"] = "The draught is ready. It has to get there before the stone reaches the heart.",
	["quest.side_ash_nest.p2"] = "Wiesława asked for one more thing: the great nest on the rock table, where the young fly from. As long as it stands, the wyverns will keep coming back.",
	["quest.side_ash_nest.p3"] = "Take the draught and burn the nest. In that order, if you want my advice.",
	["quest.side_ash_nest.progress"] = "The Draught against Stone for Wiesława the Wyvern Hunter and the nest on the rock table of the Wyvern Crags burnt.",
	["quest.side_ash_nest.done"] = "Mirko moved his toes. He limps and will keep limping, but he lives. And the nest burns so that you can see it from the city. Take this, you have earned it.",
	["quest.side_ash_nest.done.driven"] = "I still do not know what drives them out. But Mirko lives, moves his toes and swears as he used to. The nest is burning. Take this, you have earned it.",
	["quest.side_ash_nest.say.draught"] = "The draught first.",
	["quest.side_ash_nest.say.draught.reply"] = "Yes. The stone does not wait.",
	["quest.side_ash_nest.say.nest"] = "The nest first.",
	["quest.side_ash_nest.say.nest.reply"] = "Wiesława asked for both. The order is yours, the time is not.",
	["quest.side_ash_nest.bark.accept1"] = "Keep the draught warm. Cold, it will not work.",
	["quest.side_ash_nest.bark.half1"] = "Half done. The stone is not standing still either.",
	["quest.side_ash_nest.bark.near1"] = "The young are squealing. Do not look, just set it alight.",
	["quest.side_ash_nest.bark.done1"] = "I can hear it crackle. Come back, Mirko wants to thank you.",
	-- S107: Y. The Sleep of Kings
	["quest.side_ash_king.title"] = "The Buried King",
	["quest.side_ash_king.p1"] = "The sand is moving, and the dead of the Ash Kings walk the dunes. They seek something they cannot find.",
	["quest.side_ash_king.p2"] = "The eldest of them, the Buried King, rises from a dune: his head and one hand. That is where the path of the dead begins.",
	["quest.side_ash_king.p3"] = "I will lead you by the road. Then lay to sleep those who have risen.",
	["quest.side_ash_king.progress"] = "Walk with Ezra the Tombwarden to the Buried King and lay twelve desert mummies to rest on the Scorpion Dunes.",
	["quest.side_ash_king.done"] = "They sleep. For now. The path of the dead is quiet for the first time in months, but the sand still moves.",
	["quest.side_ash_king.say.faces"] = "What are the dead looking for?",
	["quest.side_ash_king.say.faces.reply"] = "Their faces. Without their masks they do not know who they were.",
	["quest.side_ash_king.say.legs"] = "Can you walk up to the dunes?",
	["quest.side_ash_king.say.legs.reply"] = "I have walked there for forty years. Slowly, but straight.",
	["quest.side_ash_king.say.lead"] = "Lead the way.",
	["quest.side_ash_king.say.lead.reply"] = "Follow me. The sand remembers the old paths, and so do I.",
	["quest.side_ash_king.bark.accept1"] = "By the road, not through the courtyards.",
	["quest.side_ash_king.bark.half1"] = "They lie down. The sand takes them back.",
	["quest.side_ash_king.bark.near1"] = "There. The head and the hand. The rest of the king sleeps deeper.",
	["quest.side_ash_king.bark.done1"] = "They sleep. For now.",
	["quest.side_ash_king.bark.death1"] = "Get up. Here no one may lie without a name.",
	["quest.side_ash_king.comp.join1"] = "Let us go by the road. The dead will not let even me through the courtyards.",
	["quest.side_ash_king.comp.wait1"] = "I cannot go faster and must not go slower. Come.",
	["quest.side_ash_king.comp.arrive1"] = "Their path begins here. I will stay by the king.",
	["quest.side_ash_king.comp.back1"] = "I lost you. I will wait by the pyramid.",
	["quest.side_ash_wards.title"] = "Runes of Sleep",
	["quest.side_ash_wards.p1"] = "The wind laid the sarcophagi bare, and the runes of sleep on their lids have worn down to smooth stone.",
	["quest.side_ash_wards.p1.legs"] = "We got there together. From here you go alone, my legs stayed on the dunes. The wind laid the sarcophagi bare, and the runes of sleep on their lids have worn smooth.",
	["quest.side_ash_wards.p2"] = "I will show you the sign. Renew it on three lids, carefully, stroke by stroke.",
	["quest.side_ash_wards.p3"] = "Scorpions nest in the cracks of the sarcophagi. Drive them out before you begin.",
	["quest.side_ash_wards.progress"] = "The runes of sleep renewed on three sarcophagi and eight desert scorpions on the Scorpion Dunes.",
	["quest.side_ash_wards.done"] = "The runes glow. Those three will sleep in peace. Many are left, but one has to begin somewhere.",
	["quest.side_ash_wards.say.sign"] = "Show me the sign once more.",
	["quest.side_ash_wards.say.sign.reply"] = "Three strokes and a closed eye. The eye always closed.",
	["quest.side_ash_wards.say.scorp"] = "The scorpions first.",
	["quest.side_ash_wards.say.scorp.reply"] = "They sit in the cracks of the lids. Drive them out.",
	["quest.side_ash_wards.bark.accept1"] = "Draw slowly. A rune written in haste does not hold.",
	["quest.side_ash_wards.bark.half1"] = "Good. The stone takes the sign.",
	["quest.side_ash_wards.bark.done1"] = "They sleep more quietly. Come back, do not stay there after dark.",
	["quest.side_ash_altar.title"] = "Incense on the Altar",
	["quest.side_ash_altar.p1"] = "On the altar of the east courtyard incense burned for the kings for three hundred years. It went out when the last priest died.",
	["quest.side_ash_altar.p2"] = "I no longer have the strength to go down into the courtyard where the mummies walk. Once I went down every day.",
	["quest.side_ash_altar.p3"] = "Light the incense. The mummies that smell the smoke will go back to their graves or fall.",
	["quest.side_ash_altar.progress"] = "Ten desert mummies in the Desert Tombs and the incense lit on the altar of the east courtyard.",
	["quest.side_ash_altar.done"] = "I can smell that smoke from here. It smells as it did the day I came to learn. Thank you.",
	["quest.side_ash_altar.say.priest"] = "Who was the last priest?",
	["quest.side_ash_altar.say.priest.reply"] = "My teacher. The incense went out the night he died.",
	["quest.side_ash_altar.say.potions"] = "The courtyard is full of mummies.",
	["quest.side_ash_altar.say.potions.reply"] = "Take the potions. I have no more need of them.",
	["quest.side_ash_altar.bark.accept1"] = "The incense is in a clay pot. Light it from embers, not from a flame.",
	["quest.side_ash_altar.bark.half1"] = "I hear them fall. Careful at the altar.",
	["quest.side_ash_altar.bark.done1"] = "The smoke drifts over the courtyard. Come back.",
	["quest.side_ash_masks.title"] = "The Masks of the Kings",
	["quest.side_ash_masks.p1"] = "Grave robbers tore the funeral masks from the kings. Without faces the dead cannot find their way to sleep.",
	["quest.side_ash_masks.p2"] = "The mummies that took them back carry them and defend them like the life they no longer have.",
	["quest.side_ash_masks.p3"] = "Three masks and the pyramid's doors. You will seal them with your hand, I will say the words.",
	["quest.side_ash_masks.p4"] = "Since the forge in the east burns again, the sand does not sleep. Perhaps after this night it will sleep a little.",
	["quest.side_ash_masks.p4.faces"] = "You asked what the dead are looking for. Now you know: themselves. Since the forge in the east burns again, the sand does not sleep. Perhaps after this night it will sleep a little.",
	["quest.side_ash_masks.progress"] = "Three funeral masks from the desert mummies in the Desert Tombs and the pyramid's doors sealed.",
	["quest.side_ash_masks.done"] = "The doors closed, the masks in their places. They all sleep, for the first time in years. Take a gift from the wardens' treasury, no one deserves it more.",
	["quest.side_ash_masks.say.door"] = "Why with my hand?",
	["quest.side_ash_masks.say.door.reply"] = "Because mine shakes. The doors do not like that.",
	["quest.side_ash_masks.say.after"] = "What then?",
	["quest.side_ash_masks.say.after.reply"] = "Then I keep watch, as before. That is what I am for.",
	["quest.side_ash_masks.bark.accept1"] = "The masks are light, but not for them. Do not hurry.",
	["quest.side_ash_masks.bark.half1"] = "The second mask. This king had a narrow face.",
	["quest.side_ash_masks.bark.done1"] = "The doors are waiting. Lay your hand on them, I will say the rest.",
	-- S107: Z. The Salt Caravans
	["quest.side_ash_wagons.title"] = "The Broken Wagons",
	["quest.side_ash_wagons.p1"] = "Salt, cloth and tools lie in the broken wagons, and basilisks walk among them as if they owned them.",
	["quest.side_ash_wagons.p2"] = "Search the three wagons. What can be saved goes to the city, the rest the wastes can keep.",
	["quest.side_ash_wagons.p3"] = "Ten basilisks by the road before the next caravan comes through. The wagoners will not drive while those things roam here.",
	["quest.side_ash_wagons.progress"] = "Three robbed wagons searched and ten basilisks on the Ash Road.",
	["quest.side_ash_wagons.done"] = "Enough for the caravan to move on. Less than there was, more than I thought.",
	["quest.side_ash_wagons.say.oxen"] = "Did the oxen live?",
	["quest.side_ash_wagons.say.oxen.reply"] = "Two. They ran first. Wiser than the wagoners.",
	["quest.side_ash_wagons.say.husband"] = "Where is your husband?",
	["quest.side_ash_wagons.say.husband.reply"] = "By the pit. Standing. Later.",
	["quest.side_ash_wagons.say.basilisks"] = "The basilisks first.",
	["quest.side_ash_wagons.say.basilisks.reply"] = "Good. The wagons will not run away.",
	["quest.side_ash_wagons.bark.accept1"] = "Do not look the basilisks in the eye. Watch their legs.",
	["quest.side_ash_wagons.bark.half1"] = "The salt is whole. The cloth is not.",
	["quest.side_ash_wagons.bark.done1"] = "Come back. The wagons will not harness themselves.",
	["quest.side_ash_avenue.title"] = "The Toll Coins",
	["quest.side_ash_avenue.p1"] = "The wyverns carry the shining toll coins to their nests by the Avenue of Kings. I saw one snatch a whole purse.",
	["quest.side_ash_avenue.p2"] = "That is the caravan's money and the wagoners' pay. Go to the Avenue and recover five coins, the rest we will count as lost.",
	["quest.side_ash_avenue.progress"] = "The Avenue of Kings on the Ash Road and five toll coins from the wyverns.",
	["quest.side_ash_avenue.done"] = "Five coins. The wagoners will get one each and complain it is too little. That is a good sign, people complain when they are alive.",
	["quest.side_ash_avenue.say.kings"] = "Who were these kings?",
	["quest.side_ash_avenue.say.kings.reply"] = "I do not know. The wagoners call them grandfathers and bow as they pass.",
	["quest.side_ash_avenue.say.toll"] = "Toll to whom?",
	["quest.side_ash_avenue.say.toll.reply"] = "Once to the kings. Now to the wyverns.",
	["quest.side_ash_avenue.bark.accept1"] = "The Avenue lies west of the wagons. You will see the statues from afar.",
	["quest.side_ash_avenue.bark.half1"] = "I hear them clink. A few more.",
	["quest.side_ash_avenue.bark.done1"] = "Five. Come back before the wyverns count theirs.",
	["quest.side_ash_mirror.title"] = "The Shield at the Pit",
	["quest.side_ash_mirror.p1"] = "The old faith of the wagoners says that a basilisk that sees its own eyes goes away and does not come back.",
	["quest.side_ash_mirror.p2"] = "I have my husband's polished shield. Set it up by the pit, its face turned inward.",
	["quest.side_ash_mirror.p3"] = "My husband stands in stone by that pit. That cannot be undone. But no one else will end like that.",
	["quest.side_ash_mirror.progress"] = "Twelve basilisks on the Ash Road and the shield set up by the basilisk's pit.",
	["quest.side_ash_mirror.done"] = "I left a handful of salt by him. Wagoners do that when someone stays by the road. Take this, and may the road lead you.",
	["quest.side_ash_mirror.done.husband"] = "I said: later. Now. I left him salt, so he would know we made it. Take this, and may the road lead you.",
	["quest.side_ash_mirror.say.shield"] = "Is that your husband's shield?",
	["quest.side_ash_mirror.say.shield.reply"] = "He polished it every evening. He said it would be useful some day.",
	["quest.side_ash_mirror.say.faith"] = "Do you believe it?",
	["quest.side_ash_mirror.say.faith.reply"] = "I believe no one else will stand by that pit like that.",
	["quest.side_ash_mirror.bark.accept1"] = "The shield is heavy. Carry it with its face to you.",
	["quest.side_ash_mirror.bark.half1"] = "Fewer and fewer of them. The pit grows quiet.",
	["quest.side_ash_mirror.bark.near1"] = "The shield's face to the pit. Do not look into it yourself.",
	["quest.side_ash_mirror.bark.done1"] = "Is it standing? Good. Come back, I will go to him alone.",
	-- S108: side quests of the Frost Peaks (eight arcs fp_*, docs/DESIGN-15.md §3.4) ---------------------------------
