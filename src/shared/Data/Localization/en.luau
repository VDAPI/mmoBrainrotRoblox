	-- Skills (DESIGN §14)
	["skill.mightyStrike.name"] = "Mighty Strike",
	["skill.mightyStrike.desc"] = "A heavy blow dealing {dmg}% of physical attack.",
	["skill.battleCry.name"] = "Battle Cry",
	["skill.battleCry.desc"] = "Raises your physical attack by {atk}% for {statBuffDuration} s.",
	["skill.charge.name"] = "Charge",
	["skill.charge.desc"] = "Rush at a target up to {range} studs away, dealing {dmg}% and stunning for {stunDuration} s.",
	["skill.bladeWhirl.name"] = "Blade Whirl",
	["skill.bladeWhirl.desc"] = "Two spins with the blade: {hits} blows of {dmg}% to every enemy within {radius} studs.",
	["skill.steelSkin.name"] = "Steel Skin",
	["skill.steelSkin.desc"] = "Passive: +{armor}% armor.",
	["skill.cleave.name"] = "Cleave",
	["skill.cleave.desc"] = "Hits enemies in a cone for {dmg}% and makes them bleed for {bleed}% over {bleedDuration} s.",
	["skill.taunt.name"] = "Taunt",
	["skill.taunt.desc"] = "Monsters within {radius} studs attack you for {tauntDuration} s; +{armor}% armor meanwhile.",
	["skill.fortitude.name"] = "Fortitude",
	["skill.fortitude.desc"] = "Passive: +{hp}% maximum health.",
	["skill.earthquake.name"] = "Earthquake",
	["skill.earthquake.desc"] = "Shakes the ground around you for {dmg}% and slows enemies by {slow}% for {slowDuration} s.",
	["skill.bloodlust.name"] = "Bloodlust",
	["skill.bloodlust.desc"] = "+{speed}% attack speed and +{lifesteal}% life steal for {statBuffDuration} s.",
	["skill.riposte.name"] = "Riposte",
	["skill.riposte.desc"] = "Passive: {chance}% chance to counter with a basic attack after every regular attack on you, even a blocked or dodged one.",
	["skill.crushingBlow.name"] = "Crushing Blow",
	["skill.crushingBlow.desc"] = "Deals {dmg}% and lowers the target's armor by {armorBreak}% for {armorBreakDuration} s.",
	["skill.lastBastion.name"] = "Last Bastion",
	["skill.lastBastion.desc"] = "Take {reduction}% less damage for {damageReductionDuration} s.",
	["skill.titansWrath.name"] = "Titan's Wrath",
	["skill.titansWrath.desc"] = "Strike the ground {hits} times, each hit dealing {dmg}% to enemies within {radius} studs.",
	-- S74: Warrior path skills (ROZWOJ 10.3-10.5)
	["skill.intercept.name"] = "Intercept",
	["skill.intercept.desc"] = "Leap to an ally within {range} studs and for {interceptDuration} s take {share}% of every monster blow aimed at them, red zones included. With no ally selected you pick one standing in a red zone, then the most wounded; with nobody near you take {guard}% less damage for {damageReductionDuration} s.",
	["skill.shieldWall.name"] = "Shield Wall",
	["skill.shieldWall.desc"] = "You drive your shield into the ground: for {interceptDuration} s you take {share}% of monster blows aimed at allies within {radius} studs (at most 25% of your maximum health per second), you take {reduction}% less damage, and enemies within {hitRadius} studs are taunted for {tauntDuration} s.",
	["skill.rend.name"] = "Rend",
	["skill.rend.desc"] = "A blow dealing {dmg}% of physical attack and a bleed of {bleed}% of attack over {bleedDuration} s. Consumes all Fury: +{furyDmg}% hit damage per stack.",
	["skill.carnage.name"] = "Carnage",
	["skill.carnage.desc"] = "You consume all Fury: +{perFury}% physical attack per stack for {carnageDuration} s. Meanwhile Fury does not decay and grows by 2 per hit, and every kill resets Charge and Blade Whirl.",
	["skill.warBanner.name"] = "War Banner",
	["skill.warBanner.desc"] = "You plant a banner up to {range} studs away for {duration} s. Every second allies within {radius} studs, you included, gain +{haste}% attack speed. The banner falls if you die.",
	["skill.advanceOrder.name"] = "Order to Advance",
	["skill.advanceOrder.desc"] = "You give the order and strike the ground: enemies within {hitRadius} studs take {dmg}% of physical attack, and allies within {radius} studs, you included, gain +{crit} percentage points of critical chance for {statBuffDuration} s.",
	["skill.aimedShot.name"] = "Aimed Shot",
	["skill.aimedShot.desc"] = "A precise arrow dealing {dmg}%.",
	["skill.doubleShot.name"] = "Double Shot",
	["skill.doubleShot.desc"] = "Two arrows, {dmg}% each.",
	["skill.disengage.name"] = "Disengage",
	["skill.disengage.desc"] = "Leap {length} studs back; your next shot deals +{bonus}%.",
	["skill.arrowRain.name"] = "Arrow Rain",
	["skill.arrowRain.desc"] = "{hits} waves of arrows on an area of {radius} studs, {dmg}% each.",
	["skill.hawkEye.name"] = "Hawk Eye",
	["skill.hawkEye.desc"] = "Passive: +{crit}% critical chance and +{critDmg}% critical damage.",
	["skill.venomArrow.name"] = "Venom Arrow",
	["skill.venomArrow.desc"] = "Deals {dmg}% and poisons for {poison}% over {poisonDuration} s.",
	["skill.frostTrap.name"] = "Frost Trap",
	["skill.frostTrap.desc"] = "Places a trap that roots enemies within {radius} studs for {rootDuration} s.",
	["skill.agility.name"] = "Agility",
	["skill.agility.desc"] = "Passive: +{dodge}% dodge and +{move}% movement speed.",
	["skill.piercingArrow.name"] = "Piercing Arrow",
	["skill.piercingArrow.desc"] = "An arrow that hits everything in a {length}-stud line for {dmg}%.",
	["skill.huntersMark.name"] = "Hunter's Mark",
	["skill.huntersMark.desc"] = "The target takes +{vuln}% damage for {vulnerabilityDuration} s.",
	["skill.predatorInstinct.name"] = "Predator Instinct",
	["skill.predatorInstinct.desc"] = "Passive: +{speed}% attack speed.",
	["skill.volley.name"] = "Volley",
	["skill.volley.desc"] = "{hits} arrows into a cone, {dmg}% each.",
	["skill.camouflage.name"] = "Camouflage",
	["skill.camouflage.desc"] = "Monsters lose track of you for {camouflageDuration} s; your next shot is a guaranteed critical hit.",
	["skill.stormArrow.name"] = "Storm Arrow",
	["skill.stormArrow.desc"] = "Deals {dmg}% to the target and {splash}% to enemies within {radius} studs.",
	-- S77: Hunter path skills (ROZWOJ 11.3-11.5)
	["skill.drawBead.name"] = "Draw a Bead",
	["skill.drawBead.desc"] = "You draw a bead on the target for {sightedDuration} s: your hits on it gain +{crit}% critical chance and +{critDmg}% critical damage. Only your own hits benefit.",
	["skill.heartseeker.name"] = "Heartseeker",
	["skill.heartseeker.desc"] = "You aim for {castTime} s, standing still, then loose an arrow for {dmg}%. A target below {finisherHp}% health takes ×{finisherMul}. Moving cancels the aim and refunds energy and cooldown; damage does not cancel it.",
	["skill.venomSnare.name"] = "Venom Snare",
	["skill.venomSnare.desc"] = "You throw a snare up to {range} studs. It waits {duration} s; the first enemy within {radius} studs springs it. Those caught take {dmg}%, poison for {poison}% over {poisonDuration} s and are slowed by {slow}% for {slowDuration} s.",
	["skill.snarefield.name"] = "Snarefield",
	["skill.snarefield.desc"] = "You set {hits} snares in a ring of {ringRadius} studs around a point up to {range} studs away. Each waits {duration} s and catches enemies within {radius} studs: {dmg}%, +{vuln}% damage taken for {vulnerabilityDuration} s and a root for {rootDuration} s (bosses are not rooted).",
	["skill.falcon.name"] = "Falcon",
	["skill.falcon.desc"] = "You release your falcon for {duration} s. Every {interval} s it strikes your target within {range} studs or, without one, the nearest enemy your party is fighting within {radius} studs, for {dmg}%. It is support from the air: it cannot be hit and draws no attention.",
	["skill.drive.name"] = "The Drive",
	["skill.drive.desc"] = "You drive the quarry: enemies within {pullRadius} studs of the point are pulled to its centre, and everyone within {radius} studs takes {dmg}%, is slowed by {slow}% for {slowDuration} s and takes +{vuln}% damage for {vulnerabilityDuration} s.",
	["skill.firebolt.name"] = "Arcane Bolt",
	["skill.firebolt.desc"] = "A bolt of magic dealing {dmg}% of magic attack. Takes the weapon's element: fire burns, ice slows, lightning arcs to an enemy nearby.",
	["skill.iceShard.name"] = "Ice Shard",
	["skill.iceShard.desc"] = "Deals {dmg}% and slows by {slow}% for {slowDuration} s.",
	["skill.blink.name"] = "Blink",
	["skill.blink.desc"] = "Teleport {length} studs in the direction you are moving.",
	["skill.fireball.name"] = "Fireball",
	["skill.fireball.desc"] = "Explodes for {dmg}% within {radius} studs of the point.",
	["skill.focus.name"] = "Focus",
	["skill.focus.desc"] = "Passive: +{reserve}% mana reserve. Enlarges your mana pool without speeding up its regeneration.",
	["skill.chainLightning.name"] = "Chain Lightning",
	["skill.chainLightning.desc"] = "Lightning jumps between up to {jumps} enemies, {dmg}% (-10% per jump).",
	["skill.manaShield.name"] = "Mana Shield",
	["skill.manaShield.desc"] = "For {duration} s, 50% of damage taken drains mana instead of health.",
	["skill.elementalist.name"] = "Elementalist",
	["skill.elementalist.desc"] = "Passive: +{bonus}% elemental damage.",
	["skill.frostNova.name"] = "Frost Nova",
	["skill.frostNova.desc"] = "Deals {dmg}% around you and freezes enemies for {freezeDuration} s.",
	["skill.meteor.name"] = "Meteor",
	["skill.meteor.desc"] = "After a short delay a meteor hits the area for {dmg}%.",
	["skill.arcaneMind.name"] = "Arcane Mind",
	["skill.arcaneMind.desc"] = "Passive: +{crit} percentage points of critical chance and +{critDmg} percentage points of critical damage.",
	["skill.firewall.name"] = "Thunderstorm",
	["skill.firewall.desc"] = "A storm in a {radius}-stud circle: every 0.5 s lightning strikes a random enemy for {dmg}% for 5 s.",
	["skill.evocation.name"] = "Evocation",
	["skill.evocation.desc"] = "Channel for {duration} s to restore {mana}% of your maximum mana. Taking damage, moving or casting anything else interrupts it.",
	["skill.meteorStorm.name"] = "Elemental Fury",
	["skill.meteorStorm.desc"] = "{hits} strikes of the weapon's element fall on random spots inside a {radius}-stud circle, {dmg}% each in its own small area (fire: meteors, ice: ice spikes, lightning: bolts).",
	["skill.elementalVortex.name"] = "Elemental Vortex",
	["skill.elementalVortex.desc"] = "A vortex of your weapon's element circles around you: {hits} waves every 0.4 s, each dealing {dmg}% of magic attack to enemies within {radius} studs. The vortex follows you and does not stop you from casting other spells. The weapon's element adds its effect.",
	["skill.cataclysm.name"] = "Cataclysm",
	["skill.cataclysm.desc"] = "Pulls enemies within a circle of {radius} studs to its centre (bosses are immune), then {hits} waves every 0.6 s deal {dmg}% of magic attack to them. The weapon's element adds its effect.",
	["skill.arcaneDischarge.name"] = "Arcane Discharge",
	["skill.arcaneDischarge.desc"] = "A bolt of pure magic dealing {dmg}% of magic attack. Consumes all Arcane Charges: +{perCharge}% damage for each. Charges raise its cost too.",
	["skill.arcaneTorrent.name"] = "Arcane Torrent",
	["skill.arcaneTorrent.desc"] = "A ray of pure magic on one target up to {range} studs for {duration} s: {ticks} ticks of {dmg}% of magic attack, each {growth}% stronger than the last. Every tick drains {drain}% of max mana. Damage does not break it; it ends when you are stunned, knocked back, move, cast another spell, run out of mana, or the target dies or gets away.",
	["skill.holyStrike.name"] = "Holy Strike",
	["skill.holyStrike.desc"] = "Strikes with light for {dmg}% of magic attack.",
	["skill.heal.name"] = "Heal",
	["skill.heal.desc"] = "Heals you or an ally for {healHp}% of their max health + {healMag}% of magic attack.",
	["skill.renew.name"] = "Renew",
	["skill.renew.desc"] = "Heals {healHp}% of the target's max health + {healMag}% of magic attack over {duration} s.",
	["skill.radiance.name"] = "Radiance",
	["skill.radiance.desc"] = "Deals {dmg}% to enemies within {radius} studs and heals allies for {heal}% of that.",
	["skill.devotion.name"] = "Devotion",
	["skill.devotion.desc"] = "Passive: +{heal}% healing done.",
	["skill.circleOfLight.name"] = "Circle of Light",
	["skill.circleOfLight.desc"] = "Heals your party within {radius} studs for {healHp}% of each member's max health + {healMag}% of magic attack.",
	["skill.purify.name"] = "Purify",
	["skill.purify.desc"] = "Removes harmful effects and heals for {healHp}% of the target's max health + {healMag}% of magic attack.",
	["skill.auraOfEndurance.name"] = "Aura of Endurance",
	["skill.auraOfEndurance.desc"] = "Your party within {radius} studs gets +{hp}% maximum health for {duration} s.",
	["skill.resurrection.name"] = "Resurrection",
	["skill.resurrection.desc"] = "Revives a fallen ally with {hp}% health, skipping the respawn timer.",
	["skill.shieldOfFaith.name"] = "Shield of Faith",
	["skill.shieldOfFaith.desc"] = "A shield absorbing {shieldHp}% of the target's max health + {shieldMag}% of magic attack for {duration} s.",
	["skill.divineWrath.name"] = "Divine Wrath",
	["skill.divineWrath.desc"] = "Passive: +{bonus}% holy damage; Holy Strike heals you for {bonus}% of the damage.",
	["skill.judgement.name"] = "Judgement",
	["skill.judgement.desc"] = "Deals {dmg}% and stuns for {stunDuration} s.",
	["skill.prayer.name"] = "Prayer",
	["skill.prayer.desc"] = "Channel for {duration} s: restores {mana}% of your mana and {group}% to your party.",
	["skill.divineIntervention.name"] = "Divine Intervention",
	["skill.divineIntervention.desc"] = "Your party within {radius} studs becomes invulnerable for {invulnDuration} s and heals {heal}% health.",
	["skill.sanctuary.name"] = "Sanctuary",
	["skill.sanctuary.desc"] = "Consecrates a {radius}-stud circle at the chosen spot for {duration} s: every second allies inside recover {healHp}% of max health and {healMag}% of magic attack.",
	["skill.guardianAngel.name"] = "Guardian Angel",
	["skill.guardianAngel.desc"] = "Allies within {radius} studs are watched over for {guardianAngelDuration} s: the first lethal blow from a monster leaves them at 1 health and heals {saveHeal}% of max health. Does not protect against players.",
	["skill.fortuneDice.name"] = "Roll of the Dice",
	["skill.fortuneDice.desc"] = "You roll the dice for your party within {radius} studs: each gets one random face for {statBuffDuration} s: Blade (+{crit} percentage points of critical chance), Wind (+{haste}% attack speed) or Spring ({regen}% of max health every second).",
	["skill.wheelOfFortune.name"] = "Wheel of Fortune",
	["skill.wheelOfFortune.desc"] = "Your party within {radius} studs gets all three faces for {statBuffDuration} s (critical chance +{crit} percentage points, attack speed +{haste}%, {regen}% of max health every second), and the face the wheel points to is {boost}% stronger. Enemies within {enemyRadius} studs miss normal attacks with a {miss}% chance.",
	["skill.brandOfLight.name"] = "Brand of Light",
	["skill.brandOfLight.desc"] = "Brands the target with light for {dmg}% of magic attack and sets it alight: {dot}% of magic attack over {burnDuration} s.",
	["skill.hammerOfHeaven.name"] = "Hammer of Heaven",
	["skill.hammerOfHeaven.desc"] = "After a moment a hammer of light falls on a {radius}-stud circle: {dmg}% of magic attack and a {stunDuration} s stun (bosses and Elite II take only the damage).",

