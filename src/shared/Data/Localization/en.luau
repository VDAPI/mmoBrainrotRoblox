	-- S101b: answers (Wit, Borys) and the page of side_den that remembers side_bears
	["quest.side_venom.say.where"] = "Where do these toads sit?",
	["quest.side_venom.say.where.reply"] = "West of my hut, by the water. I will mark where they croak the loudest.",
	["quest.side_venom.say.luck"] = "They say toads bring luck.",
	["quest.side_venom.say.luck.reply"] = "To the ones left in the bog. You they will give a rash.",
	["quest.side_venom.say.jagna"] = "Will Jagna get well?",
	["quest.side_venom.say.jagna.reply"] = "Ysolde says so. I believe her, because I have no other choice.",
	["quest.side_bears.say.supplies"] = "I could use something for wounds.",
	["quest.side_bears.say.supplies.reply"] = "Here are two potions. A bear does not ask whether you are ready.",
	["quest.side_bears.say.quiet"] = "You talk of them as if they listen.",
	["quest.side_bears.say.quiet.reply"] = "Because they do. A bear hears you talk about it. Quieter.",
	["quest.side_bears.say.fire"] = "Not afraid of fire? That is impossible.",
	["quest.side_bears.say.fire.reply"] = "So I thought. Until yesterday.",
	["quest.side_den.say.denFirst"] = "The den first.",
	["quest.side_den.say.denFirst.reply"] = "Good. We set the mark before someone wanders in.",
	["quest.side_den.say.goblinsFirst"] = "The goblins first.",
	["quest.side_den.say.goblinsFirst.reply"] = "Good too. Fewer eyes in the ravine.",
	["quest.side_den.say.drums"] = "There were drums in the night.",
	["quest.side_den.say.drums.reply"] = "That was no wind. Wind does not keep a beat.",
	["quest.side_den.p1.quiet"] = "Remember what I said? Quieter. The biggest den lies under the rock by the waterfall, and the rock has ears too.",
	["quest.side_den.p1.fire"] = "You think it impossible? Under the rock by the waterfall, where the biggest den lies, you will see what is possible.",
	-- S101b: Borys walks with the player through side_den
	["quest.side_den.comp.join1"] = "I will come with you. I would not go alone, but two of us will give a bear pause.",
	["quest.side_den.comp.join2"] = "Come. And do not talk loudly about bears.",
	["quest.side_den.comp.wait1"] = "Not so fast. The ravine has ears.",
	["quest.side_den.comp.back1"] = "I lost sight of you. I will join you when you are back on the meadows.",
	-- S101b: comments during the story 1-20
	["quest.arrival.bark.accept1"] = "Take a look around the square, then come to me. I have work for you.",
	["quest.arrival.bark.done1"] = "Good, you are here. Listen closely, I do not like repeating myself.",
	["quest.healer.bark.accept1"] = "Potion on your belt, not in your pack. In a fight nobody waits while you dig for it.",
	["quest.healer.bark.half1"] = "Tastes foul, I know. Now go to Mirela by the temple.",
	["quest.healer.bark.done1"] = "Still standing, I see. Keep it that way, it saves me work.",
	["quest.smith.bark.accept1"] = "Dorgan says steel likes patience. People at his forge never have any.",
	["quest.smith.bark.half1"] = "One upgrade done. Now show it to Dorgan before he starts grumbling.",
	["quest.smith.bark.done1"] = "Forty-two strokes, I counted. Fair enough for a first time.",
	["quest.portal.bark.accept1"] = "The gate is to the east, the portal beyond it. Do not lose what I forged for you.",
	["quest.portal.bark.done1"] = "A new face? Stand where I can see you and do not scare the game.",
	["quest.firstHunt.bark.accept1"] = "Rabbits run in zigzags. You walk straight, they double back anyway.",
	["quest.firstHunt.bark.half1"] = "Not bad. A few more, and do not forget what they leave behind.",
	["quest.firstHunt.bark.done1"] = "That will do. Come back to me, we will talk about something that bites.",
	["quest.gearUp.bark.accept1"] = "Put on something proper. The woods do not like bare hands.",
	["quest.gearUp.bark.half1"] = "Better already. Now see to yourself, not only to what you wear.",
	["quest.gearUp.bark.done1"] = "Well now. You look almost dangerous.",
	["quest.wolves.bark.accept1"] = "The pack is circling. Do not get surrounded, wolves always come from behind.",
	["quest.wolves.bark.half1"] = "Half the pack. The rest know you are here now.",
	["quest.wolves.bark.done1"] = "Enough wolf blood. Come back before the crows gather.",
	["quest.wolfFangs.bark.accept1"] = "Ysolde pays for whole fangs, not pieces. Aim for the ribs.",
	["quest.wolfFangs.bark.half1"] = "Half the fangs. The wolves seem to be avoiding you now.",
	["quest.wolfFangs.bark.done1"] = "Six whole fangs. Bring them here, Ysolde sent something in return.",
	["quest.boars.bark.accept1"] = "Boars charge in a straight line. You need not, step aside.",
	["quest.boars.bark.half1"] = "The woods grunt less already. A few more.",
	["quest.boars.bark.done1"] = "The woodcutters can go back. Come, I have something else for you.",
	["quest.herbs.bark.accept1"] = "Meadowsweet smells of honey. You will not miss it, unless you have a cold.",
	["quest.herbs.bark.half1"] = "Mirela needs an armful, not a posy. Keep picking.",
	["quest.herbs.bark.done1"] = "I can smell it from here. Bring it before it wilts.",
	["quest.banditRoad.bark.accept1"] = "The bandits have new swords. Someone bought them, and I want to know who.",
	["quest.banditRoad.bark.half1"] = "The road is quieting. The ones left will be jumpier.",
	["quest.banditRoad.bark.done1"] = "The road is clear. Come back, the merchants left you something.",
	["quest.banditOrders.bark.accept1"] = "The ones in charge carry the orders. Look for whoever shouts loudest.",
	["quest.banditOrders.bark.done1"] = "You have the orders? Do not read them on the way. You will anyway, I know.",
	["quest.goblinCamp.bark.accept1"] = "The camp lies past the hill to the east. You can see the smoke from the gate.",
	["quest.goblinCamp.bark.half1"] = "Mira reports the goblins are falling back. Do not slow down.",
	["quest.goblinCamp.bark.done1"] = "They are fleeing to the cave. Come to me, I know where they hide.",
	["quest.mosshollow.bark.accept1"] = "You can hear a drum in the cave. Follow it, but not too fast.",
	["quest.mosshollow.bark.half1"] = "Their warriors will not give way as easily as the scouts. Careful.",
	["quest.mosshollow.bark.done1"] = "The warriors are down. Come out into the light, we will talk about the chieftain.",
	["quest.grimrok.bark.accept1"] = "Grimrok is no ordinary goblin. Come back alive, that is all I ask.",
	["quest.grimrok.bark.done1"] = "The goblin chieftain is dead. Come to me, I want to hear it from you.",
	-- S101b: comments during the Meadows side quests
	["quest.side_granary.bark.accept1"] = "The farm is past the gate, west of the shrine. Bartosz is stubborn but true.",
	["quest.side_granary.bark.done1"] = "I know, I know, the order. Come here, you will see why I am late.",
	["quest.side_rabbits.bark.accept1"] = "There are more rabbits on the glade than cabbages. For now.",
	["quest.side_rabbits.bark.half1"] = "Half. The rest run off, but they will be back tomorrow with family.",
	["quest.side_rabbits.bark.done1"] = "Quieter already. Come back, I have another trouble.",
	["quest.side_fence.bark.accept1"] = "Four corners of the patch. Boards are by the barn, the hammer too.",
	["quest.side_fence.bark.half1"] = "Two corners done. The ones facing the forest are left.",
	["quest.side_fence.bark.done1"] = "Now that is a fence. Come, let me thank you properly.",
	["quest.side_sheep.bark.accept1"] = "You will find the bells in the wolves. Look in the clearings and on the hillsides.",
	["quest.side_sheep.bark.half1"] = "I would know them by the sound. My sheep rang true.",
	["quest.side_sheep.bark.done1"] = "Five bells. Bring them, I want to see them.",
	["quest.side_grainCart.bark.accept1"] = "A sack for Ignacy. Mind the wolves on the road, the weather suits them.",
	["quest.side_grainCart.bark.half1"] = "The road to town is getting cleaner. Maybe my boy will stop being afraid.",
	["quest.side_grainCart.bark.done1"] = "Grain from Bartosz? Bring it to the granary before it gets wet.",
	["quest.side_shrine.bark.accept1"] = "The candles are in the shrine. Light them slowly, the oak dislikes haste.",
	["quest.side_shrine.bark.half1"] = "I feel warmth from the meadows. Little is left.",
	["quest.side_shrine.bark.done1"] = "Come back to me when you are ready. The prayer will wait.",
	["quest.side_stoneCircle.bark.accept1"] = "The circle stands on the Wolf Hills ridge. Go there with a clear head.",
	["quest.side_stoneCircle.bark.half1"] = "Less blood in the circle now. A few more lynxes.",
	["quest.side_stoneCircle.bark.done1"] = "The circle is silent again. Come back and tell me of it.",
	["quest.side_father.bark.accept1"] = "Father's hut is on the north shore of the pond. He will be by the nets.",
	["quest.side_father.bark.done1"] = "I can smell Jagna's bread from here. Come on, do not just stand there.",
	["quest.side_toads.bark.accept1"] = "The toads sit in the marsh. Do not meet their eyes too long, it is bad luck.",
	["quest.side_toads.bark.half1"] = "Less croaking already. The fish can hear it.",
	["quest.side_toads.bark.done1"] = "The water breathes again. Come back, I have one more matter.",
	["quest.side_venom.bark.accept1"] = "Tie the pouches tight. The venom eats through linen faster than skin.",
	["quest.side_venom.bark.half1"] = "Three pouches. Jagna coughs less already, though that is likely chance.",
	["quest.side_venom.bark.done1"] = "Six pouches, I hear. Carry them carefully, venom dislikes being shaken.",
	["quest.side_venom.bark.stuck1"] = "The toads keep to the water at Toad Pond. You will not find them on dry land.",
	["quest.side_net.bark.accept1"] = "The net is caught past the jetty. Pull from below, not from above.",
	["quest.side_net.bark.half1"] = "The net is ashore. Now the fish, Jagna will not believe it without them.",
	["quest.side_net.bark.done1"] = "Fish from Father? Bring them before they stop smelling of the river.",
	["quest.side_roast.bark.accept1"] = "The boars in the Old Forest are fatter than ever. Take the best haunches.",
	["quest.side_roast.bark.half1"] = "Three haunches. The cook is sharpening her knives already.",
	["quest.side_roast.bark.done1"] = "I can smell the roast before I have even cooked it. Back to the inn.",
	["quest.side_woodcutter.bark.accept1"] = "Gerwazy lives in the clearing by the forest path. Do not open the ale on the way.",
	["quest.side_woodcutter.bark.done1"] = "Ale from Wacław? Come, sit down. The forest will wait, it always does.",
	["quest.side_logs.bark.accept1"] = "The piles are spread through the forest. The forest gives, if you do not rush it.",
	["quest.side_logs.bark.half1"] = "Half the work done. The crows give my piles a wide berth now.",
	["quest.side_logs.bark.done1"] = "The marks stand, the crows are gone. Come back, something still troubles me.",
	["quest.side_shiny.bark.accept1"] = "Crows hoard trinkets in their nests. That signet with the mill's crest keeps me awake.",
	["quest.side_shiny.bark.half1"] = "Buttons, nails, a coin. Keep looking, the signet must be somewhere.",
	["quest.side_shiny.bark.done1"] = "They say you have something for me. Come, please.",
	["quest.side_mill.bark.accept1"] = "The ruins lie on Crow Field. Please take care of yourself.",
	["quest.side_mill.bark.half1"] = "Thank you for going there. Nobody else would.",
	["quest.side_mill.bark.done1"] = "Come back to me with whatever lies there. I need to know.",
	["quest.side_smugglers.bark.accept1"] = "The hideout is in a cave to the south. Bring the ledger, that is all I need.",
	["quest.side_smugglers.bark.half1"] = "The boss is close. Do not let him slip away with the ledger.",
	["quest.side_smugglers.bark.done1"] = "The boss's ledger? Bring it to the guardhouse before someone comes looking.",
	["quest.side_wagon.bark.accept1"] = "The horses came back alone, their traces cut. Look for Lucjan along the road.",
	["quest.side_wagon.bark.done1"] = "Someone looking for me? Over here, by the wagon. Or what is left of it.",
	["quest.side_goods.bark.accept1"] = "Eight bales of cloth, each worth more than those thieves put together.",
	["quest.side_goods.bark.half1"] = "Four bales back. As many again to go.",
	["quest.side_goods.bark.done1"] = "All the bales? Come back, I will count them in front of you, to avoid confusion.",
	["quest.side_wanted.bark.accept1"] = "Fifteen from the road. Count out loud, I want it in the report.",
	["quest.side_wanted.bark.half1"] = "Half the list. Do not slow down, they can count too.",
	["quest.side_wanted.bark.done1"] = "The road is clear. At ease, and report to the guardhouse for your reward.",
	["quest.side_ore.bark.accept1"] = "The quarry is to the east. Put the letter in his own hands, not a kobold's.",
	["quest.side_ore.bark.done1"] = "A letter from Dorgan? Hand it over, I know what he wrote anyway.",
	["quest.side_tools.bark.accept1"] = "My picks bear my mark on the haft. Kobolds cannot read marks, but they can steal.",
	["quest.side_tools.bark.half1"] = "Three picks. That is nine more hours of digging a day, I counted.",
	["quest.side_tools.bark.done1"] = "All six? Come back before the kobolds notice they are gone.",
	["quest.side_tunnels.bark.accept1"] = "Three tunnels on the terraces. Nail the boards crosswise, it holds longest.",
	["quest.side_tunnels.bark.half1"] = "Going well. The kobolds will have to dig new burrows, and that takes time.",
	["quest.side_tunnels.bark.done1"] = "Ore from Dobromir? Let me guess, on time. Bring it to the forge.",
	["quest.side_totem.bark.accept1"] = "The camp lies north-east. Scouts first, then the totem. Those are the orders.",
	["quest.side_totem.bark.half1"] = "Report: fewer scouts, the totem still stands. Carry on.",
	["quest.side_totem.bark.done1"] = "The smoke is visible from the guardhouse. Report in.",
	["quest.side_foreman.bark.accept1"] = "The mound lies under the hills. Two foremen, and no needless heroics.",
	["quest.side_foreman.bark.half1"] = "Good report from the mound. The foremen keep close to the ore.",
	["quest.side_foreman.bark.done1"] = "The foremen are down? Come back, the miners want to thank you.",
	["quest.side_hunter.bark.accept1"] = "Borys hunts above Bear Ravine. Take him this before he eats his own boots.",
	["quest.side_hunter.bark.done1"] = "I smell Wacław's biscuits. Come here, but quietly, the ravine listens.",
	["quest.side_bears.bark.accept1"] = "Ten bears and four claws. Come at them downwind.",
	["quest.side_bears.bark.half1"] = "The bears are restless. Something drives them from the rocks.",
	["quest.side_bears.bark.done1"] = "Show me the claws. I need to know where they have been.",
	["quest.side_bears.bark.stuck1"] = "The bears keep to the ravine, below my camp. Look for them there.",
	["quest.side_den.bark.accept1"] = "Lead on. I will watch the bushes.",
	["quest.side_den.bark.half1"] = "The mark stands. Now for whoever is drumming here.",
	["quest.side_den.bark.near1"] = "Smell the tar? Bears do not smell like that.",
	["quest.side_den.bark.done1"] = "Enough. Back to camp before more of them come.",
	["quest.side_den.bark.death1"] = "Get up. I will not leave you here.",
	["quest.side_den.bark.stuck1"] = "The goblins keep higher up, by the rocks. Look there.",
	-- S101b: comments during the stable arc (S96)
	["quest.side_stable_harness.bark.accept1"] = "Three harness pieces. The goblins split it up in their camp, likely as trinkets.",
	["quest.side_stable_harness.bark.half1"] = "Most of the harness is back. A little more and I start stitching.",
	["quest.side_stable_harness.bark.done1"] = "A harness does not bite, unlike the horse. Bring it here.",
	["quest.side_stable_stallion.bark.accept1"] = "Approach quietly, hands empty. A stallion reads hands faster than faces.",
	["quest.side_stable_stallion.bark.half1"] = "Quieter above the ravine now. The stallion can feel it.",
	["quest.side_stable_stallion.bark.done1"] = "The stallion is at my camp. Come, but do not snap any branches.",
	["quest.side_stable_ride.bark.accept1"] = "Heels down, head up. And do not drag on the lead rope, guide him.",
	["quest.side_stable_ride.bark.done1"] = "I can see you both from the gate. Lead him straight into the stall.",
	-- S102: story chapter I "The Frost Sign" (pages, new quests, answers, comments, cutscenes, admin)
	["quest.arrival.p1"] = "Welcome to Vaelthorn. The city needs people. For weeks now the merchants from the north have stopped coming, and nobody knows why.",
	["quest.arrival.p2"] = "Before you go beyond the walls, learn the basics. Start with Healer Mirela by the temple.",
	["quest.healer.p1"] = "A potion saves a life more often than a sword does. Always carry a few.",
	["quest.healer.p2"] = "Drink one now so you know how it works, then go to Mirela. She will teach you the rest.",
	["quest.smith.p1"] = "You will not get far with a blade like that. I have seen what is left of people who thought otherwise.",
	["quest.smith.p2"] = "Go to Dorgan the blacksmith and upgrade something to +1. Then talk to him; he likes to know who he forges for.",
	["quest.portal.p1"] = "Beyond the east gate stands the portal to the Whispering Meadows. A few steps and you are outside the city.",
	["quest.portal.p2"] = "Scout Mira waits on the other side. Listen to her. She knows every burrow on the Meadows.",
	["quest.firstHunt.p1"] = "Rabbits first. Do not laugh, they will teach you to aim and keep your breath.",
	["quest.firstHunt.p2"] = "Hunt a few and pick up what they leave. Loot does not lie around for long; the forest takes it.",
	["quest.gearUp.p1"] = "Loot in a bag does you no good. A thing only works when you wear it.",
	["quest.gearUp.p2"] = "Put on whatever is better and spend your points in the character window. Then come back, I will find you something.",
	["quest.wolves.p1"] = "The wolves come down from the hills lower every week. Too early this year, and too bold.",
	["quest.wolves.p2"] = "Thin out the pack. And learn something new along the way; strength alone will not do.",
	["quest.wolfFangs.p1"] = "Ysolde pays for wolf fangs. The garrison needs her brews, and she needs the fangs.",
	["quest.wolfFangs.p2"] = "Bring six. Whole ones, not broken, or she will complain.",
	["quest.boars.p1"] = "The boars in the Old Forest are skittish. As if something drove them out of the deep woods.",
	["quest.boars.p2"] = "Thin them out before they trample the woodcutters. Then we will think about what chases them.",
	["quest.herbs.p1"] = "Mirela asked for meadowsweet. It grows on the fields and smells of honey.",
	["quest.herbs.p2"] = "Five sprigs. Lately Mirela treats things she does not understand herself, and she needs all she can get.",
	["quest.banditRoad.p1"] = "They are robbing on the old road again. The merchants are afraid to travel even with an escort.",
	["quest.banditRoad.p2"] = "There are more bandits than usual, and they carry better weapons. Someone pays them. Clear the road.",
	["quest.banditOrders.p1"] = "The bandits you killed carried papers. Orders, not love letters.",
	["quest.banditOrders.p2"] = "Get one of those letters. One of them is bound to carry it.",
	["quest.banditOrders.p3"] = "Do not read it by the campfire. Take it straight to Captain Aldric.",
	["quest.goblinCamp.p1"] = "The goblins of the east are gathering in a camp. Too many of them for simple raiding.",
	["quest.goblinCamp.p2"] = "Break the camp before they march on the road. Mira will show you the way.",
	["quest.mosshollow.p1"] = "The goblins have a chief in Mosshollow Cave. The ones who fled the camp went straight to him.",
	["quest.mosshollow.p2"] = "Thin out his guard. Without his warriors the chief stands alone.",
	["quest.grimrok.p1"] = "Grimrok waits in his chamber deep in the cave. He knows we are coming for him.",
	["quest.grimrok.p2"] = "Do not go alone. Take people you trust.",
	["quest.grimrok.p3"] = "If he knows who the master in the north is, he will say it before he dies. Listen carefully.",
	["quest.frostRuins.title"] = "Frost in Midsummer",
	["quest.frostRuins.p1"] = "Yesterday I tended a woodcutter from the Old Forest. His fingers were frostbitten, in the middle of summer.",
	["quest.frostRuins.p2"] = "He spoke of the old tower in the forest. He said the stones there are white with frost.",
	["quest.frostRuins.p3"] = "Go and see it with your own eyes. Then tell Mira what you found.",
	["quest.frostRuins.text"] = "Healer Mirela tended a woodcutter with frostbitten hands. Search the tower ruins in the Old Forest and tell Mira what you found.",
	["quest.frostRuins.done"] = "A snowflake pierced by a thorn? I do not know that crest. And the rune is fresh, someone carved it not long ago. For now we stick to what we know: the bandits.",
	["quest.frostSign.title"] = "The Sign of the Long Winter",
	["quest.frostSign.p1"] = "Sergeant Dobiesław questioned the captured bandits. Find out from him who paid them.",
	["quest.frostSign.p2"] = "You have already seen the crest from those orders on the tower ruins. That is no coincidence.",
	["quest.frostSign.p3"] = "Show it to Brother Anzelm in the temple. If anyone still remembers the old signs, it is him.",
	["quest.frostSign.text"] = "Learn from Sergeant Dobiesław who paid the bandits, and show the sign to Brother Anzelm in the temple.",
	["quest.frostSign.done"] = "Ilvar. I remember him: a quiet man, always with a book. If Anzelm is right, we have a bigger problem than bandits.",
	["quest.frostSign.done.chance"] = "A coincidence, you said. Coincidences have no names. This one does: Ilvar. A quiet man, always with a book. If Anzelm is right, we have a bigger problem than bandits.",
	["quest.frostSign.sergeant"] = "A man in a grey cloak paid them. He spoke softly and evenly, like a priest at the pulpit. Nobody remembers his face, only his cold hands.",
	["quest.frostSign.anzelm"] = "A snowflake pierced by a thorn. The sign of the Long Winter, and of the one who brought it. We do not speak his name.",
	["quest.warrenCharms.title"] = "Charms That Do Not Melt",
	["quest.warrenCharms.p1"] = "The goblins from the camp fled into the Goblin Warren. Some of them wore something white around their necks.",
	["quest.warrenCharms.p2"] = "Their warriors will not give those up willingly.",
	["quest.warrenCharms.p3"] = "Go down into the Warren, defeat the warriors and bring me those charms.",
	["quest.warrenCharms.text"] = "Defeat the goblin warriors in the Goblin Warren and take their Frost Charms.",
	["quest.warrenCharms.done"] = "I held one over the fire for a whole watch. It did not even get damp. The goblins say it is a gift from the master in the north.",
	["quest.warCouncil.title"] = "Council in Vaelthorn",
	["quest.warCouncil.p1"] = "Grimrok is dead, but this war was not his idea.",
	["quest.warCouncil.p1.jewelry"] = "Mira keeps repeating your joke about goblins in jewellery in the barracks. Nobody laughs, but she keeps at it. Grimrok is dead, but this war was not his idea.",
	["quest.warCouncil.p1.ready"] = "You told Mira you could manage. You did. Grimrok did not. But this war was not his idea.",
	["quest.warCouncil.p2"] = "Dorgan wants to look at his axe, and Ysolde at the charm.",
	["quest.warCouncil.p3"] = "Hear them both out and come back to me.",
	["quest.warCouncil.p4"] = "Then we will decide where you go next.",
	["quest.warCouncil.text"] = "Show Grimrok's axe to Dorgan the blacksmith and take the Frost Charm to Ysolde the alchemist. Then return to Captain Aldric.",
	["quest.warCouncil.done"] = "Dwarven steel, a scale of something cold and a priest who went north. Ilvar vanished in Duskwood. That is where you are going.",
	["quest.warCouncil.blacksmith"] = "The runes on this axe are dwarven, and so is the steel. Steel like this is forged only in Deepforge, far to the east. The goblins could never have paid for it.",
	["quest.warCouncil.alchemist"] = "There is dust from a scale in this charm. From something alive and cold. I do not know what has scales like that, and I would rather not find out.",
	["quest.frostRuins.say.go"] = "I will go at once.",
	["quest.frostRuins.say.go.reply"] = "Take a cloak. I know it is summer.",
	["quest.frostRuins.say.exaggerate"] = "Woodcutters exaggerate.",
	["quest.frostRuins.say.exaggerate.reply"] = "His fingers did not. They were blue.",
	["quest.frostRuins.say.supplies"] = "What should I take?",
	["quest.frostRuins.say.supplies.reply"] = "Two potions. The woodcutter also thought his axe would be enough.",
	["quest.frostSign.say.chance"] = "Maybe it is a coincidence.",
	["quest.frostSign.say.chance.reply"] = "In the army we call a coincidence whatever we do not understand yet.",
	["quest.frostSign.say.same"] = "The same sign. Someone is behind this.",
	["quest.frostSign.say.same.reply"] = "So do I. That is why we do not talk about it on the plaza.",
	["quest.frostSign.say.who"] = "Who is Brother Anzelm?",
	["quest.frostSign.say.who.reply"] = "He remembers more than the chronicles. Speak softly, he does not like haste.",
	["quest.warrenCharms.say.count"] = "How many are there?",
	["quest.warrenCharms.say.count.reply"] = "Too many to count out loud. I will mark the entrance to the Warren for you.",
	["quest.warrenCharms.say.jewelry"] = "Goblins wearing jewellery. The world is going to the dogs.",
	["quest.warrenCharms.say.jewelry.reply"] = "At least dogs do not wear charms. Not yet.",
	["quest.warrenCharms.say.ready"] = "I can manage.",
	["quest.warrenCharms.say.ready.reply"] = "Everyone says that. Some of them come back.",
	["quest.warCouncil.say.smithFirst"] = "Dorgan first.",
	["quest.warCouncil.say.smithFirst.reply"] = "Fine. Just do not let him start on tempering.",
	["quest.warCouncil.say.alchemistFirst"] = "Ysolde first.",
	["quest.warCouncil.say.alchemistFirst.reply"] = "Sensible. Ysolde does not like to wait.",
	["quest.warCouncil.say.burn"] = "Why not just burn the charms?",
	["quest.warCouncil.say.burn.reply"] = "Mira tried. The charm survived, the campfire did not.",
	["quest.frostRuins.bark.accept1"] = "Mira waits by the gate. Tell her I sent you.",
	["quest.frostRuins.bark.near1"] = "Feel that? Cold as a cellar, and the sun is blazing.",
	["quest.frostRuins.bark.half1"] = "Crows are always the first to know where something is wrong.",
	["quest.frostRuins.bark.done1"] = "Back to the gate. I want to go over this again, calmly.",
	["quest.frostRuins.bark.death1"] = "Get up. The crows are already queuing.",
	["quest.frostRuins.comp.join1"] = "Mirela sent you? Come, I know a shortcut through the Old Forest.",
	["quest.frostRuins.comp.wait1"] = "Do not fall behind. The forest does not like loners.",
	["quest.frostRuins.comp.back1"] = "I lost you. I am going back to the gate, find me there.",
	["quest.frostSign.bark.accept1"] = "Dobiesław stands by the east gate. Do not let him get going about drill.",
	["quest.frostSign.bark.half1"] = "The temple is past the fountain. Not far now.",
	["quest.frostSign.bark.done1"] = "Come back to me. I would rather hear that name from you than from gossip.",
	["quest.frostSign.bark.stuck1"] = "Anzelm sits in the temple, next to the healer. You cannot miss him.",
	["quest.frostSign.comp.join1"] = "To the temple? I will lead. Steady pace, no running.",
	["quest.frostSign.comp.wait1"] = "Keep up, recruit. The temple will not come to us.",
	["quest.frostSign.comp.arrive1"] = "On your own from here. I only go into temples for funerals.",
	["quest.frostSign.comp.back1"] = "Lost in your own city? I will wait at the gate.",
	["quest.warrenCharms.bark.accept1"] = "The Warren lies past the camp. Do not go in without potions.",
	["quest.warrenCharms.bark.half1"] = "Half done. Those charms jingle like cowbells.",
	["quest.warrenCharms.bark.done1"] = "That will do. Come back before they count their losses.",
	["quest.warrenCharms.bark.death1"] = "Get up. Goblins cannot boast properly anyway.",
	["quest.warrenCharms.bark.stuck1"] = "Only the warriors wear the charms. Look for the ones with better axes.",
	["quest.warCouncil.bark.accept1"] = "First the smith and the alchemist. Then a talk I do not look forward to.",
	["quest.warCouncil.bark.half1"] = "You know one thing now. Now the other.",
	["quest.warCouncil.bark.done1"] = "Back to the plaza. We will put it all together.",
	["story.chapter.1"] = "Chapter I: The Frost Sign",
	["story.chapter.2"] = "Chapter II: The Forgotten House",
	["story.chapter.3"] = "Chapter III: Cold Fire",
	["story.chapter.4"] = "Chapter IV: The Long Winter",
	["story.chapter.1.end"] = "End of Chapter I",
	["quest.item.frostCharm"] = "Frost Charm",
	["place.towerRuins"] = "The tower ruins in the Old Forest",
	["place.temple"] = "The temple of Vaelthorn",
	["quest.use.crest"] = "Scrape the frost off the crest",
	["cutscene.ch1_open.title"] = "Vaelthorn",
	["cutscene.ch1_open.l1"] = "For weeks a wind has blown from the north that does not belong to summer. The merchants have stopped coming.",
	["cutscene.ch1_open.l2"] = "Vaelthorn needs hands that can hold a sword. Learn the basics first, then go beyond the walls.",
	["cutscene.portal_gate.l1"] = "New, are you? Aldric sends me younger ones every time.",
	["cutscene.portal_gate.l2"] = "The Meadows look peaceful. Do not be fooled. Come, I will show you how we hunt here.",
	["cutscene.frost_ruins.l1"] = "The stone under your fingers is cold as deep winter. A crest emerges from the frost: a snowflake pierced by a thorn.",
	["cutscene.frost_ruins.l2"] = "Crows burst from the tower. For a moment there is nothing but their cries.",
	["cutscene.bandit_orders.l1"] = "Goblin gold… and this sign.",
	["cutscene.bandit_orders.l2"] = "A snowflake pierced by a thorn. The same one you saw on the tower ruins.",
	["cutscene.bandit_orders.l3"] = "Someone writes orders for bandits. And does not sign them with a name.",
	["cutscene.frost_sign.l1"] = "Only one man in this temple ever read the forbidden chronicle of the Long Winter.",
	["cutscene.frost_sign.l2"] = "Brother Ilvar. My brother in faith. Ten years ago he went north and never came back.",
	["cutscene.frost_sign.l3"] = "I prayed that he was dead. It seems that prayer will not be answered.",
	["cutscene.grimrok_end.l1"] = "You think… you have won? The master in the north promised us warmth when the winter comes.",
	["cutscene.grimrok_end.l2"] = "It will come for all of you…",
	["cutscene.grimrok_end.l3"] = "The goblin chief falls silent. Strange runes gleam on the blade of his axe.",
	["cutscene.ch1_close.l1"] = "At the edge of Duskwood, where the Meadows end, someone in a grey cloak is standing.",
	["cutscene.ch1_close.l2"] = "He looks south for a long time, as if counting the roofs of Vaelthorn. Then frost fills the air, and he is gone.",
	["cutscene.who.ilvar"] = "The Voice of Winter",
	["cutscene.skip"] = "Skip",
	["cutscene.next"] = "Next ▸",
	["quest.journal.pages"] = "Recall the conversation",
	["quest.journal.replay"] = "Watch the scene again",
