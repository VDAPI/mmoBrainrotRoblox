	["place.elderTree"] = "The Elder Tree in the hollow of the Forest Heart",
	["place.stiltVillage"] = "The stilt village",
	["npc.forester_radomir.name"] = "Forester Radomir",
	["npc.forester_radomir.role"] = "Forester",
	["npc.forester_radomir.greeting"] = "The forest is hungry today. You can smell it in the air.",
	["npc.forester_radomir.line1"] = "The forest is an animal. When it is wounded, it bites anything that comes near.",
	["npc.forester_radomir.line2"] = "Milosz always got up before dawn. Now I stay awake for him.",
	["npc.forester_radomir.line3"] = "Wolves do not leave tracks like these on their own. Something drove them.",
	["npc.forester_radomir.where"] = "in the ravaged hunters' camp in the Werewolf Thicket",
	["npc.ghost_oswin.name"] = "The Ghost of Steward Oswin",
	["npc.ghost_oswin.role"] = "Ghost",
	["npc.ghost_oswin.greeting"] = "The manor does not receive guests. My lady is… absent.",
	["npc.ghost_oswin.line1"] = "Lord Vael is hunting in the forest today. Kindly wait in the hall.",
	["npc.ghost_oswin.line2"] = "The silver must be polished every week. Someone has neglected the silver.",
	["npc.ghost_oswin.line3"] = "The crypt is closed to strangers. I keep the key myself. I kept it.",
	["npc.ghost_oswin.where"] = "by the chapel in the Haunted Ruins",
	["npc.defector_jorund.name"] = "Jorund the Turncoat",
	["npc.defector_jorund.role"] = "Runaway cultist",
	["npc.defector_jorund.greeting"] = "Quieter. The mist has ears.",
	["npc.defector_jorund.line1"] = "I wore their robe for ten years. Shame is worn longer.",
	["npc.defector_jorund.line2"] = "Do not come from the road side. They walk there.",
	["npc.defector_jorund.line3"] = "I once believed what they said. Faith is a strange thing.",
	["npc.defector_jorund.where"] = "by the wayside shrine at the Misty Crossroads",
	["npc.witch_ragna.name"] = "Ragna of the Stilts",
	["npc.witch_ragna.role"] = "Hermit",
	["npc.witch_ragna.greeting"] = "Witches live in the marsh. I live on stilts. What do you want?",
	["npc.witch_ragna.line1"] = "Fish for medicine. Gold for medicine too, but fish smell better.",
	["npc.witch_ragna.line2"] = "The coven has stopped listening to the forest. It listens to someone else.",
	["npc.witch_ragna.line3"] = "Not every old woman with herbs is a witch. Some are worse.",
	["npc.witch_ragna.where"] = "in the abandoned village on stilts in the Troll Swamp",
	["cutscene.ch2_title.title"] = "Duskwood",
	["cutscene.ch2_title.l1"] = "Past the Dusk Gate the road you know comes to an end. The blue lanterns mark the border of the light.",
	["cutscene.ch2_title.l2"] = "Ten years ago Brother Ilvar vanished here. The forest remembers everyone who has passed through it.",
	["cutscene.moonstone.l1"] = "The rune cracks with the snap of ice. Shards of frost fall onto the grass.",
	["cutscene.moonstone.l2"] = "The cold blue fades, and the stone shines silver again, as it has every night for ages.",
	["cutscene.moonstone.l3"] = "Do you hear that? They have gone quiet.",
	["cutscene.houseOfVael.l1"] = "Pale light falls through the broken glass. From the window a queen looks down, her spear driven into a dragon.",
	["cutscene.houseOfVael.l2"] = "That is my lady Morvane, the last of House Vael.",
	["cutscene.houseOfVael.l3"] = "With the spear called the Thorn of Vael she wounded the dragon. And then the chronicles forgot her.",
	["cutscene.elderHeart.l1"] = "The cold blue in the crack goes out. The shard of ice melts and runs down the bark.",
	["cutscene.elderHeart.l2"] = "The Elder Tree sighs like someone who has held their breath for a long time. The crack begins to glow gold.",
	["cutscene.elderHeart.l3"] = "A branch slides out of the crack, warm to the touch. It hums softly, like a taut string.",
	["cutscene.cult.l1"] = "A dragon on every seal.",
	["cutscene.cult.l2"] = "They do not only worship it. They want to wake it.",
	["cutscene.cult.l3"] = "I know this hand. Ilvar. He is their Voice.",
	["cutscene.turncoat.l1"] = "I was a fool, not a monster.",
	["cutscene.turncoat.l2"] = "He says the winter is clean. That it will cleanse the world.",
	["cutscene.turncoat.l3"] = "Three seals. He already has the first.",
	["cutscene.barrow.l1"] = "On the stone altar lies an empty shroud, stiff with frost.",
	["cutscene.barrow.l2"] = "The violet fire shrinks and goes out, as if someone blew out a candle.",
	["cutscene.barrow.l3"] = "The last page of the Book of Rites: “The blood of Vael has risen. The blood of Vael serves the Winter.”",
	["cutscene.cryptGate.l1"] = "The frost on the gate gathers into a figure in a grey cloak.",
	["cutscene.cryptGate.l2"] = "Too late. The queen already sings for the Winter.",
	["cutscene.cryptGate.l3"] = "When the winter calls you, come north. Everyone comes in the end.",
	["cutscene.cryptGate.l4"] = "The figure crumbles into frost, and the dust settles on the stones of the gate.",
	["cutscene.morvane.l1"] = "Someone spoke my name. For three hundred years nobody remembered it.",
	["cutscene.morvane.l2"] = "A man in a grey cloak took my name and gave me a crown of ice.",
	["cutscene.morvane.l3"] = "Take my ring. Let it remind you what the Thorn was.",
	["cutscene.morvane.l4"] = "Now I can sleep.",
	["cutscene.queensLegacy.l1"] = "Anzelm lays the branch beside the ring. The wood begins to glow a warm gold.",
	["cutscene.queensLegacy.l2"] = "“The shaft was given to the forest, the head to the dwarves, the oath to the Watch.”",
	["cutscene.queensLegacy.l3"] = "This is no branch. It is the shaft of the Thorn of Vael.",
	["cutscene.queensLegacy.l4"] = "East, then.",
	["cutscene.who.queen"] = "Morvane of House Vael",
	["story.chapter.2.end"] = "End of Chapter II",
	["story.morvane.name"] = "You speak her name: Morvane of House Vael. The queen falters.",
	-- S104: story chapter III "Cold Fire" (pages, new quests, NPCs of the Ashen Wastes, answers, comments, cutscenes)
	["quest.obj.collectFrom"] = "Get: {item} ({monster}) {count}",
	["quest.ashen.p1"] = "Anzelm's chronicle goes on. The second seal is the Rune: the Chains of Winter, forged by the dwarves in Deepforge, beyond the Ashen Wastes.",
	["quest.ashen.p2"] = "No caravan has come from there in a month, and at night the glow in the east is brighter than ever. Ysolde spoke of fires burning brighter.",
	["quest.ashen.p3"] = "Scout Kesra keeps the Ribcage Gate. The salamanders crawl out of the cracks farther than they used to; something heats the ground from below. Thin them out and report to her.",
	["quest.ashen.bark.accept1"] = "The Ribcage Gate stands right past the portal. I wait under the ribs.",
	["quest.ashen.bark.half1"] = "The salamanders are hiding. A few more and the ground stops hissing.",
	["quest.ashen.bark.done1"] = "That will do. Come to the fire before the heat eats you.",
	["quest.deadOasis.title"] = "The Dead Oasis",
	["quest.deadOasis.p1"] = "He came at night from the oasis, alone, with burnt hands. He says he is a runesmith of Deepforge, and that hyenas tore his caravan apart once the drivers were already dead.",
	["quest.deadOasis.p2"] = "Brokk wants one thing only: the iron chest with his notes, left on the bed of the dry lake.",
	["quest.deadOasis.p3"] = "Vultures have circled over it for three days, hyenas guard the carrion. Brokk insists on leading you there himself.",
	["quest.deadOasis.text"] = "Go with Brokk to the remains of his caravan, recover the chest from the bed of the Dead Oasis and thin out the hyenas.",
	["quest.deadOasis.done"] = "The chest is whole, the notes are dry. My forefathers forged the Chains of Winter to keep the dragon asleep. Azgor's fire was meant to warm them, never to melt them. Someone let him. And someone pays him for it.",
	["quest.deadOasis.say.notes"] = "What is in the chest?",
	["quest.deadOasis.say.notes.reply"] = "Notes of three hundred years, he says. Without them he is a dwarf who remembers much and can prove nothing.",
	["quest.deadOasis.say.hands"] = "His hands first.",
	["quest.deadOasis.say.hands.reply"] = "He says his hands can wait and the chest cannot. The hyenas are already sniffing round it.",
	["quest.deadOasis.say.count"] = "How many were they?",
	["quest.deadOasis.say.count.reply"] = "I asked. Nine drivers, seven wagons, fourteen oxen. And him. He counted it twice.",
	["quest.deadOasis.bark.accept1"] = "I lead. Keep to the road, the ash fills the pits.",
	["quest.deadOasis.bark.half1"] = "Half of it behind us. The hyenas still circle the wagons.",
	["quest.deadOasis.bark.done1"] = "The chest is here, the notes are here. Now I can worry properly.",
	["quest.deadOasis.bark.death1"] = "Get up. Enough people lie on the bed of this oasis.",
	["quest.deadOasis.comp.join1"] = "I am coming with you. My hands are burnt, my legs are not.",
	["quest.deadOasis.comp.wait1"] = "Kesra says I count too much. I know how many arrows she has: twenty-three.",
	["quest.deadOasis.comp.wait2"] = "Deepforge has seven gates, the Ribcage Gate fourteen ribs. Count them if you doubt.",
	["quest.deadOasis.comp.wait3"] = "I stand. I count. I have reached three hundred. Do not make me reach a thousand.",
	["quest.deadOasis.comp.arrive1"] = "There were nine drivers. Six lie here. The orcs took three alive.",
	["quest.deadOasis.comp.arrive2"] = "Six of nine. Tracks of iron-shod boots, heavy ones. Three were taken alive.",
	["quest.deadOasis.comp.back1"] = "I go back to tell Kesra. You take the chest, I cannot do it.",
	["quest.warcampCages.title"] = "The Warcamp Cages",
	["quest.warcampCages.p1"] = "Six of the nine drivers lay on the bed of the oasis. Tracks of iron-shod boots lead up to the plateau: the orcs took three alive.",
	["quest.warcampCages.p1.count"] = "I told you: nine. Six lay on the bed. Tracks of iron-shod boots lead up to the plateau, so the orcs took three alive.",
	["quest.warcampCages.p2"] = "In the camp of the Ash Orcs stand cages of bone and logs. If the captives live, they are there.",
	["quest.warcampCages.p3"] = "Kesra told me to tell you: orcs do not take captives for nothing, someone pays for them. Her scouts saw an orc woman in shaman's amulets in one cage.",
	["quest.warcampCages.text"] = "Open the cages in the orc camp, break the guards and talk to the freed shaman by the Hot Spring.",
	["quest.warcampCages.done"] = "The drivers are in the camp, unharmed. Ghasha will not go back to her people. She says the warchief takes gold and axes of cold iron from the grey men, and she would not take their gold, so she ended up in a cage. Cold iron does not grow in the desert.",
	["quest.warcampCages.ghasha"] = "The grey men gave the warchief gold that does not warm the hand. And axes that do not cool, they freeze. Who takes their gold is no longer of the clan.",
	["quest.warcampCages.say.gate"] = "I will go in through the gate.",
	["quest.warcampCages.say.gate.reply"] = "Loud. But Kesra will know where to look for you.",
	["quest.warcampCages.say.cages"] = "The cages first.",
	["quest.warcampCages.say.cages.reply"] = "On the west side of the camp, by the fence of bones.",
	["quest.warcampCages.say.why"] = "What do orcs want with captives?",
	["quest.warcampCages.say.why.reply"] = "Captives are goods. Find out who buys them.",
	["quest.warcampCages.bark.accept1"] = "Three alive. Come back with three.",
	["quest.warcampCages.bark.half1"] = "The cage is open. The guards are left.",
	["quest.warcampCages.bark.near1"] = "Bars of bone. Lever the hinge, not the lock.",
	["quest.warcampCages.bark.done1"] = "Kesra writes they are unharmed. Three. The count is right.",
	["quest.warcampCages.bark.stuck1"] = "Ghasha waits by the Hot Spring. She will not come to you.",
	["quest.orcs.p1"] = "The war drum beats every night. The warchief gathers the clans, and since the cult pays him, we will not wait for them to march.",
	["quest.orcs.p2"] = "The smiths in our camp need silver for arrowheads. You will find veins of silver in the rocks by the roads.",
	["quest.orcs.bark.accept1"] = "The camp is on the plateau. Silver in the rocks by the roads.",
	["quest.orcs.bark.half1"] = "The drum beats less often. Someone there is counting losses.",
	["quest.orcs.bark.done1"] = "The drum is silent. For now.",
	["quest.mineDepths.title"] = "Cold Iron",
	["quest.mineDepths.p1"] = "At night the orcs carry something into the Abandoned Mine under the plateau and come back with empty wagons.",
	["quest.mineDepths.p2"] = "Brokk says you will know cold iron by the frost on the hinges of the crates. Go down the shafts. Their overseers, the strongest of the orcs, carry ledgers.",
	["quest.mineDepths.p3"] = "Careful in the shafts. The orcs know them better than you, and in the dark every step sounds like someone else's.",
	["quest.mineDepths.text"] = "Go down into the Abandoned Mine, defeat the orc overseers and take the supply ledger.",
	["quest.mineDepths.done"] = "The ledger says it plainly: the cold iron goes down a shaft to Deepforge, and from there north, to the pass. Someone forges weapons in Deepforge and sends them into the mountains.",
	["quest.mineDepths.say.frost"] = "Brokk spoke of frost.",
	["quest.mineDepths.say.frost.reply"] = "Cold iron sweats frost even in a furnace, he says. Do not touch the white hinges bare-handed.",
	["quest.mineDepths.say.dark"] = "It is dark in the shafts.",
	["quest.mineDepths.say.dark.reply"] = "Orcs see in the dark. You have a torch and a bad feeling. Nearly even.",
	["quest.mineDepths.say.quick"] = "In and out.",
	["quest.mineDepths.say.quick.reply"] = "So said everyone who stayed down there.",
	["quest.mineDepths.bark.accept1"] = "The shaft is behind the orc camp, at the foot of the plateau.",
	["quest.mineDepths.bark.half1"] = "Got an overseer? They carry the ledger at the belt.",
	["quest.mineDepths.bark.done1"] = "A ledger says more than a prisoner. And it does not lie out of fear.",
	["quest.mineDepths.bark.death1"] = "The shafts do not forgive. Rest and come back.",
	["quest.emberCores.title"] = "Ember Cores",
	["quest.emberCores.p1"] = "Brokk says his runes went cold on the road. To warm them he needs a fire that never goes out, and the fire golems carry one in their chests.",
	["quest.emberCores.p2"] = "Four cores will do. The golems walk the Golem Fields, round the crater.",
	["quest.emberCores.p3"] = "Before you come back, hold one of his runes to the eyes of the Sleeping Colossus. Brokk wants to know if it is the same fire.",
	["quest.emberCores.p3.notes"] = "Brokk asks you to write down in his notes what you see. Page two hundred and fourteen is free. Hold the rune to the eyes of the Sleeping Colossus; he wants to know if it is the same fire.",
	["quest.emberCores.text"] = "Get four ember cores from the golems, test the eyes of the Sleeping Colossus with the rune and talk to Brokk.",
	["quest.emberCores.done"] = "Red, not blue? Brokk went pale when he heard it. It is Azgor's fire. The golems in the Fields are his, and Azgor himself no longer sits in chains.",
	["quest.emberCores.brokk"] = "Red. Not blue. It is his fire, and if the golems carry it in their chests, Azgor no longer sits in chains.",
	["quest.emberCores.say.how"] = "How do I take a core out of a golem?",
	["quest.emberCores.say.how.reply"] = "Brokk says: carefully. And only once it stops moving.",
	["quest.emberCores.say.colossus"] = "The Colossus first.",
	["quest.emberCores.say.colossus.reply"] = "Good. Brokk would rather know sooner than later. So would I.",
	["quest.emberCores.say.why"] = "Why a fire that never goes out?",
	["quest.emberCores.say.why.reply"] = "He says runes fall asleep like people. You must wake them before they forget what they are.",
	["quest.emberCores.bark.accept1"] = "Four cores. Not five. Five is greed.",
	["quest.emberCores.bark.half1"] = "Half the work. The golems have noticed too.",
	["quest.emberCores.bark.near1"] = "Hold the rune to the eye. Not the brow. The eye.",
	["quest.emberCores.bark.done1"] = "Red, not blue. He is free.",
	["quest.golems.p1"] = "If the golems are Azgor's, the Fields are his guard. The way to Deepforge runs through them and past the scorpions by the road.",
	["quest.golems.p2"] = "Clear the way before we send anyone under the Forge Mountain.",
	["quest.golems.bark.accept1"] = "Golems in the Fields, scorpions by the road. Do not stand in the lava.",
	["quest.golems.bark.half1"] = "Half the way is clear. The golems feel no fear; you should.",
	["quest.golems.bark.done1"] = "The road to Deepforge is free. Come back.",
	["quest.burntTemple.title"] = "A Bell for the Dead",
	["quest.burntTemple.p1"] = "In the south, past the Fire Vein, there was a town. Now there are only chimneys and a temple without a dome. Someone still lights candles there.",
	["quest.burntTemple.p2"] = "It is a hermit, Brother Kaspar. I want to know what he saw, because nobody from the town fled west.",
	["quest.burntTemple.p3"] = "Imps nest in the ashes. Kaspar does not step past the temple's threshold.",
	["quest.burntTemple.text"] = "Find Brother Kaspar in the Burnt Ruins, drive off the imps and strike the bell for the dead.",
	["quest.burntTemple.done"] = "I heard the bell all the way here. Kaspar says the flame fell from the sky in one night, and in the morning those who lived were led east on a chain, towards Deepforge. A man in a grey cloak led them, and the fire stepped out of his way. The same man as in the bandits' orders.",
	["quest.burntTemple.kaspar"] = "I saw him. A grey cloak, empty hands. He walked through the flames as through rain, and they parted before him. Strike the bell if you can. The dead should know someone still counts them.",
	["quest.burntTemple.say.empty"] = "I will go empty-handed.",
	["quest.burntTemple.say.empty.reply"] = "Wise. Those who lived through a fire do not like people with torches.",
	["quest.burntTemple.say.way"] = "How do I get there?",
	["quest.burntTemple.say.way.reply"] = "Over the bridge across the Fire Vein, then straight to the square. The temple stands past the fountain.",
	["quest.burntTemple.say.candles"] = "Who gives him candles?",
	["quest.burntTemple.say.candles.reply"] = "No one. He gathers stubs from the houses. There are many houses.",
	["quest.burntTemple.bark.accept1"] = "Speak to him quietly.",
	["quest.burntTemple.bark.half1"] = "The imps scattered. Do not chase them through the cellars.",
	["quest.burntTemple.bark.near1"] = "The bell lies at the foot of the tower.",
	["quest.burntTemple.bark.done1"] = "You can hear it all the way here.",
	["quest.wyvernLair.title"] = "The Sky Road",
	["quest.wyvernLair.p1"] = "The wyverns of the Crags fly by night now, north, and come back without a load.",
	["quest.wyvernLair.p2"] = "In the Wyvern Lair the strongest of them wear harnesses. Take two off and bring them.",
	["quest.wyvernLair.p3"] = "If the cult trains wyverns, then the weapons of Deepforge do not go by road.",
	["quest.wyvernLair.text"] = "Go down into the Wyvern Lair, defeat the strongest wyverns and take two harnesses of the cult.",
	["quest.wyvernLair.done"] = "On the harnesses is a snowflake pierced by a thorn, the same sign as in the Meadows and in Duskwood. The wyverns carry the weapons of Deepforge to the Frost Peaks. It is the cult's road through the sky.",
	["quest.wyvernLair.say.dead"] = "I will take the harnesses off the dead.",
	["quest.wyvernLair.say.dead.reply"] = "Off the living it would be harder.",
	["quest.wyvernLair.say.heat"] = "Is the lair hot?",
	["quest.wyvernLair.say.heat.reply"] = "Like a furnace. Take this, Ysolde sent a few for such places.",
	["quest.wyvernLair.say.north"] = "Where do they fly?",
	["quest.wyvernLair.say.north.reply"] = "North. That is what I want to know better.",
	["quest.wyvernLair.bark.accept1"] = "The lair is in the plateau past the Stone Wyvern.",
	["quest.wyvernLair.bark.half1"] = "Half behind you. The wyverns in the lair already know why you came.",
	["quest.wyvernLair.bark.done1"] = "A snowflake pierced by a thorn. Again.",
	["quest.ashRoad.title"] = "The Stone Caravan",
	["quest.ashRoad.p1"] = "On the Ash Road stands a caravan turned to stone: a wagon, oxen, people. The basilisks guard it as their own.",
	["quest.ashRoad.p2"] = "The dwarven renegades used that road. Someone may have left by the wagon what they did not manage to deliver.",
	["quest.ashRoad.p3"] = "Search the wagon and thin out the basilisks.",
	["quest.ashRoad.text"] = "Search the stone wagon on the Ash Road and thin out the basilisks.",
	["quest.ashRoad.done"] = "A letter to the renegades' leader. \"The dragon's hoard for melting the Chains. Do not put out Azgor until the last link has run.\" Signed: the Voice of Winter. Anzelm spoke that name in a whisper.",
	["quest.ashRoad.say.what"] = "What am I looking for?",
	["quest.ashRoad.say.what.reply"] = "Something that is not made of stone.",
	["quest.ashRoad.say.stone"] = "Did the basilisks turn them to stone?",
	["quest.ashRoad.say.stone.reply"] = "No. The basilisks only moved in.",
	["quest.ashRoad.say.hunt"] = "The basilisks first.",
	["quest.ashRoad.say.hunt.reply"] = "Sensible. They do not like anyone digging in their wagon.",
	["quest.ashRoad.bark.accept1"] = "The wagon stands on the Ash Road, by the stone kings.",
	["quest.ashRoad.bark.half1"] = "The basilisks thin out. Do not look into their eyes longer than you must.",
	["quest.ashRoad.bark.stuck1"] = "The wagon stands by the road past the avenue of kings.",
	["quest.ashRoad.bark.done1"] = "The Voice of Winter. Anzelm spoke that name in a whisper.",
	["quest.deepforge.p1"] = "The gate in the Forge Mountain stands open. Inside, the renegades forge weapons marked with the dragon's claw, and crates wait to be shipped north.",
	["quest.deepforge.p2"] = "Brokk knows the way: through the Great Forge to the Heart, where the Chains lie.",
	["quest.deepforge.p3"] = "Start with those who guard the anvils.",
	["quest.deepforge.bark.accept1"] = "The gate of Deepforge stands open. Do not go in with empty waterskins.",
	["quest.deepforge.bark.half1"] = "The anvils fall silent one after another.",
	["quest.deepforge.bark.done1"] = "That will do. Get out before they notice who is missing.",
	["quest.runesOfBinding.title"] = "Runes of Binding",
	["quest.runesOfBinding.p1"] = "From the Heart of the Forge came the news Brokk feared: the Chains of Winter are half melted. By them lies a spearhead the fire did not touch.",
	["quest.runesOfBinding.p2"] = "Brokk says it is the head of Vael's Thorn, given to the dwarves for safekeeping. No one carries it out bare-handed: it needs a setting of mithril and runes.",
	["quest.runesOfBinding.p3"] = "Bring mithril and defeat the magma golems that guard the Heart. Brokk waits by the Ribcage Gate.",
	["quest.runesOfBinding.text"] = "Gather five veins of mithril, defeat four elite magma golems in Deepforge and return to Brokk.",
	["quest.runesOfBinding.done"] = "The setting is done. Look, the runes on the spearhead light up blue. The Chains will not hold for long. But the spearhead is ours.",
	["quest.runesOfBinding.done.why"] = "I told you runes must be woken. Look, they light up blue. The Chains will not hold for long. But the spearhead is ours.",
	["quest.runesOfBinding.brokk"] = "Good mithril. Give it here, I will forge the setting. My hands still hurt, but the hammer remembers.",
	["quest.runesOfBinding.say.where"] = "Where do I look for mithril?",
	["quest.runesOfBinding.say.where.reply"] = "Brokk says: a blue vein in black rock. If you do not see it, ask again.",
	["quest.runesOfBinding.say.spear"] = "Whose spearhead is it?",
	["quest.runesOfBinding.say.spear.reply"] = "Vael's. The dwarves kept it three hundred years and nearly lost it in one winter.",
	["quest.runesOfBinding.say.who"] = "Who else can forge such runes?",
	["quest.runesOfBinding.say.who.reply"] = "Brokk says four could. Three now forge for the dragon.",
	["quest.runesOfBinding.bark.accept1"] = "Five veins. Not a grain less.",
	["quest.runesOfBinding.bark.half1"] = "Mithril and golems. Any order, the same result.",
	["quest.runesOfBinding.bark.done1"] = "The runes knew it. Now nothing will melt it.",
	["quest.forgeChains.title"] = "Chained in the Forge",
	["quest.forgeChains.p1"] = "In the Smelter and the Armoury work people of the burnt town and those of my brothers who did not join the renegades. They are chained to posts by the hearths.",
	["quest.forgeChains.p1.gate"] = "No gate this time. In Deepforge the echo carries all the way to Azgor. In the Smelter and the Armoury, people of the burnt town and my loyal brothers work chained to posts.",
	["quest.forgeChains.p2"] = "Before you face Azgor, set them free. Three posts, three keys of runes. The flamesmiths will not let you do it kindly.",
	["quest.forgeChains.p3"] = "The renegades are not alone down there. Deep in the Forge there is no law: beware of anyone who bears a weapon, not only the smiths.",
	["quest.forgeChains.text"] = "Free the captives in the Smelter, in the Armoury and by the Heart of the Forge, and defeat ten flamesmiths.",
	["quest.forgeChains.done"] = "The captives reached the camp. One of the townsfolk carried a little bell from the town chapel and gave it to Brokk for Kaspar. Now only Azgor is left.",
	["quest.forgeChains.say.alone"] = "I will go without you.",
	["quest.forgeChains.say.alone.reply"] = "You will not. Keys of runes obey the hand that forged them.",
	["quest.forgeChains.say.smiths"] = "The smiths first.",
	["quest.forgeChains.say.smiths.reply"] = "Good. The captives waited a month, they can wait a little longer.",
	["quest.forgeChains.say.keys"] = "Show me the keys.",
	["quest.forgeChains.say.keys.reply"] = "Three runes, three posts. Each knows its own.",
	["quest.forgeChains.bark.accept1"] = "We meet in the first hall of Deepforge. I have the keys with me.",
	["quest.forgeChains.bark.half1"] = "Half the work. The smiths already know we are here.",
	["quest.forgeChains.bark.near1"] = "My grandfather cast steel for the hinges of the Chains in this forge.",
	["quest.forgeChains.bark.near2"] = "Four hundred and twelve axes with the claw. I counted twice, slower the second time.",
	["quest.forgeChains.bark.near3"] = "Seven generations of forging. Half a night to melt it.",
	["quest.forgeChains.bark.death1"] = "Get up. The smiths do not wait. I do.",
	["quest.forgeChains.bark.done1"] = "All of them free. Only he is left.",
	["quest.forgeChains.comp.join1"] = "The keys obey the hand that forged them. Lead, I am behind you.",
	["quest.forgeChains.comp.wait1"] = "I wait. The flamesmiths do not.",
	["quest.forgeChains.comp.back1"] = "I will lead them out. You finish the smiths.",
	["quest.azgor.p1"] = "Before the gate of the Furnace the Chains keep heating. While Azgor burns, the melting will not stop.",
	["quest.azgor.p2"] = "Brokk says Azgor is not evil the way the dragon is. He is a fire whose cage someone opened, promising him a world to burn.",
	["quest.azgor.p3"] = "Put him out.",
	["quest.azgor.bark.accept1"] = "The Furnace lies past the Heart of the Forge. Come back to us alive, glory can wait.",
	["quest.azgor.bark.done1"] = "Azgor is out? Come back to the city. I must hear it from you.",
	["quest.coldFire.title"] = "Cold Fire",
	["quest.coldFire.p1"] = "Azgor is out, but the Chains have already melted. The second seal broke before anyone could stop it.",
	["quest.coldFire.p2"] = "Yet the Thorn's spearhead is ours. Take it to Dorgan: Anzelm has already brought him the branch of the Elder Tree.",
	["quest.coldFire.p3"] = "Then go to Anzelm. The chronicle has one more page.",
	["quest.coldFire.p3.empty"] = "Kesra writes of empty hands at the hermit's door. Anzelm comes like that too. Go to him once Dorgan is done: the chronicle has one more page.",
	["quest.coldFire.p4"] = "The north wind brings snow in midsummer. Scout Halvar waits on the Frost Peaks.",
	["quest.coldFire.text"] = "Take the Thorn's spearhead to Blacksmith Dorgan and talk to Brother Anzelm.",
	["quest.coldFire.done"] = "Dorgan has set the spearhead on the shaft. The Thorn is almost whole. Anzelm says only the Watch's oath is missing, and the Order of the Frost Watch froze at its post. Set out for the Peaks when you are ready.",
	["quest.coldFire.blacksmith"] = "The Thorn's spearhead? Give it here. The branch of the Elder Tree has waited with me a week, as if it knew you would come.",
	["quest.coldFire.anzelm"] = "The last page of the chronicle speaks of the Watch's oath. The Order of the Frost Watch kept it on the Peaks. Nobody has come back from there since winter.",
	["quest.coldFire.say.dorgan"] = "Dorgan first.",
	["quest.coldFire.say.dorgan.reply"] = "He is in the forge. He is always in the forge.",
	["quest.coldFire.say.anzelm"] = "Anzelm first.",
	["quest.coldFire.say.anzelm.reply"] = "As you like. He will say he knew anyway.",
	["quest.coldFire.say.tired"] = "The Wastes burnt me out.",
	["quest.coldFire.say.tired.reply"] = "They burn everyone out. Then winter comes and you stop feeling it.",
	["quest.coldFire.bark.accept1"] = "Dorgan is in the forge, Anzelm in the temple. Your order.",
	["quest.coldFire.bark.half1"] = "One done. The other waits in the city.",
	["quest.coldFire.bark.done1"] = "Rest. There will be no rest on the Peaks.",
	["quest.item.supplyLedger"] = "Supply ledger",
	["quest.item.emberCore"] = "Ember core",
	["quest.item.cultHarness"] = "Cult harness",
	["quest.item.spearhead"] = "Thorn's spearhead",
	["quest.use.chest"] = "Open the chest",
	["quest.use.cage"] = "Open the cage",
	["quest.use.eyes"] = "Hold the rune to the glow",
	["quest.use.bell"] = "Strike the bell",
	["quest.use.stoneWagon"] = "Search the stone wagon",
	["quest.use.shackles"] = "Break the shackles",
	["place.caravanRemains"] = "The caravan's remains in the Dead Oasis",
	["place.orcCages"] = "The prisoners' cages in the orc camp",
	["place.kasparThreshold"] = "Brother Kaspar's threshold",
	["place.mithrilVein"] = "A mithril vein in the Golem Fields",
	["npc.runesmith_brokk.name"] = "Brokk the Runesmith",
	["npc.runesmith_brokk.role"] = "Runesmith",
	["npc.runesmith_brokk.greeting"] = "Runes do not lie. People do. What do you want?",
	["npc.runesmith_brokk.line1"] = "Deepforge had seven gates and not one lock. Nobody stole from the dwarves.",
	["npc.runesmith_brokk.line2"] = "Seven generations forged the Chains. Every link bears a smith's name.",
	["npc.runesmith_brokk.line3"] = "Fire is not evil. Fire has a master. It is worse when the master changes.",
	["npc.runesmith_brokk.where"] = "by the Ribcage Gate, next to Kesra",
	["npc.shaman_ghasha.name"] = "Ghasha the Shaman",
	["npc.shaman_ghasha.role"] = "Orc shaman",
	["npc.shaman_ghasha.greeting"] = "Your scent is of the cage. Mine too. Sit by the water.",
	["npc.shaman_ghasha.line1"] = "The grey men's gold does not warm the hand. Who takes it is no longer of the clan.",
	["npc.shaman_ghasha.line2"] = "The ancestors live in the spring's steam. They say little, but they do not lie.",
	["npc.shaman_ghasha.line3"] = "The young of the clan listen to the drum, not to the elders. And the drum beats for gold.",
	["npc.shaman_ghasha.where"] = "by the Hot Spring",
	["npc.hermit_kaspar.name"] = "Brother Kaspar",
	["npc.hermit_kaspar.role"] = "Hermit",
	["npc.hermit_kaspar.greeting"] = "Shake the ash off your boots before you come in. People lie here.",
	["npc.hermit_kaspar.line1"] = "The bell cracked the night the fire fell. Nobody has struck it since.",
	["npc.hermit_kaspar.line2"] = "I saw him. A grey cloak, empty hands. He walked through the flames as through rain, and they parted before him.",
	["npc.hermit_kaspar.line3"] = "I know the names of everyone who lived here. I say them every evening, so they do not die a second time.",
	["npc.hermit_kaspar.where"] = "before the burnt temple in the Burnt Ruins",
	["cutscene.ch3_title.title"] = "The Ashen Wastes",
	["cutscene.ch3_title.l1"] = "Past the Ribcage Gate the grass ends. The ash has lain here since times no one remembers.",
	["cutscene.ch3_title.l2"] = "In the east the glow does not fade even at noon. Someone feeds a fire that was meant to sleep.",
	["cutscene.ch3_cages.l1"] = "You open a stranger's cage. Why?",
	["cutscene.ch3_cages.l2"] = "The drum went quiet. For a moment. Do not stand here when it starts again.",
	["cutscene.ch3_cages.l3"] = "The war drum falls silent, then starts to beat again.",
	["cutscene.ch3_bell.l1"] = "The first time since that night.",
	["cutscene.ch3_bell.l2"] = "Do you hear? Someone still counts you.",
	["cutscene.ch3_bell.l3"] = "The smoke stops seeping from the bell tower.",
	["cutscene.ch3_wyvern.l1"] = "There. Flying north, low, with a load.",
	["cutscene.ch3_wyvern.l2"] = "A road through the sky. We will not stop it with a sword.",
	["cutscene.ch3_forge.title"] = "Deepforge",
	["cutscene.ch3_forge.subtitle"] = "Here the Chains of Winter were forged",
	["cutscene.ch3_forge.l1"] = "The stone kings still hold their hammers. Someone chiselled off their faces and carved a flame in their place.",
	["cutscene.ch3_runes.l1"] = "Look. The runes knew it.",
	["cutscene.ch3_runes.l2"] = "Three hundred years it lay by the Chains and did not melt. Now it goes where it is needed.",
	["cutscene.ch3_runes.l3"] = "The runes on the spearhead light up blue.",
	["cutscene.ch3_freed.l1"] = "We thought nobody would come.",
	["cutscene.ch3_freed.l2"] = "I have a bell from our chapel. Brother Kaspar should have it.",
	["cutscene.ch3_azgor.l1"] = "The Furnace goes out. The moat of lava blackens and cools.",
	["cutscene.ch3_azgor.l2"] = "The cold one… paid… for my fire…",
	["cutscene.ch3_end.l1"] = "Dwarven work. It sits on the shaft as if it had been waiting for it.",
	["cutscene.ch3_end.l2"] = "Only the oath is missing. The Watch will give it, or no one will.",
	["cutscene.ch3_end.l3"] = "The north is waiting.",
	["cutscene.who.freedSmith"] = "Freed smith",
	["cutscene.who.freedVillager"] = "Freed townsman",
	["story.chapter.3.end"] = "End of Chapter III",
	-- S105: story chapter IV "The Long Winter" and the finale "The First Spring" (docs/FABULA.md §2.5)
	["story.chapter.5"] = "Finale: The First Spring",
	["quest.frostpeak.p1"] = "Dorgan has set the spearhead on the shaft from the Elder Tree. The Thorn looks like a weapon, but it is not one yet: it lacks the oath of the Watch.",
	["quest.frostpeak.p2"] = "Halvar writes from the north that wolves and yetis have taken the passes, and that at night a roar comes down the mountains and silences the village dogs.",
	["quest.frostpeak.p3"] = "The Order of the Ice Guard kept these mountains before it froze at its post. If anyone still remembers its oath, it is up there. Climb to the Frost Peaks and clear the passes.",
	["quest.frostpeak.bark.accept1"] = "Take a warm cloak. On the Peaks summer ends at the first cairn.",
	["quest.frostpeak.bark.half1"] = "Halvar writes that the wolves are falling back. The yetis are not.",
	["quest.frostpeak.bark.done1"] = "The passes are clear. Now there is only the wind. And that roar.",
	["quest.trappersCamp.title"] = "The Abandoned Camp",
	["quest.trappersCamp.p1"] = "In the autumn a band of trappers was meant to come down before the blizzards. They never did. No furs came down, and no word either.",
	["quest.trappersCamp.p2"] = "Their guide, Sigrun, went back up alone to follow their trail. She sits in the abandoned camp in the valley and will not come down to people.",
	["quest.trappersCamp.p3"] = "Leopards have circled the camp for a week. Go to her before they do what they are waiting for. The camp lies in the valley beyond the horned cairn.",
	["quest.trappersCamp.text"] = "Find Sigrun in the abandoned trappers' camp in the Ice Wolf Valley and thin out the leopards besieging it.",
	["quest.trappersCamp.done"] = "My brother Arne led the band up the old path to the Ice Grotto. Nine days ago. He said they would be back before the full moon. The full moon was three nights ago.",
	["quest.trappersCamp.sigrun"] = "Do not just stand there. The leopards look at you longer than I do.",
	["quest.trappersCamp.say.where"] = "Where is this camp?",
	["quest.trappersCamp.say.where.reply"] = "In the valley, beyond the horned cairn. I will mark it for you.",
	["quest.trappersCamp.say.sigrun"] = "Who is Sigrun?",
	["quest.trappersCamp.say.sigrun.reply"] = "A guide. She spits over her left shoulder before every bridge. She has never lost anyone yet.",
	["quest.trappersCamp.say.alone"] = "She went back alone? Brave.",
	["quest.trappersCamp.say.alone.reply"] = "Or stubborn. In the mountains it is the same thing.",
	["quest.trappersCamp.bark.accept1"] = "The leopards have circled for a week. Do not go there after dark.",
	["quest.trappersCamp.bark.half1"] = "The leopards begin to keep away from you. Good.",
	["quest.trappersCamp.bark.near1"] = "Stop on the threshold. You do not walk into an empty camp without a word.",
	["quest.trappersCamp.bark.done1"] = "You came. Sit by the fire, though it went out long ago.",
	["quest.trappersCamp.bark.death1"] = "Leopards hunt low, right along the snow. Watch your feet.",
	["quest.iceGrotto.title"] = "The Singing Ice",
	["quest.iceGrotto.p1"] = "Arne led them up the old path of the order, higher than trappers go. He always carried his journal and wrote in it every evening.",
	["quest.iceGrotto.p1.sigrun"] = "Halvar told you about my superstitions. Good. Then I need not explain why I leave bread on the threshold. Arne led them up the order's old path. He had his journal with him.",
	["quest.iceGrotto.p2"] = "The path ends in the Ice Grotto. For a week the yetis have been coming down the slopes from there, as if running from something.",
	["quest.iceGrotto.p3"] = "Go to the Grotto. If they live, bring them back. If not, bring me Arne's journal. I will walk with you to the mouth, no further.",
	["quest.iceGrotto.text"] = "Go with Sigrun to the Ice Grotto, defeat the yeti chieftains and find the journal of her brother Arne.",
	["quest.iceGrotto.done"] = "I read until dawn. They froze in the Grotto, all of them. The last page speaks of the order's old path towards the glacier, and of the ice singing. The glacier is waking.",
	["quest.iceGrotto.done.promise"] = "You promised her you would bring them back. You brought their words. That was all there was. They froze in the Grotto, and Arne writes of the order's path to the glacier. It is waking.",
	["quest.iceGrotto.say.promise"] = "I will bring them back.",
	["quest.iceGrotto.say.promise.reply"] = "Do not make promises in the mountains. The mountains listen, and they like to argue.",
	["quest.iceGrotto.say.wind"] = "Ice does not sing. It is the wind.",
	["quest.iceGrotto.say.wind.reply"] = "Arne said so too. He wrote it in his journal.",
	["quest.iceGrotto.say.supplies"] = "What should I take?",
	["quest.iceGrotto.say.supplies.reply"] = "Fire and potions. Yetis do not like fire. Take these two, they are strong.",
	["quest.iceGrotto.bark.accept1"] = "I will spit over my shoulder after you. Do not look back.",
	["quest.iceGrotto.bark.half1"] = "The yetis run downhill. Something is driving them out.",
	["quest.iceGrotto.bark.near1"] = "I stay here. If the ice sings, I do not want to hear whose voice it has.",
	["quest.iceGrotto.bark.done1"] = "Come back. We will read the journal together.",
	["quest.iceGrotto.comp.join1"] = "I will go with you to the Grotto. I will not go inside.",
	["quest.iceGrotto.comp.wait1"] = "Not so fast. On this slope the yetis walk in pairs.",
	["quest.iceGrotto.comp.back1"] = "I lost you among the rocks. I am going back to the camp.",
	["quest.harpyRocks.title"] = "The Harpies' Nests",
	["quest.harpyRocks.p1"] = "Harpies carry anything that glitters to their nests. Buckles, arrowheads, rings. Also what was left of the climbers at the foot of the Queen's Spire.",
	["quest.harpyRocks.p2"] = "The climbers have lain there since autumn with no stone on their chests. Bury them our way, thin out the harpies and see what they stole.",
	["quest.harpyRocks.text"] = "Bury the climbers at the foot of the Harpy Queen's Spire, thin out the harpies and search their nests.",
	["quest.harpyRocks.done"] = "A seal of the Order of the Ice Guard. A snowflake pierced by a thorn, the same sign as on the Meadows. A harpy took it from someone's chest. I will keep it for now.",
	["quest.harpyRocks.say.shiny"] = "Harpies steal trinkets?",
	["quest.harpyRocks.say.shiny.reply"] = "Buckles, arrowheads, rings. Once they took the bell off my sledge. Along with the sledge.",
	["quest.harpyRocks.say.climbers"] = "Who were the climbers?",
	["quest.harpyRocks.say.climbers.reply"] = "People who wanted to see the Spire up close. They did.",
	["quest.harpyRocks.say.where"] = "Where is their camp?",
	["quest.harpyRocks.say.where.reply"] = "At the foot of the Harpy Queen's Spire. I will mark it.",
	["quest.harpyRocks.bark.accept1"] = "Take a shovel. The harpies will not give the dead back on their own.",
	["quest.harpyRocks.bark.half1"] = "The nests are emptying. Look for metal in them.",
	["quest.harpyRocks.bark.near1"] = "A stone on the chest, the ice axe on top. That is how the mountains bury.",
	["quest.harpyRocks.bark.done1"] = "The same sign as on the Meadows. Snowflake and thorn.",
	["quest.giants.p1"] = "The frost giants have closed the pass. They no longer hunt, they march. All of them one way, towards the Frozen Hold.",
	["quest.giants.p2"] = "Before you face them, upgrade your weapon to +5. A giant will not notice a blow that does not break its hide. Then clear the pass.",
	["quest.giants.bark.accept1"] = "The giants march one way. Stand in their road.",
	["quest.giants.bark.half1"] = "Half the pass is clear. The rest can hear you coming.",
	["quest.giants.bark.done1"] = "The road is free. And nobody knows where they were going.",
	["quest.mammothTundra.title"] = "The Giants' Spoils",
	["quest.mammothTundra.p1"] = "In the giants' hunting camp, south of the mammoth graveyard, there is armour. Not a giant's. A knight's, torn off frosted bodies.",
	["quest.mammothTundra.p2"] = "Gather it before the giants forge it into spearheads. And thin out the mammoths: the giants are driving them to war.",
	["quest.mammothTundra.text"] = "Gather the armour of the order's knights in the giants' hunting camp and thin out the mammoths of the Mammoth Tundra.",
	["quest.mammothTundra.done"] = "Snowflake and thorn on the pauldrons. The giants are fighting something in the Frozen Hold. Someone there still keeps the watch.",
	["quest.mammothTundra.say.knights"] = "Whose armour is this?",
	["quest.mammothTundra.say.knights.reply"] = "The order's. Snowflake and thorn on the pauldrons.",
	["quest.mammothTundra.say.herd"] = "The herd first.",
	["quest.mammothTundra.say.herd.reply"] = "Sensible. Dead mammoths do not guard a camp.",
	["quest.mammothTundra.say.mammoths"] = "Mammoths going to war?",
	["quest.mammothTundra.say.mammoths.reply"] = "A giant on a mammoth is a war. A giant without one is only trouble.",
	["quest.mammothTundra.bark.accept1"] = "The armour lies in the snow. Do not leave it to the giants.",
	["quest.mammothTundra.bark.half1"] = "The herd thins. The giants will notice.",
	["quest.mammothTundra.bark.done1"] = "The order's armour. I will lay it by the fire.",
	["quest.mammothTundra.bark.stuck1"] = "The hunting camp is south of the graveyard. Look for smoke.",
	["quest.frozenHold.title"] = "The Frozen Hold",
	["quest.frozenHold.p1"] = "The Frozen Hold was the home of the Order of the Ice Guard before the glacier swallowed it. The giants broke in through a breach in the wall.",
	["quest.frozenHold.p2"] = "Something in there still fights. The giant chieftains lead their own inside, and fewer come out.",
	["quest.frozenHold.p3"] = "I will take you to the Breach. From there you go alone: defeat the giant chieftains and see who you meet inside.",
	["quest.frozenHold.text"] = "Go with Halvar to the Giants' Breach, enter the Frozen Hold and defeat the giant chieftains.",
	["quest.frozenHold.done"] = "The knights still stand their watch, you say. Only no longer for people. And over the courtyard hangs a flower of ice, pulsing. I do not like it.",
	["quest.frozenHold.say.order"] = "What do you know of the Order?",
	["quest.frozenHold.say.order.reply"] = "My grandmother said the Watch never sleeps. I thought it was a bedtime story.",
	["quest.frozenHold.say.breach"] = "How do I get into the Hold?",
	["quest.frozenHold.say.breach.reply"] = "Through the Breach. I will take you. I wait on the tundra, by the stone.",
	["quest.frozenHold.bark.accept1"] = "I wait by the stone on the tundra. Do not keep me freezing.",
	["quest.frozenHold.bark.half1"] = "The chieftains fall. The Hold grows quiet.",
	["quest.frozenHold.bark.done1"] = "Come back carefully. The ice in the Hold remembers everything.",
	["quest.frozenHold.comp.join1"] = "I will lead you to the Breach myself. Beyond it the walls remember only the Watch.",
	["quest.frozenHold.comp.wait1"] = "The tundra is flat, the mammoths are not. Keep close.",
	["quest.frozenHold.comp.arrive1"] = "Here is the Breach. Giants do not knock, so they made themselves a door.",
	["quest.frozenHold.comp.back1"] = "I lost you on the tundra. I wait by the stone.",
	["quest.frozenLake.title"] = "The Heart under the Ice",
	["quest.frozenLake.p1"] = "The crystals on the Frozen Lake all glow in one rhythm. Ice elementals are born beside them like flies by a carcass.",
	["quest.frozenLake.p2"] = "Thin out the elementals and break one crystal in the garden of ice. Then put your ear to the ice and listen.",
	["quest.frozenLake.text"] = "Thin out the ice elementals of the Frozen Lake and break a crystal in the garden of ice.",
	["quest.frozenLake.done"] = "Those are not crystals. That is a heart beating under the glacier. Faster and faster.",
	["quest.frozenLake.say.listen"] = "How do I listen to a crystal?",
	["quest.frozenLake.say.listen.reply"] = "Break it and put your ear to the ice. That is how my mother looked for fish.",
	["quest.frozenLake.say.where"] = "Where do the crystals grow?",
	["quest.frozenLake.say.where.reply"] = "In the garden of ice out on the lake. I will mark it.",
	["quest.frozenLake.bark.accept1"] = "The ice on the lake holds. So do the elementals.",
	["quest.frozenLake.bark.half1"] = "Fewer elementals. The crystals still glow.",
	["quest.frozenLake.bark.near1"] = "Do you hear it? Once, and once again.",
	["quest.frozenLake.bark.done1"] = "A heart under the glacier. I knew something was down there.",
	["quest.iceWatch.title"] = "The Last of the Ice Guard",
	["quest.iceWatch.p1"] = "Arne wrote that the last brother of the order died in the Ice Watch. But the trappers have seen a light there. Three winters running.",
	["quest.iceWatch.p1.wind"] = "You said ice does not sing. In the Watch someone sings at night. See whether that is the wind too. Arne wrote that the last brother of the order died there, yet the trappers see a light.",
	["quest.iceWatch.p2"] = "Frozen sentries stand before the gate. They let in no one who does not belong to the Watch.",
	["quest.iceWatch.p3"] = "Take the seal from the harpy nest. Get past the sentries and carry it to the keep. If anyone still keeps watch there, they will know this sign.",
	["quest.iceWatch.text"] = "Fight your way past the frozen sentries of the Ice Watch and carry the order's seal to the courtyard before the keep.",
	["quest.iceWatch.done"] = "My seal. They took it from Brother Edwin's chest when he fell on the slope. I am Halgrim, the last one the frost could not break. I know the words of the Watch's oath.",
	["quest.iceWatch.halgrim"] = "You carry the sign of the Watch. Come closer. I must see it.",
	["quest.iceWatch.say.light"] = "A light in a dead watchtower?",
	["quest.iceWatch.say.light.reply"] = "The trappers saw it three winters running. Sigrun says it is a soul. I say: go and see.",
	["quest.iceWatch.say.seal"] = "Will the Watch take a stranger?",
	["quest.iceWatch.say.seal.reply"] = "It took anyone who stood between the winter and those who sleep. So Arne writes.",
	["quest.iceWatch.bark.accept1"] = "Take the seal. The sentries at the gate do not ask your name.",
	["quest.iceWatch.bark.half1"] = "The sentries crumble to snow. Keep going.",
	["quest.iceWatch.bark.near1"] = "The gate. The icicles in it will not hold you, you can pass.",
	["quest.iceWatch.bark.done1"] = "Come closer. Show me the sign.",
	["quest.oathWords.title"] = "The Words of the Oath",
	["quest.oathWords.p1"] = "Twenty winters ago the frost came by night, with no horn and no fire. My brothers stood on the walls and stayed there. They stand there still.",
	["quest.oathWords.p2"] = "In the courtyard of the Hold hangs the Frost Flower. It holds them captive and makes them guard what killed them. Break it.",
	["quest.oathWords.p3"] = "Then go to the Chapel of Eternal Winter. By the order's sword, sealed in ice, repeat the words of the oath. I will give them to you.",
	["quest.oathWords.p4"] = "When you speak them, the Thorn of Vael will be whole: shaft, spearhead and oath. And the knights who still stand will be released from their service.",
	["quest.oathWords.text"] = "Break the Frost Flower in the courtyard of the Frozen Hold and swear the oath of the Watch by the sword in the Chapel of Eternal Winter.",
	["quest.oathWords.done"] = "Look at the spear in the light. A shaft from the Wood, a head from the Forge and an oath from the Peaks. The queen would be proud.",
	["quest.oathWords.done.you"] = "Halgrim stayed, you say. Someone always holds the Watch. Now you do too. Look at the spear: a shaft from the Wood, a head from the Forge and an oath from the Peaks.",
	["quest.oathWords.say.brothers"] = "What will happen to your brothers?",
	["quest.oathWords.say.brothers.reply"] = "They will sleep. For twenty winters they waited for an order no one gave.",
	["quest.oathWords.say.you"] = "And you?",
	["quest.oathWords.say.you.reply"] = "I stay. Someone must remember the words once you have spoken them.",
	["quest.oathWords.say.words"] = "Teach me the oath.",
	["quest.oathWords.say.words.reply"] = "By the sword. There the words weigh what they should.",
	["quest.oathWords.bark.accept1"] = "First the flower, then the chapel. Not the other way round.",
	["quest.oathWords.bark.half1"] = "My brothers kneel. They hear you.",
	["quest.oathWords.bark.done1"] = "The Thorn is whole. I can feel it even here.",
	["quest.oathWords.bark.death1"] = "The Watch does not end with one fall. Rise.",
	["quest.glacier.p1"] = "With the Thorn in hand the way to the lair lies open. The Glacier Heart is the cleft in the glacier's face, beyond the Dragon Temple.",
	["quest.glacier.p2"] = "Crystal guardians watch the entrance to the lair. Break them before the dragon wakes.",
	["quest.glacier.bark.accept1"] = "The crystal guardians do not sleep. The dragon still does.",
	["quest.glacier.bark.half1"] = "Half the guardians are down. The ice cracks louder.",
	["quest.glacier.bark.done1"] = "The lair is open. Can you hear it breathing?",
	["quest.dragonTemple.title"] = "The Waking Song",
	["quest.dragonTemple.p1"] = "The cult is singing in the Dragon Temple. Anzelm calls it the waking song. When the wind drops you can hear it down in the valley.",
	["quest.dragonTemple.p2"] = "The blue fires by the offering altars and at the colossus's feet carry the song. Whoever feeds them, sings.",
	["quest.dragonTemple.p3"] = "Put out the fires and break the dragonspawn guarding them. You may be in time, before the song ends.",
	["quest.dragonTemple.text"] = "Break the dragonspawn in the Dragon Temple and put out the blue fires by the altars and at the colossus's feet.",
	["quest.dragonTemple.done"] = "Too late. The song is over. And you saw him: the Voice of Winter has a face. It is Ilvar, the archivist of our temple.",
	["quest.dragonTemple.say.song"] = "What song is this?",
	["quest.dragonTemple.say.song.reply"] = "Anzelm calls it the waking song. Whoever hears it to the end never sleeps easy again.",
	["quest.dragonTemple.say.cult"] = "How many of them are there?",
	["quest.dragonTemple.say.cult.reply"] = "As many as believe the winter will spare them.",
	["quest.dragonTemple.say.fires"] = "I will put out the fires first.",
	["quest.dragonTemple.say.fires.reply"] = "Good. The dragonspawn will come on their own once the fires die.",
	["quest.dragonTemple.bark.accept1"] = "You can hear the song from the valley already. Hurry.",
	["quest.dragonTemple.bark.half1"] = "The singing fades. Someone still leads the tune.",
	["quest.dragonTemple.bark.done1"] = "You saw him. Come back before the glacier moves.",
	["quest.wyrmSpire.title"] = "The Wyrm Obelisk",
	["quest.wyrmSpire.p1"] = "On the Wyrm Spire the dragonspawn have raised an obelisk. Its runes glow brightest above the Bone Trail and call the brood to defend the lair.",
	["quest.wyrmSpire.p2"] = "Thin out the wyrms and break the obelisk before the dragon wakes and hears who is calling.",
	["quest.wyrmSpire.text"] = "Thin out the wyrms of the Wyrm Spire and break the dragonspawn's obelisk.",
	["quest.wyrmSpire.done"] = "The wyrms have scattered across the Spire. The way to the Heart is open.",
	["quest.wyrmSpire.say.wyrms"] = "Are wyrms dragons too?",
	["quest.wyrmSpire.say.wyrms.reply"] = "A wyrm is a dragon that never grew wings. It angers them more than it angers you.",
	["quest.wyrmSpire.say.obelisk"] = "Where is the obelisk?",
	["quest.wyrmSpire.say.obelisk.reply"] = "Above the Bone Trail, where the runes glow brightest. I will mark it.",
	["quest.wyrmSpire.bark.accept1"] = "The obelisk calls the brood. Silence it.",
	["quest.wyrmSpire.bark.half1"] = "Fewer wyrms. The obelisk calls louder.",
	["quest.wyrmSpire.bark.done1"] = "Silence on the Spire. The first in weeks.",
	["quest.wyrmSpire.bark.stuck1"] = "The obelisk stands higher, above the wyrm's skeleton.",
	["quest.eveOfBattle.title"] = "On the Eve",
	["quest.eveOfBattle.p1"] = "Before you go down to the dragon, go back to the city. Aldric wants to see you. So does Brother Anzelm.",
	["quest.eveOfBattle.p2"] = "Do not tell me there is no time. The dragon slept three hundred years, it can wait one more night.",
	["quest.eveOfBattle.p3"] = "Then come to the Dragon Stairs at dawn. You will not be alone there.",
	["quest.eveOfBattle.text"] = "Visit Captain Aldric and Brother Anzelm in Vaelthorn, then come to the Dragon Stairs at dawn.",
	["quest.eveOfBattle.done"] = "Aldric gave you the banner of Vaelthorn, Anzelm gave you his blessing. And by the Stairs the scouts of the four lands are waiting. Together for the first time.",
	["quest.eveOfBattle.captain"] = "Take the banner. Not to carry it. To remember who you walk for.",
	["quest.eveOfBattle.anzelm"] = "May the light guide your steps where mine cannot follow. And come back.",
	["quest.eveOfBattle.say.captain"] = "Aldric first.",
	["quest.eveOfBattle.say.captain.reply"] = "The captain does not like to wait. Not even on the eve.",
	["quest.eveOfBattle.say.anzelm"] = "Anzelm first.",
	["quest.eveOfBattle.say.anzelm.reply"] = "Anzelm prays at length. Keep that in mind.",
	["quest.eveOfBattle.say.afraid"] = "Are you afraid?",
	["quest.eveOfBattle.say.afraid.reply"] = "Every scout is afraid. The ones who are not never come back to report.",
	["quest.eveOfBattle.bark.accept1"] = "Go to the city. Come back at dawn.",
	["quest.eveOfBattle.bark.half1"] = "One more talk. Then the Stairs.",
	["quest.eveOfBattle.bark.done1"] = "You are here. So are the others.",
	["quest.vaelgrath.p1"] = "Vaelgrath is waking. The glacier is cracking from within, and the roar carries all the way to Vaelthorn.",
	["quest.vaelgrath.p2"] = "Three hundred years ago Queen Morvane wounded him with the Thorn of Vael. Now the same Thorn is in your hands.",
	["quest.vaelgrath.p3"] = "Go down into the Lair and end this, for Vaelthorn.",
	["quest.vaelgrath.bark.accept1"] = "Go. The Thorn knows where to strike.",
	["quest.vaelgrath.bark.done1"] = "The dragon is dead. Vaelthorn will celebrate tonight.",
	["quest.snowInSummer.title"] = "Snow in Midsummer",
	["quest.snowInSummer.p1"] = "So we thought. The square celebrated until midnight, and then it began to snow. In midsummer, on the tables and the torches.",
	["quest.snowInSummer.p2"] = "Anzelm says there was no heart in the dragon's body. Someone carried it away before it fell. Talk to him.",
	["quest.snowInSummer.p3"] = "Then go down to the Glacier Heart and see what is left there. Bring it to Halvar. If the winter still lives, he will know where.",
	["quest.snowInSummer.text"] = "So we thought. Talk to Brother Anzelm, go down to the Glacier Heart and bring what you see back to Halvar.",
	["quest.snowInSummer.done"] = "An empty chamber in the Glacier Heart. Tracks of the brood, fresh, leading to the Bone Trail. Something heavy was carried.",
	["quest.snowInSummer.anzelm"] = "The dragon was hollow. The heart of winter was carried out before it fell. Someone knew you were coming.",
	["quest.snowInSummer.say.feast"] = "Maybe it is just a cold night.",
	["quest.snowInSummer.say.feast.reply"] = "Cold nights do not pour snow on the tables in midsummer.",
	["quest.snowInSummer.say.where"] = "Where should I look?",
	["quest.snowInSummer.say.where.reply"] = "In the Glacier Heart. Halvar knows the way better than any chronicle.",
	["quest.snowInSummer.say.anzelm"] = "What does Anzelm say?",
	["quest.snowInSummer.say.anzelm.reply"] = "That there was no heart. I believe him. I would rather not.",
	["quest.snowInSummer.bark.accept1"] = "Snow on the square. Go, before people start to be afraid.",
	["quest.snowInSummer.bark.half1"] = "Anzelm is not wrong. He seldom is.",
	["quest.snowInSummer.bark.done1"] = "Tracks of the brood. Fresh. Sigrun will know where they lead.",
	["quest.dragonsBrood.title"] = "The Bone Trail",
	["quest.dragonsBrood.p1"] = "The young dragons carried the Heart of Winter out of the glacier. The brood still prowls the Glacier Heart, guarding an empty chamber.",
	["quest.dragonsBrood.p1.wind"] = "Sigrun asks whether you still think ice does not sing. You can answer her yourself, on the Trail. The young dragons carried the Heart of Winter away, and the brood guards the empty chamber.",
	["quest.dragonsBrood.p2"] = "Defeat the brood. Then go to Sigrun at the fork by the mammoth graveyard. She knows the Bone Trail and will lead you to the wyrm's skeleton.",
	["quest.dragonsBrood.text"] = "Defeat the young dragons in the Glacier Heart, then walk with Sigrun up the Bone Trail to the wyrm's skeleton.",
	["quest.dragonsBrood.done"] = "The trail leads higher, to the circle below the Spire's summit. Someone waits there. Barefoot, Sigrun says? I know who walks barefoot on snow.",
	["quest.dragonsBrood.say.trail"] = "Who knows the Bone Trail?",
	["quest.dragonsBrood.say.trail.reply"] = "Sigrun. She walked it with her brother. She waits by the mammoth graveyard.",
	["quest.dragonsBrood.say.brood"] = "Are young dragons dangerous?",
	["quest.dragonsBrood.say.brood.reply"] = "The young do not yet know what to fear. That is what makes them dangerous.",
	["quest.dragonsBrood.bark.accept1"] = "The brood guards an empty chamber. Break it.",
	["quest.dragonsBrood.bark.half1"] = "Fewer young ones. Sigrun waits by the mammoth bones.",
	["quest.dragonsBrood.bark.near1"] = "Stop. The brood's tracks, and human ones among them. Someone walked with them barefoot.",
	["quest.dragonsBrood.bark.done1"] = "Barefoot, Sigrun says? I know who walks barefoot on snow. Come back.",
	["quest.dragonsBrood.bark.death1"] = "Get up. The mountains are not done talking to us.",
	["quest.dragonsBrood.comp.join1"] = "Halvar says we go after dragons. I go after a trail. Keep to the road.",
	["quest.dragonsBrood.comp.join2"] = "I will spit over my shoulder. You may too. It does no harm.",
	["quest.dragonsBrood.comp.wait1"] = "Faster. The one I walked here with never fell behind.",
	["quest.dragonsBrood.comp.wait2"] = "Do not walk under the ribs. The wyrm's bones remember who passed them.",
	["quest.dragonsBrood.comp.arrive1"] = "I will not go under the ribs. The tracks go up, to the circle. Go back to Halvar.",
	["quest.dragonsBrood.comp.back1"] = "I lost you. I am going back to the fork. Do not walk here alone after dark.",
	["quest.voiceOfWinter.title"] = "The Voice of Winter",
	["quest.voiceOfWinter.p1"] = "Sigrun came down from the mountains before dawn. She says that in the circle below the Spire's summit someone stands by the Heart of Winter and sings.",
	["quest.voiceOfWinter.p2"] = "It is Ilvar. He is holding a rite: he means to take the Heart into himself and become the winter. Then there will be no one left to defeat.",
	["quest.voiceOfWinter.p3"] = "Dragonspawn and wyrms guard the way to the circle. Fight your way through them.",
	["quest.voiceOfWinter.p4"] = "Break the rite before it is complete. Sigrun will lead you to the circle. From there you go alone.",
	["quest.voiceOfWinter.text"] = "Reach the Rite Circle below the Spire's summit, fight through the dragonspawn and wyrms and break Ilvar's rite.",
	["quest.voiceOfWinter.done"] = "The frost he called has taken him. He stands in the circle now, his hand stretched out, made of ice. But the Heart of Winter still beats.",
	["quest.voiceOfWinter.say.alone"] = "I will go alone.",
	["quest.voiceOfWinter.say.alone.reply"] = "Not quite. Sigrun waits by the bones. She will take you to the circle, no one further.",
	["quest.voiceOfWinter.say.turn"] = "Can he be turned back?",
	["quest.voiceOfWinter.say.turn.reply"] = "Anzelm prays for him. I have seen what he left on the Meadows.",
	["quest.voiceOfWinter.say.supplies"] = "What should I take?",
	["quest.voiceOfWinter.say.supplies.reply"] = "Everything you have. And these, for the way back.",
	["quest.voiceOfWinter.bark.accept1"] = "Sigrun waits by the bones. Do not make her wait long.",
	["quest.voiceOfWinter.bark.half1"] = "The rite still goes on. You can hear it from here.",
	["quest.voiceOfWinter.bark.near1"] = "Do you see him? He is singing. I go no further. Someone must go back and tell it.",
	["quest.voiceOfWinter.bark.done1"] = "The Heart of Winter still beats. Come back.",
	["quest.voiceOfWinter.comp.join1"] = "The tracks go up. I will walk with you to the circle.",
	["quest.voiceOfWinter.comp.wait1"] = "Do not fall behind. Up this high the wind takes your voice.",
	["quest.voiceOfWinter.comp.back1"] = "I lost sight of you. I am going back to the bones.",
	["quest.firstSpring.title"] = "The First Spring",
	["quest.firstSpring.p1"] = "The Heart of Winter still beats, though no one calls to it now. While it beats, every summer in Vaelthorn will end in snow.",
	["quest.firstSpring.p2"] = "The queen wounded the dragon with the Thorn and went away. You will do what she had no time for: drive the Thorn of Vael into the Heart itself.",
	["quest.firstSpring.p3"] = "Then stay in the mountains until you become what the queen was to this land. The mountains will know when you are ready.",
	["quest.firstSpring.p4"] = "When you are, go back to Aldric. Say nothing. You will see for yourself.",
	["quest.firstSpring.text"] = "Drive the Thorn of Vael into the Heart of Winter in the Rite Circle, reach level 100 and return to Captain Aldric.",
	["quest.firstSpring.done"] = "Look at the city. The first spring in three hundred years.",
	["quest.firstSpring.done.afraid"] = "Halvar says that on the eve you asked him about fear. Good. Everyone who came back was afraid. Look at the city. The first spring in three hundred years.",
	["quest.firstSpring.say.stay"] = "I will stay as long as it takes.",
	["quest.firstSpring.say.stay.reply"] = "The queen stayed too. The mountains remember those who stay.",
	["quest.firstSpring.say.city"] = "What do I tell the city?",
	["quest.firstSpring.say.city.reply"] = "Nothing. They will see.",
	["quest.firstSpring.say.thorn"] = "Will the Thorn hold?",
	["quest.firstSpring.say.thorn.reply"] = "It held three hundred years in the dragon's wound. It will hold this too.",
	["quest.firstSpring.bark.accept1"] = "The circle waits. The Heart beats quieter, but it beats.",
	["quest.firstSpring.bark.half1"] = "The Thorn is in the Heart. Stay in the mountains until you are ready.",
	["quest.firstSpring.bark.done1"] = "Come back to the city. Something has changed here.",
