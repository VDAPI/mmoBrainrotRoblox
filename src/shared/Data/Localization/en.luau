	["path.scout.lightStep.desc"] = "+{lightStep} percentage points of dodge.",
	["path.scout.talons.name"] = "Sharp Talons",
	["path.scout.talons.desc"] = "Falcon strikes deal +{talons} percentage points of damage.",
	["path.scout.bond.name"] = "Falcon Bond",
	["path.scout.bond.desc"] = "Your falcon stays {bond} s longer. With Royal Falcon, its dive deals +{bondDive} percentage points of damage instead.",
	["path.scout.hardy.name"] = "Hardy Scout",
	["path.scout.hardy.desc"] = "+{hardy}% max health.",
	["path.scout.retreat.name"] = "Fall Back",
	["path.scout.retreat.desc"] = "Disengage's cooldown is {retreatPct}% shorter.",
	["path.scout.warning.name"] = "Warning",
	["path.scout.warning.desc"] = "When a monster within 30 studs starts a red-zone attack, your party within 40 studs (you included) takes {warning}% less damage until the wind-up ends and for 0.5 s after. At most once every 8 s; works alongside Vigilance.",
	["path.scout.trail.name"] = "Blood Trail",
	["path.scout.trail.desc"] = "When an enemy with Hunter's Mark dies, the mark and its remaining time pass to the nearest enemy within {trail} studs.",
	["path.scout.royalFalcon.name"] = "Royal Falcon",
	["path.scout.royalFalcon.desc"] = "After you call your Falcon, it stays until the fight ends (leaving 5 s later), and with the Spotting node its strikes apply Spotting. Hunter's Mark sends it diving at the marked target: 150% damage and a 1 s stun (not on bosses or players). It is support from the sky: the falcon cannot be hit.",
	["path.scout.quickMark.name"] = "Quick Mark",
	["path.scout.quickMark.desc"] = "Hunter's Mark's cooldown is {quickMarkPct}% shorter.",
	["path.scout.duet.name"] = "Hunting Duet",
	["path.scout.duet.desc"] = "Your falcon's strikes and dive deal {duet}% more damage.",
	["path.scout.beater.name"] = "Seasoned Beater",
	["path.scout.beater.desc"] = "The Drive's vulnerability and slow last {beater} s longer.",
	["path.scout.royalFalcon2.name"] = "Sovereign's Falcon",
	["path.scout.royalFalcon2.desc"] = "The interval between your falcon's strikes is {sovereignPace}% shorter (normally 2 s), and Spotting adds +{sovereignMark} percentage points of vulnerability.",
	-- S81: Mage paths (ROZWOJ 12), breakpoints B, the rework paragraph
	["rework.class.Mage"] = "Mage: Elementalist, Mana Shield, Elemental Fury, Evocation, Focus and Arcane Mind now belong to the paths and are bought with path points. Without Focus you have a smaller mana pool and slower regeneration until level 45. Meteor unlocks at level 30 and Thunderstorm at 45; put new base skills on your bar with the “To bar” button. Without your path's weapon, rows 3–11 are disabled.",
