	-- NPCs (S27)
	["npc.granary_keeper.name"] = "Steward Ignacy",
	["npc.granary_keeper.role"] = "Granary steward",
	["npc.granary_keeper.greeting"] = "Every sack recorded, every grain counted. Only there are fewer sacks every week.",
	["npc.granary_keeper.line1"] = "Winter comes in the same month every year. People are surprised every year.",
	["npc.granary_keeper.line2"] = "The granary is the heart of the city. An empty heart does not beat for long.",
	["npc.granary_keeper.line3"] = "I count the mice separately. They eat too, and they pay no taxes.",
	["npc.granary_keeper.where"] = "by the granary",
	["npc.brother_anzelm.name"] = "Brother Anzelm",
	["npc.brother_anzelm.role"] = "Monk",
	["npc.brother_anzelm.greeting"] = "May the light guide your steps. And when it fails, may good sense guide them.",
	["npc.brother_anzelm.line1"] = "Old places remember more than chronicles do. One only has to listen.",
	["npc.brother_anzelm.line2"] = "Prayer will not replace a sword. But a sword without prayer is easily lost.",
	["npc.brother_anzelm.line3"] = "Mirela the healer mends bodies. I try the rest, with mixed results.",
	["npc.brother_anzelm.where"] = "in front of the temple",
	["npc.fishwife.name"] = "Jagna the Fishwife",
	["npc.fishwife.role"] = "Fishwife",
	["npc.fishwife.greeting"] = "Fresh this morning! Well, yesterday morning. They still smell like fish.",
	["npc.fishwife.line1"] = "Father fishes on the Meadows, I sell in the city. It has always been so.",
	["npc.fishwife.line2"] = "Buy a fish without smelling it and you buy trouble.",
	["npc.fishwife.line3"] = "Wind from the gate. Rain is coming, and fish bite better in the rain.",
	["npc.fishwife.where"] = "at the fish stall",
	["npc.innkeeper.name"] = "Wacław the Innkeeper",
	["npc.innkeeper.role"] = "Innkeeper",
	["npc.innkeeper.greeting"] = "Sit down, traveller. The ale is cold, the bench is warm and the gossip is free.",
	["npc.innkeeper.line1"] = "An inn hears everything. The trick is remembering only what pays.",
	["npc.innkeeper.line2"] = "Whoever buys the round hears more. That is the rule.",
	["npc.innkeeper.line3"] = "The last hero who slept here left debts and half a sword.",
	["npc.innkeeper.gossip1"] = "I hear {npc} {where} is looking for a pair of hands.",
	["npc.innkeeper.gossip2"] = "Word is that {npc} {where} needs help. Pays fairly, they say.",
	["npc.innkeeper.gossip3"] = "{npc} {where} — there is work there for someone like you, I hear.",
	["npc.innkeeper.where"] = "at the inn",
	["npc.miller_widow.name"] = "Hanna the Miller's Widow",
	["npc.miller_widow.role"] = "Miller's widow",
	["npc.miller_widow.greeting"] = "My husband ran the mill on the Meadows. Now I only have this one, here.",
	["npc.miller_widow.line1"] = "Water turns the wheel no matter who died. Perhaps that is for the best.",
	["npc.miller_widow.line2"] = "Flour from the city mill is worse. But nobody will set it on fire.",
	["npc.miller_widow.line3"] = "They ask whether I will go back to the Meadows. I do not know. Not yet.",
	["npc.miller_widow.where"] = "at the mill by the river",
	["npc.stablemaster.name"] = "Radosz the Stablemaster",
	["npc.stablemaster.role"] = "Stablemaster",
	["npc.stablemaster.greeting"] = "Horses are more honest than people. You always know when they mean to kick you.",
	["npc.stablemaster.line1"] = "A horse knows the way home better than its rider. Remember that in fog.",
	["npc.stablemaster.line2"] = "Merchants pay me for stabling, bandits for silence. I turn the second lot down.",
	["npc.stablemaster.line3"] = "Oats cost more. Everything costs more since the road became dangerous.",
	["npc.stablemaster.where"] = "at the stable by the gate",
	["npc.sergeant.name"] = "Sergeant Dobiesław",
	["npc.sergeant.role"] = "Sergeant of the guard",
	["npc.sergeant.greeting"] = "Keep it short. The guard has more work than men.",
	["npc.sergeant.line1"] = "Wanted posters hang on the guardhouse wall. If you can read — and fight — take a look.",
	["npc.sergeant.line2"] = "The captain keeps the walls. I keep it from getting worse beyond them.",
	["npc.sergeant.line3"] = "Every bandit has someone selling him information. I am looking for that someone.",
	["npc.sergeant.where"] = "at the guardhouse",
	["npc.blacksmith.where"] = "at the forge",
	["npc.farmer_bartosz.name"] = "Bartosz the Farmer",
	["npc.farmer_bartosz.role"] = "Farmer",
	["npc.farmer_bartosz.greeting"] = "The soil here is good. Only everything on it wants to eat me or rob me.",
	["npc.farmer_bartosz.line1"] = "Cabbage grows by itself. So does whatever eats it.",
	["npc.farmer_bartosz.line2"] = "Ignacy thinks grain grows in sacks. Let him come out here once.",
	["npc.farmer_bartosz.line3"] = "The bees are gentle this year. At least they are.",
	["npc.farmer_bartosz.where"] = "on the farm past the Meadows gate",
	["npc.fisher_wit.name"] = "Wit the Fisherman",
	["npc.fisher_wit.role"] = "Fisherman",
	["npc.fisher_wit.greeting"] = "Quiet. Fish hear footsteps. Sadly, so do the toads.",
	["npc.fisher_wit.line1"] = "My Jagna sells everything I catch here in the city. A clever girl.",
	["npc.fisher_wit.line2"] = "On the pond they bite best at dawn. Even the marsh smells better then.",
	["npc.fisher_wit.line3"] = "I can sell you a rod. Patience I cannot sell, bring your own.",
	["npc.fisher_wit.where"] = "by Toad Pond",
	["npc.woodcutter_gerwazy.name"] = "Gerwazy the Woodcutter",
	["npc.woodcutter_gerwazy.role"] = "Woodcutter",
	["npc.woodcutter_gerwazy.greeting"] = "Mind where you stand. Trees fall where they like, not where I say.",
	["npc.woodcutter_gerwazy.line1"] = "The Old Forest was old before anyone called it that.",
	["npc.woodcutter_gerwazy.line2"] = "The crows here are shameless. Yesterday one took the bread out of my hand.",
	["npc.woodcutter_gerwazy.line3"] = "I sharpen the axe every morning. Myself every evening, with Wacław's ale.",
	["npc.woodcutter_gerwazy.where"] = "in a clearing of the Old Forest",
	["npc.merchant_lucjan.name"] = "Lucjan the Merchant",
	["npc.merchant_lucjan.role"] = "Merchant of the wrecked wagon",
	["npc.merchant_lucjan.greeting"] = "Once I had a wagon, horses and goods. Today I have only good manners.",
	["npc.merchant_lucjan.line1"] = "I drove this road for twenty years. This is the first time anyone stopped me.",
	["npc.merchant_lucjan.line2"] = "Southern cloth is worth more than my wagon. The bandits knew it.",
	["npc.merchant_lucjan.line3"] = "I will not leave the wagon until I get my goods back. I am stubborn.",
	["npc.merchant_lucjan.where"] = "by the wrecked wagon on the road",
	["npc.miner_dobromir.name"] = "Dobromir the Miner",
	["npc.miner_dobromir.role"] = "Miner",
	["npc.miner_dobromir.greeting"] = "The quarry is old, there is still ore. Only these kobolds...",
	["npc.miner_dobromir.line1"] = "Kobolds dig better than people. Pity they dig in my quarry.",
	["npc.miner_dobromir.line2"] = "I sell picks. Without a pick you have no business here.",
	["npc.miner_dobromir.line3"] = "Dorgan shouts that the ore is late. Let him go down to the third terrace himself.",
	["npc.miner_dobromir.where"] = "on the rim of the Old Quarry",
	["npc.hunter_borys.name"] = "Borys the Hunter",
	["npc.hunter_borys.role"] = "Hunter",
	["npc.hunter_borys.greeting"] = "Whisper. Echo carries far in the ravine, and bears have good ears.",
	["npc.hunter_borys.line1"] = "A bear does not attack without a reason. When it does, look for the reason.",
	["npc.hunter_borys.line2"] = "The waterfall drowns everything out. A good place for an ambush. For anyone.",
	["npc.hunter_borys.line3"] = "I dry the hides by the fire and smoke the meat. The rest is patience.",
	["npc.hunter_borys.where"] = "above Bear Ravine",

	-- Side quests (S27): title, pages, progress line, thanks
	["quest.side_granary.title"] = "The Grain Order",
	["quest.side_granary.p1"] = "The granary is near empty, and winter will not ask whether we are ready. Bartosz of the farm past the gate was to send grain two weeks ago.",
	["quest.side_granary.p2"] = "No cart, no word. Bartosz is stubborn but keeps his word — something must have held him up.",
	["quest.side_granary.p3"] = "Take him this order with the granary's seal. The farm stands by the road, west of the shrine under the old oak.",
	["quest.side_granary.progress"] = "Bartosz is waiting for the order. The farm lies just past the Meadows gate.",
	["quest.side_granary.done"] = "An order from Ignacy? I know, I know, I am late. Look around and you will see why.",
	["quest.side_rabbits.title"] = "The Long-Eared Plague",
	["quest.side_rabbits.p1"] = "Rabbits. Hundreds of rabbits. They ate half my cabbage field before I could grab the pitchfork.",
	["quest.side_rabbits.p2"] = "Thin them out on Rabbit Glade. Ten will do for the rest to get the message. Then we can talk about grain.",
	["quest.side_rabbits.progress"] = "Ten rabbits from the Glade. The ones from my field count double, but only in my head.",
	["quest.side_rabbits.done"] = "Quieter already. Good work. But that is only the start of my troubles.",
	["quest.side_fence.title"] = "A Fence Full of Holes",
	["quest.side_fence.p1"] = "Wolves go through my fence like water through a sieve. Four corners of the vegetable plot, every one broken.",
	["quest.side_fence.p2"] = "The boards are by the barn. Replace them at every corner while I keep watch over the cabbage.",
	["quest.side_fence.progress"] = "Four corners of the fence by the vegetable plot. Drive the boards in hard — wolves do not knock.",
	["quest.side_fence.done"] = "Now that is a fence! Let one of the grey ones try.",
	["quest.side_sheep.title"] = "Bells of My Sheep",
	["quest.side_sheep.p1"] = "The fence is one thing, but the sheep were lost before it. Wolves took them from the pasture, one by one.",
	["quest.side_sheep.p2"] = "Each had a bell with my mark. Wolves swallow them with the meat, stupid beasts that they are.",
	["quest.side_sheep.p3"] = "Bring me five bells. I cannot bring the sheep back, but I want to know how many I really lost.",
	["quest.side_sheep.progress"] = "You will find the bells in wolves. Look in the glades and on the slopes of the Wolf Hills.",
	["quest.side_sheep.done"] = "Five... All from my flock. At least I know where I stand. Thank you.",
	["quest.side_grainCart.title"] = "A Cart for the City",
	["quest.side_grainCart.p1"] = "With peace on the farm there is grain again. This sack is for Ignacy, the first of many.",
	["quest.side_grainCart.p2"] = "Only the wolves prowl the road to the city again. My boy is afraid to drive.",
	["quest.side_grainCart.p3"] = "Take the sack to the granary and thin out the wolves along the way. Ignacy will know how to thank you.",
	["quest.side_grainCart.progress"] = "A sack of grain for Ignacy in the city. And six fewer wolves by the road.",
	["quest.side_grainCart.done"] = "Grain from Bartosz! I thought they had buried him. The granary owes you — choose something from the guard's chest.",
	["quest.side_shrine.title"] = "Candles Under the Oak",
	["quest.side_shrine.p1"] = "Under the old oak on the Meadows stands a shrine older than the walls of this city. Nobody has lit a candle there since autumn.",
	["quest.side_shrine.p2"] = "Travellers say the nights on the Meadows have grown strangely quiet. I say that is no accident.",
	["quest.side_shrine.p3"] = "Light the candles in the shrine and lay an offering of three sprigs of meadowsweet. Leave the prayer to me.",
	["quest.side_shrine.progress"] = "The candles in the shrine under the oak and three sprigs of meadowsweet.",
	["quest.side_shrine.done"] = "I can feel it even here. The oak keeps watch again. Thank you.",
	["quest.side_stoneCircle.title"] = "The Stone Circle",
	["quest.side_stoneCircle.p1"] = "When the flame in the shrine caught, I read the old records. The shrine is only a gate. The true place lies higher.",
	["quest.side_stoneCircle.p2"] = "A stone circle stands on the ridge of the Wolf Hills. Lynxes made it their lair and stain it with blood.",
	["quest.side_stoneCircle.p3"] = "Go to the circle, see it with your own eyes and drive the lynxes off the hills. Eight should be enough.",
	["quest.side_stoneCircle.progress"] = "The stone circle on the Wolf Hills ridge and eight lynxes nearby.",
	["quest.side_stoneCircle.done"] = "The circle is empty and quiet again. As it should be. Take this — a blessing is no substitute for steel.",
	["quest.side_father.title"] = "Bread for Father",
	["quest.side_father.p1"] = "Father has sat by Toad Pond for a week and will not come back to the city. He says the nets will not haul themselves.",
	["quest.side_father.p2"] = "Take him this basket of bread. And tell him that if he does not eat, I will come in person.",
	["quest.side_father.progress"] = "A basket of bread for Wit. The fisherman's hut stands on the north shore of Toad Pond.",
	["quest.side_father.done"] = "From Jagna? Stubborn like her mother. Fine, I will eat. And since you are here...",
	["quest.side_toads.title"] = "Toads of the Marsh",
	["quest.side_toads.p1"] = "The toads have overrun the marsh. They eat the fry before it grows big enough for a pan.",
	["quest.side_toads.p2"] = "Twelve fewer and the water will breathe again. Mind the venom, it stings like the devil.",
	["quest.side_toads.progress"] = "Twelve toads from the marsh by Toad Pond.",
	["quest.side_toads.done"] = "You can hear the fish instead of the croaking already. I have one more thing for you.",
	["quest.side_venom.title"] = "Venom for a Cure",
	["quest.side_venom.p1"] = "My Jagna has coughed since winter. The alchemist in the city says she can make a syrup from marsh toad venom.",
	["quest.side_venom.p2"] = "I am too old to wade through the marsh, and the toads do not give up their venom kindly.",
	["quest.side_venom.p3"] = "Collect six pouches of venom and take them to Ysolde. Tied tight, for the gods' sake.",
	["quest.side_venom.progress"] = "Six pouches of toad venom for Ysolde the Alchemist in the city.",
	["quest.side_venom.done"] = "Fresh, thick venom... Enough for Jagna's syrup and a few elixirs for me. A fair trade, wouldn't you say?",
	["quest.side_net.title"] = "The Net by the Shore",
	["quest.side_net.p1"] = "The syrup helped, Jagna wrote to me. Now it is my turn to send her something.",
	["quest.side_net.p2"] = "My best net is stuck by the shore, past the jetty. I cannot haul it in myself, my back is not what it was.",
	["quest.side_net.p3"] = "Haul in the net and catch three fish. Take them to Jagna — let her know her father remembers her.",
	["quest.side_net.progress"] = "The net by the shore of Toad Pond and three fish caught for Jagna.",
	["quest.side_net.done"] = "Fish from father? The stubborn old man... Thank you. Take something from me, and do not refuse.",
	["quest.side_roast.title"] = "A Roast for the Feast",
	["quest.side_roast.p1"] = "The feast is around the corner and I have no meat. The boars in the Old Forest are fatter than ever.",
	["quest.side_roast.p2"] = "Six haunches and you drink on me till the end of the month. Well, till the end of the week.",
	["quest.side_roast.progress"] = "Six boar haunches from the Old Forest.",
	["quest.side_roast.done"] = "Now that is meat! The cook will weep for joy. Listen, I have one more favour to ask.",
	["quest.side_woodcutter.title"] = "A Barrel for the Woodcutter",
	["quest.side_woodcutter.p1"] = "Gerwazy, the woodcutter of the Old Forest, keeps me in firewood. He has not sent a single log in a month.",
	["quest.side_woodcutter.p2"] = "Take him a barrel of ale and ask what is going on. Ale usually loosens his tongue.",
	["quest.side_woodcutter.progress"] = "A barrel of ale for Gerwazy. The woodcutter's hut stands in a clearing by the forest path.",
	["quest.side_woodcutter.done"] = "Ale from Wacław? The old fox knows how to bribe me. Sit down, I will tell you about those cursed birds.",
	["quest.side_logs.title"] = "Felled and Marked",
	["quest.side_logs.p1"] = "I fell trees, stack the logs, and by morning half are scattered. It is not people. It is the crows.",
	["quest.side_logs.p2"] = "The carrion crows dig grubs from under the bark, wreck my stacks and then peck at the horses.",
	["quest.side_logs.p3"] = "Put my mark on five log piles in the forest so nobody takes them, and drive off eight carrion crows.",
	["quest.side_logs.progress"] = "Five log piles in the Old Forest to mark and eight fewer carrion crows.",
	["quest.side_logs.done"] = "Marks on the piles, crows gone. I can work again. Only one thing gives me no peace...",
	["quest.side_shiny.title"] = "The Carrion Crows' Hoard",
	["quest.side_shiny.p1"] = "Crows carry everything that shines to their nests. Buttons, nails, coins. Lately something more.",
	["quest.side_shiny.p2"] = "One dropped a ring with the mill's crest. The mill burned down last autumn, with the miller in it.",
	["quest.side_shiny.p3"] = "Take five shiny trinkets from the crows. If the miller's signet is among them, bring it to his widow, Hanna, in the city.",
	["quest.side_shiny.progress"] = "Five shiny trinkets from the carrion crows. All of it for Hanna, the miller's widow at the city mill.",
	["quest.side_shiny.done"] = "This... this is his signet. He wore it to the end. How would a crow get it, if my husband burned in the mill? Please, take this. And come back to me.",
	["quest.side_mill.title"] = "Ashes of the Mill",
	["quest.side_mill.p1"] = "They told me it was an accident. A spark from the stone, dry flour, a fire within a minute.",
	["quest.side_mill.p2"] = "But a signet does not slip off a dead man's hand by itself. Someone took it before the mill collapsed.",
	["quest.side_mill.p3"] = "Search the ashes on Crow Field. Bandits prowl there, so be careful — six fewer would not hurt.",
	["quest.side_mill.progress"] = "The ashes of the burnt mill on Crow Field and six bandits nearby.",
	["quest.side_mill.done"] = "A box under the ashes... and a letter from the smuggler who wanted to buy the mill. My husband refused him. Now I know what it cost him.",
	["quest.side_smugglers.title"] = "The Smugglers' Hideout",
	["quest.side_smugglers.p1"] = "That smuggler has a hideout in a cave in the south of the Meadows. Everyone knows of it and nobody does anything.",
	["quest.side_smugglers.p2"] = "The Bandit Chief leads them. He had the mill burned when my husband refused to store his goods.",
	["quest.side_smugglers.p3"] = "I do not want revenge. I want proof. The Chief keeps an account ledger — everything is in there.",
	["quest.side_smugglers.p4"] = "Get that ledger and take it to Sergeant Dobiesław at the guardhouse. He will know what to do with it.",
	["quest.side_smugglers.progress"] = "The Smugglers' Hideout, the Bandit Chief and his account ledger for Sergeant Dobiesław.",
	["quest.side_smugglers.done"] = "The Chief's ledger... Half the road is in here. Every bribe, every burnt house. Hanna will get justice, and you a reward from the guard's coffers.",
	["quest.side_wagon.title"] = "Horses Without a Wagon",
	["quest.side_wagon.p1"] = "Lucjan the merchant's two horses came back alone yesterday, their traces cut. No sign of the wagon.",
	["quest.side_wagon.p2"] = "Lucjan took the Merchant Road. If he lives, he is somewhere by the road. Find him.",
	["quest.side_wagon.progress"] = "Find Lucjan the merchant by the Merchant Road.",
	["quest.side_wagon.done"] = "The horses came back? Thank the gods, at least they did. They left me only my life and a wrecked wagon.",
	["quest.side_goods.title"] = "The Wrecked Wagon",
	["quest.side_goods.p1"] = "Bandits fell on me in broad daylight. They took the cloth, eight bales of the finest cloth from the south.",
	["quest.side_goods.p2"] = "Something may be left in the wagon. Search it, I do not have the nerve to go back.",
	["quest.side_goods.p3"] = "Then take my bales back from those road thieves. Every one of them wears my cloth under his cloak now.",
	["quest.side_goods.progress"] = "Search the wrecked wagon and take back eight bales of cloth from the bandits of the Merchant Road.",
	["quest.side_goods.done"] = "My cloth! And the bill of carriage from the wagon, sealed by a guard someone bribed. Show it to the sergeant.",
	["quest.side_wanted.title"] = "Wanted",
	["quest.side_wanted.p1"] = "Lucjan's bill of carriage confirms what I suspected. The road bandits have someone in the guard.",
	["quest.side_wanted.p2"] = "Before I find him, the road must be cleared. Fifteen bandits of the Merchant Road. Dead or alive — I prefer the former.",
	["quest.side_wanted.progress"] = "Fifteen bandits of the Merchant Road.",
	["quest.side_wanted.done"] = "The road is open again. The merchants are already asking whom to thank. Take your reward from the guard's armoury.",
	["quest.side_ore.title"] = "A Letter for the Miner",
	["quest.side_ore.p1"] = "Dobromir of the Old Quarry has not sent me ore in three weeks. And no ore means no steel.",
	["quest.side_ore.p2"] = "Take him my letter. I wrote what I think of his punctuality. Politely, more or less.",
	["quest.side_ore.progress"] = "A letter from Dorgan the Blacksmith for Dobromir the miner at the Old Quarry.",
	["quest.side_ore.done"] = "Dorgan is angry? Let him come and dig with kobolds at his back.",
	["quest.side_tools.title"] = "Picks of the Quarry",
	["quest.side_tools.p1"] = "The kobolds of the quarry steal my tools. Picks, shovels, they even took the wheelbarrow in the night.",
	["quest.side_tools.p2"] = "No picks, no ore, and without ore Dorgan will keep shouting.",
	["quest.side_tools.p3"] = "Take six picks back from the kobolds. You will know them by my mark on the handle.",
	["quest.side_tools.progress"] = "Six picks from the kobold miners of the Old Quarry.",
	["quest.side_tools.done"] = "My picks, every one with my mark. One thing left: stop up those burrows of theirs.",
	["quest.side_tunnels.title"] = "Sealed Tunnels",
	["quest.side_tunnels.p1"] = "The kobolds come out of three old tunnels on the quarry terraces. Boarded up, they will hold for a season at least.",
	["quest.side_tunnels.p2"] = "Seal all three, then mine the iron veins at the bottom eight times.",
	["quest.side_tunnels.p3"] = "Take the ore to Dorgan. Let him see that Dobromir keeps his word when he has something to dig with.",
	["quest.side_tunnels.progress"] = "Three tunnels to seal and eight iron veins mined in the Old Quarry. Then to Dorgan the Blacksmith.",
	["quest.side_tunnels.done"] = "Ore from Dobromir, and through you. Good quality, too. For that I will forge you something proper — choose.",
	["quest.side_totem.title"] = "The Goblin Totem",
	["quest.side_totem.p1"] = "The goblins in the camp in the north-east of the Meadows no longer hide. Scouts have seen a totem and drums.",
	["quest.side_totem.p2"] = "The totem is their pride and their sign to other tribes. While it stands, more will come.",
	["quest.side_totem.p3"] = "Cut down twelve scouts in the camp and set the totem alight. Let the smoke be seen from the walls.",
	["quest.side_totem.progress"] = "Twelve goblin scouts in the Goblin Camp and the totem set alight.",
	["quest.side_totem.done"] = "I saw the smoke from the guardhouse. Good work. But these goblins did not come from nowhere...",
	["quest.side_foreman.title"] = "The Kobold Foreman",
	["quest.side_foreman.p1"] = "Prisoners from the camp spoke of the Goblin Warren, burrows under the hills. Kobolds toil there for the goblins.",
	["quest.side_foreman.p2"] = "Foremen drive them to dig and steal ore from the quarry. They are what Dobromir has on his back.",
	["quest.side_foreman.p3"] = "Go down into the Goblin Warren and defeat two foremen. Then tell Dobromir — he has earned some peace.",
	["quest.side_foreman.progress"] = "The Goblin Warren and two Kobold Foremen. Then to Dobromir at the quarry.",
	["quest.side_foreman.done"] = "The foremen are down? That is the end of the ore thefts. Here, this is from the miners — well, from me and Dorgan.",
	["quest.side_hunter.title"] = "Supplies for the Hunter",
	["quest.side_hunter.p1"] = "Borys hunts in Bear Ravine and always gets his supplies from me. This time he did not come.",
	["quest.side_hunter.p2"] = "Take him a waterskin and hardtack. If he is hurt, at least he will not be hungry.",
	["quest.side_hunter.progress"] = "A waterskin and hardtack for Borys the hunter above Bear Ravine.",
	["quest.side_hunter.done"] = "Wacław remembers me, the good soul. Good that you came. You will be useful.",
	["quest.side_bears.title"] = "Enraged Bears",
	["quest.side_bears.p1"] = "The bears in the ravine have gone mad. They attack by day, leave their dens, fear no fire.",
	["quest.side_bears.p2"] = "Something is goading them. Before I learn what, there must be fewer of them. Ten.",
	["quest.side_bears.p3"] = "And bring me four claws. From them I will see where they have been.",
	["quest.side_bears.progress"] = "Ten brown bears in Bear Ravine and four claws.",
	["quest.side_bears.done"] = "There is tar and paint on the claws. Bears do not paint themselves. Someone is setting them on us.",
	["quest.side_den.title"] = "The Den in the Ravine",
	["quest.side_den.p1"] = "The biggest den lies under a rock not far from the waterfall. That is where the madness began.",
	["quest.side_den.p2"] = "Examine it and leave my mark, so the hunters know where not to go.",
	["quest.side_den.p3"] = "If goblins are goading the bears, their scouts must be prowling the ravine. Six of them and there will be peace.",
	["quest.side_den.progress"] = "The den in Bear Ravine and six goblin scouts nearby.",
	["quest.side_den.done"] = "Goblins with drums, tar on the claws... Now I understand. The ravine is ours again. Take this — you have earned it.",
