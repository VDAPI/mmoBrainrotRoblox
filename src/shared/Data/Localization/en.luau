	["quest.item.anzelmLetter"] = "Brother Anzelm's Letter",
	["quest.item.wyrmScale"] = "Wyrm Scale",
	["quest.item.vigdisTreatise"] = "The Treatise “On the Brood”",
	["place.leopardLedge"] = "The Leopards' Ledge over the brook",
	["place.thrones"] = "The giants' Hall of Thrones",
	["place.frozenBoat"] = "The boat in the ice",
	["place.howlRock"] = "The Howling Rock",
	["place.avalanche"] = "The avalanche cone",
	["place.wyrmBurrows"] = "The burrows in the ice scarps",
	["npc.scout_frostpeak.where"] = "by the cairn at the foot of the Frost Peaks",
	["npc.cairn_ingrid.name"] = "Old Ingrid",
	["npc.cairn_ingrid.role"] = "Keeper of the Cairn",
	["npc.cairn_ingrid.greeting"] = "Going up or coming back? I ask because it decides what I tie.",
	["npc.cairn_ingrid.line1"] = "My husband led people over the pass for forty winters. Now I keep watch over those who go alone.",
	["npc.cairn_ingrid.line2"] = "A north wind brings snow, an east wind brings wolves. A west wind brings only merchants.",
	["npc.cairn_ingrid.line3"] = "Whoever comes back unties their own ribbon. I do it for nobody.",
	["npc.cairn_ingrid.where"] = "by the horned cairn at the foot of the Frost Peaks",
	["npc.hornblower_eskil.name"] = "Eskil the Hornblower",
	["npc.hornblower_eskil.role"] = "Horn Warden",
	["npc.hornblower_eskil.greeting"] = "The snow on the top bench has grown a hand's width. Do you see it too, or only me?",
	["npc.hornblower_eskil.line1"] = "My grandfather blew the horn, my father blew it. I blow it and count who didn't listen.",
	["npc.hornblower_eskil.line2"] = "An avalanche doesn't ask whether you carry a sword. It has its own opinion and always shares it.",
	["npc.hornblower_eskil.line3"] = "On the Slopes the horn carries through the whole valley. When it doesn't sound, that's news as well.",
	["npc.hornblower_eskil.where"] = "on the lower bench of the Yeti Slopes",
	["npc.skald_ragnvald.name"] = "Ragnvald the Skald",
	["npc.skald_ragnvald.role"] = "Skald",
	["npc.skald_ragnvald.greeting"] = "Stand so the light falls from the left. Heroes are described from the left.",
	["npc.skald_ragnvald.line1"] = "I came from the south for songs nobody wrote down. The giants don't care for readers.",
	["npc.skald_ragnvald.line2"] = "Every saga has two endings: the one I sing and the one that happened.",
	["npc.skald_ragnvald.line3"] = "In winter words freeze in the mouth. That is why northern sagas are short.",
	["npc.skald_ragnvald.where"] = "by the Giants' Gate in the Pass",
	["npc.icefisher_torvi.name"] = "Torvi the Ice-Fisher",
	["npc.icefisher_torvi.role"] = "Ice-Fisher",
	["npc.icefisher_torvi.greeting"] = "Quietly. Fish hear footsteps through the ice.",
	["npc.icefisher_torvi.line1"] = "My village fished through the ice for as long as anyone remembers. Now I fish alone.",
	["npc.icefisher_torvi.line2"] = "The lake fed us a hundred winters. I don't ask why it stopped.",
	["npc.icefisher_torvi.line3"] = "Never step twice in the same print. Ice remembers weight.",
	["npc.icefisher_torvi.where"] = "on the shore of the Frozen Lake",
	["npc.bonecarver_gunnar.name"] = "Gunnar the Bone-Carver",
	["npc.bonecarver_gunnar.role"] = "Bone-Carver",
	["npc.bonecarver_gunnar.greeting"] = "Sit if you have the time. Bone doesn't like haste.",
	["npc.bonecarver_gunnar.line1"] = "Mammoths come here to die. We only see that nobody disturbs them.",
	["npc.bonecarver_gunnar.line2"] = "The tundra folk take bone only from beasts that fell by themselves. The rest is theirs.",
	["npc.bonecarver_gunnar.line3"] = "The herd knows when a storm is coming. I know when the herd is coming.",
	["npc.bonecarver_gunnar.where"] = "at the edge of the mammoth graveyard on the Mammoth Tundra",
	["npc.squire_asmund.name"] = "Asmund",
	["npc.squire_asmund.role"] = "Former Squire of the Watch",
	["npc.squire_asmund.greeting"] = "Don't ask why I stand on this side of the gate.",
	["npc.squire_asmund.line1"] = "I saddled the Watch's horses. I knew every knight by his step.",
	["npc.squire_asmund.line2"] = "The walls are the same. Only the silence behind them is different.",
	["npc.squire_asmund.line3"] = "I came back after some winters. Too late to help, too soon to forget.",
	["npc.squire_asmund.where"] = "before the gate of the Ice Watch",
	["npc.scholar_vigdis.name"] = "Vigdis the Scholar",
	["npc.scholar_vigdis.role"] = "Scholar",
	["npc.scholar_vigdis.greeting"] = "Please don't step on the notes. They lie where they belong.",
	["npc.scholar_vigdis.line1"] = "I came from the southern archive. The books on dragons were written by people who never saw one.",
	["npc.scholar_vigdis.line2"] = "A wyrm is not a dragon. Please remember that, I will ask.",
	["npc.scholar_vigdis.line3"] = "Frost keeps bones well. People less so.",
	["npc.scholar_vigdis.where"] = "at the foot of the Dragon Stairs",
	-- A. The Horned Cairn
	["quest.side_fp_flask.title"] = "Halvar's Flask",
	["quest.side_fp_flask.p1"] = "Old Ingrid lives by the horned cairn, widow of the guide who taught me to read tracks. I haven't been to see her since autumn.",
	["quest.side_fp_flask.p2"] = "Take her this flask of mead. Tell her I'm still alive. She'll understand the rest.",
	["quest.side_fp_flask.progress"] = "Take Halvar's flask to Old Ingrid by the horned cairn.",
	["quest.side_fp_flask.done"] = "Mead from Halvar? Then he lives and remembers. My husband said that boy would make a guide. Set the flask by the cairn, I'll drink it tonight.",
	["quest.side_fp_flask.say.drink"] = "And if I drink it on the way?",
	["quest.side_fp_flask.say.drink.reply"] = "Ingrid will know by the flask. She knows my swallows better than I do.",
	["quest.side_fp_flask.say.who"] = "Who is Ingrid?",
	["quest.side_fp_flask.say.who.reply"] = "The widow of the man who taught me to read tracks. Bow low.",
	["quest.side_fp_flask.say.word"] = "Any message for her?",
	["quest.side_fp_flask.say.word.reply"] = "That I'm still alive. She knows the rest.",
	["quest.side_fp_flask.bark.accept1"] = "The cairn stands by the road, just past my fire. You can't miss it.",
	["quest.side_fp_flask.bark.done1"] = "Halvar sent this? Then he lives and remembers.",
	["quest.side_fp_ribbons.title"] = "Torn Ribbons",
	["quest.side_fp_ribbons.p1"] = "Whoever goes up the mountains ties a ribbon with their name on the cairn. Whoever comes back unties it. The ones that stay are the names of those who didn't.",
	["quest.side_fp_ribbons.p2"] = "A night storm tore them off the horns, and the wolves, mad with frost, dragged them across the valley to their dens. Every ribbon is someone's name.",
	["quest.side_fp_ribbons.p3"] = "Bring me six. And thin the pack before they start pulling people off the road the way they pull ribbons off the cairn.",
	["quest.side_fp_ribbons.progress"] = "Kill ten ice wolves and recover six ribbons in Ice Wolf Valley.",
	["quest.side_fp_ribbons.done"] = "Six. This one is Olaf's, this his brother's. I'll tie them before dusk so they don't spend the night on the ground.",
	["quest.side_fp_ribbons.say.names"] = "Do you remember all the names?",
	["quest.side_fp_ribbons.say.names.reply"] = "Every one. Some better than the faces.",
	["quest.side_fp_ribbons.say.wolves"] = "Why do the wolves take them?",
	["quest.side_fp_ribbons.say.wolves.reply"] = "They smell of people. A wolf doesn't ask whose.",
	["quest.side_fp_ribbons.say.first"] = "Where do I start?",
	["quest.side_fp_ribbons.say.first.reply"] = "With the ribbons. The wolves will find you on their own.",
	["quest.side_fp_ribbons.bark.accept1"] = "Every ribbon is a name. Leave none in the snow.",
	["quest.side_fp_ribbons.bark.half1"] = "Wolves always keep the prettiest for last.",
	["quest.side_fp_ribbons.bark.done1"] = "Come back. I'll tie them before dusk.",
	["quest.side_fp_ribbons.bark.stuck1"] = "Look by the dens. Wolves carry anything that smells of people there.",
	["quest.side_fp_howl.title"] = "An Offering at the Howling Rock",
	["quest.side_fp_howl.p1"] = "An old custom of the valley: whoever wants to pass leaves tallow and a bone for the Wolf of the Pass at the Howling Rock. Then the pack lets them by.",
	["quest.side_fp_howl.p2"] = "Nobody has done it since autumn, and I'm too old for the road. The Rock stands to the north, by the trail above the Harpy Tarn.",
	["quest.side_fp_howl.p3"] = "Then come back and tie the ribbons to the cairn's horns. A double knot, the way names are tied.",
	["quest.side_fp_howl.progress"] = "Leave the offering at the Howling Rock and tie the ribbons to the horned cairn.",
	["quest.side_fp_howl.done"] = "They hang again. You see the new one, without a name? The trappers tied it, the ones who went to the Ice Grotto. Don't untie it. Let it wait.",
	["quest.side_fp_howl.done.names"] = "You asked about the names. This new ribbon has none yet. The trappers who went to the Ice Grotto tied it. May it stay that way.",
	["quest.side_fp_howl.say.believe"] = "Do you believe in the Wolf of the Pass?",
	["quest.side_fp_howl.say.believe.reply"] = "I believe in the custom. Those who broke it have ribbons here.",
	["quest.side_fp_howl.say.little"] = "Tallow and a bone? That's all?",
	["quest.side_fp_howl.say.little.reply"] = "The wolf isn't greedy. Greedy are those who walk the mountains.",
	["quest.side_fp_howl.say.road"] = "Which way to the Rock?",
	["quest.side_fp_howl.say.road.reply"] = "North, along the brook. I'll mark it.",
	["quest.side_fp_howl.bark.accept1"] = "Tallow and a bone. Nothing more, the wolf dislikes excess.",
	["quest.side_fp_howl.bark.near1"] = "Hear the rock howl in the wind? That's the name.",
	["quest.side_fp_howl.bark.half1"] = "Now the ribbons. A double knot, don't forget.",
	["quest.side_fp_howl.bark.done1"] = "The valley has its custom back.",
	-- B. The Trappers' Last Catch
	["quest.side_fp_snares.title"] = "The Trappers' Snares",
	["quest.side_fp_snares.p1"] = "Before the party went to the Ice Grotto, they set snares around the camp. Arne said: whatever happens, the camp must eat.",
	["quest.side_fp_snares.p2"] = "The leopards empty the loops before anyone gets to them. Three snares need setting again.",
	["quest.side_fp_snares.p3"] = "Drive the leopards out of the valley. Otherwise we'll be feeding them, not ourselves.",
	["quest.side_fp_snares.progress"] = "Reset three snares by the trappers' camp and kill eight snow leopards in Ice Wolf Valley.",
	["quest.side_fp_snares.done"] = "The loops hold. The camp will eat, even with nobody to eat. Arne would laugh at that. I can't.",
	["quest.side_fp_snares.say.eat"] = "Food for whom, if the camp is empty?",
	["quest.side_fp_snares.say.eat.reply"] = "For those who come back. Snares are set for the living.",
	["quest.side_fp_snares.say.learn"] = "Do the leopards know your loops?",
	["quest.side_fp_snares.say.learn.reply"] = "They learn faster than Arne did. He needed three winters.",
	["quest.side_fp_snares.say.which"] = "Snares first, or leopards?",
	["quest.side_fp_snares.say.which.reply"] = "Leopards. The snares will wait, they won't.",
	["quest.side_fp_snares.bark.accept1"] = "Three loops around the camp. Arne set one by every way out.",
	["quest.side_fp_snares.bark.half1"] = "One loop always tightens. You only have to wait.",
	["quest.side_fp_snares.bark.done1"] = "The camp will eat. Come back.",
	["quest.side_fp_snares.bark.death1"] = "Get up slowly. A leopard comes back when its prey moves.",
	["quest.side_fp_ledge.title"] = "Arne's Knife",
	["quest.side_fp_ledge.p1"] = "You've been in the Grotto. You saw them. Arne, my brother, led that party.",
	["quest.side_fp_ledge.p2"] = "Last winter he lost his knife on the Leopards' Ledge, fighting an old she-leopard. I want it back, to lay it beside him.",
	["quest.side_fp_ledge.p3"] = "The Ledge can't be seen from the road. I'll take you there. The she-leopard I leave to you.",
	["quest.side_fp_ledge.progress"] = "Go with Sigrun to the Leopards' Ledge and take Arne's knife back from the leopards of Ice Wolf Valley.",
	["quest.side_fp_ledge.done"] = "That's it. The crooked handle, he carved it himself and never admitted it was crooked. I'll lay it beside him when we bring him down.",
	["quest.side_fp_ledge.say.knife"] = "What kind of knife?",
	["quest.side_fp_ledge.say.knife.reply"] = "A chamois horn handle. He carved it himself, crooked. I'll know it.",
	["quest.side_fp_ledge.say.alone"] = "I can go without you.",
	["quest.side_fp_ledge.say.alone.reply"] = "You can't. The Ledge can't be seen from the road, and I see it in my sleep.",
	["quest.side_fp_ledge.say.lead"] = "Lead the way.",
	["quest.side_fp_ledge.say.lead.reply"] = "Follow me and don't tread on the leopards' tracks.",
	["quest.side_fp_ledge.bark.accept1"] = "I know the way, you have the sword. We go together.",
	["quest.side_fp_ledge.bark.near1"] = "Arne taught me to set snares here. I was worse at it than he was.",
	["quest.side_fp_ledge.bark.half1"] = "The knife is with the she-leopard who doesn't run. Look for her.",
	["quest.side_fp_ledge.bark.done1"] = "That's it. The crooked handle. Thank you.",
	["quest.side_fp_ledge.comp.join1"] = "Stay close. Past the camp the leopards hunt in pairs.",
	["quest.side_fp_ledge.comp.wait1"] = "Don't fall behind. It's easy to lose the trail here.",
	["quest.side_fp_ledge.comp.arrive1"] = "Here. The old she-leopard takes anything that shines. Look to her.",
	["quest.side_fp_ledge.comp.back1"] = "I've lost you. I'm going back to the camp, I'll wait there.",
	["quest.side_fp_sledge.title"] = "The Sledge Down",
	["quest.side_fp_sledge.p1"] = "I want to bring them down. I can't leave my brother in the ice forever.",
	["quest.side_fp_sledge.p2"] = "We have the old sledge, but a runner cracked on the last run. It has to be mended before the new snow falls.",
	["quest.side_fp_sledge.p3"] = "The way down crosses the Slopes. The leopards follow the camp's scent and wait for anyone going down.",
	["quest.side_fp_sledge.p4"] = "Once the sledge is down, I'll stay here until spring. Someone has to.",
	["quest.side_fp_sledge.progress"] = "Mend the sledge's runner in the trappers' camp and clear the way across the Yeti Slopes of ten snow leopards.",
	["quest.side_fp_sledge.done"] = "The sledge is ready. The mountains give back their dead only when the snows let go. I'll stay until spring. Take something of the party's things, they'd want that.",
	["quest.side_fp_sledge.done.alone"] = "The Ledge without a guide has already taken one. Good that we went together. The sledge is ready, I'll stay until spring. Take something of the party's things.",
	["quest.side_fp_sledge.say.bury"] = "Where will you bury them?",
	["quest.side_fp_sledge.say.bury.reply"] = "By the cairn in the valley. Ingrid will tie ribbons for them.",
	["quest.side_fp_sledge.say.stay"] = "You'll stay here alone?",
	["quest.side_fp_sledge.say.stay.reply"] = "Until spring. Someone must see the mountains don't take them twice.",
	["quest.side_fp_sledge.say.rope"] = "What do I bind the runner with?",
	["quest.side_fp_sledge.say.rope.reply"] = "A strap off Arne's sledge. Take this too.",
	["quest.side_fp_sledge.bark.accept1"] = "The runner first, then the road. In that order.",
	["quest.side_fp_sledge.bark.half1"] = "The sledge has to go down in one run. I can't do it twice.",
	["quest.side_fp_sledge.bark.done1"] = "Until spring they'll lie by the cairn. Come back.",
	-- C. The Avalanche Horn
	["quest.side_fp_horn.title"] = "The Buried Horn",
	["quest.side_fp_horn.p1"] = "For generations my kin have blown the great horn when the snow on the slopes grows. The valley hears it and gets off the road.",
	["quest.side_fp_horn.p2"] = "The last avalanche the yeti brought down buried the horn's stand at the foot of the cone. Dig it out, carefully.",
	["quest.side_fp_horn.p3"] = "The yeti never came this low in my lifetime. Thin them out before they bring down the next one.",
	["quest.side_fp_horn.progress"] = "Dig out the horn at the foot of the avalanche cone and kill ten yeti on the Yeti Slopes.",
	["quest.side_fp_horn.done"] = "Whole. The wood is only split at the band, that can be mended. But the mouthpiece is gone. The silver one. Without it the horn only wheezes.",
	["quest.side_fp_horn.say.count"] = "How many avalanches do you remember?",
	["quest.side_fp_horn.say.count.reply"] = "Forty-one. Forty I lived through, one I slept through.",
	["quest.side_fp_horn.say.why"] = "Why a horn, if you can see the snow?",
	["quest.side_fp_horn.say.why.reply"] = "From above you see the snow. From below you only see that it's too late.",
	["quest.side_fp_horn.say.where"] = "Where was the stand?",
	["quest.side_fp_horn.say.where.reply"] = "At the foot of the avalanche cone. I'll mark it.",
	["quest.side_fp_horn.bark.accept1"] = "The stand is under the snow. Dig carefully, it's old wood.",
	["quest.side_fp_horn.bark.half1"] = "Whole. Only the mouthpiece is gone. Somebody has taste.",
	["quest.side_fp_horn.bark.done1"] = "I'll play it once it has a mouth again. Come back.",
	["quest.side_fp_boulders.title"] = "The Yeti's Boulders",
	["quest.side_fp_boulders.p1"] = "The yeti carry boulders up to the middle bench and stack them in heaps. I thought it was play.",
	["quest.side_fp_boulders.p2"] = "It isn't play. They push them down when the snow is heavy and start avalanches on purpose. Topple three heaps.",
	["quest.side_fp_boulders.p3"] = "Leopards hunt on the bench. They wait for whoever walks there, so watch your back.",
	["quest.side_fp_boulders.progress"] = "Topple three heaps of boulders on the middle bench and kill eight snow leopards on the Yeti Slopes.",
	["quest.side_fp_boulders.done"] = "Three heaps fewer is three avalanches fewer. I counted. I always count.",
	["quest.side_fp_boulders.say.purpose"] = "The yeti do it on purpose?",
	["quest.side_fp_boulders.say.purpose.reply"] = "On purpose. They learn from us, only faster.",
	["quest.side_fp_boulders.say.nobody"] = "Why has nobody stopped them?",
	["quest.side_fp_boulders.say.nobody.reply"] = "The valley pays me to blow a horn, not to move boulders.",
	["quest.side_fp_boulders.say.cats"] = "Leopards first?",
	["quest.side_fp_boulders.say.cats.reply"] = "Yes. There's nowhere to run on the bench, and they know it.",
	["quest.side_fp_boulders.bark.accept1"] = "Three heaps on the middle bench. Topple them before the yeti push them.",
	["quest.side_fp_boulders.bark.half1"] = "Two heaps fewer is two avalanches fewer.",
	["quest.side_fp_boulders.bark.done1"] = "The bench is clear. For now. Come back.",
	["quest.side_fp_boulders.bark.stuck1"] = "The heaps are higher than you think. The yeti carry boulders uphill.",
	["quest.side_fp_matriarch.title"] = "The Silver Mouthpiece",
	["quest.side_fp_matriarch.p1"] = "A great yeti took the mouthpiece into the Ice Grotto. The oldest yeti wear trinkets, the older the more.",
	["quest.side_fp_matriarch.p2"] = "The yeti never came this low in my lifetime. They're running from something that wakes under the glacier.",
	["quest.side_fp_matriarch.p3"] = "But the horn has to sound, whatever wakes. Take the mouthpiece from the oldest of them.",
	["quest.side_fp_matriarch.progress"] = "Enter the Ice Grotto, defeat three elite yeti and take back the silver mouthpiece.",
	["quest.side_fp_matriarch.done"] = "It fits. Listen. The valley has known this sound for three hundred years. Now your head knows it too.",
	["quest.side_fp_matriarch.done.count"] = "Forty-two. I'll count this one as yours. Listen to the horn with its mouthpiece. The valley has known this sound for three hundred years.",
	["quest.side_fp_matriarch.say.trinkets"] = "Why do yeti want trinkets?",
	["quest.side_fp_matriarch.say.trinkets.reply"] = "No idea. Maybe they want to be heard too.",
	["quest.side_fp_matriarch.say.flee"] = "What are they running from?",
	["quest.side_fp_matriarch.say.flee.reply"] = "Something under the glacier. Beasts hear it before people do.",
	["quest.side_fp_matriarch.say.cave"] = "Where is the Grotto?",
	["quest.side_fp_matriarch.say.cave.reply"] = "At the end of the salt road under the mountain. I'll mark the mouth.",
	["quest.side_fp_matriarch.bark.accept1"] = "Look for the oldest and proudest. The one with most to lose wears the silver.",
	["quest.side_fp_matriarch.bark.half1"] = "I can hear the Grotto shaking from here. You're doing well.",
	["quest.side_fp_matriarch.bark.done1"] = "Come back. The valley will know this sound.",
	["quest.side_fp_matriarch.bark.death1"] = "Get up. In the Grotto you're not prey, just an uninvited guest.",
	-- D. The Giants' Saga
	["quest.side_fp_colossi.title"] = "Runes on the Plinths",
	["quest.side_fp_colossi.p1"] = "I gather the songs of the north, the ones nobody wrote down. The oldest giant saga is carved on the plinths of the Gate's colossi.",
	["quest.side_fp_colossi.p2"] = "Take rubbings of the runes in charcoal, from both plinths. I have no hands for charcoal, and the giants have no patience for skalds.",
	["quest.side_fp_colossi.p3"] = "They let nobody near the statues of their forefathers. Persuade them that this time they will.",
	["quest.side_fp_colossi.progress"] = "Take rubbings of the runes on both colossi of the Giants' Gate and kill ten frost giants in the Pass.",
	["quest.side_fp_colossi.done"] = "Clean rubbings. The first verse matches mine, the second doesn't. Either my master was wrong, or the stone lies. Stones rarely lie.",
	["quest.side_fp_colossi.say.sing"] = "Will you sing something?",
	["quest.side_fp_colossi.say.sing.reply"] = "After the saga. I sing for free only to goats, and even they walk out.",
	["quest.side_fp_colossi.say.giants"] = "Will the giants allow it?",
	["quest.side_fp_colossi.say.giants.reply"] = "No. That's why I'm asking you, not them.",
	["quest.side_fp_colossi.say.charcoal"] = "What do I take rubbings with?",
	["quest.side_fp_colossi.say.charcoal.reply"] = "Charcoal. Take this as well, near the giants it'll serve you better than charcoal.",
	["quest.side_fp_colossi.bark.accept1"] = "Two plinths. Giants dislike copyists, so copy quickly.",
	["quest.side_fp_colossi.bark.half1"] = "The first verse matches mine. So far.",
	["quest.side_fp_colossi.bark.done1"] = "Charcoal on the fingers is the price of art. Come back.",
	["quest.side_fp_thrones.title"] = "The Throne Stones",
	["quest.side_fp_thrones.p1"] = "The saga went on, on the stones of the thrones in the Hall of Thrones, beyond the giants' fire.",
	["quest.side_fp_thrones.p2"] = "The giants chipped the runes off and wear them round their necks like charms. They wear the past and don't remember what it means.",
	["quest.side_fp_thrones.p3"] = "I'm coming with you. I want to stand in that hall before I sing of it once more.",
	["quest.side_fp_thrones.progress"] = "Go with Ragnvald the Skald to the Hall of Thrones and take three throne runes from the frost giants of the Pass.",
	["quest.side_fp_thrones.done"] = "Three runes, one verse. When the dragon first came down from the mountains, the giants held the pass together with the Order of the Frost Watch. Together, not against each other.",
	["quest.side_fp_thrones.say.come"] = "You're coming with me?",
	["quest.side_fp_thrones.say.come.reply"] = "Of course. A saga without a witness is gossip.",
	["quest.side_fp_thrones.say.danger"] = "There are giants there.",
	["quest.side_fp_thrones.say.danger.reply"] = "That's why I walk behind you, not ahead of you.",
	["quest.side_fp_thrones.say.why"] = "Why does this saga matter so much to you?",
	["quest.side_fp_thrones.say.why.reply"] = "I've sung it for thirty years. I want to know if I sing the truth.",
	["quest.side_fp_thrones.bark.accept1"] = "The Hall is past the giants' fire. Lead, I'll follow.",
	["quest.side_fp_thrones.bark.near1"] = "Here it says “together”. Giants and the Order. And for thirty years I sang “against”.",
	["quest.side_fp_thrones.bark.half1"] = "The second rune says the same. My master lied or couldn't read.",
	["quest.side_fp_thrones.bark.done1"] = "I got back before you. A skald always knows a shortcut when the saga changes.",
	["quest.side_fp_thrones.bark.death1"] = "Get up. I haven't written the elegy yet and I don't intend to.",
	["quest.side_fp_thrones.bark.stuck1"] = "They wear the runes round their necks. We have to ask them. With a sword, sadly.",
	["quest.side_fp_thrones.comp.join1"] = "Lead on. I'll describe how bravely you lead.",
	["quest.side_fp_thrones.comp.join2"] = "Not too fast. A hero who runs, in a saga, is fleeing.",
	["quest.side_fp_thrones.comp.back1"] = "I lost you among the boulders. I'm going back to the Gate.",
	["quest.side_fp_verse.title"] = "The Last Verse",
	["quest.side_fp_verse.p1"] = "I have the whole saga but the last verse. It isn't on the stones: nobody ever carved it, or the wind ate it.",
	["quest.side_fp_verse.p1.why"] = "You asked whether I sing the truth. Now I will. All I lack is the last verse, and the stones don't have it.",
	["quest.side_fp_verse.p2"] = "I'll compose it myself. But the harpies carried my pages off to their nests on the rocks of the Pass, and without them I lose the measure.",
	["quest.side_fp_verse.p3"] = "Get back four pages. Then carve the verse on the colossus's fallen head by the road.",
	["quest.side_fp_verse.p4"] = "So the giants remember who they were. And so the southern singers stop singing lies.",
	["quest.side_fp_verse.progress"] = "Recover four pages of the saga from the peak harpies of the Pass and carve the last verse on the colossus's head by the road.",
	["quest.side_fp_verse.done"] = "Listen: “Giants and men stood in the pass, and the dragon turned back, for it found no gap.” Short. In the north sagas must be short. Take something for your trouble.",
	["quest.side_fp_verse.say.write"] = "You'll compose it yourself?",
	["quest.side_fp_verse.say.write.reply"] = "I will. You carve it, my hands shake when something has to last.",
	["quest.side_fp_verse.say.harpies"] = "What do harpies want with your pages?",
	["quest.side_fp_verse.say.harpies.reply"] = "My saga keeps their chicks warm. I've never had better criticism.",
	["quest.side_fp_verse.say.truth"] = "Will you write it as it was?",
	["quest.side_fp_verse.say.truth.reply"] = "This time, yes. Giants and the Order, shoulder to shoulder.",
	["quest.side_fp_verse.bark.accept1"] = "The pages are with the harpies, the verse in my head. Pages first.",
	["quest.side_fp_verse.bark.half1"] = "All I lack now is a rhyme and courage.",
	["quest.side_fp_verse.bark.done1"] = "Carved. Giants may forget, stone won't.",
	-- E. The Ice Hole
	["quest.side_fp_icehole.title"] = "A Hungry Ice Hole",
	["quest.side_fp_icehole.p1"] = "I haven't eaten fresh fish in weeks. Elementals crawl out of the ice holes and guard them as if the water were theirs.",
	["quest.side_fp_icehole.p2"] = "Catch me three fish, wherever you like, and thin the elementals on the lake. Then we'll talk of something more important.",
	["quest.side_fp_icehole.progress"] = "Catch three fish and kill eight ice elementals on the Frozen Lake.",
	["quest.side_fp_icehole.done"] = "Fresh fish. The first in weeks. The lake still gives, when it's asked politely.",
	["quest.side_fp_icehole.say.bait"] = "What do they bite on?",
	["quest.side_fp_icehole.say.bait.reply"] = "Patience. A worm, once the patience runs out.",
	["quest.side_fp_icehole.say.why"] = "Why are there elementals in the ice hole?",
	["quest.side_fp_icehole.say.why.reply"] = "The lake spits them out. Don't ask the lake why.",
	["quest.side_fp_icehole.say.where"] = "Where should I fish?",
	["quest.side_fp_icehole.say.where.reply"] = "Anywhere but here. There's an ice hole by my father's boat. I'll mark it.",
	["quest.side_fp_icehole.bark.accept1"] = "Three fish. No more, the lake dislikes the greedy.",
	["quest.side_fp_icehole.bark.near1"] = "Quietly. The lake is listening.",
	["quest.side_fp_icehole.bark.half1"] = "I hear the ice crack under the elementals. Fewer of them.",
	["quest.side_fp_icehole.bark.done1"] = "The first fresh fish in weeks. Come back.",
	["quest.side_fp_boat.title"] = "Father's Boat",
	["quest.side_fp_boat.p1"] = "One night the lake froze in an hour, from the bottom to the top. With my father's boat in it. He was aboard.",
	["quest.side_fp_boat.p2"] = "The boat still stands in the ice by the ice hole. I'll lead you, don't walk the ice alone. Chip it free, carefully.",
	["quest.side_fp_boat.p3"] = "And bring me the elementals' cores. An old custom: the lake should get back what was taken from it.",
	["quest.side_fp_boat.progress"] = "Walk with Torvi over the ice to the boat, chip it free and take four frost cores from the ice elementals on the lake.",
	["quest.side_fp_boat.done"] = "Father's log. “The lake sang, the crystals shone in time.” Nothing more. I'll drop the cores into the ice hole. The lake has its due. So do we.",
	["quest.side_fp_boat.say.lead"] = "Lead the way.",
	["quest.side_fp_boat.say.lead.reply"] = "Step for step. Ice remembers weight.",
	["quest.side_fp_boat.say.father"] = "What was your father like?",
	["quest.side_fp_boat.say.father.reply"] = "Quiet. Like me, only a better fisher.",
	["quest.side_fp_boat.say.straight"] = "Why not go straight?",
	["quest.side_fp_boat.say.straight.reply"] = "Only those who haven't fallen through yet walk straight.",
	["quest.side_fp_boat.bark.accept1"] = "Don't go onto the ice alone. Wait for me on the shore.",
	["quest.side_fp_boat.bark.half1"] = "Father's log is whole. The cores go back to the lake.",
	["quest.side_fp_boat.bark.done1"] = "The lake has its due. So do we.",
	["quest.side_fp_boat.comp.join1"] = "Step for step behind me. Ice remembers weight.",
	["quest.side_fp_boat.comp.wait1"] = "Don't stand long in one place. The ice doesn't like it.",
	["quest.side_fp_boat.comp.arrive1"] = "Here. Chip carefully. This wood remembers my father's hands.",
	["quest.side_fp_boat.comp.back1"] = "Don't go onto the ice without me. I'll wait on the shore.",
	["quest.side_fp_hoard.title"] = "The Hoard in the Ice",
	["quest.side_fp_hoard.p1"] = "When the lake froze, it took the village's things too. They lie in the ice by the west shore: a chest, a shield, a sword.",
	["quest.side_fp_hoard.p2"] = "Every thing has an owner, or the owner's children. Chip them free, I'll give them back to the families.",
	["quest.side_fp_hoard.p3"] = "Mammoths come onto the ice for salt and break it by the hoard. The things sink a second time. Drive them off.",
	["quest.side_fp_hoard.progress"] = "Chip the chest, the shield and the sword out of the hoard in the lake's ice and kill eight ice mammoths on the Frozen Lake.",
	["quest.side_fp_hoard.done"] = "Halldora's chest, the shield from over the neighbours' door, old Bjorn's sword. I'll give them back. And you take this, someone has to remember us by something.",
	["quest.side_fp_hoard.done.bait"] = "The worm came in handy. I've eaten fresh fish all week. The chest, the shield and the sword go back to the families. And you take this, to remember us by.",
	["quest.side_fp_hoard.say.families"] = "Are the families still alive?",
	["quest.side_fp_hoard.say.families.reply"] = "Some went down to the Wastes. They'll return when the lake falls silent.",
	["quest.side_fp_hoard.say.keep"] = "And if I keep something?",
	["quest.side_fp_hoard.say.keep.reply"] = "The lake will remember your face. So will I.",
	["quest.side_fp_hoard.say.mammoths"] = "Why do the mammoths break the ice?",
	["quest.side_fp_hoard.say.mammoths.reply"] = "They look for salt. The ice cracks and the village's things sink again.",
	["quest.side_fp_hoard.bark.accept1"] = "Every thing has an owner. Chip carefully.",
	["quest.side_fp_hoard.bark.half1"] = "That shield hung over the neighbours' door. I know it.",
	["quest.side_fp_hoard.bark.done1"] = "I'll give them back. One stays with you.",
	-- F. The Mammoth Graveyard
	["quest.side_fp_tusks.title"] = "The Tusk Arch",
	["quest.side_fp_tusks.p1"] = "The tusk arch over the road marks the way into the graveyard. The herd knows that beyond it the pasture ends and rest begins.",
	["quest.side_fp_tusks.p2"] = "A maddened herd broke a tusk out of the arch. I need five tusks for a new post.",
	["quest.side_fp_tusks.p3"] = "Take them only from beasts that had to fall. Then lash the post at the arch's west foot.",
	["quest.side_fp_tusks.progress"] = "Take five tusks from the ice mammoths of the Mammoth Tundra and lash a new post at the tusk arch.",
	["quest.side_fp_tusks.done"] = "It stands. The herd will know the arch before it sees it. Mammoths remember the way better than people.",
	["quest.side_fp_tusks.say.rule"] = "Only from the dead?",
	["quest.side_fp_tusks.say.rule.reply"] = "From those that had to fall. Let the rest keep their tusks.",
	["quest.side_fp_tusks.say.carve"] = "What do you carve?",
	["quest.side_fp_tusks.say.carve.reply"] = "Mammoths. Merchants only buy the ones with sad eyes.",
	["quest.side_fp_tusks.say.arch"] = "What is the arch for?",
	["quest.side_fp_tusks.say.arch.reply"] = "So the herd knows where the pasture ends and rest begins.",
	["quest.side_fp_tusks.bark.accept1"] = "Tusks only from those that had to fall. Remember.",
	["quest.side_fp_tusks.bark.half1"] = "Five tusks make one post. A good sum.",
	["quest.side_fp_tusks.bark.done1"] = "The herd will know the arch. Come back.",
	["quest.side_fp_stampede.title"] = "The Living Wall",
	["quest.side_fp_stampede.p1"] = "The giants drive the herds towards the Frozen Hold like a living wall. They fight something there that they fear.",
	["quest.side_fp_stampede.p2"] = "Herders don't drive their herds to war. These giants do. Mammoths fall on the ice before they reach the gates.",
	["quest.side_fp_stampede.p3"] = "Break the drive. The drivers, and the beasts already maddened in the herd.",
	["quest.side_fp_stampede.progress"] = "Kill twelve ice mammoths and six frost giants on the Mammoth Tundra.",
	["quest.side_fp_stampede.done"] = "Hear that? The herd slows. A few went back to the pastures, the rest stand and don't know where to go. That's something.",
	["quest.side_fp_stampede.say.war"] = "The giants are going to war?",
	["quest.side_fp_stampede.say.war.reply"] = "With something in the Hold. Herders don't drive herds to war. These giants do.",
	["quest.side_fp_stampede.say.pity"] = "Pity about the mammoths.",
	["quest.side_fp_stampede.say.pity.reply"] = "A pity. That's why the drivers come first.",
	["quest.side_fp_stampede.say.many"] = "How many are there?",
	["quest.side_fp_stampede.say.many.reply"] = "Too many for one knife, too few for a herd.",
	["quest.side_fp_stampede.bark.accept1"] = "Giants first. Without its drivers the herd slows by itself.",
	["quest.side_fp_stampede.bark.half1"] = "Hear that? The herd is slowing.",
	["quest.side_fp_stampede.bark.done1"] = "The drive is broken. Come back.",
	["quest.side_fp_stampede.bark.stuck1"] = "The giants walk behind the herd, not ahead of it. Look at the back.",
	["quest.side_fp_warhorn.title"] = "The Skull Horn",
	["quest.side_fp_warhorn.p1"] = "The giants in the Hold call the herds with a horn made from a mammoth's skull. The mammoths follow that sound like the call of their forefathers.",
	["quest.side_fp_warhorn.p2"] = "Their chief carries the horn. He won't give it up politely, and in the Hold the frost bites harder than the giants.",
	["quest.side_fp_warhorn.p3"] = "Bring it to me. The herds will stop coming down once nobody calls them.",
	["quest.side_fp_warhorn.progress"] = "Enter the Frozen Hold, defeat three elite frost giants and take the mammoth skull horn.",
	["quest.side_fp_warhorn.done"] = "I'll hang it on the tusk arch. Let the herds know the war isn't theirs. Take something from me, I carve useful things too.",
	["quest.side_fp_warhorn.done.pity"] = "You said it was a pity about the mammoths. The herd went down to the pastures. All of them, I counted. The horn goes on the arch. Take something from me.",
	["quest.side_fp_warhorn.say.horn"] = "What does the horn look like?",
	["quest.side_fp_warhorn.say.horn.reply"] = "A mammoth's skull bound in iron. You'll hear it before you see it. I'll mark the gate.",
	["quest.side_fp_warhorn.say.cold"] = "The Hold is full of giants.",
	["quest.side_fp_warhorn.say.cold.reply"] = "And ice. Take this, the frost bites harder there than they do.",
	["quest.side_fp_warhorn.say.hang"] = "What will you do with it?",
	["quest.side_fp_warhorn.say.hang.reply"] = "Hang it on the arch. Let the herds know who calls them now.",
	["quest.side_fp_warhorn.bark.accept1"] = "The chief won't give the horn up politely. Don't ask him.",
	["quest.side_fp_warhorn.bark.half1"] = "The herd on the tundra raises its heads. Something changes in the Hold.",
	["quest.side_fp_warhorn.bark.done1"] = "The herds know the war isn't theirs. Come back.",
	["quest.side_fp_warhorn.bark.death1"] = "Get up. The Hold doesn't like those who lie down.",
	-- G. The Squire of the Watch
	["quest.side_fp_squire.title"] = "Brothers on the Walls",
	["quest.side_fp_squire.p1"] = "I was Brother Halgrim's squire. I saddled horses, cleaned armour, carried water up to the walls.",
	["quest.side_fp_squire.p2"] = "The night the frost came to the Watch, I ran. I came back after some winters. I can't make myself pass the gate.",
	["quest.side_fp_squire.p3"] = "My brothers still walk the walls. Frozen, armoured, swords in hand. They know no one.",
	["quest.side_fp_squire.p4"] = "Give them rest. I can't raise a hand against them.",
	["quest.side_fp_squire.progress"] = "Kill ten frozen knights in the Ice Watch.",
	["quest.side_fp_squire.done"] = "The wall is quieter. I heard them fall from here. I knew each of them by his step.",
	["quest.side_fp_squire.say.why"] = "Why did you run?",
	["quest.side_fp_squire.say.why.reply"] = "I was young and afraid of the frost. Now I'm old and afraid of the gate.",
	["quest.side_fp_squire.say.know"] = "Will they know you?",
	["quest.side_fp_squire.say.know.reply"] = "No. That's worse than a sword.",
	["quest.side_fp_squire.say.how"] = "How do I give them rest?",
	["quest.side_fp_squire.say.how.reply"] = "With a sword. They remember one thing only: that they must keep watch.",
	["quest.side_fp_squire.bark.accept1"] = "Don't kill them. Let them rest.",
	["quest.side_fp_squire.bark.half1"] = "That was Brother Tomir. I knew his step. He always dragged his left foot.",
	["quest.side_fp_squire.bark.done1"] = "The wall is quieter. Come back.",
	["quest.side_fp_shields.title"] = "Juniper for the Shields",
	["quest.side_fp_shields.p1"] = "On the outer wall hang shields with the knights' names. They have hung there since the Watch was built.",
	["quest.side_fp_shields.p2"] = "Lay a sprig of juniper under the three I knew. It smells like the Watch's chapel.",
	["quest.side_fp_shields.p3"] = "And bring me the sigils from their cloaks. I'll bury them in the valley, so something of them comes down from the mountains.",
	["quest.side_fp_shields.progress"] = "Lay juniper under three shields on the Watch's west wall and take four sigils from the frozen knights.",
	["quest.side_fp_shields.done"] = "Four sigils. I'll bury them by the cairn in the valley. Ingrid will tie ribbons for them, though nobody will untie them now.",
	["quest.side_fp_shields.say.names"] = "Whose shields are they?",
	["quest.side_fp_shields.say.names.reply"] = "Brother Eryk's, Brother Tomir's, Brother Harald's. They taught me to saddle.",
	["quest.side_fp_shields.say.juniper"] = "Why juniper?",
	["quest.side_fp_shields.say.juniper.reply"] = "It smells like the Watch's chapel. Maybe they'll know it.",
	["quest.side_fp_shields.say.seals"] = "The sigils too?",
	["quest.side_fp_shields.say.seals.reply"] = "I'll bury them in the valley. Let something of them come down.",
	["quest.side_fp_shields.bark.accept1"] = "Three shields on the west wall. Their names are cut into the bosses.",
	["quest.side_fp_shields.bark.half1"] = "The last shield. Brother Harald loved juniper. Said it smelled of home.",
	["quest.side_fp_shields.bark.done1"] = "I'll bury the sigils by the cairn. Come back.",
	["quest.side_fp_spurs.title"] = "The Squire's Spurs",
	["quest.side_fp_spurs.p1"] = "I still have my squire's spurs. I didn't earn them that night and I never will.",
	["quest.side_fp_spurs.p2"] = "Lay them before the barred gate and light the candles. Let the gate see that I came back.",
	["quest.side_fp_spurs.p3"] = "Elementals circle the gate like sentries. Drive them off before they put the candles out.",
	["quest.side_fp_spurs.progress"] = "Lay down the spurs and light the candles before the Ice Watch's gate, and kill eight ice elementals at the Watch.",
	["quest.side_fp_spurs.done"] = "The candles burn. If Brother Halgrim still keeps watch, let him know his squire came back. Take this. I have no use for any of it now.",
	["quest.side_fp_spurs.done.why"] = "I said I was afraid of the gate. Today I stood by it a long time. If Brother Halgrim still keeps watch, let him know his squire came back. Take this.",
	["quest.side_fp_spurs.say.forgive"] = "Will they forgive you?",
	["quest.side_fp_spurs.say.forgive.reply"] = "That's not why I leave them. They're theirs, not mine.",
	["quest.side_fp_spurs.say.enter"] = "Will you go in afterwards?",
	["quest.side_fp_spurs.say.enter.reply"] = "Not today. Maybe when the gate knows me.",
	["quest.side_fp_spurs.say.wind"] = "The wind will put the candles out.",
	["quest.side_fp_spurs.say.wind.reply"] = "It will. Then I'll light new ones.",
	["quest.side_fp_spurs.bark.accept1"] = "The gate will see that I came back. That's all I want.",
	["quest.side_fp_spurs.bark.near1"] = "I stood here that night. Here I turned around.",
	["quest.side_fp_spurs.bark.half1"] = "The elementals circle closer to the candles. Don't let them go out.",
	["quest.side_fp_spurs.bark.done1"] = "If Brother Halgrim still keeps watch, let him know his squire came back.",
	-- H. Wyrm Bones
	["quest.side_fp_letter.title"] = "A Letter for Vigdis",
	["quest.side_fp_letter.p1"] = "For years I have written to Vigdis, a scholar of the southern archive. She writes on dragons better than anyone I know. Now she has come to the Dragon Stairs alone.",
	["quest.side_fp_letter.p2"] = "Take her this letter. I ask her to come down from the mountains. I know she won't, but I must ask.",
	["quest.side_fp_letter.progress"] = "Take Brother Anzelm's letter to Vigdis the Scholar at the foot of the Dragon Stairs.",
	["quest.side_fp_letter.done"] = "Anzelm. He writes that I should come down. He has written so for twenty years. I'll answer him from up here. Since you're here, you'll be useful.",
	["quest.side_fp_letter.say.who"] = "Who is Vigdis?",
	["quest.side_fp_letter.say.who.reply"] = "A scholar of the southern archive. Stubborn, like all scholars.",
	["quest.side_fp_letter.say.warn"] = "What are you warning her of?",
	["quest.side_fp_letter.say.warn.reply"] = "Curiosity. Mine once cost me dearly.",
	["quest.side_fp_letter.say.where"] = "Where will I find her?",
	["quest.side_fp_letter.say.where.reply"] = "At the foot of the Dragon Stairs. I'll mark it.",
	["quest.side_fp_letter.bark.accept1"] = "Give her the letter before she starts talking. After that you won't get a chance.",
	["quest.side_fp_letter.bark.done1"] = "From Anzelm? I'll answer from up here. Let him worry with a view.",
	["quest.side_fp_clutches.title"] = "Clutches in the Scarps",
	["quest.side_fp_clutches.p1"] = "The wyrms lay their clutches in burrows in the ice scarps beyond the Bone Trail. The shells are thin as glass and warm despite the frost.",
	["quest.side_fp_clutches.p2"] = "They must be smashed before they hatch. I'll note every shell, but the smashing needs someone else's hand.",
	["quest.side_fp_clutches.p3"] = "The dragonspawn guard the burrows like a temple. Thin them out, or you won't get close.",
	["quest.side_fp_clutches.progress"] = "Smash three clutches in the burrows of the ice scarps and kill twelve dragonspawn on the Wyrm Spire.",
	["quest.side_fp_clutches.done"] = "Nothing will hatch here this spring. The shells grow in rings, like wood. That matters, though I don't know why yet. I'll write it down.",
	["quest.side_fp_clutches.say.spawn"] = "Dragonspawn clutches?",
	["quest.side_fp_clutches.say.spawn.reply"] = "Wyrm clutches. The spawn guard them. Please don't confuse them, I'm writing a treatise.",
	["quest.side_fp_clutches.say.eggs"] = "They're only eggs.",
	["quest.side_fp_clutches.say.eggs.reply"] = "In a year, only wyrms. In ten years, only your valley.",
	["quest.side_fp_clutches.say.burrows"] = "Where are the burrows?",
	["quest.side_fp_clutches.say.burrows.reply"] = "In the scarps beyond the Bone Trail. I'll mark them.",
	["quest.side_fp_clutches.bark.accept1"] = "Three burrows. The spawn guard them, please keep that in mind.",
	["quest.side_fp_clutches.bark.half1"] = "Shells thin as glass. Noted.",
	["quest.side_fp_clutches.bark.done1"] = "Nothing will hatch here this spring.",
	["quest.side_fp_clutches.bark.death1"] = "Get up. I keep notes, not obituaries.",
	["quest.side_fp_bonetrail.title"] = "The Bone Trail",
	["quest.side_fp_bonetrail.p1"] = "The skeleton on the Bone Trail is a wyrm older than human memory. Its ribs make a gate over the road.",
	["quest.side_fp_bonetrail.p2"] = "I want to compare it with the scales of living wyrms. If they grow alike, I have an answer I'm afraid of.",
	["quest.side_fp_bonetrail.p3"] = "Go to the skeleton and look at the ribs. Then bring three scales. From living ones, please, I have dead ones already.",
	["quest.side_fp_bonetrail.progress"] = "Reach the wyrm's skeleton on the Bone Trail and take three scales from the frost wyrms of the Wyrm Spire.",
	["quest.side_fp_bonetrail.done"] = "They grow alike. In rings, like trees, and like the dragon. These are no beasts of the mountains. They are the dragon's brood.",
	["quest.side_fp_bonetrail.say.age"] = "How old is that skeleton?",
	["quest.side_fp_bonetrail.say.age.reply"] = "Older than the chronicles. Chronicles are younger than they seem.",
	["quest.side_fp_bonetrail.say.scales"] = "Why scales from living ones?",
	["quest.side_fp_bonetrail.say.scales.reply"] = "To compare the growth. Scales first, then bones.",
	["quest.side_fp_bonetrail.say.trail"] = "Which way?",
	["quest.side_fp_bonetrail.say.trail.reply"] = "From the tundra up onto the plateau. The bones show the way.",
	["quest.side_fp_bonetrail.bark.accept1"] = "The skeleton and three scales. Any order, only come back.",
	["quest.side_fp_bonetrail.bark.near1"] = "Look at the ribs. They grow in rings, like a dragon's.",
	["quest.side_fp_bonetrail.bark.half1"] = "The living ones' scales grow the same. I feared as much.",
	["quest.side_fp_bonetrail.bark.done1"] = "I have the proof. Come back before I lose it in my notes.",
	["quest.side_fp_treatise.title"] = "On the Brood",
	["quest.side_fp_treatise.p1"] = "I'm finishing the treatise. Its title: “On the Brood”. The wyrms are the dragon's offspring, and the mountains know it already. The valleys don't yet.",
	["quest.side_fp_treatise.p1.eggs"] = "You said they were only eggs. Now you know whose. I'm finishing “On the Brood”. The mountains know it already, the valleys don't yet.",
	["quest.side_fp_treatise.p2"] = "The wyrms have circled my camp since you smashed the clutches. They remember. Thin them out, I must finish in peace.",
	["quest.side_fp_treatise.p3"] = "Then take the treatise to Anzelm. Into the archive, not into the fireplace.",
	["quest.side_fp_treatise.p4"] = "I'm staying. Anzelm asked me to come down. I will, when I finish the next one.",
	["quest.side_fp_treatise.progress"] = "Kill ten frost wyrms on the Wyrm Spire and take the treatise “On the Brood” to Brother Anzelm in the city.",
	["quest.side_fp_treatise.done"] = "“On the Brood.” I'll put it in the archive, where another book once stood, one that should never have been read. This one is different. This one must be read. Take this for the road.",
	["quest.side_fp_treatise.say.title"] = "Why “On the Brood”?",
	["quest.side_fp_treatise.say.title.reply"] = "Because “On What I Fear” sounds less scholarly.",
	["quest.side_fp_treatise.say.down"] = "Anzelm asked you to come down.",
	["quest.side_fp_treatise.say.down.reply"] = "I will, when I'm done. The treatise goes down first.",
	["quest.side_fp_treatise.say.blood"] = "The dragon and the wyrms are one blood?",
	["quest.side_fp_treatise.say.blood.reply"] = "One. That's why this treatise can't stay in the mountains.",
	["quest.side_fp_treatise.bark.accept1"] = "I must finish in peace. The wyrms disagree.",
	["quest.side_fp_treatise.bark.half1"] = "The last chapter. The shortest and the worst.",
	["quest.side_fp_treatise.bark.done1"] = "I'll put it where it belongs. Thank you.",
	["quest.side_fp_treatise.bark.stuck1"] = "The wyrms circle over the plateau, not in the burrows. Look up.",
}
