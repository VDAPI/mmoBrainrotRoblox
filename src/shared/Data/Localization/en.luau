	["place.manor"] = "The ruined manor on the hill in the Haunted Ruins",
	["place.wayShrine"] = "The wayside shrine at the Misty Crossroads",
	["place.cryptGate"] = "The Crypt Gate on the Blood Cliffs",
	["place.lostCamp"] = "The lost camp in Bear Hollow",
	["place.moonGlade"] = "The Moon Glade",
