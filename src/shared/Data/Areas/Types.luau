--!strict
-- Named monster areas and map features (S19, DESIGN §3.5–§3.6). One source of truth for monster groups
-- (Logic/AreaSpawns -> Data/Spawns), roads drawn by the layouts, cave entrances and the world map (S20).
-- Coordinates are map-relative studs.

export type Circle = { x: number, z: number, r: number }

export type Road = { points: { number }, width: number, material: string }

-- Stream (S26): water channel along points {x1, z1, x2, z2, ...}; `widths` per point (water width in studs),
-- `bank` gentle bank width on each side, `depth` of the channel under the water surface. The water level falls
-- along the stream (Logic/MeadowsTerrain); `into` names what it flows into ("lake" or "stream:<index>").
export type Stream = {
	id: string,
	points: { number },
	widths: { number },
	bank: number,
	depth: number,
	into: string,
	-- Shallow places (fords, rapids): circles where the channel is only `depth` deep.
	shallows: { { x: number, z: number, r: number, depth: number } }?,
	-- Water level from the centre line only (a stream on a plateau ending at a cliff: the waterfall lip).
	centreOnly: boolean?,
	-- S47: frozen over: a flat top of ice at the water level (walkable, no water), the water under it.
	frozen: boolean?,
}

-- Place prepared for an NPC of a later session (S26 -> S27): standing point and facing (yaw, degrees; the front
-- is (-sin, -cos) like the city plan). Flat ground, dry, outside every monster group (listed in `avoid`).
export type NpcSpot = { x: number, z: number, facing: number }

-- Invisible quest object (S26 -> S27): a part tagged "QuestAnchor" with the attribute AnchorId, `y` studs over
-- the ground (default 2).
export type QuestAnchor = { id: string, x: number, z: number, y: number? }

-- Place of a building or landmark built by a layout (S26): yaw `rot` in degrees, front = (-sin rot, -cos rot).
export type Site = { x: number, z: number, rot: number }

export type Area = {
	id: string,
	nameKey: string,
	lv: { number }, -- { min, max }
	kinds: { string }, -- normal monster kinds (2–3)
	rect: { number }, -- { x1, z1, x2, z2 }
	groups: number,
	landmark: { x: number, z: number }?,
	-- Where a portal or a map stone brings a player who picked this area (S22): on a road just inside the area,
	-- 35+ studs from every group (generated by Logic/AreaArrival, checked by tests/areaarrival.spec).
	arrive: { x: number, z: number }?,
	-- S26: client decoration theme ("meadow", "hills", "marsh", "forest", "field", "road", "quarry", "goblin",
	-- "ravine"; S45 Duskwood: "thicket", "hollow", "ruins", "rot", "cult", "mist", "bog", "witch", "cliffs"),
	-- also the key of the area's mood in Data/Ambience.
	decor: string?,
	-- S33: hunting ground profile (Data/AreaProfiles: "exp" | "loot" | "gold"); nil = neutral.
	profile: string?,
}

-- Entrance of a cave on its region map; the mouth faces `rot` degrees (0 = the opening looks to -Z).
export type CaveEntrance = { cave: string, x: number, z: number, rot: number }

export type MapAreas = {
	map: string,
	roads: { Road },
	lakes: { Circle },
	avoid: { Circle }, -- portals, spawn points, buildings: no monster groups here
	caves: { CaveEntrance },
	areas: { Area },
	streams: { Stream }?, -- S26
	npcSpots: { [string]: NpcSpot }?, -- S26
	questAnchors: { QuestAnchor }?, -- S26
	sites: { [string]: Site }?, -- S26: buildings and landmarks of the layout (also terrain flats)
}

export type Room = { x: number, z: number, r: number, h: number }

export type Cave = {
	id: string, -- map id
	region: string, -- region map id
	nameKey: string,
	levels: { number }, -- { min, max }
	normal: { string }, -- 2–3 normal kinds (groups of 1–4)
	elites: { string }, -- exactly 2 elite kinds (3–5 groups of 1–2)
	elite2: { string }, -- 1–2 kinds; one Elite II at a time, picked on every respawn
	eliteGroups: number,
	ores: { string }, -- gathering node kinds
	oreCount: number,
	-- Generated caves (CaveTemplate): seed, terrain material and decoration theme; the boss caves keep
	-- their hand-made layouts and list their rooms here.
	seed: number?,
	material: string?,
	theme: string?,
	rooms: { Room }?, -- rooms[1] is the entrance; boss caves: the last room is the dungeon antechamber
	boss: boolean, -- last cave of the region with the boss dungeon gate
	profile: string?, -- S33: Data/AreaProfiles id (caves have none yet: their elites already are the better drop)
}

return nil
