--!strict
-- Template animation (owner 2026-10-26, "krecimy dzisiaj animacje do reszty"): the four humanoid bosses on the biped
-- template (Logic/BipedMotion, client/Anim/BipedRig) instead of their bone clips. Data/BipedStyles registers these
-- styles by the boss's id (Data/MonsterAssets `motion`); the conventions are that file's (keys in the segments A, S,
-- F, R of a timeline whose strike ends exactly on the server's hit, distances in leg lengths). What a boss adds:
-- * `boss` (Data/BipedStyles.BossLayer): the weight of its walk (the mocap walk at full weight however slow a giant's
--   stride, the pelvis dropping after each footfall onto planted feet), a stance never quite let go out of the fight,
--   a slow head scan, deep breathing, the enraged and shielded stances, how little a hit stirs a big cast, its roars;
-- * channels (`channel`): the blow held for the run's `hold` (keys in segment "H": a spiral pours out, a breath sweeps,
--   bombs and javelins fly one after another), the body turning with the cast (the run's `turn`);
-- * a leap (`leap`) flying the boss's own arc (Data/BossMotions arc) over its last part to where the server lands it;
-- * meta controls in keys: `tremble` (a gathering strain), `spin` (the whirlwind's turns), `air` (a hop).
-- Every attack of Data/Bosses and every pattern of Data/BossMotions maps to an action (`abilities`); a roar into each
-- phase, the rage, the stagger of a broken channel and a long death (the look's clone plays it on, MonsterViewController).
-- Locomotion is the bandit's Mixamo mocap (Data/BipedClips walk, run, idles; owner-approved) with the weight layer,
-- Morvane floats (Logic/SpiritMotion: her gown trails). Weapons are part of each mesh: no grip is known, so the keys
-- swing the arms and wrists only (Data/MonsterAssets `grip` and bRx..bRz can aim a blade after the Studio pass).

type Pose = { [string]: number }
type Key = { seg: string, u: number, ease: string?, pose: Pose }
type Action = {
	keys: { Key },
	strike: number,
	follow: number,
	recover: number,
	legs: boolean,
	hold: boolean?,
	travel: boolean?,
	full: boolean?,
	lag: { [string]: number }?,
	channel: boolean?,
	turnFeet: number?,
	leap: boolean?,
}

local BossStyles = {}

-- A pose: the base with `over` laid on (absolute values).
local function from(base: Pose, over: Pose): Pose
	local out = table.clone(base)
	for k, v in over do
		out[k] = v
	end
	return out
end

local function key(seg: string, u: number, ease: string, pose: Pose): Key
	return { seg = seg, u = u, ease = ease, pose = pose }
end

-- The bandit's mocap (Data/BipedClips): walk and run phase-synced to the ground speed, the idles.
local CLIPS = { idle = { "idle", "idleShift", "idleLook" }, walk = "walk", run = "run" }

-- The flinch of a boss: a third of the bandit's (a heavy body; a big cast damps it further, `castDamp`).
local function flinch(k: number): { [string]: Pose }
	return {
		front = { spitch = -0.3 * k, hpitch = -0.25 * k, pz = 0.05 * k, aRo = 0.15 * k, aLo = 0.2 * k },
		back = { spitch = 0.32 * k, hpitch = 0.2 * k, pz = -0.04 * k, ppitch = 0.06 * k },
		left = { sroll = -0.28 * k, hroll = -0.2 * k, syaw = 0.12 * k, px = 0.04 * k },
		right = { sroll = 0.28 * k, hroll = 0.2 * k, syaw = -0.12 * k, px = -0.04 * k },
	}
end

