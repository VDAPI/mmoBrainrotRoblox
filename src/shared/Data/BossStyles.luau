-- the fist (the regular blow): the right fist hauled back past the hip with the shoulder turned away, then a huge
-- hook through the target with the body wrung after it
local function hook(side: string): Action
	local s = side
	local o = if s == "R" then "L" else "R"
	local sign = if s == "R" then 1 else -1
	local back: Pose = hv({
		py = -0.1,
		pz = 0.04,
		pyaw = -0.35 * sign,
		syaw = -0.42 * sign,
		spitch = 0.18,
		hyaw = 0.35 * sign,
	})
	back["a" .. s .. "p"] = 0.6
	back["a" .. s .. "o"] = 0.75
	back["a" .. s .. "y"] = -0.45
	back["e" .. s] = 1.6
	back["c" .. s .. "u"] = 0.35
	back["a" .. o .. "p"] = 0.9
	back["a" .. o .. "o"] = 0.35
	back["a" .. o .. "y"] = 0.55
	back["e" .. o] = 1.2
	local hit: Pose = hv({
		py = -0.18,
		pz = -0.1,
		pyaw = 0.32 * sign,
		syaw = 0.45 * sign,
		spitch = 0.32,
		hyaw = -0.2 * sign,
		fLz = -0.24,
	})
	hit["a" .. s .. "p"] = 1.4
	hit["a" .. s .. "o"] = 0.35
	hit["a" .. s .. "y"] = 0.9
	hit["e" .. s] = 0.55
	hit["c" .. s .. "f"] = 0.35
	hit["a" .. o .. "p"] = 0.2
	hit["a" .. o .. "o"] = 0.6
	hit["a" .. o .. "y"] = 0
	hit["e" .. o] = 1.0
	local after = table.clone(hit)
	after.pyaw = 0.4 * sign
	after.syaw = 0.55 * sign
	after["a" .. s .. "y"] = 1.1
	after["e" .. s] = 0.75
	return {
		strike = 0.17,
		follow = 0.38,
		recover = 0.5,
		legs = true,
		lag = { head = 0.07, free = 0.07 },
		keys = {
			key("A", 1, "inout", back),
			key("S", 1, "in", hit),
			key("F", 1, "out", after),
			key("R", 1, "inout", HV_GUARD),
		},
	}
end
