--!strict
-- Monster bodies (ARCHITECTURE §7). Decision (S03): every monster is a Model with an invisible
-- HumanoidRootPart and an R15-type Humanoid (HipHeight keeps it standing, MoveTo walks it).
-- Decision (S24): the server builds only that body. The look (generated by Logic/Anatomy from
-- Data/MonsterLooks, or a real model from ReplicatedStorage.Assets.Monsters) is built by each client
-- (MonsterViewController) inside the model, welded to the root. The server sizes the root and the hip
-- height from the same rig the clients build (or from `asset` numbers), and tells clients what to build with
-- the attributes Look (look id), LookScale and LookRegion, set before the model is parented.
-- S162m: the root carries an Attachment "Muzzle" where the kind's shots leave the drawn body (Data/MonsterRelease).
-- Owner 2026-11-10 ("they may block, but no climbing"): a player bumps into the monster's invisible "Blocker" column
-- (Data/BodyGroups.blocker, welded to the root, colliding with player characters only, over the highest a player's body
-- gets beside it), never into its root, so nobody steps, jumps or rides onto a monster; one who comes down on the column
-- from above (a ledge, a cliff) slides off it (Logic/BlockerGuard). RigBuilder.dropBlocker lets the way free when it
-- dies. The column is part of the model, so clients measure a monster by its look (client/Util/MonsterBox), not by the
-- model's bounding box.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Anatomy = require(ReplicatedStorage.Shared.Logic.Anatomy)
local BodyGroups = require(ReplicatedStorage.Shared.Data.BodyGroups)
local MonsterLooks = require(ReplicatedStorage.Shared.Data.MonsterLooks)
local MonsterRelease = require(ReplicatedStorage.Shared.Data.MonsterRelease)
local Monsters = require(ReplicatedStorage.Shared.Data.Monsters)

local RigBuilder = {}

-- `drawn` (S162m): the height of the drawn look (an imported model grows by its `visual`, Data/MonsterAssets)
export type Body = { rootSize: Vector3, hipHeight: number, height: number, drawn: number }

local AURA = {
	elite = { color = "#D64A3E", rate = 6 },
	elite2 = { color = "#B455FF", rate = 14 },
}

-- Body sizes per look id, variant and scale (rigs are deterministic, so one build per combination).
local cache: { [string]: Body } = {}

local function aura(root: BasePart, color: Color3, rate: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Aura"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Speed = NumberRange.new(1, 2.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = root
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 12
	light.Brightness = 1.2
	light.Parent = root
end

local function configureHumanoid(humanoid: Humanoid)
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.AutoJumpEnabled = false
	humanoid.MaxHealth = 1e9
	humanoid.Health = 1e9
	for _, state in
		{
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Swimming,
			Enum.HumanoidStateType.FallingDown,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Dead,
			Enum.HumanoidStateType.Jumping,
		}
	do
		humanoid:SetStateEnabled(state, false)
	end
end

-- Root size, hip height and height of a look at `scale` (asset numbers when the look names a real model).
function RigBuilder.body(lookId: string, variant: string, scale: number, region: number?): Body
	local key = `{lookId}|{variant}|{math.floor(scale * 1000 + 0.5)}`
	local cached = cache[key]
	if cached then
		return cached
	end
	local look = MonsterLooks.get(lookId, region)
	local body: Body
	if look and look.asset then
		local asset = look.asset
		local k = scale * (asset.scale or 1)
		body = {
			rootSize = Vector3.new(asset.rootSize[1], asset.rootSize[2], asset.rootSize[3]) * k,
			hipHeight = math.max(0.1, asset.hipHeight * k),
			height = asset.height * k,
			drawn = asset.height * k * (asset.visual or 1),
		}
	else
		local rig = Anatomy.build(
			(look or MonsterLooks.get("bandit")) :: any,
			{ id = lookId, variant = variant, scale = scale }
		)
		local s = rig.root.size
		body = {
			rootSize = Vector3.new(s[1], s[2], s[3]),
			hipHeight = rig.hipHeight,
			height = rig.height,
			drawn = rig.height,
		}
	end
	cache[key] = body
	return body
end

-- Builds the body of a monster kind at `variantScale` (multiplied by the kind's size). Not parented.
function RigBuilder.build(def: Monsters.MonsterDef, variant: string, variantScale: number): Model
	local scale = def.size * variantScale
	local region = if def.region > 0 then def.region else nil
	if not MonsterLooks.has(def.id) then
		warn(`[RigBuilder] no look for {def.id} in Data/MonsterLooks; using a placeholder`)
	end
	local body = RigBuilder.body(def.id, variant, scale, region)

	local model = Instance.new("Model")
	model.Name = def.id
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = body.rootSize
	root.Transparency = 1
	-- The root is the only colliding part, so the humanoid always has something to stand with. Clicks hit it
	-- too (CanQuery) when the look is not built yet.
	root.CanCollide = true
	root.CanTouch = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root

	-- the column players bump into (the root is in "Monsters", which never touches a player)
	local size, y =
		BodyGroups.blocker({ body.rootSize.X, body.rootSize.Y, body.rootSize.Z }, body.hipHeight, body.drawn)
	local blocker = Instance.new("Part")
	blocker.Name = BodyGroups.BLOCKER
	blocker.Size = Vector3.new(size[1], size[2], size[3])
	blocker.CFrame = root.CFrame * CFrame.new(0, y, 0)
	blocker.Transparency = 1
	blocker.CanCollide = true
	blocker.CanQuery = false
	blocker.CanTouch = false
	blocker.Massless = true
	blocker.CastShadow = false
	blocker.CollisionGroup = BodyGroups.BLOCKERS
	blocker.TopSurface = Enum.SurfaceType.Smooth
	blocker.BottomSurface = Enum.SurfaceType.Smooth
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = blocker
	weld.Parent = blocker
	blocker.Parent = model

	-- S162m: where its shots leave (the mouth, the beak, the hand): shares of the drawn height from the feet, ahead of
	-- the root (-Z) and to its right; the root's centre stands hipHeight + half its height over the feet
	local release = MonsterRelease.of(def.id)
	local h = body.drawn
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position =
		Vector3.new(release.side * h, release.up * h - body.hipHeight - body.rootSize.Y / 2, -release.fwd * h)
	muzzle.Parent = root

	local humanoid = Instance.new("Humanoid")
	configureHumanoid(humanoid)
	humanoid.HipHeight = body.hipHeight
	humanoid.WalkSpeed = def.moveSpeed
	humanoid.Parent = model

	model:SetAttribute("Look", def.id)
	model:SetAttribute("LookScale", scale)
	model:SetAttribute("LookRegion", region)
	-- Stream the whole model at once so clients never see half a monster.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local spec = (AURA :: any)[variant]
	if spec then
		aura(root, Color3.fromHex(spec.color), spec.rate)
	elseif variant == "boss" then
		aura(root, Color3.fromHex(def.aura or "#E8C25A"), 24)
	end
	return model
end

-- A dead monster's body no longer blocks the way (its blocker stops colliding; the body stays for the death).
function RigBuilder.dropBlocker(model: Model)
	local blocker = model:FindFirstChild(BodyGroups.BLOCKER)
	if blocker and blocker:IsA("BasePart") then
		blocker.CanCollide = false
	end
end

return RigBuilder
