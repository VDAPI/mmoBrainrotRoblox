		{ path = "Data/BuffCategories" },
		{ path = "Data/Classes", omit = LOOKS },
		{ path = "Data/Combat" },
		{ path = "Data/Families", omit = LOOKS },
		{ path = "Data/GuildSkills", omit = LOOKS },
		{ path = "Data/ItemTraits", omit = LOOKS },
		{ path = "Data/ItemValue" },
		{ path = "Data/ItemWeights" },
		{ path = "Data/Items/Backpacks", omit = LOOKS },
		{ path = "Data/Items/Bases", omit = LOOKS },
		{ path = "Data/Items/Consumables", omit = LOOKS },
		{ path = "Data/Items/Materials", omit = LOOKS },
