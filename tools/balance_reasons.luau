		-- the rest of Items/init is the generated byId (Bases x tiers) and slot lists
		{ path = "Data/Items/init", pick = { "startingPotions" } },
		{ path = "Data/LevelCurves" },
		{ path = "Data/LootRules" },
		{ path = "Data/LootTables" },
		{ path = "Data/Luck" },
		{ path = "Data/Market" },
		{ path = "Data/MonsterAbilities", omit = LOOKS },
		{ path = "Data/Monsters", omit = LOOKS },
		{ path = "Data/Paths/Cleric" },
		{ path = "Data/Paths/Hunter" },
		{ path = "Data/Paths/Mage" },
		{ path = "Data/Paths/Warrior" },
		-- list / byId / byClass are the records of the class files (dumped there)
		{ path = "Data/Paths/init", omit = { "list", "byId", "byClass" } },
		{ path = "Data/Progression" },
		{ path = "Data/Quests/Daily" },
		{ path = "Data/Quests/Main" },
		{ path = "Data/Quests/Side" },
		{ path = "Data/Rarities", omit = LOOKS },
		{ path = "Data/Recipes" },
		{ path = "Data/Shops" },
		{ path = "Data/SkillCurves" },
