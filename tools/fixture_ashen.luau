--!strict
-- Writes tests/fixtures/ashenHeights.luau (S46): ~400 points of the finished Ashen Wastes terrain (height, water,
-- material) from Logic/RegionTerrain. tests/ashen.spec checks the engine still gives them; S47 extends
-- the engine and must not change them. Run only when the Wastes' shape is meant to change:
--   lune run tools/fixture_ashen.luau

local fs = require("@lune/fs")

local RegionTerrain = require("../src/shared/Logic/RegionTerrain")

local T = assert(RegionTerrain.get("ashen"))
local lines = {
	"--!strict",
	"-- Generated by tools/fixture_ashen.luau (S46): { x, z, height, water?, material } of the Ashen Wastes terrain.",
	"-- Do not edit; regenerate only when the Wastes' shape is meant to change.",
	"",
	"return {",
	"\tpoints = {",
}
local n = 0
for i = 0, 19 do
	for k = 0, 19 do
		local x = -780 + i * 82 + (k % 3) * 7
		local z = -780 + k * 82 + (i % 4) * 5
		local h = T.height(x, z)
		local w = T.water(x, z)
		table.insert(
			lines,
			string.format('\t\t{ %d, %d, %.4f, %s, "%s" },', x, z, h, if w then "true" else "false", T.material(x, z))
		)
		n += 1
	end
end
table.insert(lines, "\t},")
table.insert(lines, "}")
fs.writeFile("tests/fixtures/ashenHeights.luau", table.concat(lines, "\n") .. "\n")
print(`{n} points -> tests/fixtures/ashenHeights.luau`)
