--!strict
-- Writes tests/fixtures/caveShapes.luau (S48): ~300 points per map on the cave engine (floor, ceiling, liquid level,
-- floor material) from Logic/CaveTerrain. S49-S51 add their maps and must not change the existing entries: run this
-- only on purpose (after a deliberate change of a cave's shape) and keep the old maps' lines.
--   lune run tools/fixture_caveshapes.luau

local fs = require("@lune/fs")

local CaveDress = require("../src/shared/Logic/CaveDress")
local CaveTerrain = require("../src/shared/Logic/CaveTerrain")
local Rng = require("../src/shared/Logic/Rng")

local lines = {
	"--!strict",
	"-- Generated by tools/fixture_caveshapes.luau (S48): points of the caves on the cave engine",
	"-- { x, z, floor | false, ceiling | false, liquid level | false, floor material }. Do not edit.",
	"",
	"return {",
}
local function n(v: number?): string
	if v == nil then
		return "false"
	end
	return string.format("%.3f", math.min(v, 9999))
end
for _, id in CaveDress.maps() do
	local T = assert(CaveTerrain.get(id))
	local rng = Rng.new(4848)
	table.insert(lines, `\t{id} = \{`)
	local made = 0
	local tries = 0
	while made < 300 and tries < 20000 do
		tries += 1
		local x = math.floor(rng:float(-T.HALF, T.HALF))
		local z = math.floor(rng:float(-T.HALF, T.HALF))
		local c = T.column(x, z)
		-- two thirds of the points on the floor, a third in the rock
		if c.open or made % 3 == 2 then
			made += 1
			local liquid = c.liquid
			table.insert(
				lines,
				`\t\t\{ {x}, {z}, {if c.open then n(c.floor) else "false"}, {if c.open
					then n(c.ceiling)
					else "false"}, {if liquid then n(liquid.level) else "false"}, "{c.floorMat}" \},`
			)
		end
	end
	table.insert(lines, "\t},")
end
table.insert(lines, "}")
table.insert(lines, "")
fs.writeFile("tests/fixtures/caveShapes.luau", table.concat(lines, "\n"))
print("wrote tests/fixtures/caveShapes.luau")
