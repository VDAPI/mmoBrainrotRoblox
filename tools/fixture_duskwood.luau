--!strict
-- Writes tests/fixtures/duskwoodHeights.luau (S45): ~400 points of the finished Duskwood terrain (height, water,
-- material) from Logic/RegionTerrain. tests/regionterrain.spec checks the engine still gives them; S46/S47 extend
-- the engine and must not change them. Run only when Duskwood's shape is meant to change:
--   lune run tools/fixture_duskwood.luau

local fs = require("@lune/fs")

local RegionTerrain = require("../src/shared/Logic/RegionTerrain")

local T = assert(RegionTerrain.get("duskwood"))
local lines = {
	"--!strict",
	"-- Generated by tools/fixture_duskwood.luau (S45): { x, z, height, water?, material } of the Duskwood terrain.",
	"-- Do not edit; regenerate only when Duskwood's shape is meant to change.",
	"",
	"return {",
	"\tpoints = {",
}
local n = 0
for i = 0, 19 do
	for k = 0, 19 do
		local x = -780 + i * 82 + (k % 3) * 7
		local z = -780 + k * 82 + (i % 4) * 5
		local h = T.height(x, z)
		local w = T.water(x, z)
		table.insert(lines, string.format('\t\t{ %d, %d, %.4f, %s, "%s" },', x, z, h, if w then "true" else "false", T.material(x, z)))
		n += 1
	end
end
table.insert(lines, "\t},")
table.insert(lines, "}")
fs.writeFile("tests/fixtures/duskwoodHeights.luau", table.concat(lines, "\n") .. "\n")
print(`{n} points -> tests/fixtures/duskwoodHeights.luau`)
