--!strict
-- Writes tests/fixtures/caveRooms.luau (S48): the room plans (Logic/CaveGen) of every generated cave and every
-- spawner of Logic/AreaSpawns.cave of all 12 caves (id, x, z, variant, monster, members, count, radius). The cave
-- engine of S48-S51 may change only the spawners' y, so tests/caveterrain.spec compares the rest against this file.
--   lune run tools/fixture_caves.luau

local fs = require("@lune/fs")

local AreaSpawns = require("../src/shared/Logic/AreaSpawns")
local Areas = require("../src/shared/Data/Areas")
local CaveGen = require("../src/shared/Logic/CaveGen")

local lines = {
	"--!strict",
	"-- Generated by tools/fixture_caves.luau (S48): room plans of the generated caves and every cave spawner's x/z.",
	"-- Do not edit; the cave engine may change only the spawners' y.",
	"",
	"return {",
	"\tplans = {",
}
local function num(v: number): string
	return string.format("%.4f", v)
end
local caves = {}
for _, cave in Areas.caves.list do
	table.insert(caves, cave)
end
table.sort(caves, function(a, b)
	return a.id < b.id
end)
for _, cave in caves do
	if cave.seed and not cave.rooms then
		local plan = CaveGen.generate(cave.seed)
		table.insert(lines, `\t\t{cave.id} = \{`)
		table.insert(lines, "\t\t\trooms = {")
		for _, r in plan.rooms do
			table.insert(lines, `\t\t\t\t\{ {num(r.x)}, {num(r.z)}, {r.r}, {r.h} \},`)
		end
		table.insert(lines, "\t\t\t},")
		table.insert(lines, "\t\t\tcorridors = {")
		for _, c in plan.corridors do
			table.insert(lines, `\t\t\t\t\{ {num(c.ax)}, {num(c.az)}, {num(c.bx)}, {num(c.bz)}, {c.w} \},`)
		end
		table.insert(lines, "\t\t\t},")
		table.insert(lines, "\t\t},")
	end
end
table.insert(lines, "\t},")
table.insert(lines, "\tspawners = {")
for _, cave in caves do
	for _, s in AreaSpawns.cave(cave) do
		local members = {}
		for _, m in s.members do
			table.insert(members, `"{m}"`)
		end
		table.insert(
			lines,
			`\t\t\{ "{s.id}", {s.position.x}, {s.position.z}, "{s.variant}", "{s.monster}", \{ {table.concat(
				members,
				", "
			)} \}, {s.count}, {s.radius} \},`
		)
	end
end
table.insert(lines, "\t},")
table.insert(lines, "}")
table.insert(lines, "")
fs.writeFile("tests/fixtures/caveRooms.luau", table.concat(lines, "\n"))
print("wrote tests/fixtures/caveRooms.luau")
