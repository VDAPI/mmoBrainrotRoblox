--!strict
local Channel = require("../src/shared/Logic/Channel")
local SkillData = require("../src/shared/Data/Skills")
local Skills = require("../src/shared/Logic/Skills")
local T = require("./Test")

T.describe("Channel.stops (S70)", function()
	T.it("damage ends a channel unless steadfast; moving and death always", function()
		T.expect(Channel.stops("channel", "damage", {})).toBe(true)
		T.expect(Channel.stops("channel", "damage", nil)).toBe(true)
		T.expect(Channel.stops("channel", "damage", { steadfast = true })).toBe(false)
		T.expect(Channel.stops("channel", "move", { steadfast = true })).toBe(true)
		T.expect(Channel.stops("channel", "death", { steadfast = true })).toBe(true)
		T.expect(Channel.stops("channel", "move", nil)).toBe(true)
		T.expect(Channel.stops("other", "damage", { steadfast = true })).toBe(true)
	end)

	T.it("Prayer 10B makes the channel steadfast", function()
		local prayer = SkillData.byId.prayer
		local steady = Skills.effective(prayer, 10, { ["prayer:10"] = "b" }, nil, true)
		T.expect(steady.steadfast).toBe(true)
		T.expect(Channel.stops("channel", "damage", steady)).toBe(false)
		local plain = Skills.effective(prayer, 10, nil, nil, true)
		T.expect(plain.steadfast).toBeNil()
		T.expect(Channel.stops("channel", "damage", plain)).toBe(true)
		local chosenA = Skills.effective(prayer, 10, { ["prayer:10"] = "a" }, nil, true)
		T.expect(Channel.stops("channel", "damage", chosenA)).toBe(true)
	end)
end)

T.describe("castTime (S76)", function()
	T.it("moving or a stun ends the aim with a refund, damage never, death without a refund", function()
		local def = {}
		local stop, refund = Channel.stops("castTime", "move", def)
		T.expect({ stop, refund }).toEqual({ true, true })
		stop, refund = Channel.stops("castTime", "disabled", def)
		T.expect({ stop, refund }).toEqual({ true, true })
		stop, refund = Channel.stops("castTime", "death", def)
		T.expect({ stop, refund }).toEqual({ true, false })
		T.expect((Channel.stops("castTime", "damage", def))).toBe(false)
		T.expect((Channel.stops("castTime", "damage", { steadfast = true }))).toBe(false)
		T.expect((Channel.stops("castTime", "damage", nil))).toBe(false)
	end)

	T.it("Focus and Prayer keep their rules and ignore a stun", function()
		local stop, refund = Channel.stops("channel", "disabled", {})
		T.expect({ stop, refund }).toEqual({ false, false })
		stop, refund = Channel.stops("channel", "move", {})
		T.expect({ stop, refund }).toEqual({ true, false })
		stop, refund = Channel.stops("channel", "damage", {})
		T.expect({ stop, refund }).toEqual({ true, false })
		T.expect((Channel.stops("channel", "damage", { steadfast = true }))).toBe(false)
	end)
end)

T.describe("channelMove (S79)", function()
	T.it("a channel with channelMove survives moving, not damage; aiming still ends with a refund", function()
		T.expect({ Channel.stops("channel", "move", { channelMove = 50 }) }).toEqual({ false, false })
		T.expect((Channel.stops("channel", "move", {}))).toBe(true)
		T.expect((Channel.stops("channel", "damage", { channelMove = 50 }))).toBe(true)
		T.expect({ Channel.stops("castTime", "move", { channelMove = 50 }) }).toEqual({ true, true })
	end)
end)

return nil
