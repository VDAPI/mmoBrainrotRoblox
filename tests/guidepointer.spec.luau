--!strict
-- The guide pointer's maths (W28, Logic/GuidePointer): the arrow's angle against the camera, the screen-edge arrow,
-- the ground chevrons and the reach test.
local GuidePointer = require("../src/shared/Logic/GuidePointer")
local T = require("./Test")

T.describe("GuidePointer: bearing", function()
	T.it("points up for a target straight ahead and turns clockwise to the right", function()
		-- camera looking along -Z (Roblox's default front); +X is to its right
		T.expect(GuidePointer.bearing(0, -10, 0, -1)).toBeNear(0, 1e-6)
		T.expect(GuidePointer.bearing(10, 0, 0, -1)).toBeNear(90, 1e-6)
		T.expect(GuidePointer.bearing(-10, 0, 0, -1)).toBeNear(-90, 1e-6)
		T.expect(math.abs(GuidePointer.bearing(0, 10, 0, -1) :: number)).toBeNear(180, 1e-6)
	end)
	T.it("is relative to the camera's ground direction and wraps into (-180, 180]", function()
		-- camera looking along +X: a target at +X is ahead, one at +Z is to its right
		T.expect(GuidePointer.bearing(5, 0, 1, 0)).toBeNear(0, 1e-6)
		T.expect(GuidePointer.bearing(0, 5, 1, 0)).toBeNear(90, 1e-6)
		T.expect(GuidePointer.bearing(-1, -1, 0.2, 1)).toBeBetween(-180, 180)
		T.expect(GuidePointer.wrap(270)).toBe(-90)
		T.expect(GuidePointer.wrap(-190)).toBe(170)
	end)
	T.it("has no answer for a camera looking straight down or a zero direction", function()
		T.expect(GuidePointer.bearing(3, 4, 0, 0)).toBeNil()
		T.expect(GuidePointer.bearing(0, 0, 0, -1)).toBeNil()
	end)
	T.it("yaw turns a part's front (-Z) towards the target", function()
		for _, d in { { 0, -1 }, { 1, 0 }, { -1, 0 }, { 0.6, 0.8 } } do
			local yaw = GuidePointer.yaw(d[1], d[2])
			-- CFrame.Angles(0, yaw, 0).LookVector = (-sin yaw, 0, -cos yaw)
			T.expect(-math.sin(yaw)).toBeNear(d[1], 1e-6)
			T.expect(-math.cos(yaw)).toBeNear(d[2], 1e-6)
		end
	end)
end)

T.describe("GuidePointer: screen edge", function()
	local W, H, M = 1000, 600, 50
	T.it("stays on the target while it is on screen", function()
		local e = GuidePointer.edge(400, 300, 20, W, H, M)
		T.expect(e.onScreen).toBe(true)
		T.expect({ e.x, e.y }).toEqual({ 400, 300 })
	end)
	T.it("clamps an off-screen target to the margin and points at it", function()
		local right = GuidePointer.edge(2000, 300, 20, W, H, M)
		T.expect(right.onScreen).toBe(false)
		T.expect(right.x).toBeNear(W - M, 1e-6)
		T.expect(right.y).toBeNear(300, 1e-6)
		T.expect(right.rotation).toBeNear(90, 1e-6)
		local top = GuidePointer.edge(500, -900, 20, W, H, M)
		T.expect(top.y).toBeNear(M, 1e-6)
		T.expect(top.rotation).toBeNear(0, 1e-6)
		local corner = GuidePointer.edge(5000, 5000, 20, W, H, M)
		T.expect(corner.x).toBeBetween(M - 1e-6, W - M + 1e-6)
		T.expect(corner.y).toBeBetween(M - 1e-6, H - M + 1e-6)
	end)
	T.it("behind the camera mirrors the projection and never points up", function()
		-- a target behind and to the left projects (mirrored) to the right
		local e = GuidePointer.edge(700, 200, -5, W, H, M)
		T.expect(e.onScreen).toBe(false)
		T.expect(e.x < W / 2).toBe(true)
		T.expect(e.y >= H / 2).toBe(true)
		local straight = GuidePointer.edge(500, 300, -5, W, H, M)
		T.expect(straight.y).toBeNear(H - M, 1e-6)
		T.expect(math.abs(straight.rotation)).toBeNear(180, 1e-6)
		-- inside the screen rectangle but behind: still an edge arrow
		T.expect(GuidePointer.edge(400, 300, -1, W, H, M).onScreen).toBe(false)
	end)
end)

T.describe("GuidePointer: chevrons and reach", function()
	T.it("places the chevrons every spacing from the first, short of the target", function()
		T.expect(GuidePointer.chevrons(100, 3, 4, 5, 0)).toEqual({ 3, 7, 11, 15, 19 })
		T.expect(GuidePointer.chevrons(100, 3, 4, 3, 0.5)).toEqual({ 5, 9, 13 })
		T.expect(GuidePointer.chevrons(12, 3, 4, 7, 0)).toEqual({ 3, 7 })
		T.expect(GuidePointer.chevrons(4, 3, 4, 7, 0)).toEqual({})
		T.expect(GuidePointer.chevrons(100, 3, 4, 2, 1.25)).toEqual({ 4, 8 })
	end)
	T.it("fades the scrolling ends and keeps the middle solid", function()
		T.expect(GuidePointer.fade(1, 5, 0)).toBeNear(1, 1e-6)
		T.expect(GuidePointer.fade(3, 5, 0.4)).toBeNear(0.15, 1e-6)
		T.expect(GuidePointer.fade(5, 5, 1 - 1e-9)).toBeNear(1, 1e-6)
	end)
	T.it("reaches within the radius, measures on the ground and shows whole studs", function()
		T.expect(GuidePointer.flat(0, 0, 3, 4)).toBeNear(5, 1e-6)
		T.expect(GuidePointer.reached(9, GuidePointer.REACH.npc)).toBe(true)
		T.expect(GuidePointer.reached(9.5, GuidePointer.REACH.npc)).toBe(false)
		T.expect(GuidePointer.meters(41.6)).toBe(42)
		T.expect(GuidePointer.meters(-2)).toBe(0)
		T.expect(GuidePointer.bob(0, 1, 2)).toBeNear(0, 1e-9)
		T.expect(GuidePointer.bob(0.5, 1, 2)).toBeNear(1, 1e-9)
	end)
end)
