--!strict
-- S98 (docs/DESIGN-15.md §3.2): the quest EXP budget. MONSTER_EXP_MUL is generated by tools/quest_budget.luau from the
-- quest data and the S94 base (tests/fixtures/quest_budget_base.json); this spec fails when it is out of date, when the
-- hours of grinding per band move away from the base, or when the model and the server disagree.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local B = require("./Balance")
local BalanceTables = require("./BalanceTables")
local BudgetData = require("../src/shared/Data/QuestBudget")
local Gen = require("../tools/QuestBudgetGen")
local QuestBudget = require("../src/shared/Logic/QuestBudget")
local Quests = require("../src/shared/Data/Quests")
local Bosses = require("../src/shared/Data/Bosses")
local Test = require("./Test")

local describe, it, expect = Test.describe, Test.it, Test.expect

describe("Quest EXP budget (S98)", function()
	it("MONSTER_EXP_MUL is up to date", function()
		local computed = Gen.compute().mul
		local wrong = {}
		for L = 1, 99 do
			if math.abs(computed[L] - BudgetData.MONSTER_EXP_MUL[L]) > 0.0005 then
				table.insert(wrong, `L{L}: {BudgetData.MONSTER_EXP_MUL[L]} -> {computed[L]}`)
			end
		end
		if #wrong > 0 then
			error(
				`MONSTER_EXP_MUL is out of date: run \`lune run tools/quest_budget.luau\` ({table.concat(
					wrong,
					"; ",
					1,
					math.min(10, #wrong)
				)})`,
				0
			)
		end
	end)

	it("has the right shape", function()
		expect(#BudgetData.MONSTER_EXP_MUL).toBe(99)
		for L = 1, 99 do
			local m = BudgetData.MONSTER_EXP_MUL[L]
			expect(m >= BudgetData.MUL_MIN and m <= BudgetData.MUL_MAX).toBe(true)
		end
		expect(QuestBudget.monsterExpMul(100)).toBe(1)
		expect(QuestBudget.monsterExpMul(0)).toBe(BudgetData.MONSTER_EXP_MUL[1])
		expect(QuestBudget.monsterExpMul(150)).toBe(1)
		local sum = 0
		for _, v in BudgetData.TARGET do
			sum += v
		end
		expect(math.abs(sum - 0.30) <= 0.001).toBe(true)
		local nextLevel = 1
		for _, band in BudgetData.BANDS do
			expect(band[1]).toBe(nextLevel)
			expect(band[2] >= band[1]).toBe(true)
			nextLevel = band[2] + 1
		end
		expect(nextLevel).toBe(100)
		local lo, hi = QuestBudget.bandOf(100)
		expect({ lo, hi }).toEqual({ 70, 99 })
	end)

	it("the base file is the S98 base of 99 levels", function()
		local file = serde.decode("json", fs.readFile(Gen.BASE_PATH))
		expect(file.meta.session).toBe("S98")
		local n = 0
		for _ in file.levels do
			n += 1
		end
		expect(n).toBe(99)
		for L = 1, 99 do
			local r = file.levels[tostring(L)]
			expect(r.share >= 0 and r.share <= 1).toBe(true)
			expect(r.need + r.quest + r.carryIn >= r.exp - 1e-6).toBe(true)
		end
	end)

	it("keeps the hours of grinding of every band within 1%", function()
		local computed = Gen.compute()
		local clamped: { [number]: boolean } = {}
		for _, L in computed.clamped do
			clamped[L] = true
		end
		local base = Gen.base()
		local credit = Gen.credit()
		for _, band in BudgetData.BANDS do
			local b, n = 0, 0
			for L = band[1], band[2] do
				if not clamped[L] then
					b += base[L].share * credit[L].exp
					n += credit[L].need / BudgetData.MONSTER_EXP_MUL[L]
				end
			end
			local ratio = if b > 0 then n / b else 1
			if ratio < 0.99 or ratio > 1.01 then
				error(
					`band {band[1]}-{band[2]}: grinding x{string.format("%.4f", ratio)} of the base (clamped: {table.concat(
						computed.clamped,
						", "
					)})`,
					0
				)
			end
		end
	end)

	it("the model applies the same multiplier as the server", function()
		for _, L in { 5, 30, 60, 90 } do
			local on = B.killExp(L, B.GENERIC, L)
			B.QUEST_BUDGET_OFF = true
			local off = B.killExp(L, B.GENERIC, L)
			local boss = B.killExp(L, B.GENERIC, L, "boss")
			B.QUEST_BUDGET_OFF = false
			expect(on / off).toBeNear(QuestBudget.monsterExpMul(L), 1e-9)
			expect(B.killExp(L, B.GENERIC, L, "boss")).toBe(boss)
		end
	end)

	it("boss quests take TARGET.boss of every band", function()
		for _, band in Gen.shares() do
			local share = band.byCategory.boss or 0
			if share < BudgetData.TARGET.boss - 0.005 or share > BudgetData.TARGET.boss + 0.005 then
				error(`band {band.lo}-{band.hi}: boss quests {share}`, 0)
			end
		end
		for _, def in Bosses.list do
			local n = 0
			for _, q in Quests.Boss.list do
				if q.objectives[1].boss == def.id then
					n += 1
				end
			end
			expect(n).toBe(1)
		end
	end)

	it("is neutral on the base model (the refactor matches the S94 model bit for bit)", function()
		for L, m in Gen.compute({ budget = false }).mul do
			if m ~= 1 then
				error(`L{L}: {m}`, 0)
			end
		end
	end)

	it("the allowed mode finds no new and no dead ALLOWED_1_20_DIFFS entries", function()
		local r = Gen.allowed("check")
		expect(#r.added).toBe(0)
		expect(#r.dead).toBe(0)
		expect(#r.changed).toBe(0)
		local n = 0
		for _ in BalanceTables.ALLOWED_1_20_DIFFS do
			n += 1
		end
		expect(#r.entries).toBe(n)
	end)
end)

return nil
