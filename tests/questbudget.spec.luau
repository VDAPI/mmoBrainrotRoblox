--!strict
-- S98 (docs/DESIGN-15.md §3.2): the quest EXP budget. MONSTER_EXP_MUL is generated by tools/quest_budget.luau from the
-- quest data and the S94 base (tests/fixtures/quest_budget_base.json); this spec fails when it is out of date, when the
-- hours of grinding per band move away from the base, or when the model and the server disagree.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local B = require("./Balance")
local BalanceTables = require("./BalanceTables")
local BudgetData = require("../src/shared/Data/QuestBudget")
local Gen = require("../tools/QuestBudgetGen")
local QuestBudget = require("../src/shared/Logic/QuestBudget")
local Quests = require("../src/shared/Data/Quests")
local Bosses = require("../src/shared/Data/Bosses")
local Test = require("./Test")

local describe, it, expect = Test.describe, Test.it, Test.expect

describe("Quest EXP budget (S98)", function()
	it("MONSTER_EXP_MUL is up to date", function()
		local computed = Gen.compute().mul
		local wrong = {}
		for L = 1, 99 do
			if math.abs(computed[L] - BudgetData.MONSTER_EXP_MUL[L]) > 0.0005 then
				table.insert(wrong, `L{L}: {BudgetData.MONSTER_EXP_MUL[L]} -> {computed[L]}`)
			end
		end
		if #wrong > 0 then
			error(
				`MONSTER_EXP_MUL is out of date: run \`lune run tools/quest_budget.luau\` ({table.concat(
					wrong,
					"; ",
					1,
					math.min(10, #wrong)
				)})`,
				0
			)
		end
	end)

	it("has the right shape", function()
		expect(#BudgetData.MONSTER_EXP_MUL).toBe(99)
		for L = 1, 99 do
			local m = BudgetData.MONSTER_EXP_MUL[L]
			expect(m >= BudgetData.MUL_MIN and m <= BudgetData.MUL_MAX).toBe(true)
		end
		expect(QuestBudget.monsterExpMul(100)).toBe(1)
		expect(QuestBudget.monsterExpMul(0)).toBe(BudgetData.MONSTER_EXP_MUL[1])
		expect(QuestBudget.monsterExpMul(150)).toBe(1)
		local sum = 0
		for _, v in BudgetData.TARGET do
			sum += v
		end
		expect(math.abs(sum - 0.30) <= 0.001).toBe(true)
		local nextLevel = 1
		for _, band in BudgetData.BANDS do
			expect(band[1]).toBe(nextLevel)
			expect(band[2] >= band[1]).toBe(true)
			nextLevel = band[2] + 1
		end
		expect(nextLevel).toBe(100)
		local lo, hi = QuestBudget.bandOf(100)
		expect({ lo, hi }).toEqual({ 70, 99 })
	end)

	it("the base file is the S98 base of 99 levels", function()
		local file = serde.decode("json", fs.readFile(Gen.BASE_PATH))
		-- S109 (D4): for ever S98, the permanent S94 reference ("time per level = S94"); `base` never rebases it
		expect(file.meta.session).toBe("S98")
		local n = 0
		for _ in file.levels do
			n += 1
		end
		expect(n).toBe(99)
		for L = 1, 99 do
			local r = file.levels[tostring(L)]
			expect(r.share >= 0 and r.share <= 1).toBe(true)
			expect(r.need + r.quest + r.carryIn >= r.exp - 1e-6).toBe(true)
		end
	end)

	it("keeps the hours of grinding of every band within 1%", function()
		local computed = Gen.compute()
		local clamped: { [number]: boolean } = {}
		for _, L in computed.clamped do
			clamped[L] = true
		end
		local base = Gen.base()
		local credit = Gen.credit()
		for _, band in BudgetData.BANDS do
			local b, n = 0, 0
			for L = band[1], band[2] do
				if not clamped[L] then
					b += base[L].share * credit[L].exp
					n += credit[L].need / BudgetData.MONSTER_EXP_MUL[L]
				end
			end
			local ratio = if b > 0 then n / b else 1
			if ratio < 0.99 or ratio > 1.01 then
				error(
					`band {band[1]}-{band[2]}: grinding x{string.format("%.4f", ratio)} of the base (clamped: {table.concat(
						computed.clamped,
						", "
					)})`,
					0
				)
			end
		end
	end)

	it("the model applies the same multiplier as the server", function()
		for _, L in { 5, 30, 60, 90 } do
			local on = B.killExp(L, B.GENERIC, L)
			B.QUEST_BUDGET_OFF = true
			local off = B.killExp(L, B.GENERIC, L)
			local boss = B.killExp(L, B.GENERIC, L, "boss")
			B.QUEST_BUDGET_OFF = false
			expect(on / off).toBeNear(QuestBudget.monsterExpMul(L), 1e-9)
			expect(B.killExp(L, B.GENERIC, L, "boss")).toBe(boss)
		end
	end)

	it("boss quests take TARGET.boss of every band", function()
		for _, band in Gen.shares() do
			local share = band.byCategory.boss or 0
			if share < BudgetData.TARGET.boss - 0.005 or share > BudgetData.TARGET.boss + 0.005 then
				error(`band {band.lo}-{band.hi}: boss quests {share}`, 0)
			end
		end
		for _, def in Bosses.list do
			local n = 0
			for _, q in Quests.Boss.list do
				if q.objectives[1].boss == def.id then
					n += 1
				end
			end
			expect(n).toBe(1)
		end
	end)

	it("is neutral on the base model (the refactor matches the S94 model bit for bit)", function()
		for L, m in Gen.compute({ budget = false }).mul do
			if m ~= 1 then
				error(`L{L}: {m}`, 0)
			end
		end
	end)

	it("the allowed mode finds no new and no dead ALLOWED_1_20_DIFFS entries", function()
		local r = Gen.allowed("check")
		expect(#r.added).toBe(0)
		expect(#r.dead).toBe(0)
		expect(#r.changed).toBe(0)
		local n = 0
		for _ in BalanceTables.ALLOWED_1_20_DIFFS do
			n += 1
		end
		expect(#r.entries).toBe(n)
	end)
end)

-- S109 (docs/DESIGN-15.md §3.2): the final audit of the quest series. Targets in QuestBudgetGen.AUDIT (measuring
-- tools, not game numbers); the rows are the ones `lune run tools/quest_budget.luau audit` prints.
describe("Quest budget audit (S109)", function()
	local audit = Gen.audit()
	local function rowsOf(prefix: string): { Gen.AuditRow }
		local out = {}
		for _, r in audit.rows do
			if string.sub(r.id, 1, #prefix) == prefix then
				table.insert(out, r)
			end
		end
		expect(#out > 0).toBe(true)
		return out
	end
	local function check(prefix: string)
		for _, r in rowsOf(prefix) do
			if r.report then
				continue
			end
			if not r.ok then
				error(
					`{r.id} {r.label}: {Gen.fmtAuditValue(r.id, r.value)} outside {Gen.fmtAuditBand(r)}`
						.. (
							if #r.outliers > 0
								then ` ({table.concat(r.outliers, ", ", 1, math.min(10, #r.outliers))})`
								else ""
						),
					0
				)
			end
		end
	end

	it("T-QB1: all quests 27-33% of every band 20-44, 45-69, 70-99", function()
		check("T-QB1")
		expect(#rowsOf("T-QB1")).toBe(3)
	end)

	it("T-QB2: the categories in their bands (contract, story and side by construction, boss)", function()
		check("T-QB2")
		expect(#rowsOf("T-QB2")).toBe(12)
	end)

	it("T-QB3: the moving mean of the quest share stays in 15-50% on 21-97", function()
		check("T-QB3")
	end)

	it("T-QB4: contracts 1-19 in their band (story, side and total of the Meadows reported)", function()
		check("T-QB4")
		for _, id in { "T-QB4.main", "T-QB4.side", "T-QB4.total" } do
			local found = false
			for _, r in audit.rows do
				if r.id == id then
					found = true
					expect(r.report).toBe(true)
				end
			end
			expect(found).toBe(true)
		end
	end)

	it("T-QB5: no level clamped, monsterExpMul 0.55-1.00 from 20, steps <= 0.10", function()
		check("T-QB5")
		expect(#Gen.compute().clamped).toBe(0)
	end)

	it("T-QB6: the hours of grinding of every band and level stay those of the S94 base", function()
		check("T-QB6")
	end)

	it("T-QB7: every quest is seen by the credit model exactly once, contracts 1-99 without gaps", function()
		check("T-QB7")
	end)

	it("S109 audit report rows", function()
		local n = 0
		for _, r in audit.rows do
			if r.report then
				n += 1
				expect(r.why ~= nil and #(r.why :: string) > 0).toBe(true)
				print(`  {r.id} {r.label}: {Gen.fmtAuditValue(r.id, r.value)} (cel {Gen.fmtAuditBand(r)}) — {r.why}`)
			end
		end
		expect(n > 0).toBe(true)
	end)

	it("the base is never rebased (the mode refuses even with --force)", function()
		local allowed, why = Gen.baseAllowed(true, true)
		expect(allowed).toBe(false)
		expect(why).toBe(Gen.BASE_REFUSAL)
		expect((Gen.baseAllowed(true, false))).toBe(false)
		expect((Gen.baseAllowed(false, false))).toBe(true)
		local cli = fs.readFile("tools/quest_budget.luau")
		expect(string.find(cli, "Gen.baseAllowed", 1, true) ~= nil).toBe(true)
	end)

	it("is deterministic and its rows are the printed ones", function()
		local text = Gen.auditText(audit)
		for _, r in audit.rows do
			local line = `{r.id} {r.label}: {Gen.fmtAuditValue(r.id, r.value)}`
			if not string.find(text, line, 1, true) then
				error(`the audit text has no row "{line}"`, 0)
			end
		end
		expect(Gen.auditOk(audit)).toBe(true)
		-- a second computation from the data gives the same numbers (the cache is only a speed-up)
		local again = Gen.audit(true)
		expect(again ~= audit).toBe(true)
		expect(#again.rows).toBe(#audit.rows)
		for i, r in audit.rows do
			local b = again.rows[i]
			expect(`{b.id} {b.value} {b.ok}`).toBe(`{r.id} {r.value} {r.ok}`)
		end
		expect(#again.bands).toBe(#audit.bands)
		for i, band in audit.bands do
			local b = again.bands[i]
			expect(b.model.total).toBe(band.model.total)
			expect(b.all.total).toBe(band.all.total)
			for cat, v in band.model.byCategory do
				expect(b.model.byCategory[cat]).toBe(v)
			end
			for cat, v in band.all.byCategory do
				expect(b.all.byCategory[cat]).toBe(v)
			end
		end
		expect(#again.levels).toBe(#audit.levels)
		for i, lvl in audit.levels do
			local b = again.levels[i]
			expect(`{b.level} {b.total} {b.avg} {b.mul} {b.hoursNow}`).toBe(
				`{lvl.level} {lvl.total} {lvl.avg} {lvl.mul} {lvl.hoursNow}`
			)
		end
		expect(#again.hours).toBe(#audit.hours)
		for i, h in audit.hours do
			local b = again.hours[i]
			expect(`{b.lo} {b.s94} {b.now} {b.allQuests}`).toBe(`{h.lo} {h.s94} {h.now} {h.allQuests}`)
		end
	end)
end)

return nil
