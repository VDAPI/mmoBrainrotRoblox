--!strict
-- S134f: the ready check at the dungeon gate (Logic/ReadyCheck).
local Config = require("../src/shared/Config")
local ReadyCheck = require("../src/shared/Logic/ReadyCheck")
local T = require("./Test")

local cfg = Config.Boss

T.describe("ReadyCheck", function()
	T.it("the leader is ready at once", function()
		local check = ReadyCheck.new({ 1, 2, 3 }, 1, 100, cfg)
		T.expect(check.answers[1]).toBe(true)
		T.expect(ReadyCheck.pending(check)).toEqual({ 2, 3 })
		T.expect(ReadyCheck.status(check, 100)).toBe("waiting")
	end)

	T.it("all yes -> go after the countdown", function()
		local check = ReadyCheck.new({ 1, 2, 3 }, 1, 100, cfg)
		T.expect((ReadyCheck.answer(check, 2, true, 101))).toBe(true)
		T.expect(ReadyCheck.status(check, 101)).toBe("waiting")
		T.expect((ReadyCheck.answer(check, 3, true, 105))).toBe(true)
		T.expect(ReadyCheck.status(check, 105)).toBe("go")
		T.expect(ReadyCheck.goAt(check)).toBe(105 + cfg.readyCountdown)
		T.expect(cfg.readyCountdown).toBe(3)
	end)

	T.it("one no -> declined", function()
		local check = ReadyCheck.new({ 1, 2, 3 }, 1, 0, cfg)
		ReadyCheck.answer(check, 2, true, 1)
		ReadyCheck.answer(check, 3, false, 2)
		T.expect(ReadyCheck.status(check, 2)).toBe("declined")
		T.expect(ReadyCheck.goAt(check)).toBeNil()
	end)

	T.it("expires after readyTimeout", function()
		local check = ReadyCheck.new({ 1, 2 }, 1, 0, cfg)
		T.expect(ReadyCheck.status(check, cfg.readyTimeout - 0.1)).toBe("waiting")
		T.expect(ReadyCheck.status(check, cfg.readyTimeout)).toBe("expired")
		local ok, err = ReadyCheck.answer(check, 2, true, cfg.readyTimeout + 1)
		T.expect(ok).toBe(false)
		T.expect(err).toBe("dungeon.ready.over")
	end)

	T.it("rejects an answer from outside the list and after the end", function()
		local check = ReadyCheck.new({ 1, 2 }, 1, 0, cfg)
		local ok, err = ReadyCheck.answer(check, 9, true, 1)
		T.expect(ok).toBe(false)
		T.expect(err).toBe("dungeon.ready.notAsked")
		ReadyCheck.answer(check, 2, true, 1)
		local ok2, err2 = ReadyCheck.answer(check, 2, false, 2)
		T.expect(ok2).toBe(false)
		T.expect(err2).toBe("dungeon.ready.over")
	end)

	T.it("a member may change the answer before go", function()
		local check = ReadyCheck.new({ 1, 2, 3 }, 1, 0, cfg)
		ReadyCheck.answer(check, 2, true, 1)
		T.expect(check.answers[2]).toBe(true)
		ReadyCheck.answer(check, 2, false, 2)
		T.expect(check.answers[2]).toBe(false)
		T.expect(ReadyCheck.status(check, 2)).toBe("declined")
	end)
end)
