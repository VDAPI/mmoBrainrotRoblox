---
// GENERATED by scripts/routes.mjs (npm run routes): the regions pages in English, only the RegionsView view.
import { pageFor, pagesOf } from "../../../views/paths";
import View from "../../../views/RegionsView.astro";

// A function declaration: the compiler hoisted `export const getStaticPaths = (...) satisfies ...` together with the
// next statement, which then ran once at module level.
export function getStaticPaths() {
  return pagesOf("regions", "en");
}

// 404 routes are rendered without the props of getStaticPaths: the page is then looked up by its address.
// eslint-disable-next-line @typescript-eslint/no-explicit-any -- each view declares its own props
const extra: any = (Astro.props.ids ? Astro.props : pageFor("regions", "en", Astro.url.pathname.slice("/en/regions/".length))).extra;
---
<View lang="en" {...extra} />
