---
// Site-wide 404: both languages, the script shows the one from the start of the path.
import "../styles/tokens.css";
import "../styles/tokens.data.css";
import "../styles/components.css";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>404 · Vaelthorn Wiki</title>
    <meta name="description" content="Nie ma takiej strony. Page not found." />
    <style>body { margin: 0; min-height: 100vh; background: var(--vw-bg); color: var(--vw-text); font-family: var(--vw-font-ui); }</style>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="vw-empty" id="main">
      <span class="vw-empty__mark" aria-hidden="true"></span>
      <div lang="pl" data-lang="pl">
        <h1 class="vw-h2">Nic tu nie ma</h1>
        <p>Ta strona nie istnieje albo została przeniesiona.</p>
        <p><a href="/pl/">Wróć na stronę główną</a> · <a href="/pl/szukaj/">Szukaj w wiki</a></p>
      </div>
      <div lang="en" data-lang="en" hidden>
        <p class="vw-h2" data-h1>Nothing here</p>
        <p>This page does not exist or has moved.</p>
        <p><a href="/en/">Back to the home page</a> · <a href="/en/search/">Search the wiki</a></p>
      </div>
    </main>
    <script is:inline>
      if (location.pathname.indexOf("/en/") === 0) {
        document.documentElement.lang = "en";
        document.querySelector('[data-lang="pl"]').remove();
        document.querySelector('[data-lang="en"]').hidden = false;
        // one h1 in the HTML (Polish); the English page promotes its heading
        const p = document.querySelector("[data-h1]");
        const h1 = document.createElement("h1");
        h1.className = p.className;
        h1.textContent = p.textContent;
        p.replaceWith(h1);
      } else {
        document.querySelector('[data-lang="en"]').remove();
      }
    </script>
  </body>
</html>
