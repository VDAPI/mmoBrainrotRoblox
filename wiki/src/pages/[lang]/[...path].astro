---
// Every page below /<lang>/ from src/views/registry.ts.
import type { GetStaticPaths } from "astro";
import { LANGS, ROUTES, type Lang } from "../../i18n/routes";
import { REGISTRY } from "../../views/registry";

export const getStaticPaths = (() => {
  const out = [];
  for (const lang of LANGS) {
    for (const entry of REGISTRY) {
      const segment = entry.key === "404" ? "404" : ROUTES[entry.key][lang];
      for (const page of entry.getPaths(lang)) {
        out.push({
          params: { lang, path: [segment, ...page.ids].join("/") },
          props: { key: entry.key, ids: page.ids, extra: page.props ?? {} },
        });
      }
    }
  }
  return out;
}) satisfies GetStaticPaths;

const { key, ids, extra } = Astro.props;
const lang = Astro.params.lang as Lang;
const entry = REGISTRY.find((e) => e.key === key)!;
const View = entry.view;
---
<View lang={lang} ids={ids} {...extra} />
