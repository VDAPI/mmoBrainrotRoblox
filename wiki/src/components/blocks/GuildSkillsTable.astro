---
// Guild skills (S43): effect and treasury cost of every level (mechanics.guild.skills; Guild.skillEffect).
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber } from "../../lib/format";
import { name, t } from "../../lib/i18n";
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
const guild = load("mechanics").guild;
const levels = Array.from({ length: guild.maxLevel }, (_, i) => i + 1);
---
<div class="vw-scroll" tabindex="0">
  <table class="vw-table vw-table--plain vw-table--keep vw-gskills">
    <caption class="vw-sr">{t(lang, "block.guild.skills")}</caption>
    <thead><tr><th scope="col">{t(lang, "block.guild.skill")}</th>{levels.map((l) => <th scope="col">{t(lang, "block.guild.level", { n: l })}</th>)}</tr></thead>
    <tbody>
      {guild.skills.map((s) => (
        <tr>
          <th scope="row" class="rowhead"><span class="icon" aria-hidden="true">{s.icon}</span> {name(s.name, lang)}</th>
          {levels.map((l) => (
            <td>
              <strong>{name(s.desc[l - 1], lang)}</strong>
              <span class="cost">{t(lang, "block.guild.cost", { n: formatNumber(s.costs[l - 1], lang) })}</span>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<Source from="Data/GuildSkills, Logic/Guild" />
<style>
  .vw-gskills td { height: auto; padding: 10px 12px; vertical-align: top; }
  .vw-gskills strong { display: block; color: var(--vw-text); }
  .cost { display: block; font-size: 13px; color: var(--vw-gold); }
  .icon { color: var(--vw-gold); }
</style>
