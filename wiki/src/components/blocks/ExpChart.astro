---
// EXP to the next level (S42): pure SVG line chart of progression.expToNext with the region borders (maps.json) and
// four labelled points; the data table sits in <details> under it.
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber } from "../../lib/format";
import { name, t } from "../../lib/i18n";
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
const rows = load("progression").expToNext;
const regions = load("maps").maps.filter((m) => m.kind === "region").sort((a, b) => a.minLevel - b.minLevel);
const W = 720;
const H = 320;
const pad = { l: 64, r: 16, t: 20, b: 36 };
const maxLevel = rows[rows.length - 1].level;
const maxExp = Math.max(...rows.map((r) => r.exp));
const top = Math.pow(10, Math.floor(Math.log10(maxExp))) * Math.ceil(maxExp / Math.pow(10, Math.floor(Math.log10(maxExp))));
const x = (level: number) => pad.l + ((level - 1) / (maxLevel - 1)) * (W - pad.l - pad.r);
const y = (exp: number) => H - pad.b - (exp / top) * (H - pad.t - pad.b);
const line = rows.map((r, i) => `${i === 0 ? "M" : "L"}${x(r.level).toFixed(1)},${y(r.exp).toFixed(1)}`).join(" ");
const area = `${line} L${x(maxLevel).toFixed(1)},${y(0)} L${x(1)},${y(0)} Z`;
const marks = [1, 10, 50, maxLevel].map((l) => rows.find((r) => r.level === l)!).filter(Boolean);
const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => f * top);
const total = rows[rows.length - 1].total;
const label = t(lang, "block.exp.aria", { from: formatNumber(rows[0].exp, lang), to: formatNumber(rows[rows.length - 1].exp, lang), max: maxLevel + 1 });
---
<figure class="vw-chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    {ticks.map((v) => (
      <g>
        <line x1={pad.l} x2={W - pad.r} y1={y(v)} y2={y(v)} class="grid" />
        <text x={pad.l - 8} y={y(v) + 4} text-anchor="end" class="tick">{formatNumber(v, lang)}</text>
      </g>
    ))}
    {regions.filter((m) => m.minLevel > 1).map((m) => (
      <g>
        <line x1={x(m.minLevel)} x2={x(m.minLevel)} y1={pad.t} y2={H - pad.b} class="border" />
        <text x={x(m.minLevel) + 4} y={pad.t + 12} class="region">{name(m.name, lang)}</text>
      </g>
    ))}
    <path d={area} class="fill" />
    <path d={line} class="line" />
    {marks.map((r) => (
      <g>
        <circle cx={x(r.level)} cy={y(r.exp)} r="4" class="dot" />
        <text x={x(r.level) + (r.level === maxLevel ? -6 : 6)} y={y(r.exp) - 8} text-anchor={r.level === maxLevel ? "end" : "start"} class="mark">{t(lang, "block.exp.point", { level: r.level, exp: formatNumber(r.exp, lang) })}</text>
      </g>
    ))}
    {[1, 25, 50, 75, maxLevel].map((l) => <text x={x(l)} y={H - pad.b + 20} text-anchor="middle" class="tick">{l}</text>)}
  </svg>
  <figcaption class="vw-label">{t(lang, "block.exp.caption", { total: formatNumber(total, lang), max: maxLevel + 1 })}</figcaption>
  <details class="vw-chart__data">
    <summary>{t(lang, "block.chart.data")}</summary>
    <div class="vw-scroll" tabindex="0">
      <table class="vw-table vw-table--plain vw-table--dense">
        <caption class="vw-sr">{t(lang, "block.exp.table")}</caption>
        <thead><tr><th scope="col">{t(lang, "block.col.level")}</th><th scope="col">{t(lang, "block.exp.next")}</th><th scope="col">{t(lang, "block.exp.total")}</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td>{r.level}</td><td>{formatNumber(r.exp, lang)}</td><td>{formatNumber(r.total, lang)}</td></tr>)}</tbody>
      </table>
    </div>
  </details>
</figure>
<Source from="Logic/Exp.expToNext" />
