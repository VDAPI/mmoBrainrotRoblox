---
// Monster ranks (S42): mechanics.variants (Data/Combat variants + EXP and gold multipliers).
import RankBadge from "../RankBadge.astro";
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber } from "../../lib/format";
import { t } from "../../lib/i18n";
const lang = (Astro.params.lang ?? "pl") as Lang;
const variants = load("mechanics").variants;
const order = (["normal", "elite", "elite2", "boss"] as const).filter((v) => variants[v]);
const x = (v: number) => `×${formatNumber(v, lang)}`;
---
<div class="vw-scroll">
  <table class="vw-table vw-table--plain vw-table--keep">
    <caption class="vw-sr">{t(lang, "block.var.caption")}</caption>
    <thead>
      <tr>
        <th scope="col">{t(lang, "block.var.rank")}</th>
        <th scope="col" style="text-align: right">{t(lang, "block.var.level")}</th>
        <th scope="col" style="text-align: right">{t(lang, "block.var.hp")}</th>
        <th scope="col" style="text-align: right">{t(lang, "block.var.dmg")}</th>
        <th scope="col" style="text-align: right">{t(lang, "block.var.exp")}</th>
        <th scope="col" style="text-align: right">{t(lang, "block.var.gold")}</th>
      </tr>
    </thead>
    <tbody>
      {order.map((v) => {
        const r = variants[v];
        return (
          <tr>
            <th scope="row" class="rowhead"><RankBadge rank={v} lang={lang} /></th>
            <td style="text-align: right">{r.levelAdd > 0 ? `+${r.levelAdd}` : "0"}</td>
            <td style="text-align: right">{x(r.hpMul)}</td>
            <td style="text-align: right">{x(r.dmgMul)}</td>
            <td style="text-align: right">{x(r.expMul)}</td>
            <td style="text-align: right">{x(r.goldMul)}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<Source from="Data/Combat, Data/Progression" />
