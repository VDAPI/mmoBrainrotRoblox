---
// Guild rank permissions (S43): mechanics.guild.ranks (Guild.can for every rank x action). WIKI-3 (S159g): the
// default daily bank limits of every rank (gold and items out of the vault; the leader has none).
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber } from "../../lib/format";
import { name, t, type Key } from "../../lib/i18n";
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
const guild = load("mechanics").guild;
const limit = (v: number | undefined) => (v === undefined ? "—" : v < 0 ? t(lang, "block.guild.noLimit") : formatNumber(v, lang));
---
<div class="vw-scroll" tabindex="0">
  <table class="vw-table vw-table--plain vw-table--keep vw-perm">
    <caption class="vw-sr">{t(lang, "block.guild.ranks")}</caption>
    <thead><tr><th scope="col">{t(lang, "block.guild.action")}</th>{guild.ranks.map((r) => <th scope="col" style="text-align: center">{name(r.name, lang)}</th>)}</tr></thead>
    <tbody>
      {guild.actions.map((a) => (
        <tr>
          <th scope="row" class="rowhead">{t(lang, `block.guild.act.${a}` as Key)}</th>
          {guild.ranks.map((r) => (
            <td style="text-align: center" class={r.can[a] ? "yes" : "no"}>
              <span aria-hidden="true">{r.can[a] ? "✓" : "—"}</span><span class="vw-sr">{t(lang, r.can[a] ? "block.yes" : "block.no")}</span>
            </td>
          ))}
        </tr>
      ))}
      {guild.ranks.some((r) => r.gold !== undefined) && (
        <>
          <tr>
            <th scope="row" class="rowhead">{t(lang, "block.guild.goldLimit")}</th>
            {guild.ranks.map((r) => <td style="text-align: center">{limit(r.gold)}</td>)}
          </tr>
          <tr>
            <th scope="row" class="rowhead">{t(lang, "block.guild.itemLimit")}</th>
            {guild.ranks.map((r) => <td style="text-align: center">{limit(r.items)}</td>)}
          </tr>
        </>
      )}
    </tbody>
  </table>
</div>
<Source from="Logic/Guild" />
<style>
  .yes { color: var(--vw-success); font-weight: 800; }
  .no { color: var(--vw-text-muted); }
</style>
