---
// Damage removed by defence (S42): mechanics.reduction (Damage.reduction for defence x attacker level).
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber, formatPercent } from "../../lib/format";
import { t } from "../../lib/i18n";
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
const table = load("mechanics").reduction;
---
<div class="vw-scroll" tabindex="0">
  <table class="vw-table vw-table--plain vw-table--keep">
    <caption class="vw-sr">{t(lang, "block.red.caption")}</caption>
    <thead>
      <tr>
        <th scope="col">{t(lang, "block.red.defense")}</th>
        {table.levels.map((l) => <th scope="col" style="text-align: right">{t(lang, "block.red.attacker", { level: l })}</th>)}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((r) => (
        <tr><th scope="row" class="rowhead">{formatNumber(r.defense, lang)}</th>{r.values.map((v) => <td style="text-align: right">{formatPercent(v, lang)}</td>)}</tr>
      ))}
    </tbody>
  </table>
</div>
<Source from="Logic/Damage.reduction" />
