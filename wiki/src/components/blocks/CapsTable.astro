---
// Stat limits (S42): every stat of stats.json with a `cap`.
import Source from "./Source.astro";
import type { Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { formatNumber } from "../../lib/format";
import { name, t } from "../../lib/i18n";
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
const stats = load("stats").stats.filter((s) => s.cap !== undefined).sort((a, b) => a.order - b.order);
---
<table class="vw-table vw-table--plain">
  <caption class="vw-sr">{t(lang, "block.caps.caption")}</caption>
  <thead><tr><th scope="col">{t(lang, "block.formula.stat")}</th><th scope="col" style="text-align: right">{t(lang, "block.caps.cap")}</th></tr></thead>
  <tbody>
    {stats.map((s) => (
      <tr>
        <td data-mobile="title">{name(s.name, lang)}</td>
        <td data-mobile="value" style="text-align: right" class="gold">{formatNumber(s.cap!, lang)}{s.format === "pct" ? "%" : ""}</td>
      </tr>
    ))}
  </tbody>
</table>
<Source from="Data/Stats" />
