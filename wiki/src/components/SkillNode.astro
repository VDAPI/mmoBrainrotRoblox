---
// Skill tree node (.vw-node): look only; the planner (S41) adds behaviour.
interface Props {
  glyph?: string;
  state: "locked" | "available" | "partial" | "max";
  rank: number;
  max: number;
  active?: boolean;
  capstone?: boolean;
  selected?: boolean;
  label: string;
}
const { glyph = "✦", state, rank, max, active = false, capstone = false, selected = false, label } = Astro.props;
---
<button
  type="button"
  class={`vw-node${active ? " vw-node--active" : ""}${capstone ? " vw-node--capstone" : ""}`}
  data-state={state}
  aria-pressed={selected ? "true" : "false"}
  aria-label={`${label} ${rank}/${max}`}
  disabled={state === "locked"}
>
  <span class="glyph" aria-hidden="true">{glyph}</span>
  <span class="vw-node__rank">{rank}/{max}</span>
</button>
<style>
  .vw-node { color: var(--vw-gold-bright); padding: 0; }
  .vw-node[aria-pressed="true"] { box-shadow: var(--vw-focus); }
  .glyph { font-size: 28px; line-height: 1; }
</style>
