---
// Monster card (.vw-monster, VwMonsterCard): picture 4:3, rank top left, element top right, variant name, level range
// and family, the first place with a diamond in its zone colour (+N more), the signature drop at the bottom (S39: the
// rarest monster part of the variant, a boss's first named item) or "No unique loot". Top border: normal dark gold,
// elite gold, Elite II orange, boss red. `boss` renders a boss card instead of a monster.
import type { Boss, Monster } from "../data/types";
import { finalLevels, placesOf, signatureDrop } from "../lib/bestiary";
import { getItem, getMap, load } from "../lib/data";
import { name, t, type Key } from "../lib/i18n";
import type { Lang } from "../i18n/routes";
import ElementBadge from "./ElementBadge.astro";
import ItemIcon from "./ItemIcon.svelte";
import MonsterImage from "./MonsterImage.astro";
import RankBadge from "./RankBadge.astro";
interface Props {
  monster?: Monster;
  boss?: Boss;
  variant?: "normal" | "elite" | "elite2";
  level?: number;
  lang: Lang;
  href?: string | null;
  eager?: boolean;
}
const { monster, boss, variant = "normal", level, lang, href, eager = false } = Astro.props;
const rank = boss ? "boss" : variant;
const info = monster ? (monster.variants[variant] ?? monster.variants.normal ?? Object.values(monster.variants)[0]) : undefined;
const title = boss ? name(boss.name, lang) : name(info?.name ?? monster?.name, lang);
let levelText = "";
if (boss) levelText = t(lang, "level", { level: boss.level });
else if (level !== undefined) levelText = t(lang, "level", { level });
else if (info) {
  const [min, max] = finalLevels(info);
  levelText = min === max ? t(lang, "level", { level: min }) : t(lang, "levelRangeCap", { min, max });
}
const family = monster?.family ? t(lang, `family.${monster.family}` as Key) : boss ? t(lang, "rank.boss") : "";
const places = monster ? placesOf(monster, variant, lang) : [];
const dungeon = boss ? getMap(boss.dungeon) : undefined;
const place = boss ? { name: name(dungeon?.name, lang), zone: dungeon?.zone ?? "red" } : places[0] ?? (monster ? { name: name(getMap(monster.regionMap)?.name, lang), zone: getMap(monster.regionMap)?.zone ?? "yellow" } : undefined);
const dropId = boss ? boss.loot.named[0] : monster ? signatureDrop(monster, variant) : undefined;
const drop = dropId ? getItem(dropId) : undefined;
const dropRarity = drop ? drop.rarities[drop.rarities.length - 1] : undefined;
const dropRarityName = dropRarity ? name(load("rarities").rarities.find((r) => r.key === dropRarity)?.name, lang) : "";
const borders = { normal: "var(--vw-gold-dark)", elite: "var(--vw-gold-bright)", elite2: "var(--vw-r-legendary)", boss: "var(--vw-zone-red)" };
const Tag = href ? "a" : "article";
---
<Tag class={`vw-monster card${boss ? " vw-monster--boss" : ""}`} href={href ?? undefined} style={`border-top-color: ${borders[rank]}`}>
  <div class="vw-monster__render render">
    <MonsterImage id={boss?.id ?? monster?.id ?? ""} kind={boss ? "boss" : "monster"} variant={variant} alt={title} element={monster?.element} eager={eager} />
    <span class="rank"><RankBadge rank={rank} lang={lang} /></span>
    <span class="element"><ElementBadge element={monster?.element} damageKind={monster?.damageKind ?? boss?.damageKind} lang={lang} /></span>
  </div>
  <div class="vw-monster__name name">{title}</div>
  <div class="meta"><span class="lv">{levelText}</span>{family && <> · {family}</>}</div>
  {place && (
    <div class="place">
      <span class="dot" style={`--c: var(--vw-zone-${place.zone})`}></span>
      <span class="pname">{place.name}</span>
      {places.length > 1 && <span class="more">{t(lang, "bestiary.places", { n: places.length - 1 })}</span>}
    </div>
  )}
  <div class="vw-monster__drop">
    {drop ? (
      <>
        <ItemIcon glyph={drop.glyph} color={drop.color} rarity={dropRarity} size={28} />
        <div class="dropbox">
          <div class="drop-name" style={dropRarity ? `color: var(--vw-r-${dropRarity}-text)` : undefined}>{name(drop.name, lang)}</div>
          {boss && <div class="drop-meta">{dropRarityName}</div>}
        </div>
      </>
    ) : (
      <span class="drop-meta">{t(lang, "monster.noLoot")}</span>
    )}
  </div>
</Tag>
<style>
  .card { color: var(--vw-text); padding: 0; gap: 0; height: 100%; }
  a.card:hover { text-decoration: none; }
  .render { position: relative; overflow: hidden; border: 0; border-bottom: 1px solid var(--vw-border); }
  .rank { position: absolute; left: 10px; top: 10px; }
  .element { position: absolute; right: 10px; top: 10px; }
  .element :global(.vw-rank) { background: var(--vw-bg); }
  .name { font-size: 26px; color: var(--vw-text); padding: 16px 16px 0; }
  .meta { color: var(--vw-text-muted); font-size: 15px; font-weight: 700; padding: 6px 16px 0; }
  .lv { color: var(--vw-gold-bright); }
  .place { display: flex; align-items: center; gap: 8px; font-size: 15px; color: var(--vw-text-soft); padding: 6px 16px 14px; min-width: 0; }
  .pname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .more { color: var(--vw-text-muted); font-size: 13px; }
  .dot { flex-shrink: 0; width: 8px; height: 8px; background: var(--c); transform: rotate(45deg); box-shadow: 0 0 6px var(--c); }
  .vw-monster__drop { margin-top: auto; min-height: 52px; padding: 10px 16px; }
  .dropbox { min-width: 0; }
  .drop-name { font-weight: 800; font-size: 15px; line-height: 1.2; }
  .drop-meta { font-size: 13px; color: var(--vw-text-muted); }
  @media (max-width: 767px) {
    .name { font-size: 22px; padding: 12px 12px 0; line-height: 1.05; }
    .meta, .place { padding-left: 12px; padding-right: 12px; font-size: 14px; }
    .vw-monster__drop { padding: 8px 12px; }
    .rank { left: 6px; top: 6px; } .element { right: 6px; top: 6px; }
  }
</style>
