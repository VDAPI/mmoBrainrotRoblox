---
// <Spoiler title?>…</Spoiler>: blurred story text (kept out of the search index), revealed by a button.
import Callout from "../Callout.astro";
import type { Lang } from "../../i18n/routes";
interface Props {
  title?: string;
}
const { title } = Astro.props;
const lang = (Astro.url.pathname.startsWith("/en/") ? "en" : "pl") as Lang;
---
<Callout kind="spoiler" title={title} lang={lang}><slot /></Callout>
