---
// Mini map (S37, contract for S39 and NPC pages): a cropped inline SVG of a map with highlighted elements, the rest
// dimmed, ids stripped (several mini maps can share a page), no JS. Links to the world map at the highlighted place.
//   map        map id (region, city or cave)
//   highlight  areas / caves / portals / npcs ids and a point (map studs)
//   size       "sm" 280 x 180, "md" 420 x 260 (100 % wide on mobile)
//   href       link target (default: the world map with ?m=&a=); null = no link
import "../styles/map.css";
import { href as routeHref, type Lang } from "../i18n/routes";
import { t } from "../lib/i18n";
import { cropViewBox, inlineMap, loadMapSvg, parseViewBox, type Bounds } from "../lib/mapsvg";
import { load } from "../lib/data";
import { serialize } from "../lib/deeplink";
import { getMapInfo } from "../lib/world";

interface Props {
  map: string;
  lang: Lang;
  highlight?: { areas?: string[]; caves?: string[]; portals?: string[]; npcs?: string[]; point?: { x: number; z: number } };
  size?: "sm" | "md";
  href?: string | null;
  label?: string;
}

const { map, lang, highlight = {}, size = "md", label } = Astro.props;
const dims = size === "sm" ? { w: 280, h: 180 } : { w: 420, h: 260 };
const svg = loadMapSvg(map);
const full = parseViewBox(svg);
const info = getMapInfo(map);

// Points of every highlighted element, from the exported data.
const pts: { x: number; z: number }[] = [];
const areaData = load("areas");
for (const id of highlight.areas ?? []) {
  const a = areaData.areas.find((x) => x.id === id);
  if (a) pts.push({ x: a.rect[0], z: a.rect[1] }, { x: a.rect[2], z: a.rect[3] });
}
for (const id of highlight.caves ?? []) {
  const e = areaData.maps[map]?.caves.find((c) => c.cave === id);
  if (e) pts.push({ x: e.x, z: e.z });
}
for (const id of highlight.portals ?? []) {
  const p = load("portals").portals.find((x) => x.id === id);
  if (p) pts.push({ x: p.x, z: p.z });
}
for (const id of highlight.npcs ?? []) {
  const n = load("npcs").npcs.find((x) => x.id === id);
  if (n) pts.push({ x: n.x, z: n.z });
}
if (highlight.point) pts.push(highlight.point);
const bounds: Bounds = pts.length
  ? { x1: Math.min(...pts.map((p) => p.x)), z1: Math.min(...pts.map((p) => p.z)), x2: Math.max(...pts.map((p) => p.x)), z2: Math.max(...pts.map((p) => p.z)) }
  : { x1: full.x, z1: full.y, x2: full.x + full.w, z2: full.y + full.h };
const view = cropViewBox(full, bounds, dims.w / dims.h);
const ids = [
  ...(highlight.areas ?? []).map((id) => `area-${id}`),
  ...(highlight.caves ?? []).map((id) => `cave-${id}`),
  ...(highlight.portals ?? []).map((id) => `portal-${id}`),
  ...(highlight.npcs ?? []).map((id) => `npc-${id}`),
];
const mapName = info ? info.name[lang] : map;
const html = inlineMap(svg, { viewBox: view, highlight: ids, stripIds: true, stripStyle: false, k: view.w / dims.w, label: label ?? t(lang, "region.mapOf", { name: mapName }) });
const first = highlight.areas?.[0] ?? highlight.caves?.[0] ?? highlight.npcs?.[0] ?? highlight.portals?.[0];
const link =
  Astro.props.href === null
    ? null
    : (Astro.props.href ??
      `${routeHref(lang, "map")}${serialize({ m: map, a: first, x: highlight.point?.x, z: highlight.point?.z, s: Math.max(1, Math.min(10, Math.round((full.w / view.w) * 10) / 10)) })}`);
const pin = highlight.point ? { x: ((highlight.point.x - view.x) / view.w) * 100, y: ((highlight.point.z - view.y) / view.h) * 100 } : null;
---
<figure class={`vw-minimap vw-minimap--${size}`} data-pagefind-ignore>
  <div class={`vw-mapframe vw-mapframe--${info?.zone ?? "yellow"}`} data-lod="2" style={`aspect-ratio:${dims.w} / ${dims.h}`}>
    <Fragment set:html={html} />
    {pin && <span class="pin" style={`left:${pin.x}%;top:${pin.y}%`} aria-hidden="true">⚑</span>}
    {link && <a class="open" href={link}>{t(lang, "minimap.open")} ›</a>}
  </div>
</figure>
<style>
  .vw-minimap { margin: 0; width: 100%; }
  .vw-minimap--sm { max-width: 280px; }
  .vw-minimap--md { max-width: 420px; }
  .vw-mapframe :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .open {
    position: absolute; right: 8px; bottom: 8px; padding: 6px 10px; min-height: 32px; display: inline-flex; align-items: center;
    font: 800 13px/1 var(--vw-font-ui); color: var(--vw-gold-bright); background: color-mix(in srgb, var(--vw-panel) 88%, transparent);
    border: 1px solid var(--vw-gold-dark);
  }
  .open:hover { text-decoration: none; border-color: var(--vw-gold); }
  .pin { position: absolute; transform: translate(-30%, -90%); color: #e8c25a; font-size: 22px; text-shadow: 0 0 6px #000; }
  @media (max-width: 767px) { .vw-minimap--sm, .vw-minimap--md { max-width: none; } .open { min-height: 44px; } }
</style>
