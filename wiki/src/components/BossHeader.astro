---
// Boss header (.vw-boss): picture, badges, name, player chips 1–5 (S39: switch the HP on the bar and every element
// with data-by-players on the page), HP bar with phase thresholds, phase tabs "Phase 1 · 100–70%" with the phase
// shout (and the -p2 / -p3 render when it exists) and the mechanics of each phase: attacks with their telegraph,
// summons, shield, haste, enrage and `notes` (script mechanics from src/content/bosses). Without JS every phase panel
// is shown one under another. Behaviour: src/scripts/boss.ts.
import type { Boss } from "../data/types";
import { getMap, getMonster } from "../lib/data";
import { formatDuration, formatNumber } from "../lib/format";
import { name, t } from "../lib/i18n";
import { attackText, shapeText } from "../lib/monster";
import { monsterHref } from "../lib/bestiary";
import { renderFiles } from "../lib/renders";
import type { Lang } from "../i18n/routes";
import Bar from "./Bar.astro";
import ElementBadge from "./ElementBadge.astro";
import MonsterImage from "./MonsterImage.astro";
import RankBadge from "./RankBadge.astro";
import Telegraph from "./Telegraph.astro";
import ZoneBadge from "./ZoneBadge.astro";
interface Props {
  boss: Boss;
  lang: Lang;
  players?: 1 | 2 | 3 | 4 | 5;
  notes?: { phase: number; title: string; html: string }[];
  heading?: "h1" | "h2";
}
const { boss, lang, players = 1, notes = [], heading = "h2" } = Astro.props;
const Heading = heading;
const scale = boss.byPlayers.find((p) => p.players === players) ?? boss.byPlayers[0];
const dungeon = getMap(boss.dungeon);
const bounds = [1, ...boss.phases, 0];
const phases = boss.phases.map((_, i) => i).concat(boss.phases.length).map((i) => ({
  n: i + 1,
  from: Math.round(bounds[i] * 100),
  to: Math.round(bounds[i + 1] * 100),
  text: boss.phaseTexts[i] ? name(boss.phaseTexts[i], lang) : "",
  src: i > 0 && renderFiles().has(`${boss.id}-p${i + 1}.webp`) ? `/img/mobs/${boss.id}-p${i + 1}.webp` : null,
}));
const base = renderFiles().has(`${boss.id}.webp`) ? `/img/mobs/${boss.id}.webp` : null;
const hpTexts = boss.byPlayers.map((p) => `${formatNumber(p.hp, lang)} / ${formatNumber(p.hp, lang)}`);

type Mech = { type: "area" | "leap" | "summon" | "zone" | "buff" | "kill"; title: string; text: string; shape?: Record<string, unknown>; href?: string };
function mechanics(phase: number): Mech[] {
  const out: Mech[] = [];
  for (const a of boss.attacks.filter((x) => x.phases.includes(phase))) {
    const origin = a.target === "self" ? "self" : "target";
    out.push({
      type: a.leap ? "leap" : "area",
      title: name(a.name, lang) || a.id,
      text: attackText(a, lang, boss.damageKind),
      shape: { shape: a.shape, radius: a.radius, inner: a.inner, angle: a.angle, length: a.length, width: a.width, origin, label: t(lang, "telegraph.label", { shape: shapeText(a, origin, lang) }) },
    });
  }
  for (const s of boss.summons.filter((x) => x.phase === phase)) {
    const m = getMonster(s.monster);
    const mName = name(m?.variants.normal?.name ?? m?.name, lang) || s.monster;
    out.push({
      type: "summon",
      title: mName,
      text: t(lang, "boss.summonText", { count: s.count, name: mName, level: s.level, every: s.every ? t(lang, "boss.summonEvery", { every: formatNumber(s.every, lang) }) : "" }),
      href: monsterHref(lang, s.monster),
    });
    if (s.shield) out.push({ type: "zone", title: t(lang, "boss.type.zone"), text: t(lang, "boss.shieldText") });
  }
  const haste = boss.haste?.[String(phase)];
  if (haste) out.push({ type: "buff", title: t(lang, "boss.type.buff"), text: t(lang, "boss.hasteText", { pct: Math.round((haste - 1) * 100) }) });
  return out;
}
---
<section class="vw-boss boss" aria-label={name(boss.name, lang)} data-boss={boss.id}>
  <div class="picture">
    <MonsterImage id={boss.id} kind="boss" alt={name(boss.name, lang)} eager={heading === "h1"} />
  </div>
  <div class="body">
    <div class="badges">
      <RankBadge rank="boss" lang={lang} />
      <span class="vw-rank">{t(lang, "level", { level: boss.level })}</span>
      <ElementBadge element={null} damageKind={boss.damageKind} lang={lang} />
      <ZoneBadge zone={dungeon?.zone ?? "red"} lang={lang} />
    </div>
    <Heading class="name">{name(boss.name, lang)}</Heading>
    <div class="players js-only" role="group" aria-label={t(lang, "boss.playersPick")}>
      <span class="vw-label">{t(lang, "boss.playersPick")}</span>
      {boss.byPlayers.map((p) => (
        <button type="button" class="vw-chip" data-players={p.players} aria-pressed={p.players === players ? "true" : "false"}>{p.players}</button>
      ))}
    </div>
    <div class="hp">
      <div data-by-players={JSON.stringify(hpTexts)} data-target="label">
        <Bar value={scale.hp} max={scale.hp} lang={lang} />
      </div>
      {boss.phases.map((p) => <span class="mark" style={`left: ${p * 100}%`} aria-hidden="true"></span>)}
    </div>
    <div class="vw-boss__phases tabs" role="tablist" aria-label={t(lang, "boss.mechanics", { n: "" }).trim()}>
      {phases.map((p, i) => (
        <button type="button" class="vw-phase" role="tab" id={`phase-tab-${p.n}`} aria-controls={`phase-${p.n}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-src={p.src ?? base ?? undefined}>
          <span class="phase-title">{t(lang, "boss.phaseRange", { n: p.n, from: p.from, to: p.to })}</span>
          {p.text && <span class="phase-text">{p.text}</span>}
        </button>
      ))}
    </div>
  </div>
  <div class="panels">
    {phases.map((p, i) => (
      <div class="panel" role="tabpanel" id={`phase-${p.n}`} aria-labelledby={`phase-tab-${p.n}`} data-active={i === 0 ? "true" : undefined}>
        <h3 class="vw-label panel-title">{t(lang, "boss.mechanics", { n: p.n })}</h3>
        <ul class="mechs">
          {mechanics(p.n).map((m) => (
            <li class={`mech type-${m.type}`}>
              {m.shape ? <Telegraph {...(m.shape as { shape: string })} size={52} /> : <span class="mark-icon" aria-hidden="true">{m.type === "summon" ? "✚" : m.type === "buff" ? "▲" : "◎"}</span>}
              <div>
                <span class="type">{t(lang, `boss.type.${m.type}`)}</span>
                {m.href ? <a class="mname" href={m.href}>{m.title}</a> : <span class="mname">{m.title}</span>}
                <p class="mtext">{m.text}</p>
              </div>
            </li>
          ))}
          {notes.filter((note) => note.phase === p.n).map((note) => (
            <li class="mech type-zone note">
              <span class="mark-icon" aria-hidden="true">!</span>
              <div>
                <span class="type">{t(lang, "boss.note")}</span>
                <span class="mname">{note.title}</span>
                <div class="mtext" set:html={note.html} />
              </div>
            </li>
          ))}
          <li class="mech type-kill">
            <span class="mark-icon" aria-hidden="true">☠</span>
            <div>
              <span class="type">{t(lang, "boss.type.kill")}</span>
              <span class="mname">{boss.enrageText ? name(boss.enrageText, lang) : t(lang, "boss.type.kill")}</span>
              <p class="mtext">{t(lang, "boss.enrageText", { time: formatDuration(boss.enrageAfter, lang), mul: formatNumber(boss.enrageDamage, lang) })}</p>
            </div>
          </li>
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .boss { grid-template-columns: 320px minmax(0, 1fr); box-shadow: 0 -40px 120px -60px rgba(214, 74, 62, .45); }
  .picture { aspect-ratio: 3 / 4; border: 2px solid var(--vw-zone-red); box-shadow: 0 0 0 3px var(--vw-bg), 0 0 0 4px color-mix(in srgb, var(--vw-zone-red) 55%, transparent); background: #14161B; }
  .body { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .name { margin: 0; font: 700 72px/1 var(--vw-font-display); color: var(--vw-text); }
  .players { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .players .vw-label { margin-right: 6px; }
  .players .vw-chip { min-width: 44px; min-height: 44px; justify-content: center; }
  :global(html:not(.js)) .js-only { display: none; }
  .hp { position: relative; max-width: 760px; }
  .hp :global(.vw-bar) { height: 28px; }
  .mark { position: absolute; top: -4px; bottom: -4px; width: 2px; background: var(--vw-gold-bright); box-shadow: 0 0 6px var(--vw-gold-bright); }
  .tabs { margin-top: 4px; }
  .vw-phase { display: flex; flex-direction: column; gap: 4px; text-align: left; font: inherit; color: var(--vw-text); border-top-color: var(--vw-zone-red); min-height: 44px; }
  .vw-phase[aria-selected="true"] { border-top-color: var(--vw-gold-bright); }
  .vw-phase:focus-visible { box-shadow: var(--vw-focus); outline: none; }
  .phase-title { font: 800 13px/1.2 var(--vw-font-ui); letter-spacing: .12em; text-transform: uppercase; color: var(--vw-gold); }
  .phase-text { font-size: 15px; font-weight: 700; color: var(--vw-text-soft); }
  .panels { grid-column: 1 / -1; }
  :global(html.js) .panel:not([data-active]) { display: none; }
  :global(html:not(.js)) .panel + .panel { margin-top: 20px; }
  .panel-title { margin: 0 0 12px; }
  .mechs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 10px; }
  .mech { display: flex; gap: 14px; align-items: flex-start; padding: 14px; background: var(--vw-panel-raised); border: 1px solid var(--vw-border); --c: #E8763A; }
  .type-summon { --c: #A88BE8; } .type-zone { --c: #E8665A; } .type-buff { --c: #E0C23B; } .type-leap { --c: #E8763A; }
  .type-kill { --c: var(--vw-zone-red-text); border: 3px double var(--vw-zone-red); }
  .type { display: block; font: 800 12px/1.4 var(--vw-font-ui); letter-spacing: .14em; text-transform: uppercase; color: var(--c); }
  .mname { display: block; font-size: 17px; font-weight: 800; color: var(--vw-text); }
  .mtext { margin: 4px 0 0; font-size: 15px; color: var(--vw-text-soft); line-height: 1.45; }
  .mtext :global(p) { margin: 0; }
  .mark-icon { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border: 1px solid var(--c); color: var(--c); font-size: 22px; background: #14161B; }
  @media (max-width: 1023px) {
    .boss { grid-template-columns: 1fr; padding: 16px; gap: 18px; }
    .picture { aspect-ratio: auto; height: 300px; }
    .name { font-size: 44px; }
    .tabs { grid-auto-flow: row; }
    .vw-phase { flex-direction: row; justify-content: space-between; align-items: baseline; flex-wrap: wrap; }
    .mechs { grid-template-columns: 1fr; }
  }
</style>
