---
// Monster area page (/pl/krainy/<region>/<areaId>/, S37): levels, zone and hunting ground profile, mini map with the
// area highlighted, facts (groups, monsters, respawn, arrival point), monsters with their levels here, quests with a
// goal here and other hunting grounds for overlapping levels (areas and caves).
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import MiniMap from "../../components/MiniMap.astro";
import RankBadge from "../../components/RankBadge.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ZoneBadge from "../../components/ZoneBadge.astro";
import QuestCards from "./QuestCards.astro";
import Route from "./Route.astro";
import { href, type Lang } from "../../i18n/routes";
import { load } from "../../lib/data";
import { name, t } from "../../lib/i18n";
import { searchHref, sectionHref } from "../../lib/sections";
import { areaOf, areas, caves, getMapInfo, levels, monstersOn, placeHref, questsAt, respawn } from "../../lib/world";

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const area = areaOf(id)!;
const map = getMapInfo(area.map)!;
const zones = load("mechanics").zones;
const profile = area.profile ? load("mechanics").areaProfiles?.[area.profile] : undefined;
const monsterList = monstersOn(area.map, { area: id });
const quests = questsAt({ map: area.map, area: id });
const overlap = (min: number, max: number) => min <= area.levelMax && max >= area.levelMin;
const others = [
  ...areas().filter((a) => a.id !== id && overlap(a.levelMin, a.levelMax)).map((a) => ({ id: a.id, name: a.name, min: a.levelMin, max: a.levelMax, map: a.map, cave: false, profile: a.profile })),
  ...caves().filter((c) => overlap(c.levelMin, c.levelMax)).map((c) => ({ id: c.id, name: c.name, min: c.levelMin, max: c.levelMax, map: c.region, cave: true, profile: undefined as string | undefined })),
].sort((a, b) => a.min - b.min || a.max - b.max || (a.id < b.id ? -1 : 1));
const title = name(area.name, lang);
const mapName = name(map.name, lang);
const fmt = (v: number) => (Math.round(v * 100) / 100).toLocaleString(lang === "pl" ? "pl-PL" : "en-GB");
const monsterHref = (mid: string, label: string) => sectionHref(lang, "bestiary", mid) ?? searchHref(lang, label);
const route = [...(map.route ?? [])];
---
<Base lang={lang} title={title} description={`${title}: ${levels(lang, area.levelMin, area.levelMax)}, ${mapName}.`} section="map" search={{ type: "region", meta: { title, line: `${levels(lang, area.levelMin, area.levelMax)} · ${mapName}`, type: "area" } }}>
  <article class="page">
    <Crumbs items={[{ label: t(lang, "crumbs.wiki"), href: href(lang, "home") }, { label: t(lang, "region.title"), href: href(lang, "regions") }, { label: mapName, href: placeHref(lang, map.id) }, { label: title }]} />
    <header class="head">
      <h1 class="h1">{title}</h1>
      <div class="badges">
        <span class="vw-rank">{levels(lang, area.levelMin, area.levelMax)}</span>
        <ZoneBadge zone={map.zone} lang={lang} />
        {profile && <span class="vw-rank profile" style={`--c:${profile.color}`} title={name(profile.desc, lang)}>{profile.icon} {name(profile.name, lang)}</span>}
      </div>
      {profile && <p class="soft">{name(profile.desc, lang)} <span class="muted">({t(lang, "area.profileMul", { exp: fmt(profile.expMul), items: fmt(profile.itemChanceMul), gold: fmt(profile.goldMul) })})</span></p>}
    </header>

    <div class="grid">
      <MiniMap map={area.map} lang={lang} highlight={{ areas: [id] }} />
      <dl class="facts">
        <div><dt>{t(lang, "area.region")}</dt><dd><a href={placeHref(lang, map.id)}>{mapName}</a></dd></div>
        <div><dt>{t(lang, "area.groups")}</dt><dd>{area.groups}</dd></div>
        <div><dt>{t(lang, "area.count")}</dt><dd>{area.monsters}</dd></div>
        <div><dt>{t(lang, "area.respawn")}</dt><dd>{respawn(area.respawnMin, area.respawnMax)}</dd></div>
        {area.arrive && <div><dt>{t(lang, "area.arrive")}</dt><dd>{t(lang, "area.arriveText", { x: Math.round(area.arrive.x), z: Math.round(area.arrive.z) })}</dd></div>}
        <div><dt>{name(zones[map.zone]?.name, lang)}</dt><dd>{name(zones[map.zone]?.rule, lang)}</dd></div>
      </dl>
    </div>

    <section>
      <SectionTitle id="monsters">{t(lang, "region.monsters")}</SectionTitle>
      <ul class="mlist">
        {monsterList.map((m) => {
          const label = name(m.monster.variants[m.rank]?.name ?? m.monster.name, lang);
          return (
            <li>
              <span class="dia" aria-hidden="true"></span>
              <a class="strong" href={monsterHref(m.monster.id, label)}>{label}</a>
              <span class="muted nowrap">{levels(lang, m.levelMin, m.levelMax)}</span>
              <RankBadge rank={m.rank} lang={lang} />
            </li>
          );
        })}
      </ul>
    </section>

    <div class="two">
      <section>
        <SectionTitle id="quests">{t(lang, "region.quests")}</SectionTitle>
        <QuestCards lang={lang} quests={quests} place={{ map: area.map, area: id }} />
      </section>
      <section>
        <SectionTitle id="route">{t(lang, "region.route")}</SectionTitle>
        <Route lang={lang} route={route} />
      </section>
    </div>

    <section>
      <SectionTitle id="other">{t(lang, "area.other")}</SectionTitle>
      <div class="cards">
        {others.map((o) => {
          const m = getMapInfo(o.map);
          const p = o.profile ? load("mechanics").areaProfiles?.[o.profile] : undefined;
          return (
            <a class="card" href={placeHref(lang, o.id)}>
              <span class={`dia ${o.cave ? "red" : ""}`} aria-hidden="true"></span>
              <span class="strong">{name(o.name, lang)}</span>
              <span class="muted small">{levels(lang, o.min, o.max)} · {o.cave ? t(lang, "map.kind.cave") : m ? name(m.name, lang) : ""}{p ? ` · ${p.icon}` : ""}</span>
            </a>
          );
        })}
      </div>
    </section>
  </article>
</Base>

<style>
  .page { max-width: 1180px; margin: 0 auto; padding: 36px 48px 72px; display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 14px; margin-top: -16px; }
  .h1 { margin: 0; font: 700 var(--vw-fs-display-l)/1 var(--vw-font-display); }
  .badges { display: flex; flex-wrap: wrap; gap: 10px; }
  .profile { color: var(--c); border-color: color-mix(in srgb, var(--c) 60%, var(--vw-border)); }
  .soft { margin: 0; color: var(--vw-text-soft); font-size: 18px; }
  .muted { color: var(--vw-text-muted); }
  .small { font-size: 14px; }
  .nowrap { white-space: nowrap; }
  .strong { font-weight: 800; color: var(--vw-text); }
  .grid { display: grid; grid-template-columns: 420px 1fr; gap: 32px; align-items: start; }
  .facts { margin: 0; display: grid; gap: 0; background: var(--vw-panel); border: 1px solid var(--vw-border); }
  .facts div { display: grid; grid-template-columns: 200px 1fr; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--vw-border-subtle); }
  .facts div:last-child { border-bottom: 0; }
  .facts dt { font: 800 13px/1.4 var(--vw-font-ui); letter-spacing: .1em; text-transform: uppercase; color: var(--vw-gold); }
  .facts dd { margin: 0; color: var(--vw-text); }
  .mlist { list-style: none; margin: 0; padding: 0; background: var(--vw-panel); border: 1px solid var(--vw-border); }
  .mlist li { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto 90px; align-items: center; gap: 12px; min-height: 44px; padding: 0 16px; border-bottom: 1px solid var(--vw-border-subtle); }
  .mlist li:last-child { border-bottom: 0; }
  .dia { width: 11px; height: 11px; transform: rotate(45deg); background: var(--vw-text-soft); justify-self: center; }
  .dia.red { background: var(--vw-zone-red); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .card { display: grid; grid-template-columns: 16px 1fr; gap: 4px 10px; align-items: center; padding: 12px 14px; background: var(--vw-panel); border: 1px solid var(--vw-border); color: var(--vw-text); }
  .card > :not(.dia) { grid-column: 2; }
  .card .dia { grid-row: 1 / span 2; }
  .card:hover { text-decoration: none; border-color: var(--vw-gold-dark); }
  @media (max-width: 1023px) {
    .page { padding: 16px 16px 32px; }
    .grid, .two { grid-template-columns: 1fr; }
    .h1 { font-size: 46px; }
    .facts div { grid-template-columns: 1fr; gap: 2px; }
    .mlist li { min-height: 52px; }
  }
</style>
