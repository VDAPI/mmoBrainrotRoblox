---
// Boss page (S39, /pl/bossy/<id>/): BossHeader (S134: one HP for every party; phases with mechanics and script notes from
// src/content/bosses), stats for the chosen party size, shared loot, boss items, the Legendary / Mythic chances by kills that day
// bars, and on the right the entry rules, the gate on the cave mini map and the summons. Also the boss list
// (/pl/bossy/, page "index"). Behaviour: src/scripts/boss.ts. WIKI-3: page "world" = a world boss (bosses.json
// `world`): the same header, then the reward by contribution, the boss's own items with their pity, the schedule in
// Polish time and the place on the map.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BossHeader from "../components/BossHeader.astro";
import Crumbs from "../components/Crumbs.astro";
import ItemIcon from "../components/ItemIcon.svelte";
import ItemTooltip from "../components/ItemTooltip.svelte";
import MiniMap from "../components/MiniMap.astro";
import MonsterCard from "../components/MonsterCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { href, type Lang } from "../i18n/routes";
import { bossHref, monsterHref } from "../lib/bestiary";
import { fillConsts, noteHtml } from "../lib/bossnotes";
import { bosses, getBoss, getItem, getMap, getMonster, getWorldBoss, load, rarities, worldBosses } from "../lib/data";
import { formatChance, formatDuration, formatNumber } from "../lib/format";
import { iconFor } from "../lib/icons";
import { name, t } from "../lib/i18n";
import { itemHref } from "../lib/monster";
import { sectionHref } from "../lib/sections";
import { tooltipData } from "../lib/tooltip";
import { caveOf, placeHref } from "../lib/world";
import type { Name } from "../data/types";

interface Props {
  lang: Lang;
  page: "index" | "boss" | "world";
  id?: string;
}
const { lang, page, id } = Astro.props;
const crumbsBase = [
  { label: t(lang, "crumbs.wiki"), href: href(lang, "home") },
  { label: t(lang, "monster.crumb"), href: sectionHref(lang, "bestiary") },
];
const file = load("bosses");
const boss = id && page === "boss" ? getBoss(id) : undefined;
const wb = id && page === "world" ? getWorldBoss(id) : undefined;
const noteFor = boss ?? wb;
const notes = noteFor
  ? (await getCollection("bosses"))
      .filter((e) => e.data.boss === noteFor.id && e.id.startsWith(`${lang}/`))
      .sort((a, b) => a.data.phase - b.data.phase || (a.id < b.id ? -1 : 1))
      .map((e) => ({ phase: e.data.phase, title: e.data.title, html: noteHtml(fillConsts(e.body ?? "", noteFor.scriptConsts, lang, `src/content/bosses/${e.id}`)) }))
  : [];
const title = noteFor ? name(noteFor.name, lang) : t(lang, "bosses.title");
const range = (a: number, b: number) => (a === b ? formatNumber(a, lang) : `${formatNumber(a, lang)}–${formatNumber(b, lang)}`);
const rarityName = (key: string) => name(rarities().find((r) => r.key === key)?.name, lang);
const rarityOrder = (key: string) => rarities().findIndex((r) => r.key === key);

const dungeon = boss ? getMap(boss.dungeon) : undefined;
const cave = boss?.gateCave ? caveOf(boss.gateCave) : undefined;
const gate = boss ? load("portals").portals.find((p) => p.kind === "dungeon" && p.target === boss.dungeon) : undefined;
const stone = boss ? getItem(`stone_dungeon_${boss.region}`) : undefined;
const bind = t(lang, "tooltip.bind");
const pity = boss
  ? (["legendary", "mythic"] as const).map((k) => ({ key: k, line: boss.personal[k], rarity: k === "legendary" ? "legendary" : "mythic" }))
  : [];
// WIKI-3: the world boss page
const wbMap = wb ? getMap(wb.map) : undefined;
const pct = (v: number) => formatChance(v, lang);
const classNames = new Map<string, Name>(load("classes").classes.map((c) => [c.id as string, c.name]));
const wbClasses = wb ? [...new Set(wb.reward.named.items.map((x) => x.class))] : [];
const wbRarityKeys = wb ? Object.keys(wb.reward.rarities[0]?.shares ?? {}).sort((a, b) => rarityOrder(a) - rarityOrder(b)) : [];
const factorLabel = (f: number) => (f === wb?.reward.factorLo ? t(lang, "worldboss.factor.low") : f === wb?.reward.factorHi ? t(lang, "worldboss.factor.high") : t(lang, "worldboss.factor.even"));
---
{page === "index" ? (
  <Base lang={lang} title={title} description={t(lang, "bosses.lead")} section="bestiary" og={{ image: `/img/og/${lang}/bestiary.jpg`, alt: title }}>
    <div class="page">
      <Crumbs items={[...crumbsBase, { label: title }]} />
      <h1 class="h1">{title}</h1>
      <p class="lead">{t(lang, "bosses.lead")}</p>
      <ul class="bossgrid">
        {bosses().map((b) => <li><MonsterCard boss={b} lang={lang} href={bossHref(lang, b.id)} /></li>)}
      </ul>
      {worldBosses().length > 0 && (
        <section class="worldlist">
          <SectionTitle>{t(lang, "worldboss.listTitle")}</SectionTitle>
          <p class="lead small">{t(lang, "worldboss.listLead")}</p>
          <ul class="bossgrid">
            {worldBosses().map((b) => <li><MonsterCard boss={b} lang={lang} href={bossHref(lang, b.id)} /></li>)}
          </ul>
        </section>
      )}
    </div>
  </Base>
) : wb ? (
  <Base
    lang={lang}
    title={title}
    description={t(lang, "og.worldBoss", { name: title, level: wb.level })}
    section="bestiary"
    search={{ type: "monster", meta: { title, line: `${t(lang, "worldboss.rank")} · ${t(lang, "level", { level: wb.level })} · ${name(wbMap?.name, lang)}` } }}
    og={{ image: `/img/og/${lang}/boss/${wb.id}.jpg`, alt: title }}
  >
    <div class="page" data-boss-page>
      <Crumbs items={[...crumbsBase, { label: t(lang, "boss.crumb"), href: sectionHref(lang, "bosses") }, { label: title }]} />
      <div class="header"><BossHeader boss={wb} lang={lang} notes={notes} heading="h1" /></div>

      <div class="lower">
        <div class="main">
          <section>
            <SectionTitle>{t(lang, "boss.stats")}</SectionTitle>
            <dl class="cells">
              <div><dt>{t(lang, "monster.stat.hp")}</dt><dd>{formatNumber(wb.stats.hp, lang)}</dd></div>
              <div><dt>{t(lang, "boss.attack")}</dt><dd>{range(wb.stats.dmgMin, wb.stats.dmgMax)}</dd></div>
              <div><dt>{t(lang, "monster.stat.armor")}</dt><dd>{formatNumber(wb.stats.armor, lang)}</dd></div>
              <div><dt>{t(lang, "monster.stat.mres")}</dt><dd>{formatNumber(wb.stats.mres, lang)}</dd></div>
              <div><dt>{t(lang, "worldboss.players")}</dt><dd>{range(wb.players[0], wb.players[wb.players.length - 1])}</dd></div>
              <div><dt>{t(lang, "monster.stat.time")}</dt><dd>{formatDuration(wb.timeLimit, lang)}</dd></div>
            </dl>
            <p class="note">{t(lang, "monster.dmgNote")} {t(lang, "worldboss.noScaling")}</p>
          </section>

          <section>
            <SectionTitle>{t(lang, "worldboss.reward")}</SectionTitle>
            <p>{t(lang, "worldboss.rewardWho", { level: wb.minLevel, pct: formatNumber(wb.sharePct, lang), n: formatNumber(wb.shareMonsters, lang) })}</p>
            <p>{t(lang, "worldboss.rewardWhat", { exp: wb.reward.expKills, gold: wb.reward.goldKills })}</p>
            <table class="vw-table">
              <caption class="vw-sr">{t(lang, "worldboss.reward")}</caption>
              <thead><tr><th scope="col"><span class="vw-sr">{t(lang, "renders.title")}</span></th><th scope="col">{t(lang, "loot.col.item")}</th><th scope="col">{t(lang, "loot.amount", { range: "" }).trim()}</th><th scope="col" style="text-align: right">{t(lang, "loot.col.chance")}</th></tr></thead>
              <tbody>
                {wb.reward.materials.map((m) => {
                  const item = getItem(m.id);
                  const rar = item?.rarities[item.rarities.length - 1] ?? "common";
                  const ih = itemHref(lang, m.id);
                  return (
                    <tr>
                      <td class="icon"><ItemIcon glyph={item?.glyph ?? "◆"} color={item?.color ?? "#9DA3AB"} rarity={rar} size={36} src={iconFor(m.id)} /></td>
                      <td class="strong">{ih ? <a href={ih} style={`color: var(--vw-r-${rar}-text)`}>{name(item?.name, lang)}</a> : <span style={`color: var(--vw-r-${rar}-text)`}>{name(item?.name, lang)}</span>}</td>
                      <td>{range(m.min, m.max)}</td>
                      <td class="chance">{pct(m.chance)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <h3 class="vw-h3">{t(lang, "worldboss.itemTitle")}</h3>
            <p>{t(lang, wb.reward.itemBound ? "worldboss.itemBound" : "worldboss.itemFree")} {t(lang, "worldboss.factorText", { lo: formatNumber(wb.reward.factorLo, lang), hi: formatNumber(wb.reward.factorHi, lang) })}</p>
            <div class="vw-scroll" tabindex="0">
              <table class="vw-table vw-table--plain">
                <caption class="vw-sr">{t(lang, "worldboss.itemTitle")}</caption>
                <thead><tr><th scope="col">{t(lang, "worldboss.factor")}</th>{wbRarityKeys.map((k) => <th scope="col" style="text-align: right"><span style={`color: var(--vw-r-${k}-text)`}>{rarityName(k)}</span></th>)}</tr></thead>
                <tbody>
                  {wb.reward.rarities.map((row) => (
                    <tr>
                      <th scope="row" class="rowhead">{factorLabel(row.factor)} · ×{formatNumber(row.factor, lang)}</th>
                      {wbRarityKeys.map((k) => <td style="text-align: right" class="strong">{pct(row.shares[k] ?? 0)}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section>
            <SectionTitle>{t(lang, "worldboss.named")}</SectionTitle>
            <p>{t(lang, "worldboss.namedText", { chance: pct(wb.reward.named.chance), step: pct(wb.reward.named.step), pity: wb.reward.named.pityAt, avg: formatNumber(wb.reward.named.expectedFights, lang) })}</p>
            {wbClasses.map((c) => (
              <>
                <h3 class="vw-h3">{name(classNames.get(c), lang) || c}</h3>
                <div class="named">
                  {wb.reward.named.items.filter((x) => x.class === c).map((x) => {
                    const data = tooltipData(x.id, { lang });
                    return data && <ItemTooltip data={data} href={itemHref(lang, x.id)} labels={{ bind }} />;
                  })}
                </div>
              </>
            ))}
          </section>

          <section>
            <SectionTitle>{t(lang, "worldboss.absent")}</SectionTitle>
            <p>{t(lang, "worldboss.absentText")}</p>
          </section>
        </div>

        <aside class="side">
          <section class="rules">
            <h2 class="vw-label">{t(lang, "worldboss.when")}</h2>
            <dl>
              <div><dt>{t(lang, "worldboss.times")}</dt><dd>{wb.schedule.times.join(", ")} <span class="muted">— {t(lang, "worldboss.timesPl")}</span></dd></div>
              <div><dt>{t(lang, "worldboss.utc")}</dt><dd>{t(lang, "worldboss.utcText", { winter: wb.schedule.utcWinter.join(", "), summer: wb.schedule.utcSummer.join(", ") })}</dd></div>
              <div><dt>{t(lang, "worldboss.warn")}</dt><dd>{t(lang, "worldboss.warnText", { list: wb.schedule.warn.map((s) => formatNumber(Math.round(s / 60), lang)).join(", ") })}</dd></div>
              <div><dt>{t(lang, "monster.stat.time")}</dt><dd>{t(lang, "worldboss.stayText", { time: formatDuration(wb.timeLimit, lang) })}</dd></div>
              <div><dt>{t(lang, "worldboss.enrage")}</dt><dd>{t(lang, "boss.enrageText", { time: formatDuration(wb.enrageAfter, lang), mul: formatNumber(wb.enrageDamage, lang) })}</dd></div>
              <div><dt>{t(lang, "worldboss.place")}</dt><dd>{name(wb.place.name, lang)} · {wbMap ? (placeHref(lang, wbMap.id) ? <a href={placeHref(lang, wbMap.id)!}>{name(wbMap.name, lang)}</a> : name(wbMap.name, lang)) : ""}</dd></div>
              <div><dt>{t(lang, "worldboss.minLevel")}</dt><dd>{t(lang, "level", { level: wb.minLevel })} <span class="muted">— {t(lang, "worldboss.minLevelText")}</span></dd></div>
              <div><dt>{t(lang, "worldboss.pvp")}</dt><dd>{t(lang, wb.pvpSafe ? "worldboss.pvpSafe" : "worldboss.pvpOn")}</dd></div>
            </dl>
            {wbMap && <MiniMap map={wbMap.id} lang={lang} size="md" highlight={{ point: { x: wb.place.x, z: wb.place.z } }} />}
          </section>
          {wb.summons.length > 0 && (
            <section>
              <h2 class="vw-label">{t(lang, "boss.summonsTitle")}</h2>
              <p class="muted">{t(lang, "worldboss.summonsText")}</p>
              <ul class="summons">
                {[...new Map(wb.summons.map((s) => [s.monster, s])).values()].map((s) => {
                  const m = getMonster(s.monster);
                  return m && <li><MonsterCard monster={m} level={s.level} lang={lang} href={monsterHref(lang, m.id)} /></li>;
                })}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </Base>
) : boss && (
  <Base
    lang={lang}
    title={title}
    description={t(lang, "og.boss", { name: title, level: boss.level })}
    section="bestiary"
    search={{ type: "monster", meta: { title, line: `${t(lang, "rank.boss")} · ${t(lang, "level", { level: boss.level })} · ${name(dungeon?.name, lang)}` } }}
    og={{ image: `/img/og/${lang}/boss/${boss.id}.jpg`, alt: title }}
  >
    <div class="page" data-boss-page>
      <Crumbs items={[...crumbsBase, { label: t(lang, "boss.crumb"), href: sectionHref(lang, "bosses") }, { label: title }]} />
      <div class="header"><BossHeader boss={boss} lang={lang} notes={notes} heading="h1" /></div>

      <div class="lower">
        <div class="main">
          <section>
            <SectionTitle>{t(lang, "boss.stats")}</SectionTitle>
            <dl class="cells">
              <div><dt>{t(lang, "monster.stat.hp")}</dt><dd>{formatNumber(boss.stats.hp, lang)}</dd></div>
              <div><dt>{t(lang, "boss.attack")}</dt><dd>{range(boss.stats.dmgMin, boss.stats.dmgMax)}</dd></div>
              <div><dt>{t(lang, "monster.stat.armor")}</dt><dd>{formatNumber(boss.stats.armor, lang)}</dd></div>
              <div><dt>{t(lang, "monster.stat.exp")}</dt><dd>{formatNumber(boss.exp, lang)}</dd></div>
              <div><dt>{t(lang, "monster.stat.gold")}</dt><dd>{range(boss.goldMin, boss.goldMax)}</dd></div>
              <div><dt>{t(lang, "monster.stat.time")}</dt><dd>{formatDuration(boss.timeLimit, lang)}</dd></div>
            </dl>
            <p class="note">{t(lang, "monster.dmgNote")} {t(lang, "monster.stat.mres")}: {formatNumber(boss.stats.mres, lang)}. {t(lang, "boss.noScaling")}</p>
          </section>

          <section>
            <SectionTitle>{t(lang, "boss.shared")}</SectionTitle>
            <p>{t(lang, "boss.sharedText", { min: boss.loot.itemMin, max: boss.loot.itemMax })}</p>
            <p class="rars">
              {Object.entries(boss.loot.rarities).sort((a, b) => rarityOrder(a[0]) - rarityOrder(b[0])).map(([k, v]) => (
                <span class="vw-rarity" style={`--c: var(--vw-r-${k}); color: var(--vw-r-${k}-text)`}>{rarityName(k)} · {formatChance(v, lang)}</span>
              ))}
            </p>
            <table class="vw-table">
              <caption class="vw-sr">{t(lang, "boss.shared")}</caption>
              <thead><tr><th scope="col"><span class="vw-sr">{t(lang, "renders.title")}</span></th><th scope="col">{t(lang, "loot.col.item")}</th><th scope="col">{t(lang, "loot.amount", { range: "" }).trim()}</th><th scope="col" style="text-align: right">{t(lang, "loot.col.chance")}</th></tr></thead>
              <tbody>
                {boss.loot.materials.map((m) => {
                  const item = getItem(m.id);
                  const rar = item?.rarities[item.rarities.length - 1] ?? "common";
                  const ih = itemHref(lang, m.id);
                  return (
                    <tr>
                      <td class="icon"><ItemIcon glyph={item?.glyph ?? "◆"} color={item?.color ?? "#9DA3AB"} rarity={rar} size={36} src={iconFor(m.id)} /></td>
                      <td class="strong">{ih ? <a href={ih} style={`color: var(--vw-r-${rar}-text)`}>{name(item?.name, lang)}</a> : <span style={`color: var(--vw-r-${rar}-text)`}>{name(item?.name, lang)}</span>}</td>
                      <td>{range(m.min, m.max)}</td>
                      <td class="chance">{formatChance(m.chance, lang)}</td>
                    </tr>
                  );
                })}
                <tr>
                  <td class="icon"><ItemIcon glyph="✦" color="#FF9F1C" rarity="legendary" size={36} /></td>
                  <td class="strong">{t(lang, "boss.blessing")}</td>
                  <td>1</td>
                  <td class="chance">{formatChance(boss.loot.legendaryBlessingChance, lang)}</td>
                </tr>
              </tbody>
            </table>
          </section>

          <section>
            <SectionTitle>{t(lang, "boss.named")}</SectionTitle>
            <div class="named">
              {boss.loot.named.map((itemId) => {
                const data = tooltipData(itemId, { lang });
                return data && <ItemTooltip data={data} href={itemHref(lang, itemId)} labels={{ bind }} />;
              })}
            </div>
          </section>

          <section>
            <SectionTitle>{t(lang, "boss.personal")}</SectionTitle>
            <p>{t(lang, "boss.personalText")}</p>
            <div class="pity">
              {pity.map(({ key, line, rarity }) => {
                const n = line.byMisses.length;
                const w = 100 / n;
                return (
                  <figure class="pityfig">
                    <figcaption><span class="vw-label" style={`color: var(--vw-r-${rarity}-text)`}>{t(lang, `boss.pity.${key}`)}</span> {formatChance(line.chance, lang)} → {formatChance(line.byMisses[n - 1], lang)}</figcaption>
                    <svg viewBox="0 0 100 40" preserveAspectRatio="none" role="img" aria-label={`${t(lang, `boss.pity.${key}`)}: ${line.byMisses.map((c) => formatChance(c, lang)).join(", ")}`}>
                      {line.byMisses.map((c, i) => (
                        <rect x={(i * w + w * 0.12).toFixed(2)} y={(40 - c * 40).toFixed(2)} width={(w * 0.76).toFixed(2)} height={(c * 40).toFixed(2)} style={`fill: var(--vw-r-${rarity})`}><title>{i}: {formatChance(c, lang)}</title></rect>
                      ))}
                    </svg>
                    <div class="axis"><span>0</span><span>{t(lang, "boss.pity.misses")}</span><span>{n - 1}</span></div>
                    <p class="muted">{t(lang, "boss.pity.expected", { kills: formatNumber(Math.round(line.expectedKills * 10) / 10, lang), days: formatNumber(Math.round((line.expectedKills / file.dailyRuns) * 10) / 10, lang), runs: file.dailyRuns })}</p>
                  </figure>
                );
              })}
            </div>
          </section>
        </div>

        <aside class="side">
          <section class="rules">
            <h2 class="vw-label">{t(lang, "boss.entry")}</h2>
            <dl>
              <div><dt>{t(lang, "boss.room")}</dt><dd>{name(dungeon?.name, lang)} · {t(lang, "levelRangeCap", { min: dungeon?.minLevel ?? boss.level, max: dungeon?.maxLevel ?? boss.level })}</dd></div>
              <div><dt>{t(lang, "boss.required")}</dt><dd>{t(lang, "level", { level: boss.requiredLevel })}</dd></div>
              <div><dt>{t(lang, "boss.maxLevel")}</dt><dd>{t(lang, "level", { level: boss.maxLevel })} <span class="muted">— {t(lang, "boss.maxLevelText")}</span></dd></div>
              {cave && <div><dt>{t(lang, "boss.gate")}</dt><dd>{placeHref(lang, cave.id) ? <a href={placeHref(lang, cave.id)!}>{name(cave.name, lang)}</a> : name(cave.name, lang)}</dd></div>}
              {stone && <div><dt>{t(lang, "boss.stone")}</dt><dd>{itemHref(lang, stone.id) ? <a href={itemHref(lang, stone.id)!}>{name(stone.name, lang)}</a> : name(stone.name, lang)} <span class="muted">— {t(lang, "boss.stoneText")}</span></dd></div>}
              <div><dt>{t(lang, "boss.daily")}</dt><dd>{t(lang, "boss.dailyText", { n: file.dailyRuns })}</dd></div>
              <div><dt>{t(lang, "boss.party")}</dt><dd>{t(lang, "boss.partyText", { range: formatNumber(file.entryRange, lang) })}</dd></div>
              <div><dt>{t(lang, "boss.countdown")}</dt><dd>{t(lang, "boss.countdownText", { n: file.countdown })}</dd></div>
              <div><dt>{t(lang, "boss.release")}</dt><dd>{t(lang, "boss.releaseText", { n: file.releaseAfter })}</dd></div>
              <div><dt>{t(lang, "monster.stat.time")}</dt><dd>{t(lang, "boss.timeText", { time: formatDuration(boss.timeLimit, lang) })}</dd></div>
            </dl>
            {cave && gate && <MiniMap map={cave.id} lang={lang} size="md" highlight={{ portals: [gate.id] }} />}
          </section>
          {boss.summons.length > 0 && (
            <section>
              <h2 class="vw-label">{t(lang, "boss.summonsTitle")}</h2>
              <ul class="summons">
                {boss.summons.map((s) => {
                  const m = getMonster(s.monster);
                  return m && <li><MonsterCard monster={m} level={s.level} lang={lang} href={monsterHref(lang, m.id)} /></li>;
                })}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </Base>
)}

<script>
  import "../scripts/boss";
</script>

<style>
  .page { max-width: 1440px; margin: 0 auto; padding: 22px 48px 72px; }
  .h1 { margin: 12px 0 8px; font: 700 72px/1 var(--vw-font-display); color: var(--vw-gold-bright); }
  .lead { margin: 0 0 28px; font-size: 19px; color: var(--vw-text-soft); }
  .bossgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .header { margin-top: 20px; }
  .lower { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 48px; margin-top: 48px; align-items: start; }
  .main { display: flex; flex-direction: column; gap: 40px; min-width: 0; }
  .main p { margin: 0 0 12px; color: var(--vw-text-soft); }
  .cells { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; border: 1px solid var(--vw-border); background: var(--vw-panel); }
