---
// Monster page (S39, /pl/bestiariusz/<id>/, mock-up Potwor-*): every occurring variant rendered in the HTML
// (<section data-variant>, so elite names are indexed), switched by tabs (?v=elite2). Per variant: render, badges,
// description from a template, HP bar and stat cells for a spawn level (chips), combat details, loot table with the
// preview tooltip, all levels, basic attack / Elite II ability / behaviour, where it lives with mini maps. Below:
// quests, summoning bosses, other monsters of the same places. Behaviour: src/scripts/monster.ts.
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import Crumbs from "../components/Crumbs.astro";
import DataTable from "../components/DataTable.astro";
import ElementBadge from "../components/ElementBadge.astro";
import ItemIcon from "../components/ItemIcon.svelte";
import ItemTooltip from "../components/ItemTooltip.svelte";
import MiniMap from "../components/MiniMap.astro";
import MonsterImage from "../components/MonsterImage.astro";
import RankBadge from "../components/RankBadge.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Telegraph from "../components/Telegraph.astro";
import ZoneBadge from "../components/ZoneBadge.astro";
import { href, type Lang } from "../i18n/routes";
import { bossHref, finalLevels, monsterHref, placesOf, type MonsterRank } from "../lib/bestiary";
import { getMonster, load } from "../lib/data";
import { formatChance, formatNumber } from "../lib/format";
import { name, t, type Key } from "../lib/i18n";
import { abilityText, levelCells, lootRows, neighboursOf, pageVariants, questsFor, respawnText, shapeText, summonedBy } from "../lib/monster";
import { sectionHref } from "../lib/sections";
import { tooltipData } from "../lib/tooltip";
import { caveOf, placeHref, respawn } from "../lib/world";

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const m = getMonster(id)!;
const mech = load("mechanics");
const gap = Number((mech.combat as Record<string, unknown>).passiveLevelGap ?? 0);
const variants = pageVariants(m);
const summoners = summonedBy(id);
const summonerNames = summoners.map((b) => name(b.name, lang)).join(", ");
const first = variants[0];
const firstPlaces = placesOf(m, first, lang);
const crumbPlace = firstPlaces[0];
const title = name(m.variants[first].name, lang);
const quests = questsFor(id);
const others = neighboursOf(m, lang);
const kindText = (element?: string) => {
  const kind = t(lang, m.damageKind === "magic" ? "dmg.magic" : "dmg.phys");
  const el = element ? load("elements").elements.find((e) => e.id === element) : undefined;
  return el ? `${kind} (${name(el.name, lang).toLowerCase()})` : kind;
};
const bindLabel = t(lang, "tooltip.bind");
const [fMin, fMax] = finalLevels(m.variants[first]);

const pageData: Record<string, unknown> = {};
const views = variants.map((v) => {
  const info = m.variants[v];
  const cells = info.levels.map((row) => levelCells(row, lang));
  pageData[v] = cells;
  const places = placesOf(m, v, lang);
  const [min, max] = finalLevels(info);
  const zone = places[0]?.zone ?? "yellow";
  const rows = lootRows(m, v, lang);
  // Default preview: the rarest equipment group (like the mock-up's top row), else the rarest item.
  const preview = rows.find((r) => r.kind === "group" && r.item) ?? rows.find((r) => r.item) ?? rows[0];
  const desc = places.length > 0
    ? t(lang, "monster.desc", {
        name: name(info.name, lang),
        places: places.map((p) => p.name).join(", "),
        min,
        max,
        attack: t(lang, m.attack === "ranged" ? "monster.attack.ranged" : "monster.attack.melee"),
        kind: kindText(m.element),
      })
    : t(lang, "monster.none", { bosses: summonerNames });
  const levelAdd = mech.variants[v]?.levelAdd ?? 0;
  return { v, info, cells, places, min, max, zone, rows, preview, desc, levelAdd };
});
const abilityCells = m.variants.elite2?.levels[0] ? levelCells(m.variants.elite2.levels[0], lang) : undefined;
const description = t(lang, "og.monster", { name: title, min: fMin, max: fMax, place: crumbPlace?.name ?? "" });
const tabLabel = (v: MonsterRank) => name(mech.variants[v]?.name, lang);
const statCols = [
  { key: "level", label: t(lang, "col.level"), align: "right" as const },
  { key: "hp", label: t(lang, "monster.stat.hp"), align: "right" as const },
  { key: "dmg", label: t(lang, "monster.stat.dmg"), align: "right" as const },
  { key: "armor", label: t(lang, "monster.stat.armor"), align: "right" as const },
  { key: "mres", label: t(lang, "monster.stat.mres"), align: "right" as const },
  { key: "exp", label: t(lang, "monster.stat.exp"), align: "right" as const },
  { key: "gold", label: t(lang, "monster.stat.gold"), align: "right" as const },
];
---
<Base
  lang={lang}
  title={title}
  description={description}
  section="bestiary"
  search={{ type: "monster", meta: { title, line: `${t(lang, "levelRangeCap", { min: fMin, max: fMax })} · ${crumbPlace?.name ?? summonerNames}` } }}
  og={{ image: `/img/og/${lang}/monster/${id}.jpg`, alt: title }}
>
  <div class="page" data-monster style={`--glow: var(--vw-zone-${views[0].zone})`}>
    <Crumbs
      items={[
        { label: t(lang, "crumbs.wiki"), href: href(lang, "home") },
        { label: t(lang, "monster.crumb"), href: sectionHref(lang, "bestiary") },
        ...(crumbPlace ? [{ label: crumbPlace.name, href: placeHref(lang, crumbPlace.id) }] : []),
        { label: title },
      ]}
    />

    {variants.length > 1 && (
      <div class="tabs js-only" role="tablist" aria-label={t(lang, "monster.variants")}>
        {variants.map((v, i) => (
          <button type="button" role="tab" class={`tab rank-${v}`} id={`tab-${v}`} aria-controls={`variant-${v}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={v}>
            {tabLabel(v)}
          </button>
        ))}
      </div>
    )}

    {views.map((view, vi) => {
      const H = vi === 0 ? "h1" : "h2";
      const cell = view.cells[0];
      return (
        <section class="variant" id={`variant-${view.v}`} data-variant={view.v} data-active={vi === 0 ? "true" : undefined} role={variants.length > 1 ? "tabpanel" : undefined} aria-labelledby={variants.length > 1 ? `tab-${view.v}` : undefined} style={`--glow: var(--vw-zone-${view.zone})`}>
          <div class="top">
            <MonsterImage id={id} variant={view.v} stage="page" alt={name(view.info.name, lang)} element={m.element} eager={vi === 0} />
            <div class="info">
              <div class="badges">
                <RankBadge rank={view.v} lang={lang} />
                <span class="vw-rank">{view.min === view.max ? t(lang, "level", { level: view.min }) : t(lang, "levelRangeCap", { min: view.min, max: view.max })}</span>
                {m.family && <span class="vw-rank">{t(lang, `family.${m.family}` as Key)}</span>}
                <ElementBadge element={m.element} damageKind={m.damageKind} lang={lang} />
                <ZoneBadge zone={view.zone} lang={lang} />
              </div>
              <H class="h1">{name(view.info.name, lang)}</H>
              <p class="desc">{view.desc}</p>
              {view.cells.length > 1 && (
                <div class="levels js-only" role="group" aria-label={t(lang, "monster.levelPick")}>
                  {view.cells.map((c, i) => <button type="button" class="vw-chip" data-level={i} aria-pressed={i === 0 ? "true" : "false"}>{c.level}</button>)}
                </div>
              )}
              <div class="hpbar" data-cell="bar"><Bar value={cell.hp} max={cell.hp} lang={lang} /></div>
              <dl class="cells">
                <div><dt>{t(lang, "monster.stat.hp")}</dt><dd data-cell="hpText">{cell.hpText}</dd></div>
                <div><dt>{t(lang, "monster.stat.dmg")}<sup title={t(lang, "monster.dmgNote")}>*</sup></dt><dd data-cell="dmg">{cell.dmg}</dd></div>
                <div><dt>{t(lang, "monster.stat.armor")}</dt><dd data-cell="armor">{cell.armor}</dd></div>
                <div><dt>{t(lang, "monster.stat.exp")}</dt><dd data-cell="exp">{cell.exp}</dd></div>
                <div><dt>{t(lang, "monster.stat.respawn")}</dt><dd>{respawnText(view.info, lang)}</dd></div>
                <div class="mobile-only"><dt>{t(lang, "monster.stat.gold")}</dt><dd data-cell="gold">{cell.gold}</dd></div>
              </dl>
              <p class="note">* {t(lang, "monster.dmgNote")}</p>
              <details class="combat" open>
                <summary class="vw-label">{t(lang, "monster.combat")}</summary>
                <ul>
                  <li><span>{t(lang, "monster.stat.gold")}</span><strong data-cell="gold">{cell.gold}</strong></li>
                  <li><span>{t(lang, "monster.stat.mres")}</span><strong data-cell="mres">{cell.mres}</strong></li>
                  <li><span>{t(lang, "monster.stat.attackEvery")}</span><strong><span data-cell="interval">{cell.interval}</span> s</strong></li>
                  <li><span>{t(lang, "monster.stat.range")}</span><strong>{cell.range} st.</strong></li>
                  <li><span>{t(lang, "monster.stat.kind")}</span><strong>{kindText(m.element)}</strong></li>
                  <li><span>{t(lang, "monster.stat.aggro")}</span><strong>{cell.aggro} st.</strong></li>
                  <li class="full"><strong>{m.passive ? t(lang, "monster.passive") : t(lang, "monster.gap", { n: gap })}</strong></li>
                </ul>
              </details>
            </div>
          </div>

          <div class="lower">
            <section class="loot" aria-labelledby={`loot-${view.v}`}>
              <div class="lhead">
                <SectionTitle id={`loot-${view.v}`}>{t(lang, "monster.loot")}</SectionTitle>
                <span class="hint">{t(lang, "monster.lootHint")}</span>
              </div>
              <table class="vw-table loottable" data-pagefind-ignore>
                <caption class="vw-sr">{t(lang, "monster.loot")}</caption>
                <thead>
                  <tr>
                    <th scope="col"><span class="vw-sr">{t(lang, "renders.title")}</span></th>
                    <th scope="col">{t(lang, "loot.col.item")}</th>
                    <th scope="col">{t(lang, "loot.col.rarity")}</th>
                    <th scope="col">{t(lang, "loot.col.type")}</th>
                    <th scope="col" style="text-align: right">{t(lang, "loot.col.chance")}</th>
                  </tr>
                </thead>
                <tbody>
                  {view.rows.map((r) => (
                    <tr data-row={r.key} tabindex="0" aria-selected={r.key === view.preview.key ? "true" : "false"} class={`kind-${r.kind}`}>
                      <td class="icon"><ItemIcon glyph={r.glyph} color={r.color} rarity={r.rarity} size={38} src={r.icon} /></td>
                      <td class="iname">
                        {r.top ? (
                          <details class="grp">
                            <summary><span class="nm" style={r.rarity ? `color: var(--vw-r-${r.rarity}-text)` : undefined}>{r.name}</span> <span class="sub">· {r.sub}</span></summary>
                            <ul class="top">
                              <li class="vw-label">{t(lang, "loot.top")}</li>
                              {r.top.map((x) => (
                                <li>{x.href ? <a href={x.href}>{x.name}</a> : <span>{x.name}</span>}<span class="tc">{x.chanceText}</span></li>
                              ))}
                            </ul>
                          </details>
                        ) : (
                          <>
                            {r.href ? <a class="nm" href={r.href} style={r.rarity ? `color: var(--vw-r-${r.rarity}-text)` : undefined}>{r.name}</a> : <span class="nm" style={r.rarity ? `color: var(--vw-r-${r.rarity}-text)` : undefined}>{r.name}</span>}
                            {r.sub && <span class="sub">{r.questHref ? <a href={r.questHref}>{r.sub}</a> : r.sub}</span>}
                          </>
                        )}
                      </td>
                      <td class="muted hide-m">{r.rarityText}</td>
                      <td class="muted hide-m">{r.type}</td>
                      <td class="chance">{r.chanceText}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">{t(lang, "monster.lootNote", { chance: formatChance(view.info.loot.itemChance, lang), count: view.info.loot.itemMin === view.info.loot.itemMax ? view.info.loot.itemMin : `${view.info.loot.itemMin}–${view.info.loot.itemMax}`, bias: formatChance(m.classBias, lang) })}</p>
            </section>

            <aside class="preview" aria-label={t(lang, "monster.lootPreview")}>
              <h3 class="vw-label">{t(lang, "monster.lootPreview")}</h3>
              {view.rows.map((r) => {
                const data = r.item ? tooltipData(r.item, { rarity: r.itemRarity, lang }) : undefined;
                return (
                  <div class="tip" data-tip={r.key} hidden={r.key !== view.preview.key}>
                    {data ? (
                      <>
                        <ItemTooltip data={data} href={r.href} labels={{ bind: bindLabel }} />
                        {r.href && <a class="open" href={r.href}>{t(lang, "monster.openItem")}</a>}
                      </>
                    ) : (
                      <div class="plain"><strong>{r.name}</strong><span>{r.sub}</span><span class="muted">{r.type} · {r.chanceText}</span></div>
                    )}
                  </div>
                );
              })}
            </aside>

            <details class="alllv" open>
              <summary><span class="vw-label">{t(lang, "monster.allLevels")}</span></summary>
              <DataTable
                caption={t(lang, "monster.allLevels")}
                columns={statCols}
                rows={view.cells.map((c) => ({ level: c.level, hp: c.hpText, dmg: c.dmg, armor: c.armor, mres: c.mres, exp: c.exp, gold: c.gold }))}
              />
            </details>

            <section class="skills" aria-labelledby={`skills-${view.v}`}>
              <SectionTitle id={`skills-${view.v}`}>{t(lang, "monster.skills")}</SectionTitle>
              <ul class="skill-list">
                <li class="skill">
                  <span class="sicon" aria-hidden="true">{m.attack === "ranged" ? "➶" : "⚔"}</span>
                  <div>
                    <h4>{t(lang, "monster.basic")}</h4>
                    <p>{t(lang, "monster.basic.desc", { attack: t(lang, m.attack === "ranged" ? "monster.attack.ranged" : "monster.attack.melee"), range: cell.range, every: cell.interval, kind: kindText(m.element) })}</p>
                  </div>
                </li>
                {m.ability && variants.includes("elite2") && (
                  <li class="skill">
                    <Telegraph shape={m.ability.shape} radius={m.ability.radius} inner={m.ability.inner} angle={m.ability.angle} length={m.ability.length} width={m.ability.width} origin={m.ability.origin} size={44} label={t(lang, "telegraph.label", { shape: shapeText(m.ability, m.ability.origin, lang) })} />
                    <div>
                      <h4>{name(m.ability.name, lang) || m.ability.id}</h4>
                      <p class="kicker">{t(lang, "monster.ability")}</p>
                      <p>{abilityText(m.ability, view.v === "elite2" ? cell : abilityCells, lang, m.damageKind)}</p>
                      {view.v !== "elite2" && <p class="muted">{t(lang, "monster.abilityOnly")}</p>}
                    </div>
                  </li>
                )}
                <li class="skill">
                  <span class="sicon" aria-hidden="true">◉</span>
                  <div>
                    <h4>{t(lang, "monster.behaviour")}</h4>
                    <p>{m.passive ? t(lang, "monster.behaviour.passive", { speed: formatNumber(m.moveSpeed, lang) }) : t(lang, "monster.behaviour.aggro", { aggro: cell.aggro, gap, speed: formatNumber(m.moveSpeed, lang) })}</p>
                  </div>
                </li>
              </ul>
            </section>

            <section class="where" aria-labelledby={`where-${view.v}`}>
              <h3 class="vw-label" id={`where-${view.v}`}>{t(lang, "monster.where")}</h3>
              {view.places.length === 0 && <p class="muted">{t(lang, "monster.none", { bosses: summonerNames })}</p>}
              {view.info.spawns.map((s) => {
                const place = view.places.find((p) => p.id === (s.cave ?? s.area ?? s.map));
                const cave = s.cave ? caveOf(s.cave) : undefined;
                const pool = view.v === "elite2" && cave ? cave.elite2.map((x) => name(getMonster(x)?.variants.elite2?.name, lang)).filter(Boolean) : [];
                const profile = s.profile ? mech.areaProfiles?.[s.profile] : undefined;
                const target = placeHref(lang, place?.id ?? s.map);
                return (
                  <article class="wcard">
                    <MiniMap map={s.map} lang={lang} size="md" highlight={s.cave ? { caves: [s.cave] } : s.area ? { areas: [s.area] } : {}} />
                    <div class="wbody">
                      {target ? <a class="wname" href={target}>{place?.name}</a> : <span class="wname">{place?.name}</span>}
                      <span class="muted">{t(lang, "levelRangeCap", { min: s.levelMin + view.levelAdd, max: s.levelMax + view.levelAdd })} · {name(mech.zones[place?.zone ?? "yellow"]?.name, lang)}</span>
                      <span class="muted">{t(lang, "monster.whereGroups", { groups: s.groups, count: s.count })} · {t(lang, "monster.whereRespawn", { time: respawn(s.respawnMin, s.respawnMax) })}</span>
                      {profile && <span class="profile" style={`--c: ${profile.color}`}>{name(profile.name, lang)}</span>}
                      {pool.length > 1 && <span class="muted">{t(lang, "monster.elite2Pick", { names: pool.join(", ") })}</span>}
                    </div>
                  </article>
                );
              })}
            </section>
          </div>
        </section>
      );
    })}

    <div class="related">
      {quests.length > 0 && (
        <section>
          <SectionTitle>{t(lang, "monster.quests")}</SectionTitle>
          <ul class="rel">
            {quests.map((q) => {
              const qh = sectionHref(lang, "quests", q.id);
              return <li><span class="muted">{t(lang, q.type === "collect" ? "monster.quest.collect" : "monster.quest.kill")}</span> {qh ? <a href={qh}>{name(q.title, lang)}</a> : <strong>{name(q.title, lang)}</strong>} <span class="muted">· {t(lang, "level", { level: q.level })}</span></li>;
            })}
          </ul>
        </section>
      )}
      {summoners.length > 0 && (
        <section>
          <SectionTitle>{t(lang, "monster.summonedBy")}</SectionTitle>
          <ul class="rel">{summoners.map((b) => <li><a href={bossHref(lang, b.id)}>{name(b.name, lang)}</a> <span class="muted">· {t(lang, "rank.boss")} · {t(lang, "level", { level: b.level })}</span></li>)}</ul>
        </section>
      )}
      {others.length > 0 && (
        <section>
          <SectionTitle>{t(lang, "monster.others")}</SectionTitle>
          <p class="chips">{others.map((o) => <a class="vw-chip" href={monsterHref(lang, o.id)}>{name(o.variants.normal?.name ?? o.name, lang)}</a>)}</p>
        </section>
      )}
    </div>
  </div>
  <script type="application/json" id="monster-data" set:html={JSON.stringify(pageData)} />
</Base>

<script>
  import "../scripts/monster";
</script>

<style>
  .page { position: relative; max-width: 1440px; margin: 0 auto; padding: 22px 72px 72px; }
  .page::before { content: ""; position: absolute; inset: 0 0 auto; height: 520px; pointer-events: none; z-index: -1;
    background: radial-gradient(ellipse 70% 100% at 50% 0%, color-mix(in srgb, var(--glow) 12%, transparent), transparent 70%); }
  :global(html:not(.js)) .js-only { display: none !important; }
  :global(html.js) .variant:not([data-active]) { display: none; }
  :global(html:not(.js)) .variant + .variant { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--vw-border); }
  .muted { color: var(--vw-text-muted); }
  .tabs { display: flex; gap: 4px; margin: 20px 0 0; border-bottom: 1px solid var(--vw-border); }
  .tab { min-height: 44px; padding: 0 20px; background: transparent; border: 0; border-bottom: 3px solid transparent; color: var(--vw-text-muted); font: 800 15px/1 var(--vw-font-ui); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .tab[aria-selected="true"] { color: var(--vw-text); border-bottom-color: var(--vw-gold-bright); }
  .tab.rank-elite[aria-selected="true"] { color: var(--vw-gold-bright); }
  .tab.rank-elite2[aria-selected="true"] { color: var(--vw-r-legendary-text); border-bottom-color: var(--vw-r-legendary); }
  .tab:focus-visible { box-shadow: var(--vw-focus); outline: none; }
  .top { display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: 48px; margin-top: 36px; }
  .info { display: flex; flex-direction: column; gap: 18px; min-width: 0; max-width: 820px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .h1 { margin: 0; font: 700 84px/1 var(--vw-font-display); color: var(--vw-text); }
  .desc { margin: 0; max-width: 720px; font-size: 21px; font-style: italic; line-height: 1.5; color: var(--vw-text-soft); }
  .levels { display: flex; flex-wrap: wrap; gap: 6px; }
  .levels .vw-chip { min-width: 44px; min-height: 44px; justify-content: center; }
  .hpbar { max-width: 760px; }
  .hpbar :global(.vw-bar) { height: 28px; }
  .cells { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); max-width: 760px; margin: 0; border: 1px solid var(--vw-border); background: var(--vw-panel); }
  .cells > div { padding: 14px; border-right: 1px solid var(--vw-border); }
  .cells > div:last-of-type { border-right: 0; }
  .cells dt { font-size: 13px; color: var(--vw-text-muted); }
  .cells dd { margin: 6px 0 0; font-size: 20px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .mobile-only { display: none; }
  sup { color: var(--vw-gold); }
  .note { margin: -8px 0 0; font-size: 13px; color: var(--vw-text-muted); }
  .loot .note { margin-top: 10px; }
  .combat { max-width: 760px; }
  .combat summary { cursor: pointer; min-height: 32px; }
  .combat ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 24px; font-size: 15px; }
  .combat li { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; border-bottom: 1px solid var(--vw-border-subtle); color: var(--vw-text-soft); }
  .combat li.full { grid-column: 1 / -1; color: var(--vw-gold-bright); }

  .lower { display: grid; grid-template-columns: minmax(0, 1fr) 400px; grid-template-areas: "loot preview" "levels where" "skills where"; gap: 32px 48px; margin-top: 56px; align-items: start; }
  .loot { grid-area: loot; min-width: 0; }
  .preview { grid-area: preview; display: flex; flex-direction: column; gap: 10px; }
  .alllv { grid-area: levels; min-width: 0; }
  .skills { grid-area: skills; min-width: 0; }
  .where { grid-area: where; display: flex; flex-direction: column; gap: 12px; }
