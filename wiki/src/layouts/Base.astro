---
// Page layout (S36): <head> (title, description, hreflang, canonical, theme before paint, styles in the order
// tokens -> tokens.data -> components; S44: web fonts from /fonts/fonts.css without blocking the first paint), skip
// link, topbar (desktop) / header (mobile), main, footer, bottom tab bar on mobile and the Ctrl+K palette (loaded on
// first use). `search` marks entity pages for Pagefind.
import "../styles/tokens.css";
import "../styles/tokens.data.css";
import "../styles/components.css";
import { DISCORD_URL, NOINDEX, PLAY_URL, SITE_URL } from "../config";
import { ogImageFor } from "../lib/og";
import { alternate as alternateOf, href, type Lang, type RouteKey } from "../i18n/routes";
import { translateSlug } from "../lib/content";
import { meta } from "../lib/data";
import { formatDate } from "../lib/format";
import { t, type Key } from "../lib/i18n";
import { NAV_GROUPS, SECTIONS, sectionHref } from "../lib/sections";
import SoonLink from "../components/SoonLink.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternate?: string;
  noindex?: boolean;
  section?: RouteKey;
  search?: { type: string; meta?: Record<string, string> };
  /** Share preview (S39): image path on this site (default /img/og/default-art.png) and its alt text. */
  og?: { image?: string; alt?: string };
}

const { lang, title, description = t(lang, "site.tagline"), noindex = false, section, search, og = {} } = Astro.props;
const path = Astro.url.pathname;

const alt = Astro.props.alternate ?? alternateOf(path, translateSlug);
const here = path.startsWith(`/${lang}/`) ? path : href(lang, "home");
const pagePl = lang === "pl" ? here : alt;
const pageEn = lang === "en" ? here : alt;
const fullTitle = title ? `${title} · ${t(lang, "site.name")}` : t(lang, "site.name");
const ogImage = new URL(ogImageFor(lang, section, og.image), SITE_URL).href;
const ogAlt = og.alt ?? (og.image ? undefined : title || t(lang, "og.default.alt"));
const robotsNoindex = noindex || NOINDEX;
const data = meta();
const dataDate = formatDate(data.dataDate, lang);

const navLabel: Record<string, Parameters<typeof t>[1]> = {
  items: "nav.items",
  bestiary: "nav.bestiary",
  classes: "nav.classes",
  map: "nav.map",
  upgrading: "nav.upgrading",
  regions: "nav.regions",
  bosses: "nav.bosses",
  crafting: "nav.crafting",
  quests: "nav.quests",
  mechanics: "nav.mechanics",
  guides: "nav.guides",
  updates: "nav.updates",
  home: "nav.home",
  search: "nav.search",
};
const TABS: { key: RouteKey; label: Parameters<typeof t>[1] }[] = [
  { key: "home", label: "nav.home" },
  { key: "items", label: "nav.items" },
  { key: "bestiary", label: "nav.bestiaryShort" },
  { key: "map", label: "nav.map" },
  { key: "search", label: "nav.search" },
];
// Top navigation: every section in groups (desktop: one dropdown per group, phones: the Menu panel).
const navGroups = NAV_GROUPS.map((group) => ({
  id: group.id,
  label: t(lang, `nav.group.${group.id}` as Key),
  current: section !== undefined && group.sections.includes(section),
  links: group.sections.map((key) => ({ key, label: t(lang, navLabel[key]), href: sectionHref(lang, key), current: section === key })),
}));
const tabHref = (key: RouteKey) => (key === "home" ? href(lang, "home") : sectionHref(lang, key) ?? null);
const footerSections = SECTIONS.filter((s) => s.ready && s.id !== "styleguide");
const searchMeta = search?.meta ?? {};
const navText = (id: string) => t(lang, `nav.${id}` as Key);
// S44: the Ctrl+K palette is loaded on first use (script below), not hydrated on every page.
const paletteProps = {
  lang,
  searchHref: href(lang, "search"),
  labels: {
    label: t(lang, "palette.label"),
    placeholder: t(lang, "search.placeholder"),
    hint: t(lang, "palette.hint"),
    close: t(lang, "palette.close"),
    all: t(lang, "palette.allTypes"),
    pending: t(lang, "search.pending"),
    types: Object.fromEntries((["item", "monster", "boss", "map", "area", "cave", "npc", "quest", "skill", "class", "guide", "mechanic"] as const).map((k) => [k, t(lang, `search.badge.${k}`)])),
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(here, SITE_URL).href} />
    <link rel="alternate" hreflang="pl" href={new URL(pagePl, SITE_URL).href} />
    <link rel="alternate" hreflang="en" href={new URL(pageEn, SITE_URL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePl, SITE_URL).href} />
    <meta name="theme-color" content="#14161B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- S44: fonts load after the first paint (scripts/fonts.mjs); size-matched local fallbacks until then -->
    <link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/fonts/fonts.css" /></noscript>
    <meta property="og:title" content={title || t(lang, "site.name")} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={search ? "article" : "website"} />
    <meta property="og:site_name" content={t(lang, "site.name")} />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "pl" ? "en_US" : "pl_PL"} />
    <meta property="og:url" content={new URL(here, SITE_URL).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("vw-theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="vw-skip" href="#main">{t(lang, "skip")}</a>
    <header class="vw-topbar">
      <a class="vw-topbar__logo" href={href(lang, "home")}>Vaelthorn</a>
      <nav class="vw-topbar__links" aria-label={t(lang, "nav.main")}>
        {navGroups.map((group) => (
          <details class="vw-dd" name="vw-nav" data-nav-dd>
            <summary class="vw-topbar__link" data-current={group.current ? "" : undefined}>
              {group.label}<svg class="caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5L5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
            </summary>
            <ul class="vw-dd__menu">
              {group.links.map((link) => (
                <li>
                  {link.href ? (
                    <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
                  ) : (
                    <span class="soon" aria-disabled="true" title={t(lang, "soon")}>{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </nav>
      <div class="tools">
        <details class="vw-menu vw-only-mobile" data-nav-dd>
          <summary class="vw-icon-btn" aria-label={t(lang, "nav.menu")}>
            <svg class="open" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6"></path></svg>
            <svg class="close" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6"></path></svg>
          </summary>
          <nav class="vw-menu__panel" aria-label={t(lang, "nav.main")}>
            <a class="vw-menu__home" href={href(lang, "home")} aria-current={section === undefined && path === href(lang, "home") ? "page" : undefined}>{t(lang, "nav.home")}</a>
            {navGroups.map((group) => (
              <div class="vw-menu__group">
                <p class="vw-label">{group.label}</p>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      {link.href ? (
                        <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
                      ) : (
                        <span class="soon" aria-disabled="true">{link.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>
        <a class="vw-search vw-only-desktop" href={href(lang, "search")} data-palette-open>
          <span>{t(lang, "search.placeholder")}</span>
          <kbd class="vw-kbd">Ctrl K</kbd>
        </a>
        <div class="vw-lang" role="group" aria-label={t(lang, "lang.switch")}>
          <a href={pagePl} hreflang="pl" lang="pl" aria-current={lang === "pl" ? "true" : undefined} data-lang="pl">PL</a>
          <a href={pageEn} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined} data-lang="en">EN</a>
        </div>
        <button class="vw-icon-btn theme" type="button" aria-pressed="false" aria-label={t(lang, "theme.toggle")} data-theme-toggle>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path class="half" d="M10 4a6 6 0 0 1 0 12z" fill="currentColor"></path></svg>
        </button>
        <a class="vw-icon-btn vw-only-mobile" href={href(lang, "search")} aria-label={t(lang, "search.open")} data-palette-open>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.6"></path></svg>
        </a>
        {PLAY_URL && <a class="vw-btn vw-btn--primary vw-only-desktop play" href={PLAY_URL} rel="noopener">{t(lang, "play")}</a>}
      </div>
    </header>

    <main id="main" tabindex="-1" data-pagefind-body={search ? "" : undefined} data-pagefind-filter={search ? `type:${search.type}` : undefined}>
      {/* value from an attribute: Pagefind splits "key:value" lists on commas (tooltips are JSON) */}
      {search && Object.entries(searchMeta).map(([key, value]) => <span hidden data-pagefind-meta={`${key}[data-v]`} data-v={value}></span>)}
      <slot />
    </main>

    <footer class="vw-footer">
      <div class="brand">
        <a class="vw-topbar__logo" href={href(lang, "home")}>Vaelthorn</a>
        <p>{t(lang, "site.tagline")}</p>
        {PLAY_URL && <a class="vw-btn vw-btn--play" href={PLAY_URL} rel="noopener">{t(lang, "play")}</a>}
      </div>
      <div>
        <p class="vw-label">{t(lang, "footer.wiki")}</p>
        <ul>
          <li><a href={href(lang, "home")}>{t(lang, "nav.home")}</a></li>
          {footerSections.map((s) => <li><a href={href(lang, s.id)}>{t(lang, navLabel[s.id] ?? "nav.search")}</a></li>)}
          {SECTIONS.filter((s) => !s.ready).slice(0, 4).map((s) => (
            <li><SoonLink href={null} lang={lang}>{navText(s.id)}</SoonLink></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="vw-label">{t(lang, "footer.community")}</p>
        <ul>
          {DISCORD_URL ? <li><a href={DISCORD_URL} rel="noopener">{t(lang, "footer.discord")}</a></li> : <li class="muted">—</li>}
        </ul>
      </div>
      <div>
        <p class="vw-label">{t(lang, "footer.data")}</p>
        <ul>
          <li>{t(lang, "footer.commit", { commit: data.dataCommit, date: dataDate })}</li>
          <li><a href={pagePl} lang="pl" data-lang="pl">Polski</a> · <a href={pageEn} lang="en" data-lang="en">English</a></li>
        </ul>
      </div>
    </footer>

    <nav class="vw-tabbar" aria-label={t(lang, "nav.tabbar")}>
      {TABS.map((tab) => {
        const target = tabHref(tab.key);
        const current = tab.key === "home" ? section === undefined && path === href(lang, "home") : section === tab.key;
        return target ? (
          <a href={target} aria-current={current ? "page" : undefined}><span class="vw-tabbar__mark" aria-hidden="true"></span>{t(lang, tab.label)}</a>
        ) : (
          <a aria-disabled="true" class="tab-soon"><span class="vw-tabbar__mark" aria-hidden="true"></span>{t(lang, tab.label)}</a>
        );
      })}
    </nav>

    <div id="vw-palette-root" data-props={JSON.stringify(paletteProps)}></div>
    <script>
      // S44: Ctrl/Cmd+K or a click on the topbar search field loads Svelte and the palette once and opens it; from
      // then on the palette handles its keys and clicks itself (no Svelte runtime on pages that never use it).
      let state: "idle" | "loading" | "ready" = "idle";
      async function load() {
        if (state !== "idle") return;
        state = "loading";
        const root = document.getElementById("vw-palette-root");
        if (!root) return;
        const [{ mount }, { default: Palette }] = await Promise.all([import("svelte"), import("../islands/SearchPalette.svelte")]);
        // the .svelte import is typed as an Astro component here; at runtime it is the Svelte component
        mount(Palette as unknown as import("svelte").Component<Record<string, unknown>>, { target: root, props: { ...JSON.parse(root.dataset.props ?? "{}"), startOpen: true } });
        state = "ready";
      }
      window.addEventListener("keydown", (event) => {
        if (state === "ready") return;
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          void load();
        }
      });
      document.querySelectorAll<HTMLElement>(".vw-search[data-palette-open]").forEach((field) =>
        field.addEventListener("click", (event) => {
          if (state === "ready") return;
          event.preventDefault();
          void load();
        }),
      );
    </script>

    <script>
      // Top navigation dropdowns (native <details>, so they work without JS): one open at a time, closed by a click
      // outside, Escape or following a link; on a mouse the desktop dropdowns also open on hover.
      const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>("details[data-nav-dd]")];
      const closeAll = (except?: HTMLDetailsElement) => dropdowns.forEach((d) => d !== except && (d.open = false));
      dropdowns.forEach((d) => {
        d.addEventListener("toggle", () => d.open && closeAll(d));
        d.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (d.open = false)));
      });
      document.addEventListener("click", (event) => {
        if (!(event.target as Element).closest("details[data-nav-dd]")) closeAll();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const open = dropdowns.find((d) => d.open);
        if (!open) return;
        open.open = false;
        open.querySelector("summary")?.focus();
      });
      if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
        document.querySelectorAll<HTMLDetailsElement>(".vw-dd").forEach((d) => {
          let timer = 0;
          d.addEventListener("mouseenter", () => {
            clearTimeout(timer);
            d.open = true;
          });
          d.addEventListener("mouseleave", () => {
            timer = window.setTimeout(() => (d.open = false), 150);
          });
        });
      }
    </script>

    <script>
      // Language links remember the choice; the theme button switches and remembers the theme.
      document.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((a) =>
        a.addEventListener("click", () => {
          try {
            localStorage.setItem("vw-lang", a.dataset.lang ?? "pl");
          } catch {
            /* private mode */
          }
        }),
      );
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const sync = () => button?.setAttribute("aria-pressed", String(root.dataset.theme === "light"));
      sync();
      button?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        try {
          localStorage.setItem("vw-theme", root.dataset.theme);
        } catch {
          /* private mode */
        }
        sync();
      });
    </script>
  </body>
</html>

<style>
  .vw-topbar { justify-content: flex-start; }
  .vw-topbar__logo:hover { text-decoration: none; color: var(--vw-gold-bright); }
  @media (min-width: 1024px) { .vw-topbar__links { display: flex; gap: 28px; } }
  /* top navigation: dropdowns (desktop) */
  .vw-dd { position: relative; }
  .vw-dd summary { list-style: none; cursor: pointer; gap: 6px; user-select: none; }
  .vw-dd summary::-webkit-details-marker, .vw-menu summary::-webkit-details-marker { display: none; }
  .vw-dd summary[data-current] { color: var(--vw-text); border-bottom-color: var(--vw-gold-bright); }
  .vw-dd[open] summary { color: var(--vw-text); }
  .vw-dd .caret { transition: transform var(--vw-dur-base); }
  .vw-dd[open] .caret { transform: rotate(180deg); }
  .vw-dd summary:focus-visible { outline: none; box-shadow: var(--vw-focus); }
  .vw-dd__menu { position: absolute; top: calc(100% + 1px); left: -16px; z-index: 50; min-width: 220px; margin: 0; padding: 8px 0; list-style: none; background: var(--vw-panel); border: 1px solid var(--vw-gold-dark); box-shadow: 0 12px 28px rgba(0,0,0,.45); }
  .vw-dd__menu a, .vw-dd__menu .soon { display: block; padding: 10px 16px; font: 700 15px/1.2 var(--vw-font-ui); color: var(--vw-text-soft); }
  .vw-dd__menu a:hover, .vw-dd__menu a:focus-visible { background: var(--vw-panel-raised); color: var(--vw-text); text-decoration: none; }
  .vw-dd__menu a[aria-current="page"] { color: var(--vw-gold-bright); box-shadow: inset 3px 0 0 var(--vw-gold-bright); }
  .soon { cursor: default; opacity: .6; }
  /* top navigation: Menu panel (phones) */
  .vw-menu summary { list-style: none; cursor: pointer; }
  .vw-menu .close, .vw-menu[open] .open { display: none; }
  .vw-menu[open] .close { display: block; }
  .vw-menu__panel { position: absolute; top: 100%; left: 0; right: 0; z-index: 50; max-height: calc(100dvh - 60px - 68px); overflow-y: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; padding: 16px 16px 24px; background: var(--vw-panel); border-bottom: 1px solid var(--vw-gold-dark); box-shadow: 0 16px 32px rgba(0,0,0,.5); }
  .vw-menu__home { grid-column: 1 / -1; }
  .vw-menu__group ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .vw-menu__panel a, .vw-menu__panel .soon { display: flex; align-items: center; min-height: 44px; font: 700 16px/1.2 var(--vw-font-ui); color: var(--vw-text-soft); }
  .vw-menu__panel a:hover { text-decoration: none; color: var(--vw-text); }
  .vw-menu__panel a[aria-current="page"] { color: var(--vw-gold-bright); }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .vw-search { width: 212px; justify-content: space-between; font-size: 15px; }
  .vw-search:hover { text-decoration: none; color: var(--vw-text-muted); }
  .play { min-height: 40px; }
  .theme :global(.half) { transition: transform var(--vw-dur-base); transform-origin: center; }
  :global([data-theme="light"]) .theme .half { transform: rotate(180deg); }
  @media (max-width: 1023px) {
    .vw-topbar { gap: 12px; }
    .tools { gap: 8px; }
  }
  .vw-footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .vw-footer .brand p { max-width: 320px; }
  .vw-footer a { color: var(--vw-text-soft); }
  .vw-footer .brand .vw-topbar__logo { color: var(--vw-gold-bright); }
  .muted { color: var(--vw-text-muted); }
  .tab-soon { opacity: .45; }
</style>
