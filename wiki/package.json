{
  "name": "vaelthorn-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/fonts.mjs && astro dev",
    "build": "node scripts/fonts.mjs && node scripts/routes.mjs --check && astro build && node scripts/og-images.mjs && node scripts/search-index.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check && eslint . && vitest run && npm run build && node scripts/check-links.mjs && node scripts/budgets.mjs && node scripts/audit.mjs",
    "qa": "playwright test",
    "lighthouse": "npm run build && lhci autorun",
    "ci:local": "npm run data && node scripts/stale-data.mjs && npm run check && npm run qa && node -e \"console.log('Remember: lune run tests/run.luau in the repository root')\"",
    "compare": "node scripts/compare-frames.mjs",
    "data": "node scripts/data.mjs",
    "shots": "node scripts/shots.mjs",
    "renders": "node scripts/renders.mjs",
    "renders:test": "node scripts/renders.mjs --test",
    "icons": "node scripts/item-icons.mjs",
    "routes": "node scripts/routes.mjs",
    "images:city": "node scripts/city-images.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "satori": "^0.35.1",
    "sharp": "^0.34.5",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^7.2.5",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "astro": "^5.18.2",
    "svelte": "^5.57.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
