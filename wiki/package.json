{
  "name": "vaelthorn-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/og-images.mjs && node scripts/search-index.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check && eslint . && vitest run && npm run build && node scripts/check-links.mjs && node scripts/budgets.mjs",
    "data": "node scripts/data.mjs",
    "shots": "node scripts/shots.mjs",
    "renders": "node scripts/renders.mjs",
    "renders:test": "node scripts/renders.mjs --test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "satori": "^0.35.1",
    "sharp": "^0.34.5",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^7.2.5",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "astro": "^5.18.2",
    "svelte": "^5.57.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
