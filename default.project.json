{
  "name": "Vaelthorn",
  "globIgnorePaths": ["**/.gitkeep"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Assets": {
        "$path": "assets"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "Assets": {
        "$className": "Folder"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "$className": "StarterPlayerScripts"
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Health": {
          "$path": "src/character/Health.server.luau"
        },
        "Animate": {
          "$path": "src/character/Animate.client.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 512,
        "StreamingMinRadius": 128,
        "StreamingIntegrityMode": "MinimumRadiusPause"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Soft",
        "GlobalShadows": true,
        "ShadowSoftness": 0.2,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
